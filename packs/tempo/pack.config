# tempo - a Grafana Tempo, from its own metrics page: is it ready and is
# its ingester ring whole, what spans does it receive and what does it
# discard, are its blocks flushed, and are they compacted.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable tempo (or one job: vigil pack enable tempo_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Grafana Tempo: whether it is ready and its ingester ring whole, ingestion (spans received, refused and discarded, and why; live traces; blocks flushed), requests and those that failed, and its storage (compaction, retention, the blocklist)
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Grafana Tempo 2.x (tested: 2.10.10, one binary); in microservices mode, each component reports those of these metrics it has
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/tempo/README.md
needs       = its address, where it is not http://localhost:3200: env = TEMPO_URL=... on each job (in microservices mode, a component: the ingestion job at a distributor or an ingester, the storage job at the compactor)
needs       = where it asks for a login (a proxy in front of it): TEMPO_USER and secret = TEMPO_PASSWORD=secret:TEMPO_PASSWORD, or secret = TEMPO_TOKEN=secret:TEMPO_TOKEN for a bearer token
needs       = for Tempo's CPU and memory: the base pack's processes job

[job.status]
metric_name = tempo
metrics     = up, ready, version, uptime_seconds, ingesters_active, ingesters_unhealthy, ring_unhealthy, ring_not_active, requests_count, requests_4xx_count, requests_5xx_count, inflight_requests
run_every   = 1m
max_runtime = 30s
env         = TEMPO_URL=
env         = TEMPO_USER=
env         = TEMPO_CACERT=

[job.ingestion]
metric_name = tempo.ingestion
metrics     = up, spans_received_count, bytes_received_count, receiver_accepted_count, receiver_refused_count, discarded_count, discarded, discarded_not_shown, live_traces, traces_created_count, blocks_flushed_count, flush_failures_count, flush_queue, append_failures_count, warnings_count
run_every   = 1m
max_runtime = 30s
env         = TEMPO_URL=
env         = TEMPO_USER=
env         = TEMPO_CACERT=

[job.storage]
metric_name = tempo.storage
metrics     = up, blocks, compactions_count, compaction_errors_count, retention_deleted_count, retention_errors_count, blocklist_poll_errors_count, backend_requests_count, backend_errors_count, work_queue
run_every   = 5m
max_runtime = 30s
env         = TEMPO_URL=
env         = TEMPO_USER=
env         = TEMPO_CACERT=
