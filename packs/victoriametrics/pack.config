# victoriametrics - a VictoriaMetrics server, from its own metrics page: is
# it up and writable, how much disk is left, what it ingests and what
# it turns away, how its queries fare, and are its scrape targets up.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable victoriametrics (or one job: vigil pack enable victoriametrics_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = VictoriaMetrics: whether it answers and its storage is writable, disk space, ingestion (rows by protocol, rows refused, new series, limits reached), queries (errors, slow ones, the concurrency limit), and the targets it scrapes
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = VictoriaMetrics single-node 1.90 and later (tested: 1.157.0); each component of a cluster (vminsert, vmselect, vmstorage) and vmagent report those of these metrics they have
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/victoriametrics/README.md
needs       = its address, where it is not http://localhost:8428: env = VICTORIAMETRICS_URL=... on each job
needs       = where it asks for a login (-httpAuth.username, or -metricsAuthKey behind a proxy): VICTORIAMETRICS_USER and secret = VICTORIAMETRICS_PASSWORD=secret:VICTORIAMETRICS_PASSWORD, or secret = VICTORIAMETRICS_TOKEN=secret:VICTORIAMETRICS_TOKEN for a bearer token
needs       = for VictoriaMetrics' CPU and memory: the base pack's processes job

[job.status]
metric_name = victoriametrics
metrics     = up, healthy, version, uptime_seconds, read_only, free_disk_bytes, data_bytes, http_requests_count, http_errors_count, http_errors, http_errors_not_shown, slow_queries_count, selects, selects_capacity, selects_pct, selects_limit_reached_count, selects_limit_timeout_count, errors_logged_count, panics_logged_count
run_every   = 1m
max_runtime = 30s
env         = VICTORIAMETRICS_URL=
env         = VICTORIAMETRICS_USER=
env         = VICTORIAMETRICS_CACERT=

[job.ingestion]
metric_name = victoriametrics.ingestion
metrics     = up, rows_inserted_count, rows_inserted, rows_inserted_not_shown, rows_invalid_count, rows_ignored_count, rows_ignored, rows_ignored_not_shown, new_series_count, slow_row_inserts_count, slow_inserts_pct, inserts, inserts_capacity, inserts_limit_reached_count, inserts_limit_timeout_count, series_limit_dropped_count, daily_limit_dropped_count, rows, pending_rows, active_merges
run_every   = 1m
max_runtime = 30s
env         = VICTORIAMETRICS_URL=
env         = VICTORIAMETRICS_USER=
env         = VICTORIAMETRICS_CACERT=

[job.targets]
metric_name = victoriametrics.targets
metrics     = up, targets_up, targets_down, scrapes_count, scrapes_failed_count, config_reload_ok, config_reload_errors_count, down, down_not_shown
run_every   = 1m
max_runtime = 30s
env         = VICTORIAMETRICS_URL=
env         = VICTORIAMETRICS_USER=
env         = VICTORIAMETRICS_CACERT=
