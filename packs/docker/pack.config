# docker - a Docker engine, from its own API: is it up, what state is every
# container in (running, restarting, unhealthy, killed for memory), what does
# each use (CPU, memory against its limit, network, disk), and how much disk
# do images, containers, volumes and the build cache take. Linux, macOS and
# Windows. See SPECIFICATION.md section 18.10 for this format.
#
# It only reads, and changes nothing: no container is started, stopped or
# removed, and nothing is pruned.
#
# Off until enabled: vigil pack enable docker (or one job: vigil pack enable
# docker_<job>). Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Docker: whether the engine answers, its containers by state, each container (running, restarts, health, exit code, killed for memory), each one's CPU, memory against its limit, network and disk, and the disk the engine uses (images, containers, volumes, build cache)
# What vigil pack info shows besides: the engines it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Docker Engine 20.10 and later (API 1.41), Linux and Windows containers, and Docker Desktop (tested: 29.9, 29.10)
programs_linux = bash, curl, jq
programs_macos = bash, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/docker/README.md
needs       = an account that may use the engine: root, or a member of the docker group (Linux); an administrator, or a member of the group daemon.json names (Windows). That is as good as root on the machine, as it is for anyone who can run docker
needs       = its address, where it is not the default (unix:///var/run/docker.sock; on Windows npipe:////./pipe/docker_engine): env = DOCKER_HOST=... on each job
needs       = for the engine's own CPU and memory (dockerd): the base pack's processes job; for how full the disk is, its disk job

[job.status]
metric_name = docker
metrics     = up, version, containers, running, paused, restarting, exited, created, dead, unhealthy, health_starting, exited_nonzero, images, cpus, memory_bytes, warnings
run_every   = 1m
max_runtime = 30s
env         = DOCKER_HOST=

[job.containers]
metric_name = docker.containers
metrics     = up, containers, containers_restarting, containers_unhealthy, containers_oom_killed, containers_exited_nonzero, restarts_total_count, running, restarts_count, oom_killed, uptime_seconds, healthy, exit_code, containers_not_shown
run_every   = 1m
max_runtime = 1m
env         = DOCKER_HOST=

[job.resources]
metric_name = docker.resources
metrics     = up, containers_measured, memory_total_bytes, memory_fullest_pct, cpu_throttled_containers, cpu_seconds_count, cpu_throttled_seconds_count, memory_bytes, memory_limit_bytes, memory_pct, pids, network_rx_bytes_count, network_tx_bytes_count, block_read_bytes_count, block_write_bytes_count, containers_not_shown
run_every   = 1m
max_runtime = 2m
env         = DOCKER_HOST=

[job.disk]
metric_name = docker.disk
metrics     = up, images, images_unused, images_dangling, images_bytes, images_reclaimable_bytes, containers, containers_bytes, containers_stopped_bytes, container_bytes, container_bytes_not_shown, volumes, volumes_unused, volumes_bytes, volumes_unused_bytes, volume_bytes, volume_bytes_not_shown, build_cache_bytes, build_cache_reclaimable_bytes
run_every   = 15m
max_runtime = 5m
env         = DOCKER_HOST=
