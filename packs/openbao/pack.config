# openbao - an OpenBao or HashiCorp Vault node, from what it says about
# itself: is it sealed, initialized, active or standby, is its Raft
# cluster healthy and how many nodes may it lose, how many leases does it
# hold, and do logins fail.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable openbao (or one job: vigil pack enable openbao_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = OpenBao and HashiCorp Vault: sealed or not, initialized, active or standby, the unseal progress, HA and the Raft cluster (autopilot, failure tolerance, nodes unhealthy, followers behind), storage latency, leases and irrevocable ones, logins that failed and users locked out, responses refused, audit devices that failed
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = OpenBao 2.x and HashiCorp Vault 1.15 and later, one node or an HA cluster (tested: OpenBao 2.7.3 and Vault 2.2.2, each a Raft cluster of three)
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/openbao/README.md
needs       = its address, where it is not http://localhost:8200: env = OPENBAO_URL=... on each job (https, and OPENBAO_CACERT when its CA is not one the system trusts)
needs       = for the storage, leases and requests jobs, its metrics: telemetry { prometheus_retention_time = "24h" } in its configuration, and a token that may read sys/metrics (secret = OPENBAO_TOKEN=secret:OPENBAO_TOKEN; packs/openbao/README.md has the policy), or unauthenticated_metrics_access = true on the listener
needs       = on a Vault standby, unauthenticated_metrics_access = true: Vault sends a standby's sys/metrics to the active node (HTTP 307) otherwise. The status job needs neither
needs       = on each node: each reports itself; for its CPU and memory: the base pack's processes job

[job.status]
metric_name = openbao
metrics     = up, info, initialized, sealed, standby, performance_standby, unseal_threshold, unseal_shares, unseal_progress, ha_enabled, active, leader_known, raft_apply_lag
run_every   = 1m
max_runtime = 30s
env         = OPENBAO_URL=
env         = OPENBAO_USER=
env         = OPENBAO_CACERT=

[job.storage]
metric_name = openbao.storage
metrics     = up, active, autopilot_healthy, failure_tolerance, nodes, nodes_unhealthy, node_unhealthy, node_unhealthy_not_shown, raft_peers, follower_lag_max, leader_contact_avg_ms, commit_avg_ms, leadership_lost_count, leadership_setup_failed_count, storage_reads_count, storage_read_avg_ms, storage_writes_count, storage_write_avg_ms
run_every   = 1m
max_runtime = 30s
env         = OPENBAO_URL=
env         = OPENBAO_USER=
env         = OPENBAO_CACERT=
secret      = OPENBAO_TOKEN=secret:OPENBAO_TOKEN

[job.leases]
metric_name = openbao.leases
metrics     = up, leases, irrevocable_leases, tokens_created_count, tokens_created, tokens_created_not_shown, tokens, mounts
run_every   = 5m
max_runtime = 30s
env         = OPENBAO_URL=
env         = OPENBAO_USER=
env         = OPENBAO_CACERT=
secret      = OPENBAO_TOKEN=secret:OPENBAO_TOKEN

[job.requests]
metric_name = openbao.requests
metrics     = up, requests_count, in_flight, logins_count, logins_ok_count, logins_failed_count, locked_users, responses_4xx_count, permission_denied_count, responses_5xx_count, audit_request_failures_count, audit_response_failures_count
run_every   = 1m
max_runtime = 30s
env         = OPENBAO_URL=
env         = OPENBAO_USER=
env         = OPENBAO_CACERT=
secret      = OPENBAO_TOKEN=secret:OPENBAO_TOKEN
