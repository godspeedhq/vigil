# sqlite - SQLite databases, from their files: each one there or not, its
# size and free pages, its write-ahead log and a rollback journal left in
# use; and, only when asked, PRAGMA quick_check. Linux, macOS and Windows.
# See SPECIFICATION.md section 18.10 for this format.
#
# It only reads: the status job reads each database's first 100 bytes and
# the sizes and times of its files, with no SQLite library and no lock. The
# check job does nothing until SQLITE_CHECK=quick; then it opens each one
# read-only with the sqlite3 program.
#
# Off until enabled: vigil pack enable sqlite. Then set the jobs' env lines:
#   env = SQLITE_FILES=/var/lib/grafana/grafana.db; /srv/app/data.db
# (the databases, separated by ;), and for the check, SQLITE_CHECK=quick.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = SQLite databases: there or not, size and free pages, a write-ahead log that keeps growing, a rollback journal left in use, and, when asked, PRAGMA quick_check
# What vigil pack info shows besides: the databases it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = SQLite 3 databases, WAL or rollback journal (tested: written by SQLite 3.46 to 3.54)
programs_linux = bash, od, awk; sqlite3 for the check
programs_macos = bash, od, awk; sqlite3 for the check (macOS has it)
programs_windows = PowerShell 5.1 or later; sqlite3.exe for the check
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/sqlite/README.md
needs       = the databases, their paths separated by ;: env = SQLITE_FILES=/var/lib/grafana/grafana.db; /srv/app/data.db
needs       = read access to each database for the account Vigil runs as, and in WAL mode to its folder for the check (packs/sqlite/README.md shows how)
needs       = for the check, which reads every page and can make writers wait in rollback mode: env = SQLITE_CHECK=quick, and run_every = 1d

[job.status]
metric_name = sqlite
metrics     = databases, missing, found, valid, info, size_bytes, page_size, pages, free_pages, free_pct, free_bytes, wal_bytes, journal_bytes, journal_seconds, last_write_seconds
run_every   = 5m
max_runtime = 1m
env         = SQLITE_FILES=

[job.check]
metric_name = sqlite.check
metrics     = checked, ok, problems, check_seconds, busy, not_ok
run_every   = 1d
max_runtime = 30m
env         = SQLITE_FILES=
env         = SQLITE_CHECK=off
env         = SQLITE3=
