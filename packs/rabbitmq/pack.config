# rabbitmq - RabbitMQ nodes and clusters, from their Prometheus pages: up,
# memory, disk and file descriptors against their limits and alarms,
# messages in, routed, delivered, acknowledged and lost, every queue (the
# deepest first), quorum queues' Raft logs, memory by what holds it, disk
# work, the links between nodes, virtual hosts, exchanges and bindings.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format.
#
# It reads the rabbitmq_prometheus plugin's pages (on by default, port
# 15692) with curl, or Invoke-WebRequest on Windows: no login, no cookie,
# nothing to install on the Vigil machine but curl. The node's Erlang VM
# (its memory by kind, processes, atoms, run queues, crash dumps) is the
# beam pack's: name the node there too.
#
# Off until enabled: vigil pack enable rabbitmq. Then set the jobs'
# RABBITMQ_TARGETS to each node, a name, then its page's address:
#   env = RABBITMQ_TARGETS=rabbit1=http://db1:15692; rabbit2=http://db2:15692
# Name every node of a cluster: each reports what it holds.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = RabbitMQ: up, memory, disk and file descriptors against their limits and alarms, messages in and out and lost, queues (the deepest first), quorum queues, memory by use, disk work, cluster links, vhosts
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = RabbitMQ 3.13 and 4.x, a node or a cluster, with its rabbitmq_prometheus plugin (on by default)
programs_linux = bash, curl
programs_macos = bash, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/rabbitmq/README.md
needs       = each node's Prometheus page (port 15692), reachable from this machine: RABBITMQ_TARGETS=<name>=http://<host>:15692, every node of a cluster
needs       = for https: RABBITMQ_CACERT, the CA that signed the plugin's certificate, or none for the system's own CAs
needs       = for the node's Erlang VM (its memory by kind, processes, atoms, run queues, crash dumps): the beam pack, not this one: vigil pack install beam, with BEAM_PROMETHEUS set to the same pages

[job.status]
metric_name = rabbitmq
metrics     = nodes, up, version, memory_used_bytes, memory_limit_bytes, memory_pct, disk_free_bytes, disk_free_limit_bytes, alarm_memory, alarm_disk, alarm_fds, fds_used, fds_max, fd_pct, erlang_processes, erlang_processes_limit, erlang_process_pct, run_queue, uptime_seconds, unreachable_peers, connections, channels, consumers, queues, publishers
run_every   = 1m
max_runtime = 50s
env         = RABBITMQ_TARGETS=
env         = RABBITMQ_CACERT=

[job.traffic]
metric_name = rabbitmq.traffic
metrics     = nodes, up, received_count, received_confirm_count, confirmed_count, routed_count, unroutable_dropped_count, unroutable_returned_count, delivered_count, delivered_manual_ack_count, delivered_auto_ack_count, redelivered_count, acknowledged_count, get_empty_count, dead_lettered_count, unacked, unconfirmed, message_avg_bytes, connections_opened_count, connections_closed_count, channels_opened_count, channels_closed_count, queues_declared_count, queues_created_count, queues_deleted_count, logins_count, logins_failed_count
run_every   = 1m
max_runtime = 50s
env         = RABBITMQ_TARGETS=
env         = RABBITMQ_CACERT=

[job.queues]
metric_name = rabbitmq.queues
metrics     = nodes, up, queues, messages_total, without_consumers, messages, ready, unacked, consumers, utilisation_pct, bytes, memory_bytes, oldest_seconds, published_count, queues_not_shown
cron        = 1/2 * * * *
max_runtime = 100s
env         = RABBITMQ_TARGETS=
env         = RABBITMQ_CACERT=

[job.quorum]
metric_name = rabbitmq.quorum
metrics     = nodes, up, members, leaders, term, commit_latency_seconds, commit_lag, apply_lag, segments, members_not_shown
cron        = 2/5 * * * *
max_runtime = 2m
env         = RABBITMQ_TARGETS=
env         = RABBITMQ_CACERT=

[job.memory]
metric_name = rabbitmq.memory
metrics     = nodes, up, served, connection_readers_bytes, connection_writers_bytes, channels_bytes, connection_other_bytes, classic_queues_bytes, quorum_queues_bytes, quorum_queues_dlx_bytes, quorum_ets_bytes, streams_bytes, binaries_bytes, message_index_bytes, metadata_store_bytes, metrics_bytes, management_bytes, plugins_bytes, code_bytes, atoms_bytes, other_processes_bytes, other_tables_bytes, other_system_bytes, allocated_unused_bytes, reserved_unallocated_bytes
cron        = 3/5 * * * *
max_runtime = 2m
env         = RABBITMQ_TARGETS=
env         = RABBITMQ_CACERT=

[job.storage]
metric_name = rabbitmq.storage
metrics     = nodes, up, counted, read_ops_count, read_bytes, read_seconds, write_ops_count, write_bytes, write_seconds, sync_ops_count, sync_seconds, seek_ops_count, seek_seconds, reopen_ops_count, msg_store_reads_count, msg_store_writes_count, queue_index_reads_count, queue_index_writes_count, metadata_disk_tx_count, metadata_ram_tx_count
cron        = 4/5 * * * *
max_runtime = 2m
env         = RABBITMQ_TARGETS=
env         = RABBITMQ_CACERT=

[job.cluster]
metric_name = rabbitmq.cluster
metrics     = nodes, up, peers, unreachable_peers, peer_up, peer_sent_bytes, peer_received_bytes, peer_queue_bytes, vhosts, vhosts_down, vhost_up, exchanges, bindings, peers_not_shown, vhosts_not_shown
run_every   = 1m
max_runtime = 50s
env         = RABBITMQ_TARGETS=
env         = RABBITMQ_CACERT=
