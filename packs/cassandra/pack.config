# cassandra - Apache Cassandra, on this machine or any it can reach, over JMX:
# each node up and in normal operation, gossip and CQL, the nodes it sees
# down, hints; the requests it coordinates, their latency, timeouts and
# unavailables; its thread pools, blocked tasks and dropped messages; its
# compactions, and the application's tables. Never Cassandra's JVM: that is
# the jvm pack's. Linux, macOS and Windows. See SPECIFICATION.md section
# 18.10 for this format, and tools/probe/DESIGN.md for the probe that reads
# it.
#
# Every script runs _probe.jar, beside it, with Java 11 or later (a JDK or a
# JRE), once it matches the digest the script carries, with this pack's
# _probe.tables. Nothing of Cassandra's is needed here: only its JMX.
#
# Off until enabled: vigil pack enable cassandra. Then set CASSANDRA_JMX in
# the jobs vigil pack enable writes into the configuration (db1:
# jmx=localhost:7199), and with a password, CASSANDRA_JMX_USER and a secret
# line (packs/cassandra/README.md has it all).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Apache Cassandra over JMX: each node up and normal, gossip and CQL, nodes down, hints; requests and their latency, timeouts and unavailables; thread pools, blocked tasks, dropped messages; compactions, SSTables and tombstones per table
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Apache Cassandra 4.1 and 5.0 (tested: a 5.0.9 cluster of three, and 4.1.12), with JMX reachable
programs_linux = Java 11 or later, a JDK or a JRE, to run the probe
programs_macos = Java 11 or later, a JDK or a JRE, to run the probe
programs_windows = Java 11 or later, a JDK or a JRE, to run the probe
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#cassandra
needs       = each node's JMX in CASSANDRA_JMX (db1: jmx=host:7199). Cassandra listens on JMX on localhost only (LOCAL_JMX=yes in cassandra-env.sh): run the pack on each node, pointed at localhost:7199, or open JMX with a password (LOCAL_JMX=no) to read it from elsewhere (packs/cassandra/README.md shows how)
needs       = for JMX with a password: CASSANDRA_JMX_USER, and a secret line on the jobs: secret = CASSANDRA_JMX_PASSWORD=secret:CASSANDRA_JMX_PASSWORD, then vigil secret set CASSANDRA_JMX_PASSWORD
needs       = for Cassandra's JVM (heap, garbage collection, threads): the jvm pack, not this one: vigil pack install jvm, with each node in JVM_TARGETS named as here

[job.status]
metric_name = cassandra
metrics     = jmx_up, version, mode, normal, gossip_up, native_up, nodes_up, nodes_down, load_bytes, exceptions_count, hints_count, hints_in_progress, clients, commitlog_pending, commitlog_bytes
run_every   = 1m
max_runtime = 90s
env         = CASSANDRA_JMX=
env         = CASSANDRA_JMX_USER=
env         = CASSANDRA_CACERT=

[job.requests]
metric_name = cassandra.requests
metrics     = jmx_up, requests_count, latency_p99_ms, latency_mean_ms, timeouts_count, unavailables_count, failures_count, requests_count_not_shown, latency_p99_ms_not_shown, latency_mean_ms_not_shown, timeouts_count_not_shown, unavailables_count_not_shown, failures_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = CASSANDRA_JMX=
env         = CASSANDRA_JMX_USER=
env         = CASSANDRA_CACERT=

[job.threads]
metric_name = cassandra.threads
metrics     = jmx_up, pending, active, blocked, blocked_count, dropped_total_count, dropped_count, pending_not_shown, active_not_shown, blocked_not_shown, blocked_count_not_shown, dropped_total_count_not_shown, dropped_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = CASSANDRA_JMX=
env         = CASSANDRA_JMX_USER=
env         = CASSANDRA_CACERT=

[job.tables]
metric_name = cassandra.tables
metrics     = jmx_up, compactions_pending, compactions_done_count, compacted_bytes_count, key_cache_hit_pct, sstables, table_compactions_pending, sstables_per_read_p99, tombstones_per_read_p99, disk_bytes, partition_max_bytes, sstables_not_shown, table_compactions_pending_not_shown, sstables_per_read_p99_not_shown, tombstones_per_read_p99_not_shown, disk_bytes_not_shown, partition_max_bytes_not_shown
cron        = 3/5 * * * *
max_runtime = 90s
env         = CASSANDRA_JMX=
env         = CASSANDRA_JMX_USER=
env         = CASSANDRA_CACERT=
