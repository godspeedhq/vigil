# kafka - Apache Kafka 3.9 and 4.x, KRaft or ZooKeeper, on this machine or
# any it can reach, through Kafka's own command-line tools: its brokers and
# controller quorum, replication, partition moves, consumer lag, groups,
# topics, data on disk, transactions, risky settings, ACLs, features and
# certificates; and from the brokers' JMX, their traffic, requests, JVM,
# controller and connections. Linux, macOS and Windows. See
# SPECIFICATION.md section 18.10 for this format.
#
# The jobs that run every 5 or 15 minutes, or each hour, have minutes of
# their own (cron, local time), so few runs start together. Each tool a
# job runs starts Java with Kafka's libraries: about 4 seconds on Linux,
# 10 or more on Windows. So only status, replication and consumers run
# every minute; the rest every 2, 5 or 15 minutes, or each hour.
#
# Off until enabled: vigil pack enable kafka. It logs in as a user that may
# only describe; create one once, as an administrator (packs/README.md has
# it all), with SCRAM:
#   kafka-configs --alter --entity-type users --entity-name vigil_monitor \
#     --add-config 'SCRAM-SHA-512=[password=...]'
#   kafka-acls --add --allow-principal User:vigil_monitor \
#     --operation Describe --operation DescribeConfigs --cluster --topic '*'
#   kafka-acls --add --allow-principal User:vigil_monitor \
#     --operation Describe --group '*' --transactional-id '*'
# and give Vigil its password:
#   vigil secret set KAFKA_MONITOR_PASSWORD
# For another cluster, or another login, edit the env lines of the jobs
# vigil pack enable writes into the configuration; for JMX, KAFKA_JMX.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Apache Kafka: brokers, KRaft quorum, replication, consumer lag, groups, topics, disk, transactions, settings, ACLs, features, certificates; traffic, requests, JVM, controller and connections from JMX
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Apache Kafka 3.9 and 4.x, KRaft or ZooKeeper, and the clusters built on it
programs_linux = Kafka's command-line tools (3.9 or later), Java 17 or later, openssl
programs_macos = Kafka's command-line tools (3.9 or later), Java 17 or later, openssl
programs_windows = Kafka's command-line tools (3.9 or later), Java 17 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#kafka
needs       = a user that may only describe, as an administrator: kafka-configs --alter --entity-type users --entity-name vigil_monitor --add-config 'SCRAM-SHA-512=[password=...]'
needs       = its ACLs: kafka-acls --add --allow-principal User:vigil_monitor --operation Describe --operation DescribeConfigs --cluster --topic '*'; kafka-acls --add --allow-principal User:vigil_monitor --operation Describe --group '*' --transactional-id '*'
needs       = for the JMX jobs (throughput, requests, jvm, controller, connections): each broker's JMX port, without a password, in KAFKA_JMX

[job.status]
metric_name = kafka
metrics     = up, info, brokers, brokers_fenced, controller_id
run_every   = 1m
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.quorum]
metric_name = kafka.quorum
metrics     = kraft, leader_id, leader_epoch, high_watermark, max_follower_lag, max_follower_lag_ms, voters, observers, node_lag, node_fetch_age_seconds, node_caught_up_age_seconds
cron        = 1/2 * * * *
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.brokers]
metric_name = kafka.broker
metrics     = online, fenced, leaders, replicas, out_of_sync_replicas, preferred_leaders, brokers_not_shown
cron        = 1/5 * * * *
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.replication]
metric_name = kafka.replication
metrics     = topics, partitions, under_replicated, offline, under_min_isr, at_min_isr, not_preferred_leader, with_eligible_leaders, reassigning, topic_under_replicated, topic_offline, topic_under_min_isr
run_every   = 1m
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.reassignment]
metric_name = kafka.reassignment
metrics     = partitions, adding_replicas, removing_replicas, topics, topic_partitions
cron        = 2/5 * * * *
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.consumers]
metric_name = kafka.consumer
metrics     = groups, total_lag, lag, lag_max, no_offset_partitions, pairs_not_shown, group_lag
run_every   = 1m
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.groups]
metric_name = kafka.group
metrics     = all_groups, all_members, rebalancing, empty, dead, groups, members, groups_not_shown
cron        = 3/5 * * * *
max_runtime = 3m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.topics]
metric_name = kafka.topic
metrics     = topics, internal_topics, rf1_topics, compacted_topics, partitions, replication_factor, messages_count, retained_messages, topics_not_shown
cron        = 4/5 * * * *
max_runtime = 3m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.logdirs]
metric_name = kafka.logdir
metrics     = size_bytes, partitions, offline, future_replicas, dirs, dirs_offline, broker_size_bytes, topic_size_bytes, topics_not_shown, jmx_up, remote_size_bytes, remote_copy_lag_bytes
cron        = 0/5 * * * *
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
env         = KAFKA_JMX=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.transactions]
metric_name = kafka.transaction
metrics     = all_transactions, transactions, ongoing, long_running
cron        = 1/5 * * * *
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
env         = KAFKA_TXN_LONG=300
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.config]
metric_name = kafka.config
metrics     = unclean_leader_election, auto_create_topics, auto_leader_rebalance, authorizer, min_insync_replicas, default_replication_factor, offsets_replication_factor, transactions_replication_factor, message_max_bytes, retention_hours, plaintext_listeners, settings_differ, topics_unclean_election, topics_min_isr_ge_rf, topics_min_isr_1
cron        = 6/15 * * * *
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.security]
metric_name = kafka.security
metrics     = authorizer, all_acls, any_principal_acls, all_operations_acls, acls, scram_users, quotas
cron        = 8/15 * * * *
max_runtime = 3m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.features]
metric_name = kafka.feature
metrics     = metadata_version, level, supported_level, behind, features, features_behind
cron        = 10/15 * * * *
max_runtime = 2m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD

[job.throughput]
metric_name = kafka.throughput
metrics     = jmx_up, messages_in_count, bytes_in_count, bytes_out_count, bytes_rejected_count, replication_bytes_in_count, replication_bytes_out_count, produce_requests_count, fetch_requests_count, failed_produce_requests_count, failed_fetch_requests_count, produce_conversions_count, fetch_conversions_count, invalid_crc_records_count, invalid_sequence_records_count
run_every   = 2m
max_runtime = 2m
env         = KAFKA_JMX=localhost:9999
env         = KAFKA_HOME=

[job.requests]
metric_name = kafka.request
metrics     = jmx_up, total_ms_p99, queue_ms_p99, remote_ms_p99, requests_count, request_queue, response_queue, purgatory, handler_idle_pct, network_idle_pct
cron        = 1/2 * * * *
max_runtime = 2m
env         = KAFKA_JMX=localhost:9999
env         = KAFKA_HOME=

[job.jvm]
metric_name = kafka.jvm
metrics     = jmx_up, heap_used_bytes, heap_max_bytes, gc_count, gc_ms_count, open_files, max_files, cpu_pct, threads, uptime_seconds, flush_ms_p99, flushes_count, cleaner_max_dirty_pct, cleaner_idle_seconds, cleaner_dead_threads, cleaner_max_clean_seconds, offline_log_dirs
cron        = 2/5 * * * *
max_runtime = 2m
env         = KAFKA_JMX=localhost:9999
env         = KAFKA_HOME=

[job.controller]
metric_name = kafka.controller
metrics     = jmx_up, active_controller, brokers, fenced_brokers, topics, partitions, offline_partitions, preferred_imbalance, metadata_errors, metadata_lag_ms, timed_out_heartbeats, controller_changes, elections_count, unclean_elections_count, eligible_leader_elections_count, event_queue, event_queue_ms_p99
run_every   = 2m
max_runtime = 2m
env         = KAFKA_JMX=localhost:9999
env         = KAFKA_HOME=

[job.connections]
metric_name = kafka.connection
metrics     = jmx_up, connections, created_count, logins_count, failed_logins_count, failed_relogins_count
cron        = 3/5 * * * *
max_runtime = 2m
env         = KAFKA_JMX=localhost:9999
env         = KAFKA_HOME=

[job.tls]
metric_name = kafka.tls
metrics     = tls, endpoints, reachable, expires_days, trusted
cron        = 12 * * * *
max_runtime = 3m
env         = KAFKA_BOOTSTRAP=localhost:9092
env         = KAFKA_SECURITY=SASL_SSL
env         = KAFKA_SASL_MECHANISM=SCRAM-SHA-512
env         = KAFKA_USER=vigil_monitor
env         = KAFKA_CACERT=
env         = KAFKA_HOME=
secret      = KAFKA_PASSWORD=secret:KAFKA_MONITOR_PASSWORD
