# phpfpm - PHP-FPM's pools, from their status pages: workers, the listen
# queue, max_children reached, slow requests and the busiest worker.
# Linux and macOS: there is no Windows script. See SPECIFICATION.md section
# 18.10 for this format, and tools/web/DESIGN.md.
#
# It only reads: it changes nothing on the server.
#
# Off until enabled: vigil pack enable phpfpm (or one job: vigil pack enable phpfpm_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = PHP-FPM: each pool's workers, listen queue, max_children reached, slow requests, and its busiest worker, from its status page
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = PHP-FPM 7.4 and later (tested: 8.6.0 and 8.3.37)
programs_linux = bash, curl
programs_macos = bash, curl
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/phpfpm/README.md
needs       = each pool's status page, through a web server, from this machine only: pm.status_path = /fpm-status in the pool, and a location passing /fpm-status to it (packs/phpfpm/README.md)
needs       = for PHP-FPM's CPU and memory: the base pack's processes job

[job.pools]
metric_name = phpfpm
metrics     = up, timed_out, info, uptime_seconds, accepted_count, listen_queue, listen_queue_max, listen_queue_len, listen_queue_pct, idle_processes, active_processes, total_processes, active_max, max_children_reached_count, slow_requests_count, memory_peak_bytes, processes_in_state, longest_request_ms, last_request_memory_max_bytes, last_request_cpu_max_pct, process_requests_max, process_age_max_seconds
run_every   = 1m
max_runtime = 50s
env         = PHPFPM_STATUS_URLS=http://127.0.0.1/fpm-status
