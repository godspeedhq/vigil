# etcd - an etcd member, from its own metrics page: is it healthy, does its
# cluster have a leader and quorum, how often does the leader change, do
# proposals fail, how full is its database against its quota, and is its
# disk fast enough.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable etcd (or one job: vigil pack enable etcd_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = etcd: healthy or not, a leader and quorum, leader changes, proposals failed and waiting, the database against its quota and its fragmentation, keys and revisions, watchers, the WAL's and the backend's disk latency, peers and gRPC requests that failed
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = etcd 3.5 and 3.6, a member of a cluster or one alone (tested: a 3.6.17 cluster of three, and 3.5.36), from its metrics listener (--listen-metrics-urls)
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/etcd/README.md
needs       = its metrics page: etcd serves /metrics and /health on its client port, where clients usually need a certificate; give it a plain one with --listen-metrics-urls=http://127.0.0.1:2381 (kubeadm's etcd has it already), and set env = ETCD_URL=... where it is elsewhere
needs       = on each member: each reports itself and its view of the cluster
needs       = for etcd's CPU and memory: the base pack's processes job

[job.status]
metric_name = etcd
metrics     = up, healthy, version, cluster_version, has_leader, is_leader, is_learner, leader_changes_count, members, peers_active, peers_unreachable, heartbeat_failures_count, peer_send_failures_count, proposals_committed_count, proposals_applied_count, apply_backlog, proposals_pending, proposals_failed_count, slow_applies_count, read_indexes_failed_count, slow_read_indexes_count, health_failures_count
run_every   = 1m
max_runtime = 30s
env         = ETCD_URL=
env         = ETCD_USER=
env         = ETCD_CACERT=

[job.database]
metric_name = etcd.database
metrics     = up, db_bytes, quota_bytes, db_used_pct, db_in_use_bytes, fragmented_bytes, keys, revision, compacted_revision, revisions_kept, last_compaction_seconds, puts_count, deletes_count, ranges_count, txns_count, watchers, watch_streams, slow_watchers, leases_granted_count, leases_expired_count, defrag_running
run_every   = 5m
max_runtime = 30s
env         = ETCD_URL=
env         = ETCD_USER=
env         = ETCD_CACERT=

[job.disk]
metric_name = etcd.disk
metrics     = up, wal_fsyncs_count, wal_fsync_avg_ms, wal_fsyncs_slow_count, backend_commits_count, backend_commit_avg_ms, backend_commits_slow_count, wal_written_bytes_count, peer_rtt_avg_ms
run_every   = 1m
max_runtime = 30s
env         = ETCD_URL=
env         = ETCD_USER=
env         = ETCD_CACERT=

[job.requests]
metric_name = etcd.requests
metrics     = up, requests_count, failed_count, failed, failed_not_shown, requests_started_count, client_received_bytes_count, client_sent_bytes_count
run_every   = 1m
max_runtime = 30s
env         = ETCD_URL=
env         = ETCD_USER=
env         = ETCD_CACERT=
