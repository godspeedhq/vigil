# victorialogs - a VictoriaLogs server, from its own metrics page: is it
# up and writable, how much disk is left, what logs it ingests and what
# it drops, and how its queries fare.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable victorialogs (or one job: vigil pack enable victorialogs_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = VictoriaLogs: whether it answers and its storage is writable, disk space, ingestion (rows and bytes by protocol, rows dropped and why), requests and those that failed, and queries against the concurrency limit
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = VictoriaLogs single-node 1.0 and later (tested: 1.54.0)
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/victorialogs/README.md
needs       = its address, where it is not http://localhost:9428: env = VICTORIALOGS_URL=... on each job
needs       = where it asks for a login (-httpAuth.username): VICTORIALOGS_USER and secret = VICTORIALOGS_PASSWORD=secret:VICTORIALOGS_PASSWORD, or secret = VICTORIALOGS_TOKEN=secret:VICTORIALOGS_TOKEN for a bearer token
needs       = for VictoriaLogs' CPU and memory: the base pack's processes job

[job.status]
metric_name = victorialogs
metrics     = up, healthy, version, uptime_seconds, read_only, free_disk_bytes, data_bytes, http_requests_count, http_errors_count, http_errors, http_errors_not_shown, selects, selects_capacity, selects_pct, selects_limit_reached_count, selects_limit_timeout_count, live_tails, errors_logged_count, panics_logged_count
run_every   = 1m
max_runtime = 30s
env         = VICTORIALOGS_URL=
env         = VICTORIALOGS_USER=
env         = VICTORIALOGS_CACERT=

[job.ingestion]
metric_name = victorialogs.ingestion
metrics     = up, rows_ingested_count, rows_ingested, rows_ingested_not_shown, bytes_ingested_count, rows_dropped_count, rows_dropped, rows_dropped_not_shown, too_long_lines_count, ingest_errors_count, streams_created_count, rows, pending_rows, partitions, active_merges, compression_ratio
run_every   = 1m
max_runtime = 30s
env         = VICTORIALOGS_URL=
env         = VICTORIALOGS_USER=
env         = VICTORIALOGS_CACERT=
