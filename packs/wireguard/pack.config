# wireguard - WireGuard tunnels on this machine: each interface's peers, how
# long since each last completed a handshake (stale, or never), and the bytes
# each sent and received. Linux.
# See SPECIFICATION.md section 18.10 for this format.
#
# It never reads a key: it runs only "wg show interfaces", "wg show all
# latest-handshakes" and "wg show all transfer", as root through a sudoers
# rule that allows exactly those three (packs/wireguard/README.md).
#
# Off until enabled: vigil pack enable wireguard.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = WireGuard on Linux: interfaces and peers, each peer's last handshake (stale, or never), bytes sent and received; never a key
# What vigil pack info shows besides: what it watches, the programs its
# scripts need, and where it is explained.
works_with  = WireGuard on Linux, the kernel's or wireguard-go, set up by wg-quick, systemd-networkd, NetworkManager or by hand (tested: Linux 6.17, wireguard-tools 1.0.20260223)
programs_linux = bash, awk, wg (wireguard-tools), sudo
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/wireguard/README.md
needs       = root for wg show: a sudoers rule for exactly three read-only commands, none of which prints a key: vigil ALL=(root) NOPASSWD: /usr/bin/wg show interfaces, /usr/bin/wg show all latest-handshakes, /usr/bin/wg show all transfer (packs/wireguard/README.md)

[job.peers]
metric_name = wireguard
metrics     = interfaces, peers, peers_stale, peers_never, interface_peers, handshake_seconds, rx_bytes_count, tx_bytes_count, peers_not_shown
run_every   = 1m
max_runtime = 30s
env         = WG_STALE_SECONDS=180
