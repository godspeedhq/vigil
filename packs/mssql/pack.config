# mssql - Microsoft SQL Server 2019, 2022 and 2025, on Linux or Windows, on
# this machine or any it can reach: whether it answers and what it is, its
# workload, sessions and blocking, CPU and threads, Always On, waits, I/O
# per file, memory, tempdb, connections, each database, what keeps them safe,
# risky settings, backups and Agent jobs. Linux, macOS and Windows. See
# SPECIFICATION.md section 18.10 for this format.
#
# The jobs that run every 5 or 15 minutes each have minutes of their own
# (cron, local time), so few runs start together.
#
# Off until enabled: vigil pack enable mssql. It logs in as a read-only
# login; create one once, as an administrator (packs/README.md has it all):
#   CREATE LOGIN vigil_monitor WITH PASSWORD = '...';
#   GRANT VIEW SERVER PERFORMANCE STATE, VIEW SERVER SECURITY STATE,
#     VIEW ANY DATABASE, CONNECT ANY DATABASE TO vigil_monitor;
# (2019: VIEW SERVER STATE in place of the first two), and give Vigil its
# password:
#   vigil secret set MSSQL_MONITOR_PASSWORD
# For another host or port, edit the env lines of the jobs vigil pack enable
# writes into the configuration.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Microsoft SQL Server: up, workload, sessions and blocking, CPU, Always On, waits, I/O, memory, tempdb, connections, databases, integrity, settings, backups, Agent jobs
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = SQL Server 2019, 2022 and 2025, on Linux or Windows
programs_linux = sqlcmd (mssql-tools18 or go-sqlcmd)
programs_macos = sqlcmd (mssql-tools18 or go-sqlcmd)
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#mssql
needs       = a read-only login, as an administrator: CREATE LOGIN vigil_monitor WITH PASSWORD = '...'; GRANT VIEW SERVER PERFORMANCE STATE, VIEW SERVER SECURITY STATE, VIEW ANY DATABASE, CONNECT ANY DATABASE TO vigil_monitor (2019: VIEW SERVER STATE, VIEW ANY DATABASE, CONNECT ANY DATABASE)
needs       = for mssql_agent, in msdb: CREATE USER vigil_monitor FOR LOGIN vigil_monitor; ALTER ROLE SQLAgentReaderRole ADD MEMBER vigil_monitor

[job.status]
metric_name = mssql
metrics     = up, info, uptime_seconds, cpus, schedulers, connections, connections_max, clustered, cluster_node, hadr_enabled, agent_running
run_every   = 1m
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.performance]
metric_name = mssql.performance
metrics     = batch_requests_count, compilations_count, recompilations_count, transactions_count, logins_count, logouts_count, processes_blocked, errors_count, page_life_expectancy_seconds, lazy_writes_count, checkpoint_pages_count, page_reads_count, page_writes_count, lock_waits_count, lock_timeouts_count, deadlocks_count, page_splits_count, full_scans_count, memory_grants_pending, memory_grants_outstanding, buffer_cache_hit_pct, missing_indexes, missing_index_top_impact_pct
run_every   = 1m
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.activity]
metric_name = mssql.activity
metrics     = sessions, requests, requests_blocked, head_blockers, longest_request_seconds, longest_wait_seconds, oldest_transaction_seconds, idle_in_transaction, idle_in_transaction_seconds, longest_snapshot_seconds
run_every   = 1m
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.cpu]
metric_name = mssql.cpu
metrics     = sql_pct, other_pct, runnable_tasks, work_queued, pending_disk_io, workers, workers_max, workers_pct
run_every   = 1m
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.replication]
metric_name = mssql.replication
metrics     = primary, connected, health, local, sync_state, suspended, send_queue_bytes, send_rate_bytes, redo_queue_bytes, redo_rate_bytes, lag_seconds
run_every   = 1m
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.waits]
metric_name = mssql.waits
metrics     = wait_ms_count, top_wait_ms_count, top_waits_count
cron        = 1/5 * * * *
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.io]
metric_name = mssql.io
metrics     = reads_count, writes_count, read_bytes_count, written_bytes_count, read_stall_ms_count, write_stall_ms_count, size_bytes, files_not_shown
cron        = 2/5 * * * *
max_runtime = 1m
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.memory]
metric_name = mssql.memory
metrics     = target_bytes, total_bytes, process_bytes, process_low, system_total_bytes, system_available_bytes, system_low, buffer_pool_bytes, memory_grants_bytes, plan_cache_bytes, single_use_plan_bytes, xtp_bytes, clerk_bytes
cron        = 3/5 * * * *
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.tempdb]
metric_name = mssql.tempdb
metrics     = size_bytes, free_bytes, free_pct, version_store_bytes, user_objects_bytes, internal_objects_bytes, log_used_pct, data_files
cron        = 4/5 * * * *
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.connections]
metric_name = mssql.connections
metrics     = connections, connections_by_auth, sessions
cron        = 0/5 * * * *
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.databases]
metric_name = mssql.database
metrics     = databases, databases_not_shown, online, state, read_only, recovery, data_bytes, log_bytes, log_used_bytes, log_used_pct, log_reuse_waiting, active_transactions, compatibility_level, compatibility_behind, query_store
cron        = 6/15 * * * *
max_runtime = 1m
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.health]
metric_name = mssql.health
metrics     = checkdb_age_days, vlfs, pct_growth_files, max_size_used_pct, volume_total_bytes, volume_free_bytes, volume_free_pct, express_limit_used_pct, encryption_state, suspect_pages
cron        = 8/15 * * * *
max_runtime = 1m
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.config]
metric_name = mssql.config
metrics     = max_server_memory_mb, max_server_memory_default, maxdop, cost_threshold, optimize_for_ad_hoc, xp_cmdshell, clr_enabled, ole_automation, remote_admin_connections, sa_enabled, sysadmins, instant_file_init, locked_pages
cron        = 10/15 * * * *
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.backups]
metric_name = mssql.backups
metrics     = full_age_seconds, diff_age_seconds, log_age_seconds, never_backed_up
cron        = 12/15 * * * *
max_runtime = 1m
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD

[job.agent]
metric_name = mssql.agent
metrics     = readable, jobs, jobs_enabled, failed_24h, job_failed_24h, running, longest_running_seconds
cron        = 14/15 * * * *
max_runtime = 30s
env         = MSSQL_HOST=localhost
env         = MSSQL_PORT=1433
env         = MSSQL_USER=vigil_monitor
secret      = SQLCMDPASSWORD=secret:MSSQL_MONITOR_PASSWORD
