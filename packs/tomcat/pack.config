# tomcat - Apache Tomcat, on this machine or any it can reach, over JMX: the
# server and its connectors, requests and errors, threads and executors,
# requests running now and stuck, each app, its sessions and servlets, the
# JDBC pools, the resource cache and JSPs. Never Tomcat's JVM: that is the
# jvm pack's. Linux, macOS and Windows. See SPECIFICATION.md section 18.10
# for this format, and tools/probe/DESIGN.md for the probe that reads it.
#
# Every script runs _probe.jar, beside it, with Java 11 or later (a JDK or a
# JRE), once it matches the digest the script carries, with this pack's
# _probe.tables. Nothing of Tomcat's is needed here: only its JMX.
#
# Off until enabled: vigil pack enable tomcat. Then set TOMCAT_JMX in the
# jobs vigil pack enable writes into the configuration (web1:
# jmxs=host:port; web2: jmxs=host:port), TOMCAT_JMX_USER, and for its
# password a secret line (packs/README.md has it all).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.1
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Apache Tomcat over JMX: server, connectors, requests, threads and executors, requests running and stuck, apps, sessions, servlets, JDBC pools (DBCP, Tomcat JDBC, HikariCP), resource cache and JSPs
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Apache Tomcat 9, 10.1 and 11 (tested: 9.0, 10.1 and 11.0), with JMX on
programs_linux = Java 11 or later, a JDK or a JRE, to run the probe
programs_macos = Java 11 or later, a JDK or a JRE, to run the probe
programs_windows = Java 11 or later, a JDK or a JRE, to run the probe
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#tomcat
needs       = each Tomcat's JMX in TOMCAT_JMX (web1: jmxs=host:port): -Dcom.sun.management.jmxremote.port and a password and TLS in CATALINA_OPTS (packs/README.md shows how)
needs       = for JMX with a password: a secret line on the jobs: secret = TOMCAT_JMX_PASSWORD=secret:TOMCAT_JMX_PASSWORD, then vigil secret set TOMCAT_JMX_PASSWORD
needs       = for stuck requests: Tomcat's StuckThreadDetectionValve on the Host or the app (packs/README.md shows how)
needs       = for Tomcat's JVM (heap, garbage collection, threads, CPU, open files): the jvm pack, not this one: vigil pack install jvm, with each Tomcat in JVM_TARGETS named as here (web1: jmxs=host:port)

[job.status]
metric_name = tomcat
metrics     = jmx_up, version, up, engine_up, jvm_route, host_up, connector_up, host_up_not_shown, connector_up_not_shown
run_every   = 1m
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.requests]
metric_name = tomcat.requests
metrics     = jmx_up, requests_count, errors_count, sent_bytes, received_bytes, processing_seconds, slowest_seconds, requests_count_not_shown, errors_count_not_shown, sent_bytes_not_shown, received_bytes_not_shown, processing_seconds_not_shown, slowest_seconds_not_shown
run_every   = 1m
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.threads]
metric_name = tomcat.threads
metrics     = jmx_up, busy, threads, max_threads, connections, max_connections, keep_alive, backlog_max, paused, executor_busy, executor_threads, executor_max_threads, executor_largest, executor_queue, executor_max_queue, executor_done_count, utility_busy, utility_threads, utility_tasks_count, busy_not_shown, threads_not_shown, max_threads_not_shown, connections_not_shown, max_connections_not_shown, keep_alive_not_shown, backlog_max_not_shown, paused_not_shown, executor_busy_not_shown, executor_threads_not_shown, executor_max_threads_not_shown, executor_largest_not_shown, executor_queue_not_shown, executor_max_queue_not_shown, executor_done_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.inflight]
metric_name = tomcat.inflight
metrics     = jmx_up, running_seconds, stuck_threads, stuck_threshold_seconds, interrupted_count, running_seconds_not_shown, stuck_threads_not_shown, stuck_threshold_seconds_not_shown, interrupted_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.apps]
metric_name = tomcat.app
metrics     = jmx_up, up, uptime_seconds, startup_seconds, errors_count, requests_count, processing_seconds, slowest_seconds, up_not_shown, uptime_seconds_not_shown, startup_seconds_not_shown, errors_count_not_shown, requests_count_not_shown, processing_seconds_not_shown, slowest_seconds_not_shown
run_every   = 2m
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.sessions]
metric_name = tomcat.sessions
metrics     = jmx_up, active, most, limit, rejected_count, created_count, expired_count, created_per_minute, expired_per_minute, average_alive_seconds, longest_alive_seconds, active_not_shown, most_not_shown, limit_not_shown, rejected_count_not_shown, created_count_not_shown, expired_count_not_shown, created_per_minute_not_shown, expired_per_minute_not_shown, average_alive_seconds_not_shown, longest_alive_seconds_not_shown
run_every   = 1m
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.servlets]
metric_name = tomcat.servlet
metrics     = jmx_up, processing_seconds, requests_count, errors_count, slowest_seconds, load_seconds, processing_seconds_not_shown, requests_count_not_shown, errors_count_not_shown, slowest_seconds_not_shown, load_seconds_not_shown
cron        = 3/5 * * * *
max_runtime = 2m
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.jdbc]
metric_name = tomcat.jdbc
metrics     = jmx_up, active, idle, max, max_idle, min_idle, max_wait_seconds, size, waiting, borrowed_count, returned_count, created_count, released_count, abandoned_count, reconnected_count, hikari_active, hikari_idle, hikari_total, hikari_waiting, hikari_max, hikari_min_idle, hikari_timeout_seconds, active_not_shown, idle_not_shown, max_not_shown, max_idle_not_shown, min_idle_not_shown, max_wait_seconds_not_shown, size_not_shown, waiting_not_shown, borrowed_count_not_shown, returned_count_not_shown, created_count_not_shown, released_count_not_shown, abandoned_count_not_shown, reconnected_count_not_shown, hikari_active_not_shown, hikari_idle_not_shown, hikari_total_not_shown, hikari_waiting_not_shown, hikari_max_not_shown, hikari_min_idle_not_shown, hikari_timeout_seconds_not_shown
run_every   = 1m
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=

[job.cache]
metric_name = tomcat.cache
metrics     = jmx_up, lookups_count, hits_count, size_bytes, max_bytes, jsps, jsp_reloads_count, jsp_unloads_count, jsp_queue, string_cache_lookups_count, string_cache_hits_count, lookups_count_not_shown, hits_count_not_shown, size_bytes_not_shown, max_bytes_not_shown, jsps_not_shown, jsp_reloads_count_not_shown, jsp_unloads_count_not_shown, jsp_queue_not_shown
cron        = 4/5 * * * *
max_runtime = 90s
env         = TOMCAT_JMX=
env         = TOMCAT_JMX_USER=
env         = TOMCAT_CACERT=
