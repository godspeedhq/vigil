# iis - IIS on this Windows machine, as an account that is not an
# administrator: its sites, application pools and request queues, its
# worker processes, each site's log minute by minute and what HTTP.sys
# turned away, its events (pools stopped, workers crashed), and the
# certificates it serves.
# Windows: there is no Linux or macOS script. See SPECIFICATION.md section
# 18.10 for this format, and tools/web/DESIGN.md.
#
# It only reads: it changes nothing on the server.
#
# Off until enabled: vigil pack enable iis (or one job: vigil pack enable iis_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = IIS: sites, application pools and their request queues, worker processes, each site's log minute by minute and what HTTP.sys turned away, pools stopped and workers crashed (events), certificate expiry; no administrator needed
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = IIS 10 (Windows Server 2016 and later; tested: Windows Server 2025)
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/iis/README.md
needs       = the account Vigil runs as in Performance Monitor Users (for the counters) and Event Log Readers (for the events); LocalSystem, the Vigil service's account, already may
needs       = for the log job, read access to C:\inetpub\logs\LogFiles and C:\Windows\System32\LogFiles\HTTPERR (packs/iis/README.md has the icacls commands)
needs       = for IIS's CPU and memory (w3wp.exe): the base pack's processes job

[job.sites]
metric_name = iis
metrics     = up, uptime_seconds, sites, connections, site_uptime_seconds, site_connections, site_connections_max, site_requests_count, site_method_count, site_not_found_count, site_locked_count, site_bytes_sent_count, site_bytes_received_count, site_users, site_cgi_running, sites_not_shown
run_every   = 1m
max_runtime = 50s

[job.pools]
metric_name = iis.pools
metrics     = up, pools, pools_not_running, state, worker_processes, worker_processes_max, uptime_seconds, recycles_count, worker_failures_count, recent_failures, ping_failures_count, startup_failures_count, shutdown_failures_count, since_failure_seconds, queue, queue_oldest_ms, rejected_count, arrival_rate, rejection_rate, cache_hit_rate, pools_not_shown
run_every   = 1m
max_runtime = 50s

[job.workers]
metric_name = iis.workers
metrics     = workers, active_requests, requests_count, requests_rate, threads_active, threads, threads_max, sent_500_pct, sent_404_pct, sent_403_pct, sent_401_pct, websockets, file_cache_bytes, output_cache_bytes, uri_cache_hits_count, uri_cache_misses_count, workers_not_shown
run_every   = 1m
max_runtime = 50s

[job.log]
metric_name = iis.log
metrics     = log_readable, sites_logging, window_complete, requests, status_2xx, status_1xx, status_3xx, status_4xx, status_5xx, errors_5xx_pct, status, method, win32_errors, time_avg_ms, time_p50_ms, time_p90_ms, time_p99_ms, time_max_ms, httperr_readable, rejected_total, rejected, sites_not_shown
run_every   = 1m
max_runtime = 50s
env         = IIS_LOG_DIR=C:\inetpub\logs\LogFiles
env         = IIS_HTTPERR_DIR=C:\Windows\System32\LogFiles\HTTPERR
env         = IIS_LOG_MAX_MB=32

[job.events]
metric_name = iis.events
metrics     = readable, events, errors, warnings, rapid_fail_count, crashes_count, unresponsive_count, start_failures_count, recycles_count, idle_shutdowns_count, event, events_not_shown
run_every   = 5m
max_runtime = 2m
env         = IIS_EVENT_HOURS=1

[job.tls]
metric_name = iis.tls
metrics     = bindings_found, tls_up, cert_expires_days, cert_valid, cert_verified, cert_info, certs_not_shown
run_every   = 15m
max_runtime = 2m
env         = IIS_TLS=
env         = IIS_CACERT=
