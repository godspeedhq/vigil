# caddy - a Caddy server, from its admin API (GET only): its
# configuration and reloads, the traffic each server handles, its reverse
# proxies' upstreams, and the certificates every site serves.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/web/DESIGN.md.
#
# It only reads: it changes nothing on the server.
#
# Off until enabled: vigil pack enable caddy (or one job: vigil pack enable caddy_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Caddy: its configuration and reloads, traffic per server, reverse proxy upstreams and their health, certificate expiry for every site, from its admin API
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Caddy 2.6 and later (tested: 2.11.9)
programs_linux = bash, curl, jq, openssl
programs_macos = bash, curl, jq, openssl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/caddy/README.md
needs       = its admin API, reachable from this machine (Caddy's default, localhost:2019)
needs       = for the traffic job, its HTTP metrics: the global option { metrics } in the Caddyfile
needs       = for Caddy's CPU and memory: the base pack's processes job

[job.status]
metric_name = caddy
metrics     = up, servers, listeners, routes, sites, reverse_proxies, file_servers, tls_policies, metrics_enabled, reload_ok, last_reload_seconds, goroutines, open_fds, max_fds, fds_pct
run_every   = 1m
max_runtime = 30s
env         = CADDY_ADMIN=http://localhost:2019

[job.traffic]
metric_name = caddy.traffic
metrics     = up, metrics_enabled, requests_count, in_flight, handler_errors_count, status_2xx_count, status_3xx_count, status_4xx_count, status_5xx_count, duration_avg_ms, servers_not_shown
run_every   = 1m
max_runtime = 30s
env         = CADDY_ADMIN=http://localhost:2019

[job.upstreams]
metric_name = caddy.upstreams
metrics     = up, upstreams, upstreams_failing, upstreams_unhealthy, active_requests, fails, healthy, upstreams_not_shown
run_every   = 1m
max_runtime = 30s
env         = CADDY_ADMIN=http://localhost:2019

[job.tls]
metric_name = caddy.tls
metrics     = sites_found, tls_up, cert_expires_days, cert_valid, cert_verified, cert_info, certs_not_shown
run_every   = 15m
max_runtime = 2m
env         = CADDY_ADMIN=http://localhost:2019
env         = CADDY_TLS_ADDRESS=127.0.0.1:443
env         = CADDY_TLS=
env         = CADDY_CACERT=
