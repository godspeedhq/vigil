# opensearch - OpenSearch, from its REST API: the cluster's health, nodes,
# thread pools, circuit breakers, backpressure and admission control,
# indices, shards and why one is unassigned, disks and watermarks, the work
# each node does, ingest pipelines, tasks, ISM and snapshot management,
# snapshots and the cluster as a whole. Never its JVM: that is the jvm pack's.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/search/DESIGN.md.
#
# It only reads: every request is a GET, as a user that may only monitor.
# Linux and macOS read with curl and jq; Windows with PowerShell alone.
#
# Off until enabled: vigil pack enable opensearch. Then set the jobs' env lines:
#   env = OPENSEARCH_URL=https://es.example.com:9200
#   env = OPENSEARCH_USER=vigil
#   env = OPENSEARCH_CACERT=/etc/ssl/opensearch-ca.pem   (a private CA; Linux and macOS)
# add a secret line to each job:
#   secret = OPENSEARCH_PASSWORD=secret:OPENSEARCH_PASSWORD
# and: vigil secret set OPENSEARCH_PASSWORD
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = OpenSearch: cluster health, nodes, thread pools, breakers, backpressure, admission control, indices, shards and why unassigned, disk watermarks, node work, ingest, tasks, ISM, snapshot management, snapshots
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = OpenSearch 2.x and 3.x (tested: 2.19.7 and 3.10.0), with the security plugin on or off
programs_linux = bash, curl, jq
programs_macos = bash, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/opensearch/README.md
needs       = a user with a role that may only monitor (the security plugin): cluster permissions cluster_monitor and the reads of snapshots, ISM and snapshot management; index permissions indices_monitor, indices:admin/get and indices:monitor/settings/get on * (packs/opensearch/README.md has it), and its password as a secret: secret = OPENSEARCH_PASSWORD=secret:OPENSEARCH_PASSWORD, then vigil secret set OPENSEARCH_PASSWORD
needs       = for OpenSearch's JVM (heap, garbage collection, threads): the jvm pack, not this one: vigil pack install jvm

[job.status]
metric_name = opensearch
metrics     = up, version, status, timed_out, nodes, data_nodes, active_primary_shards, active_shards, active_shards_pct, relocating_shards, initializing_shards, unassigned_shards, unassigned_primary_shards, delayed_unassigned_shards, pending_tasks, task_max_wait_ms, in_flight_fetch, cluster_manager
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.nodes]
metric_name = opensearch.nodes
metrics     = up, nodes, master_eligible, data_nodes, ingest_nodes, coordinating_only, versions, info, cluster_manager, cpu_pct, load_1m, load_5m, load_15m, mem_used_pct, process_cpu_pct, open_fds, max_fds, fds_pct, disk_total_bytes, disk_free_bytes, disk_used_pct, http_open, http_opened, transport_open, transport_rx_bytes, transport_tx_bytes, indexing_pressure_bytes, indexing_pressure_limit_bytes, indexing_pressure_pct, indexing_rejections, nodes_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.thread_pools]
metric_name = opensearch.thread_pools
metrics     = up, rejected_total, queued_total, active_total, active, queue, queue_pct, rejected, completed, threads, largest, pools_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.breakers]
metric_name = opensearch.breakers
metrics     = up, tripped_total, max_used_pct, estimated_bytes, limit_bytes, used_pct, tripped, breakers_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.indices]
metric_name = opensearch.indices
metrics     = up, indices, open, closed, green, yellow, red, hidden, docs, deleted_docs, store_bytes, primary_store_bytes, blocked, write_blocked, health, is_open, index_docs, deleted_pct, index_store_bytes, index_primary_store_bytes, primaries, replicas, age_days, block, indices_not_shown
cron        = 1/5 * * * *
max_runtime = 4m
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.shards]
metric_name = opensearch.shards
metrics     = up, shards, primaries, replicas, started, relocating, initializing, unassigned, unassigned_primaries, unassigned_replicas, largest_shard_bytes, largest_shard_docs, shards_over_50gb, shards_over_200m_docs, node_shards, unassigned_seconds, unassigned_not_shown, explained, recoveries, recovery_pct, recovery_ms, recoveries_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.allocation]
metric_name = opensearch.allocation
metrics     = up, shards, undesired_shards, disk_indices_bytes, disk_used_bytes, disk_free_bytes, disk_total_bytes, disk_used_pct, watermark, nodes_over_low, nodes_over_high, nodes_over_flood, watermark_pct, watermark_free_bytes, disk_threshold_enabled, allocation_enabled, rebalance_enabled, exclusions, exclusion, max_shards_per_node, shards_capacity_pct, nodes_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.operations]
metric_name = opensearch.operations
metrics     = up, docs, store_bytes, index_total, index_time_ms, index_current, index_failed, delete_total, index_throttle_ms, query_total, query_time_ms, query_current, fetch_total, fetch_time_ms, scroll_current, open_contexts, get_total, get_missing, get_time_ms, merges_current, merges_total, merges_time_ms, merges_throttled_ms, refresh_total, refresh_time_ms, flush_total, flush_time_ms, query_cache_bytes, query_cache_hits, query_cache_misses, query_cache_evictions, request_cache_bytes, request_cache_hits, request_cache_misses, request_cache_evictions, fielddata_bytes, fielddata_evictions, segments, translog_ops, translog_bytes, translog_uncommitted_bytes, nodes_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.ingest]
metric_name = opensearch.ingest
metrics     = up, count, failed, time_ms, current, failed_pct, pipelines, pipeline_count, pipeline_failed, pipeline_failed_pct, pipeline_time_ms, pipeline_avg_ms, pipelines_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.tasks]
metric_name = opensearch.tasks
metrics     = up, tasks, longest_seconds, over_60s, cancellable, cancelled, searches, action_tasks, running_seconds, tasks_not_shown, pending, pending_oldest_ms, pending_ms
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.snapshots]
metric_name = opensearch.snapshots
metrics     = up, repositories, running, readable, snapshots, failed, partial, last_status, last_age_seconds, last_duration_seconds, last_failed_shards, last_success_age_seconds, repositories_not_shown
cron        = 7/15 * * * *
max_runtime = 10m
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.cluster]
metric_name = opensearch.cluster
metrics     = up, indices, shards, primary_shards, replication, docs, deleted_docs, store_bytes, segments, fields, fielddata_bytes, query_cache_bytes, nodes, role_nodes, versions, version_info, processors, fs_total_bytes, fs_free_bytes, fs_used_pct, pipelines, plugins
cron        = 3/5 * * * *
max_runtime = 4m
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.backpressure]
metric_name = opensearch.backpressure
metrics     = up, search_mode, search_cancellations, search_limit_reached, search_cancelled_for, shard_indexing_enabled, shard_indexing_enforced, shard_indexing_rejections, admission_rejections, nodes_not_shown
run_every   = 1m
max_runtime = 50s
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=

[job.lifecycle]
metric_name = opensearch.lifecycle
metrics     = up, ism_managed, ism_failed, ism_disabled, ism_in_state, ism_failure, ism_retries, ism_not_shown, sm_policies, sm_enabled, sm_last_status, sm_failing, sm_last_age_seconds, sm_next_seconds, sm_deletion_failing
cron        = 2/5 * * * *
max_runtime = 4m
env         = OPENSEARCH_URL=
env         = OPENSEARCH_USER=
env         = OPENSEARCH_CACERT=
