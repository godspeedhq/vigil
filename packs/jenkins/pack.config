# jenkins - a Jenkins controller, from its REST API: up, its version,
# executors busy, the build queue and what is stuck in it, every node
# online or not and why, the builds running now against their estimate,
# every job (folders and multibranch pipelines too) failing, unstable or
# disabled, and its plugins. Linux, macOS and Windows. See
# SPECIFICATION.md section 18.10 for this format.
#
# It reads /api/json with curl and jq (Linux, macOS), or Invoke-WebRequest
# (Windows), as a read-only user with an API token. Jenkins' JVM (its heap,
# garbage collection, threads) is the jvm pack's.
#
# Off until enabled: vigil pack enable jenkins. Then set the jobs' env
# lines:
#   env = JENKINS_URL=https://jenkins.example.com
#   env = JENKINS_USER=vigil
# add a secret line to each job:
#   secret = JENKINS_API_TOKEN=secret:JENKINS_API_TOKEN
# and: vigil secret set JENKINS_API_TOKEN (the user's API token).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Jenkins: up, version, executors, the queue and what is stuck, nodes online and why not, builds running against their estimate, jobs failing or unstable, plugins
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Jenkins 2.x (LTS and weekly), with a user that may read it: Overall/Read, Job/Read and Agent/Read
programs_linux = bash, curl, jq
programs_macos = bash, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/jenkins/README.md
needs       = a Jenkins user with Overall/Read, Job/Read and Agent/Read, and its API token as a secret: secret = JENKINS_API_TOKEN=secret:JENKINS_API_TOKEN, then vigil secret set JENKINS_API_TOKEN
needs       = for the plugins: Overall/SystemRead too (Jenkins started with -Djenkins.security.SystemReadPermission=true); without it, jenkins_plugins says readable 0
needs       = for Jenkins' JVM (heap, garbage collection, threads, CPU): the jvm pack, not this one: vigil pack install jvm

[job.status]
metric_name = jenkins
metrics     = up, version, quieting_down, executors_total, executors_busy, executors_busy_pct, queue_length, queue_buildable, queue_blocked, queue_stuck, nodes, nodes_offline, nodes_temporarily_offline
run_every   = 1m
max_runtime = 50s
env         = JENKINS_URL=
env         = JENKINS_USER=
env         = JENKINS_CACERT=

[job.nodes]
metric_name = jenkins.nodes
metrics     = up, nodes, monitors_readable, online, temporarily_offline, executors, busy, disk_free_bytes, disk_threshold_bytes, tmp_free_bytes, memory_free_bytes, memory_total_bytes, swap_free_bytes, response_ms, clock_diff_ms, nodes_not_shown
run_every   = 1m
max_runtime = 50s
env         = JENKINS_URL=
env         = JENKINS_USER=
env         = JENKINS_CACERT=

[job.queue]
metric_name = jenkins.queue
metrics     = up, queue_length, oldest_seconds, stuck, waiting_seconds, items_not_shown
run_every   = 1m
max_runtime = 50s
env         = JENKINS_URL=
env         = JENKINS_USER=
env         = JENKINS_CACERT=

[job.builds]
metric_name = jenkins.builds
metrics     = up, running, overdue, running_seconds, estimated_seconds, estimate_pct, builds_not_shown
run_every   = 1m
max_runtime = 50s
env         = JENKINS_URL=
env         = JENKINS_USER=
env         = JENKINS_CACERT=

[job.jobs]
metric_name = jenkins.jobs
metrics     = up, jobs, failing, unstable, disabled, never_built, building, job_failing, job_unstable, last_success_age_seconds, last_duration_seconds, jobs_not_shown
cron        = 2/5 * * * *
max_runtime = 4m
env         = JENKINS_URL=
env         = JENKINS_USER=
env         = JENKINS_CACERT=

[job.plugins]
metric_name = jenkins.plugins
metrics     = up, readable, plugins, updates, inactive, disabled, update, inactive_plugin, updates_not_shown
cron        = 13 * * * *
max_runtime = 2m
env         = JENKINS_URL=
env         = JENKINS_USER=
env         = JENKINS_CACERT=
