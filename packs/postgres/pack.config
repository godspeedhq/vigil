# postgres - a PostgreSQL server, on this machine or any it can reach:
# whether it answers, its connections, its longest query and transaction,
# transactions, deadlocks, cache hits and each database's size; what its
# sessions are doing and waiting on, replication, how far each database is
# from transaction ID wraparound, vacuum, and checkpoints, temporary files
# and WAL. Linux, macOS and Windows; PostgreSQL 14 or later for all but
# status and size. See SPECIFICATION.md section 18.10 for this format.
#
# The jobs that run every 5 or 15 minutes each have minutes of their own
# (cron, local time), around the base pack's and the mysql pack's, so few
# runs start together: io at 2, 7, 12 and so on, vacuum at 0, 15, 30 and 45,
# wraparound at 5, 20, 35 and 50, size at 10, 25, 40 and 55.
#
# Off until enabled: vigil pack enable postgres. It logs in as a read-only
# role, never a superuser; create one once, as an administrator:
#   CREATE ROLE vigil_monitor LOGIN PASSWORD '...' IN ROLE pg_monitor;
# and give Vigil its password:
#   vigil secret set POSTGRES_MONITOR_PASSWORD
# For another host, port, role or database, edit the env lines of the jobs
# vigil pack enable writes into the configuration.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.2.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = PostgreSQL: up, connections, sessions and locks, replication, wraparound, vacuum, checkpoints and WAL, database sizes
needs       = a read-only role, as a database administrator: CREATE ROLE vigil_monitor LOGIN PASSWORD '...' IN ROLE pg_monitor

[job.status]
metric_name = postgres
metrics     = up, connections, max_connections, connections_pct, longest_query_seconds, longest_transaction_seconds, commits_count, rollbacks_count, deadlocks_count, cache_hit_pct
run_every   = 1m
max_runtime = 30s
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD

[job.size]
metric_name = postgres.database
metrics     = size_bytes
cron        = 10/15 * * * *
max_runtime = 1m
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD

[job.activity]
metric_name = postgres.activity
metrics     = active, idle, idle_in_transaction, waiting, blocked, longest_wait_seconds, longest_idle_in_transaction_seconds
run_every   = 1m
max_runtime = 30s
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD

[job.replication]
metric_name = postgres.replication
metrics     = is_replica, replicas, lag_bytes, lag_seconds, slots_inactive, slot_retained_bytes, receiver_up, replay_lag_bytes, last_replay_seconds
run_every   = 1m
max_runtime = 30s
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD

[job.wraparound]
metric_name = postgres.wraparound
metrics     = xid_age_count, xid_pct, mxid_age_count, mxid_pct, oldest_xmin_age_count
cron        = 5/15 * * * *
max_runtime = 1m
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD

[job.vacuum]
metric_name = postgres.vacuum
metrics     = dead_tuples_count, tables_due_count, autovacuum_workers, autovacuum_max_workers
cron        = 0/15 * * * *
max_runtime = 2m
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD

[job.io]
metric_name = postgres.io
metrics     = checkpoints_timed_count, checkpoints_requested_count, temp_files_count, temp_bytes, wal_bytes
cron        = 2/5 * * * *
max_runtime = 30s
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD
