# postgres - a PostgreSQL server on this machine: whether it answers, its
# connections, its longest query and transaction, transactions, deadlocks,
# cache hits, and each database's size. See SPECIFICATION.md section 18.10
# for this format.
#
# Off until enabled: vigil pack enable postgres. It logs in as a read-only
# role, never a superuser; create one once, as an administrator:
#   CREATE ROLE vigil_monitor LOGIN PASSWORD '...' IN ROLE pg_monitor;
# and give Vigil its password:
#   vigil secret set POSTGRES_MONITOR_PASSWORD
# For another host, port, role or database, edit the env lines of the jobs
# vigil pack enable writes into the configuration.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.1.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = PostgreSQL: up, connections, longest query, transactions, cache hits, database sizes
needs       = a read-only role, as a database administrator: CREATE ROLE vigil_monitor LOGIN PASSWORD '...' IN ROLE pg_monitor

[job.status]
metric_name = postgres
metrics     = up, connections, max_connections, connections_pct, longest_query_seconds, longest_transaction_seconds, commits_count, rollbacks_count, deadlocks_count, cache_hit_pct
run_every   = 1m
max_runtime = 30s
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD

[job.size]
metric_name = postgres.database
metrics     = size_bytes
run_every   = 15m
max_runtime = 1m
env         = PGHOST=localhost
env         = PGPORT=5432
env         = PGUSER=vigil_monitor
env         = PGDATABASE=postgres
secret      = PGPASSWORD=secret:POSTGRES_MONITOR_PASSWORD
