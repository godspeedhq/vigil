# nats - a NATS server, from its monitoring port: is it healthy, how many
# clients and how close to its limit, which are too slow to keep up, are
# its cluster routes up, and for JetStream how full is it, does every
# stream have a leader, and which consumers are falling behind.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable nats (or one job: vigil pack enable nats_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = NATS and JetStream: healthy, connections against the limit, slow consumers, the client with the most waiting; cluster routes and peers; JetStream storage and memory against their limits, API errors, the meta leader, streams with no leader, replicas behind, streams near their limits, and consumers behind (pending, waiting for acks, redelivered), each named
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = NATS Server 2.10 and later, alone or in a cluster, with or without JetStream (tested: 2.15.3, a cluster of three, and 2.14.10 alone)
programs_linux = bash, curl, jq
programs_macos = bash, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/nats/README.md
needs       = its monitoring port, from this machine: -m 8222 (http_port: 8222 in its configuration); env = NATS_URL=... on each job where it is not http://localhost:8222
needs       = jq, on Linux and macOS
needs       = on each server of a cluster: each reports itself, and the streams and consumers it leads; for its CPU and memory: the base pack's processes job

[job.status]
metric_name = nats
metrics     = up, healthy, info, uptime_seconds, last_reload_seconds, connections, max_connections, connections_pct, total_connections_count, subscriptions, slow_consumers_count, slow_consumer_clients_count, slow_consumer_routes_count, slow_consumer_gateways_count, slow_consumer_leafs_count, stale_connections_count, in_msgs_count, out_msgs_count, in_bytes_count, out_bytes_count, pending_bytes_max
run_every   = 1m
max_runtime = 30s
env         = NATS_URL=
env         = NATS_USER=
env         = NATS_CACERT=

[job.cluster]
metric_name = nats.cluster
metrics     = up, clustered, routes_configured, route_peers, route_peer, route_peer_not_shown, route_connections, route_pending_bytes, route_rtt_max_ms, leafnodes
run_every   = 1m
max_runtime = 30s
env         = NATS_URL=
env         = NATS_USER=
env         = NATS_CACERT=

[job.jetstream]
metric_name = nats.jetstream
metrics     = up, jetstream, memory_bytes, storage_bytes, max_memory_bytes, max_storage_bytes, memory_pct, storage_pct, streams, consumers, messages, bytes, api_count, api_errors_count, meta_cluster_size, meta_leader_known, meta_is_leader, meta_replicas_behind, meta_behind, meta_behind_not_shown, streams_led, streams_no_leader, stream_replicas_behind, stream_behind, stream_behind_not_shown, stream_messages, stream_bytes, stream_not_shown, stream_used_pct, stream_used_pct_not_shown, consumers_led, consumers_pending, consumers_ack_pending, consumers_redelivered, consumer_pending, consumer_pending_not_shown, consumer_ack_pending, consumer_ack_pending_not_shown, consumer_redelivered, consumer_redelivered_not_shown
run_every   = 1m
max_runtime = 30s
env         = NATS_URL=
env         = NATS_USER=
env         = NATS_CACERT=
