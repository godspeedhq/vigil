# haproxy - an HAProxy process, from its runtime API ("show info" and
# "show stat" only): its connections, rates, TLS and load, its frontends,
# its backends, and every server with its health checks.
# Linux and macOS: there is no Windows script. See SPECIFICATION.md section
# 18.10 for this format, and tools/web/DESIGN.md.
#
# It only reads: it changes nothing on the server.
#
# Off until enabled: vigil pack enable haproxy (or one job: vigil pack enable haproxy_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = HAProxy: connections, rates, TLS and load; frontends, backends and servers with their health checks, queues, times and errors, from its runtime API
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = HAProxy 2.4 and later (tested: 3.4.8 and 3.2.x)
programs_linux = bash
programs_macos = bash
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/haproxy/README.md
needs       = its runtime API, at level user: stats socket ipv4@127.0.0.1:9999 level user (bash reads a TCP address itself), or a socket file this account may use, read with socat or nc
needs       = for HAProxy's CPU and memory: the base pack's processes job

[job.info]
metric_name = haproxy
metrics     = up, info, uptime_seconds, threads, connections, maxconn, connections_pct, maxconn_reached_count, conn_rate, conn_rate_max, sess_rate, requests_count, ssl_rate, ssl_connections, ssl_key_rate, ssl_reuse_pct, ssl_cache_misses_count, busy_pct, run_queue, tasks, streams, stopping, fd_limit, pool_used_bytes, pool_failed_count, dropped_logs_count, failed_resolutions_count, warnings, bytes_out_rate, peers_active, peers_connected
run_every   = 1m
max_runtime = 30s
env         = HAPROXY_SOCKET=

[job.frontends]
metric_name = haproxy.frontends
metrics     = up, frontends, frontends_closed, open, sessions, sessions_limit, sessions_pct, session_rate, session_rate_max, request_rate, requests_count, status_1xx_count, status_2xx_count, status_3xx_count, status_4xx_count, status_5xx_count, denied_requests_count, denied_responses_count, request_errors_count, bytes_in_count, bytes_out_count, ssl_failed_handshakes_count, frontends_not_shown
run_every   = 1m
max_runtime = 30s
env         = HAPROXY_SOCKET=

[job.backends]
metric_name = haproxy.backends
metrics     = up, backends, backends_down, backend_up, servers, servers_up, servers_active, servers_backup, sessions, queue, queue_max, queue_ms, connect_ms, response_ms, total_ms, connection_errors_count, response_errors_count, retries_count, redispatches_count, status_4xx_count, status_5xx_count, client_aborts_count, server_aborts_count, down_seconds, since_change_seconds, backends_not_shown
run_every   = 1m
max_runtime = 30s
env         = HAPROXY_SOCKET=

[job.servers]
metric_name = haproxy.servers
metrics     = up, servers, servers_up, servers_down, servers_maint, servers_drain, state, check, check_ms, since_change_seconds, down_seconds, check_failures_count, went_down_count, sessions, sessions_limit, queue, response_ms, status_5xx_count, response_errors_count, connection_errors_count, weight, servers_not_shown
run_every   = 1m
max_runtime = 30s
env         = HAPROXY_SOCKET=
