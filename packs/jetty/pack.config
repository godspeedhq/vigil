# jetty - Eclipse Jetty, on this machine or any it can reach, over JMX: the
# server and its apps, low resources, requests and responses, request times,
# the thread pool, connections and their limits, QoS, sessions and byte
# buffers. Never Jetty's JVM: that is the jvm pack's. Linux, macOS and
# Windows. See SPECIFICATION.md section 18.10 for this format, and
# tools/probe/DESIGN.md for the probe that reads it.
#
# Every script runs _probe.jar, beside it, with Java 11 or later (a JDK or a
# JRE), once it matches the digest the script carries, with this pack's
# _probe.tables. Nothing of Jetty's is needed here: only its JMX.
#
# Off until enabled: vigil pack enable jetty. Then set JETTY_JMX in the jobs
# vigil pack enable writes into the configuration (web1: jmxs=host:port),
# JETTY_JMX_USER, and for its password a secret line (packs/README.md has
# it all).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.1
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Eclipse Jetty over JMX: server and apps, low resources, requests and responses by class, request times, the thread pool, connections and limits, QoS, sessions and byte buffers
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Eclipse Jetty 9.4 to 12 (tested: 9.4, 11.0, 12.0 and 12.1), with its jmx and statistics modules
programs_linux = Java 11 or later, a JDK or a JRE, to run the probe
programs_macos = Java 11 or later, a JDK or a JRE, to run the probe
programs_windows = Java 11 or later, a JDK or a JRE, to run the probe
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#jetty
needs       = Jetty's jmx module, and its statistics module (stats on 9.4 to 11) for requests; each Jetty's JMX in JETTY_JMX (web1: jmxs=host:port): -Dcom.sun.management.jmxremote.port and a password and TLS in JAVA_OPTIONS (packs/README.md shows how)
needs       = for JMX with a password: a secret line on the jobs: secret = JETTY_JMX_PASSWORD=secret:JETTY_JMX_PASSWORD, then vigil secret set JETTY_JMX_PASSWORD
needs       = for Jetty's JVM (heap, garbage collection, threads, CPU, open files): the jvm pack, not this one: vigil pack install jvm, with each Jetty in JVM_TARGETS named as here (web1: jmxs=host:port)

[job.status]
metric_name = jetty
metrics     = jmx_up, version, up, uptime_seconds, app_up, low_on_resources, low_since_seconds, version_not_shown, up_not_shown, uptime_seconds_not_shown, app_up_not_shown, low_on_resources_not_shown, low_since_seconds_not_shown
run_every   = 1m
max_runtime = 90s
env         = JETTY_JMX=
env         = JETTY_JMX_USER=
env         = JETTY_CACERT=

[job.requests]
metric_name = jetty.requests
metrics     = jmx_up, requests_count, active, active_max, responses_1xx_count, responses_2xx_count, responses_3xx_count, responses_4xx_count, responses_5xx_count, failures_count, handling_failures_count, thrown_count, dispatched_count, dispatched_active, handling_active, async_count, async_waiting, expired_count, received_bytes, sent_bytes, slowest_seconds, mean_seconds, total_seconds, handling_slowest_seconds, handling_mean_seconds, handling_active_max, dispatched_slowest_seconds, dispatched_mean_seconds, dispatched_active_max, async_waiting_max, stats_seconds, requests_count_not_shown, active_not_shown, active_max_not_shown, responses_1xx_count_not_shown, responses_2xx_count_not_shown, responses_3xx_count_not_shown, responses_4xx_count_not_shown, responses_5xx_count_not_shown, failures_count_not_shown, handling_failures_count_not_shown, thrown_count_not_shown, dispatched_count_not_shown, dispatched_active_not_shown, handling_active_not_shown, async_count_not_shown, async_waiting_not_shown, expired_count_not_shown, received_bytes_not_shown, sent_bytes_not_shown, slowest_seconds_not_shown, mean_seconds_not_shown, total_seconds_not_shown, handling_slowest_seconds_not_shown, handling_mean_seconds_not_shown, handling_active_max_not_shown, dispatched_slowest_seconds_not_shown, dispatched_mean_seconds_not_shown, dispatched_active_max_not_shown, async_waiting_max_not_shown, stats_seconds_not_shown
run_every   = 1m
max_runtime = 90s
env         = JETTY_JMX=
env         = JETTY_JMX_USER=
env         = JETTY_CACERT=

[job.threads]
metric_name = jetty.threads
metrics     = jmx_up, threads, busy, idle, ready, utilized, max_threads, min_threads, queue, utilization_pct, low_on_threads, leased, reserved, max_available, reserved_capacity, reserved_pending, threads_not_shown, busy_not_shown, idle_not_shown, ready_not_shown, utilized_not_shown, max_threads_not_shown, min_threads_not_shown, queue_not_shown, utilization_pct_not_shown, low_on_threads_not_shown, leased_not_shown, reserved_not_shown, max_available_not_shown, reserved_capacity_not_shown, reserved_pending_not_shown
run_every   = 1m
max_runtime = 90s
env         = JETTY_JMX=
env         = JETTY_JMX_USER=
env         = JETTY_CACERT=

[job.connections]
metric_name = jetty.connections
metrics     = jmx_up, open, open_max, opened_count, duration_max_seconds, duration_mean_seconds, received_bytes, sent_bytes, received_messages_count, sent_messages_count, limited, limit, limit_pending, qos_max, qos_suspended, qos_exceeded_count, qos_expired_count, qos_requests_count, qos_suspended_count, qos_max_suspended, selector_keys, selects_count, open_not_shown, open_max_not_shown, opened_count_not_shown, duration_max_seconds_not_shown, duration_mean_seconds_not_shown, received_bytes_not_shown, sent_bytes_not_shown, received_messages_count_not_shown, sent_messages_count_not_shown, limited_not_shown, limit_not_shown, limit_pending_not_shown, qos_max_not_shown, qos_suspended_not_shown, qos_exceeded_count_not_shown, qos_expired_count_not_shown, qos_requests_count_not_shown, qos_suspended_count_not_shown, qos_max_suspended_not_shown, selector_keys_not_shown, selects_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = JETTY_JMX=
env         = JETTY_JMX_USER=
env         = JETTY_CACERT=

[job.sessions]
metric_name = jetty.sessions
metrics     = jmx_up, current, most, cached_count, created_count, alive_mean_seconds, alive_max_seconds, timeout_seconds, current_not_shown, most_not_shown, cached_count_not_shown, created_count_not_shown, alive_mean_seconds_not_shown, alive_max_seconds_not_shown, timeout_seconds_not_shown
run_every   = 1m
max_runtime = 90s
env         = JETTY_JMX=
env         = JETTY_JMX_USER=
env         = JETTY_CACERT=

[job.buffers]
metric_name = jetty.buffers
metrics     = jmx_up, direct_bytes, heap_bytes, direct_free_bytes, heap_free_bytes, direct_bytes_not_shown, heap_bytes_not_shown, direct_free_bytes_not_shown, heap_free_bytes_not_shown
cron        = 2/5 * * * *
max_runtime = 90s
env         = JETTY_JMX=
env         = JETTY_JMX_USER=
env         = JETTY_CACERT=
