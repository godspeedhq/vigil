# _probe.tables - the jetty pack's jobs, as tables the probe reads
# (tools/probe/DESIGN.md), written by tools/jetty/gen.py: edit that, not this.
# A row: metric, MBean, attribute, then tags from the MBean's name (key/
# for its value after the last /), +tag=value, -key=pattern, =STATE, @tag,
# *scale, >=floor, sum, top, age. An MBean a server does not have prints
# nothing.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

targets   JETTY_JMX
user      JETTY_JMX_USER
password  JETTY_JMX_PASSWORD
cacert    JETTY_CACERT
# Each Jetty is named as JETTY_JMX names it (web1: jmxs=host:port), else by
# its address.
name      jetty

[status]
version            org.eclipse.jetty.server:type=server,*              version              @version
up                 org.eclipse.jetty.server:type=server,*              state                =STARTED
uptime_seconds     org.eclipse.jetty.server:type=server,*              startupTime          age
app_up             org.eclipse.jetty*:type=webappcontext,*             state                context/ =STARTED
low_on_resources   org.eclipse.jetty.server:type=lowresourcemonitor,*  lowOnResources
low_since_seconds  org.eclipse.jetty.server:type=lowresourcemonitor,*  lowResourcesStarted  age

[requests]
requests_count           org.eclipse.jetty.server.handler:type=statisticshandler,*               requests
active                   org.eclipse.jetty.server.handler:type=statisticshandler,*               requestsActive
active_max               org.eclipse.jetty.server.handler:type=statisticshandler,*               requestsActiveMax
responses_1xx_count      org.eclipse.jetty.server.handler:type=statisticshandler,*               responses1xx
responses_2xx_count      org.eclipse.jetty.server.handler:type=statisticshandler,*               responses2xx
responses_3xx_count      org.eclipse.jetty.server.handler:type=statisticshandler,*               responses3xx
responses_4xx_count      org.eclipse.jetty.server.handler:type=statisticshandler,*               responses4xx
responses_5xx_count      org.eclipse.jetty.server.handler:type=statisticshandler,*               responses5xx
failures_count           org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  failures
failures_count           org.eclipse.jetty.server.handler:type=statisticshandler,id=*            errors
handling_failures_count  org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  handlingFailures
thrown_count             org.eclipse.jetty.server.handler:type=statisticshandler,id=*            responsesThrown
dispatched_count         org.eclipse.jetty.server.handler:type=statisticshandler,id=*            dispatched
dispatched_active        org.eclipse.jetty.server.handler:type=statisticshandler,id=*            dispatchedActive
handling_active          org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  handleActive
async_count              org.eclipse.jetty.server.handler:type=statisticshandler,id=*            asyncRequests
async_waiting            org.eclipse.jetty.server.handler:type=statisticshandler,id=*            asyncRequestsWaiting
expired_count            org.eclipse.jetty.server.handler:type=statisticshandler,id=*            expires
received_bytes           org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  bytesRead
sent_bytes               org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  bytesWritten
sent_bytes               org.eclipse.jetty.server.handler:type=statisticshandler,id=*            responsesBytesTotal
slowest_seconds          org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  requestTimeMax        *0.000000001
slowest_seconds          org.eclipse.jetty.server.handler:type=statisticshandler,id=*            requestTimeMax        *0.001
mean_seconds             org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  requestTimeMean       *0.000000001
mean_seconds             org.eclipse.jetty.server.handler:type=statisticshandler,id=*            requestTimeMean       *0.001
total_seconds            org.eclipse.jetty.server.handler:type=statisticshandler,context=*,id=*  requestTimeTotal      *0.000000001
total_seconds            org.eclipse.jetty.server.handler:type=statisticshandler,id=*            requestTimeTotal      *0.001

[threads]
threads          org.eclipse.jetty.util.thread:type=queuedthreadpool,*  threads                   id
busy             org.eclipse.jetty.util.thread:type=queuedthreadpool,*  busyThreads               id
idle             org.eclipse.jetty.util.thread:type=queuedthreadpool,*  idleThreads               id
ready            org.eclipse.jetty.util.thread:type=queuedthreadpool,*  readyThreads              id
utilized         org.eclipse.jetty.util.thread:type=queuedthreadpool,*  utilizedThreads           id
max_threads      org.eclipse.jetty.util.thread:type=queuedthreadpool,*  maxThreads                id
min_threads      org.eclipse.jetty.util.thread:type=queuedthreadpool,*  minThreads                id
queue            org.eclipse.jetty.util.thread:type=queuedthreadpool,*  queueSize                 id
utilization_pct  org.eclipse.jetty.util.thread:type=queuedthreadpool,*  utilizationRate           id *100
low_on_threads   org.eclipse.jetty.util.thread:type=queuedthreadpool,*  lowOnThreads              id
leased           org.eclipse.jetty.util.thread:type=queuedthreadpool,*  leasedThreads             id
reserved         org.eclipse.jetty.util.thread:type=queuedthreadpool,*  availableReservedThreads  id
max_available    org.eclipse.jetty.util.thread:type=queuedthreadpool,*  maxAvailableThreads       id

[connections]
open                     org.eclipse.jetty.io:type=connectionstatistics,*    connections                sum
open_max                 org.eclipse.jetty.io:type=connectionstatistics,*    connectionsMax             sum
opened_count             org.eclipse.jetty.io:type=connectionstatistics,*    connectionsTotal           sum
duration_max_seconds     org.eclipse.jetty.io:type=connectionstatistics,*    connectionDurationMax      sum *0.001
duration_mean_seconds    org.eclipse.jetty.io:type=connectionstatistics,*    connectionDurationMean     sum *0.001
received_bytes           org.eclipse.jetty.io:type=connectionstatistics,*    receivedBytes              sum
sent_bytes               org.eclipse.jetty.io:type=connectionstatistics,*    sentBytes                  sum
received_messages_count  org.eclipse.jetty.io:type=connectionstatistics,*    receivedMessages           sum
sent_messages_count      org.eclipse.jetty.io:type=connectionstatistics,*    sentMessages               sum
limited                  org.eclipse.jetty.server:type=connectionlimit,*     connections
limit                    org.eclipse.jetty.server:type=connectionlimit,*     maxConnections
limit_pending            org.eclipse.jetty.server:type=connectionlimit,*     pendingConnections
qos_max                  org.eclipse.jetty.server.handler:type=qoshandler,*  maxRequestCount
qos_suspended            org.eclipse.jetty.server.handler:type=qoshandler,*  suspendedRequestCount
qos_exceeded_count       org.eclipse.jetty.server.handler:type=qoshandler,*  totalExceededRequestCount
qos_expired_count        org.eclipse.jetty.server.handler:type=qoshandler,*  totalExpiredRequestCount

[sessions]
current             org.eclipse.jetty*:type=*sessioncache,*   sessionsCurrent      context/ top
most                org.eclipse.jetty*:type=*sessioncache,*   sessionsMax          context/
cached_count        org.eclipse.jetty*:type=*sessioncache,*   sessionsTotal        context/
created_count       org.eclipse.jetty*:type=sessionhandler,*  sessionsCreated      context/
alive_mean_seconds  org.eclipse.jetty*:type=sessionhandler,*  sessionTimeMean      context/
alive_max_seconds   org.eclipse.jetty*:type=sessionhandler,*  sessionTimeMax       context/
timeout_seconds     org.eclipse.jetty*:type=sessionhandler,*  maxInactiveInterval  context/

[buffers]
direct_bytes       org.eclipse.jetty.io:type=*bytebufferpool,*  directMemory           sum
heap_bytes         org.eclipse.jetty.io:type=*bytebufferpool,*  heapMemory             sum
direct_free_bytes  org.eclipse.jetty.io:type=*bytebufferpool,*  availableDirectMemory  sum
heap_free_bytes    org.eclipse.jetty.io:type=*bytebufferpool,*  availableHeapMemory    sum
