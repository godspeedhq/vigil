# artemis - Apache ActiveMQ Artemis, on this machine or any it can reach,
# over JMX: its health and high availability, address memory and disk
# against their limits, addresses and paging, queues (the deepest first,
# and the age of the oldest message), dead letter and expiry queues,
# refused logins, cluster connections and bridges. ActiveMQ Classic is the
# activemq pack's; the broker's JVM is the jvm pack's. Linux, macOS and
# Windows. See SPECIFICATION.md section 18.10 for this format, and
# tools/probe/DESIGN.md for the probe that reads it.
#
# Every script runs _probe.jar, beside it, with Java 11 or later (a JDK or a
# JRE), once it matches the digest the script carries, with this pack's
# _probe.tables. Nothing of Artemis's is needed here: only its JMX.
#
# Off until enabled: vigil pack enable artemis. Then set ARTEMIS_JMX in the
# jobs vigil pack enable writes into the configuration (art1:
# jmxs=host:port), ARTEMIS_JMX_USER, and for its password a secret line
# (packs/README.md has it all).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.1
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Apache ActiveMQ Artemis over JMX: health and HA, address memory and disk against their limits, addresses and paging, queues (the deepest first, the oldest message), dead letter and expiry queues, logins refused, cluster connections and bridges
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Apache ActiveMQ Artemis 2.x (tested: 2.33, 2.40 and 2.44), with the JVM's JMX on; Classic is the activemq pack's
programs_linux = Java 11 or later, a JDK or a JRE, to run the probe
programs_macos = Java 11 or later, a JDK or a JRE, to run the probe
programs_windows = Java 11 or later, a JDK or a JRE, to run the probe
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#artemis
needs       = each broker's JMX in ARTEMIS_JMX (art1: jmxs=host:port): the JVM's JMX, -Dcom.sun.management.jmxremote.port and a password and TLS (the registry too) in JAVA_ARGS_APPEND; not management.xml's connector, whose registry is not on TLS (packs/README.md shows how)
needs       = for JMX with a password: a secret line on the jobs: secret = ARTEMIS_JMX_PASSWORD=secret:ARTEMIS_JMX_PASSWORD, then vigil secret set ARTEMIS_JMX_PASSWORD
needs       = for the broker's JVM (heap, garbage collection, threads, CPU, open files): the jvm pack, not this one: vigil pack install jvm, with each broker in JVM_TARGETS named as here (art1: jmxs=host:port)

[job.status]
metric_name = artemis
metrics     = jmx_up, version, broker, ha_policy, uptime_seconds, started, active, backup, replica_sync, clustered, node, acceptor_up, version_not_shown, broker_not_shown, ha_policy_not_shown, uptime_seconds_not_shown, started_not_shown, active_not_shown, backup_not_shown, replica_sync_not_shown, clustered_not_shown, node_not_shown, acceptor_up_not_shown
run_every   = 1m
max_runtime = 90s
env         = ARTEMIS_JMX=
env         = ARTEMIS_JMX_USER=
env         = ARTEMIS_CACERT=

[job.broker]
metric_name = artemis.broker
metrics     = jmx_up, address_memory_bytes, address_memory_pct, global_max_bytes, disk_pct, disk_max_pct, connections, connections_count, sessions, sessions_count, consumers, messages, added_count, acknowledged_count, addresses, queues, login_failed_count, login_count, authorization_failed_count, mirror_pending, address_memory_bytes_not_shown, address_memory_pct_not_shown, global_max_bytes_not_shown, disk_pct_not_shown, disk_max_pct_not_shown, connections_not_shown, connections_count_not_shown, sessions_not_shown, sessions_count_not_shown, consumers_not_shown, messages_not_shown, added_count_not_shown, acknowledged_count_not_shown, addresses_not_shown, queues_not_shown, login_failed_count_not_shown, login_count_not_shown, authorization_failed_count_not_shown, mirror_pending_not_shown
run_every   = 1m
max_runtime = 90s
env         = ARTEMIS_JMX=
env         = ARTEMIS_JMX_USER=
env         = ARTEMIS_CACERT=

[job.addresses]
metric_name = artemis.address
metrics     = jmx_up, size_bytes, limit_pct, messages, paging, pages, routed_count, unrouted_count, queues, paused, duplicate_cache, size_bytes_not_shown, limit_pct_not_shown, messages_not_shown, paging_not_shown, pages_not_shown, routed_count_not_shown, unrouted_count_not_shown, queues_not_shown, paused_not_shown, duplicate_cache_not_shown
run_every   = 1m
max_runtime = 2m
env         = ARTEMIS_JMX=
env         = ARTEMIS_JMX_USER=
env         = ARTEMIS_CACERT=

[job.queues]
metric_name = artemis.queue
metrics     = jmx_up, messages, oldest_seconds, delivering, scheduled, added_count, acknowledged_count, expired_count, killed_count, consumers, persistent_bytes, groups, prepared, paused, enabled, durable_messages, delivering_bytes, scheduled_bytes, acknowledge_attempts_count, max_consumers, messages_not_shown, oldest_seconds_not_shown, delivering_not_shown, scheduled_not_shown, added_count_not_shown, acknowledged_count_not_shown, expired_count_not_shown, killed_count_not_shown, consumers_not_shown, persistent_bytes_not_shown, groups_not_shown, prepared_not_shown, paused_not_shown, enabled_not_shown, durable_messages_not_shown, delivering_bytes_not_shown, scheduled_bytes_not_shown, acknowledge_attempts_count_not_shown, max_consumers_not_shown
run_every   = 1m
max_runtime = 2m
env         = ARTEMIS_JMX=
env         = ARTEMIS_JMX_USER=
env         = ARTEMIS_CACERT=

[job.dlq]
metric_name = artemis.dlq
metrics     = jmx_up, dead, dead_oldest_seconds, dead_added_count, expired, expired_added_count, dead_not_shown, dead_oldest_seconds_not_shown, dead_added_count_not_shown, expired_not_shown, expired_added_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = ARTEMIS_JMX=
env         = ARTEMIS_JMX_USER=
env         = ARTEMIS_CACERT=

[job.cluster]
metric_name = artemis.cluster
metrics     = jmx_up, cluster_up, cluster_pending, cluster_acknowledged_count, bridge_up, bridge_pending, bridge_acknowledged_count, connection_up, cluster_up_not_shown, cluster_pending_not_shown, cluster_acknowledged_count_not_shown, bridge_up_not_shown, bridge_pending_not_shown, bridge_acknowledged_count_not_shown, connection_up_not_shown
run_every   = 2m
max_runtime = 90s
env         = ARTEMIS_JMX=
env         = ARTEMIS_JMX_USER=
env         = ARTEMIS_CACERT=
