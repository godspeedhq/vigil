# clickhouse - ClickHouse, from its HTTP interface: the server (up, queries,
# memory, inserts delayed and refused for too many parts), its tables'
# parts, its replicated tables, mutations and merges, disks, and the
# queries running and errors counted. Linux, macOS and Windows. See
# SPECIFICATION.md section 18.10 for this format.
#
# It only reads: every statement is a SELECT from the system tables, as a
# user the server itself keeps read-only (readonly = 1). Linux and macOS
# read with curl and jq; Windows with PowerShell alone.
#
# Off until enabled: vigil pack enable clickhouse. Then set the jobs' env
# lines:
#   env = CLICKHOUSE_URL=http://db1.example.com:8123   (its HTTP interface)
# and: vigil secret set CLICKHOUSE_PASSWORD (the read-only user's).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = ClickHouse: up, queries, memory, inserts delayed and refused for too many parts, parts per table, replicated tables read-only or behind, mutations stuck, merges, detached parts, disks, slow queries and errors
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = ClickHouse 25.x and 26.x, a server or a replicated cluster (tested: 26.8 with ClickHouse Keeper, and 25.8)
programs_linux = bash, curl, jq
programs_macos = bash, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/clickhouse/README.md
needs       = the server's HTTP interface (8123, or 8443 over TLS) reachable from this machine
needs       = a read-only user, as an admin: CREATE USER vigil IDENTIFIED WITH sha256_password BY '...' SETTINGS readonly = 1; GRANT SELECT ON system.*, SHOW TABLES ON *.* TO vigil (it sees every table's parts, never their rows); then vigil secret set CLICKHOUSE_PASSWORD

[job.status]
metric_name = clickhouse
metrics     = up, info, uptime_seconds, queries, connections, memory_bytes, memory_limit_bytes, memory_pct, max_parts_in_partition, parts_to_throw_insert, parts_pct, inserts_delayed, inserts_delayed_count, inserts_rejected_count, queries_count, failed_queries_count, keeper_sessions, readonly_replicas, replica_delay_seconds, replica_queue
run_every   = 1m
max_runtime = 50s
env         = CLICKHOUSE_URL=
env         = CLICKHOUSE_CACERT=
env         = CLICKHOUSE_USER=vigil
secret      = CLICKHOUSE_PASSWORD=secret:CLICKHOUSE_PASSWORD

[job.tables]
metric_name = clickhouse.tables
metrics     = up, tables, parts, rows, bytes, table_parts, table_partitions, table_max_parts, table_rows, table_bytes, tables_not_shown
run_every   = 5m
max_runtime = 2m
env         = CLICKHOUSE_URL=
env         = CLICKHOUSE_CACERT=
env         = CLICKHOUSE_USER=vigil
env         = CLICKHOUSE_MOST=50
secret      = CLICKHOUSE_PASSWORD=secret:CLICKHOUSE_PASSWORD

[job.replication]
metric_name = clickhouse.replication
metrics     = up, replicated, readonly, replicas_missing, queue_failing, table_readonly, table_delay_seconds, table_queue, table_queue_inserts, table_queue_merges, table_queue_failing, table_queue_oldest_seconds, table_log_behind, table_replicas_active, table_replicas, replicated_not_shown
run_every   = 1m
max_runtime = 50s
env         = CLICKHOUSE_URL=
env         = CLICKHOUSE_CACERT=
env         = CLICKHOUSE_USER=vigil
env         = CLICKHOUSE_MOST=50
secret      = CLICKHOUSE_PASSWORD=secret:CLICKHOUSE_PASSWORD

[job.merges]
metric_name = clickhouse.merges
metrics     = up, mutations, mutations_failing, mutations_oldest_seconds, mutation_seconds, mutation_parts_to_do, mutation_failing, mutations_not_shown, merges, merges_mutating, merge_longest_seconds, merges_memory_bytes, detached_parts
run_every   = 5m
max_runtime = 2m
env         = CLICKHOUSE_URL=
env         = CLICKHOUSE_CACERT=
env         = CLICKHOUSE_USER=vigil
secret      = CLICKHOUSE_PASSWORD=secret:CLICKHOUSE_PASSWORD

[job.disks]
metric_name = clickhouse.disks
metrics     = up, disks, free_bytes, total_bytes, used_pct, keep_free_bytes, used_pct_max
run_every   = 5m
max_runtime = 50s
env         = CLICKHOUSE_URL=
env         = CLICKHOUSE_CACERT=
env         = CLICKHOUSE_USER=vigil
secret      = CLICKHOUSE_PASSWORD=secret:CLICKHOUSE_PASSWORD

[job.queries]
metric_name = clickhouse.queries
metrics     = up, running, slow, longest_seconds, memory_max_bytes, query_seconds, errors_count, errors_not_shown
run_every   = 1m
max_runtime = 50s
env         = CLICKHOUSE_URL=
env         = CLICKHOUSE_CACERT=
env         = CLICKHOUSE_USER=vigil
secret      = CLICKHOUSE_PASSWORD=secret:CLICKHOUSE_PASSWORD
