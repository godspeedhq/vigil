# oracle - Oracle Database 19c, 21c and 23ai, on this machine or any it can
# reach, with SQL*Plus: whether it answers and is open, its workload, sessions
# and blocking, waits, tablespaces, the fast recovery area and redo, memory,
# RMAN backups, what keeps it whole, and its alert log. Only Oracle's basic
# views: nothing from the Diagnostics or Tuning Pack. Linux, macOS and
# Windows. See SPECIFICATION.md section 18.10 for this format.
#
# The jobs that run every 5 or 15 minutes each have minutes of their own
# (cron, local time), so few runs start together.
#
# Off until enabled: vigil pack enable oracle. It logs in as a read-only
# user; create one once, as SYSDBA, in the CDB root (packs/oracle/README.md
# has it all, and the names for a database that is not a CDB):
#   CREATE USER C##VIGIL_MONITOR IDENTIFIED BY "..." CONTAINER=ALL;
#   GRANT CREATE SESSION, SELECT_CATALOG_ROLE TO C##VIGIL_MONITOR CONTAINER=ALL;
#   ALTER USER C##VIGIL_MONITOR SET CONTAINER_DATA=ALL CONTAINER=CURRENT;
#   GRANT SELECT ON SYS.V_$DIAG_ALERT_EXT TO C##VIGIL_MONITOR CONTAINER=ALL;
# and give Vigil its password:
#   vigil secret set ORACLE_MONITOR_PASSWORD
# Then set ORACLE_SERVICE (and the host and port) in the env lines of the
# jobs vigil pack enable writes into the configuration.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Oracle Database: up and open, workload, sessions and blocking, waits, tablespaces, recovery area and redo, memory, RMAN backups, integrity, scheduler jobs, alert log
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Oracle Database 19c, 21c and 23ai, a CDB or not (tested: 23ai Free and 21c XE)
programs_linux = sqlplus (Oracle Instant Client, basic and sqlplus)
programs_macos = sqlplus (Oracle Instant Client, basic and sqlplus)
programs_windows = PowerShell 5.1 or later, sqlplus (Oracle Instant Client, basic and sqlplus)
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/oracle/README.md
needs       = a read-only user, as SYSDBA in the CDB root: CREATE USER C##VIGIL_MONITOR IDENTIFIED BY "..." CONTAINER=ALL; GRANT CREATE SESSION, SELECT_CATALOG_ROLE TO C##VIGIL_MONITOR CONTAINER=ALL; ALTER USER C##VIGIL_MONITOR SET CONTAINER_DATA=ALL CONTAINER=CURRENT (not a CDB: VIGIL_MONITOR, without CONTAINER and CONTAINER_DATA)
needs       = for oracle_alerts: GRANT SELECT ON SYS.V_$DIAG_ALERT_EXT TO C##VIGIL_MONITOR CONTAINER=ALL

[job.status]
metric_name = oracle
metrics     = up, info, uptime_seconds, open, archivelog, cpus, sessions, sessions_max, sessions_pct, processes, processes_max, processes_pct, pdbs, pdb_open
run_every   = 1m
max_runtime = 30s
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.performance]
metric_name = oracle.performance
metrics     = executions_count, user_calls_count, commits_count, rollbacks_count, logons_count, logons_current, parses_count, hard_parses_count, parse_failures_count, logical_reads_count, physical_reads_count, physical_writes_count, redo_bytes_count, bytes_received_count, bytes_sent_count, disk_sorts_count, long_table_scans_count, deadlocks_count, lock_timeouts_count, open_cursors, db_time_ms_count, db_cpu_ms_count, host_busy_ms_count, host_idle_ms_count, buffer_cache_hit_pct
run_every   = 1m
max_runtime = 30s
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.activity]
metric_name = oracle.activity
metrics     = sessions, active, blocked, longest_blocked_seconds, head_blockers, longest_active_seconds, transactions, oldest_transaction_seconds, idle_in_transaction, idle_in_transaction_seconds, long_operations
run_every   = 1m
max_runtime = 30s
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.waits]
metric_name = oracle.waits
metrics     = wait_ms_count, waits_count, top_wait_ms_count, top_waits_count
cron        = 1/5 * * * *
max_runtime = 30s
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.tablespaces]
metric_name = oracle.tablespace
metrics     = tablespaces, tablespaces_not_shown, used_pct, used_bytes, max_bytes, online, datafiles, datafiles_max
cron        = 2/5 * * * *
max_runtime = 1m
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.recovery]
metric_name = oracle.recovery
metrics     = fra_limit_bytes, fra_used_bytes, fra_reclaimable_bytes, fra_used_pct, flashback_on, archive_dest_errors, archive_dest_error, log_switches_1h, redo_groups, redo_group_bytes, redo_groups_active, redo_groups_not_archived
cron        = 3/5 * * * *
max_runtime = 30s
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.memory]
metric_name = oracle.memory
metrics     = sga_bytes, sga_target_bytes, memory_target_bytes, buffer_cache_bytes, shared_pool_bytes, shared_pool_free_bytes, pga_allocated_bytes, pga_inuse_bytes, pga_target_bytes, pga_limit_bytes, pga_limit_pct, pga_over_allocations_count
cron        = 4/5 * * * *
max_runtime = 30s
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.backups]
metric_name = oracle.backups
metrics     = full_age_seconds, incremental_age_seconds, archivelog_age_seconds, failed_24h, running, last_bytes, last_seconds
cron        = 12/15 * * * *
max_runtime = 1m
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.health]
metric_name = oracle.health
metrics     = invalid_objects, corrupt_blocks, datafiles_need_recovery, datafiles_offline, accounts_expiring, scheduler_failed_24h, job_failed_24h, scheduler_broken
cron        = 8/15 * * * *
max_runtime = 1m
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD

[job.alerts]
metric_name = oracle.alerts
metrics     = readable, errors, incidents, error_count, checkpoint_not_complete
cron        = 0/5 * * * *
max_runtime = 1m
env         = ORACLE_HOST=localhost
env         = ORACLE_PORT=1521
env         = ORACLE_SERVICE=ORCLCDB
env         = ORACLE_USER=C##VIGIL_MONITOR
secret      = ORACLE_PASSWORD=secret:ORACLE_MONITOR_PASSWORD
