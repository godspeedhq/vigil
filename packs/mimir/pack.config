# mimir - a Grafana Mimir, from its own metrics page: is it ready and are
# its rings whole, what samples does it receive and what does it
# discard, are its blocks shipped and compacted, and does its bucket
# answer.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable mimir (or one job: vigil pack enable mimir_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Grafana Mimir: whether it is ready and its rings whole (ingesters, distributors, store-gateways, compactors), ingestion (samples received, discarded and why, series in memory), requests and those that failed or were refused, and its storage (blocks shipped, compactions, the bucket)
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Grafana Mimir 2.10 and later, and 3.x (tested: 3.2.6, one binary); in microservices mode, each component reports those of these metrics it has
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/mimir/README.md
needs       = its address, where it is not http://localhost:9009: env = MIMIR_URL=... on each job (in microservices mode, a component: the ingestion job at a distributor or an ingester, the storage job at an ingester, a compactor or a store-gateway)
needs       = where it asks for a login (a proxy in front of it): MIMIR_USER and secret = MIMIR_PASSWORD=secret:MIMIR_PASSWORD, or secret = MIMIR_TOKEN=secret:MIMIR_TOKEN for a bearer token
needs       = for Mimir's CPU and memory: the base pack's processes job

[job.status]
metric_name = mimir
metrics     = up, ready, version, uptime_seconds, ingesters_active, ingesters_unhealthy, store_gateways_active, compactors_active, ring_unhealthy, ring_not_active, requests_count, requests_4xx_count, requests_5xx_count, inflight_requests, distributor_rejected_count, ingester_rejected_count, querier_rejected_count
run_every   = 1m
max_runtime = 30s
env         = MIMIR_URL=
env         = MIMIR_USER=
env         = MIMIR_CACERT=

[job.ingestion]
metric_name = mimir.ingestion
metrics     = up, samples_in_count, samples_received_count, discarded_count, discarded, discarded_not_shown, series, tenants, active_series, ingested_samples_count, ingested_failures_count, append_failures_count, pushes_in_flight, out_of_order_appended_count
run_every   = 1m
max_runtime = 30s
env         = MIMIR_URL=
env         = MIMIR_USER=
env         = MIMIR_CACERT=

[job.storage]
metric_name = mimir.storage
metrics     = up, shipper_uploads_count, shipper_failures_count, oldest_unshipped_seconds, head_compactions_failed_count, head_truncations_failed_count, wal_corruptions_count, wal_writes_failed_count, compactor_runs_count, compactor_runs_failed_count, last_compaction_seconds, cleanup_failures_count, blocks_loaded, block_load_failures_count, consistency_failures_count, bucket_operations_count, bucket_failures_count, bucket_failures, bucket_failures_not_shown
run_every   = 5m
max_runtime = 30s
env         = MIMIR_URL=
env         = MIMIR_USER=
env         = MIMIR_CACERT=
