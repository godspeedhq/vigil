#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.2.1
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = CPU, memory, disk, disk I/O, network, load, services, processes and host

[job.cpu]
metric_name = system.cpu
metrics     = used_pct, user_pct, system_pct, iowait_pct, steal_pct
run_every   = 1m
max_runtime = 30s

[job.memory]
metric_name = system.memory
metrics     = used_pct, used_bytes, total_bytes, available_bytes, swap_used_bytes, swap_total_bytes, commit_used_bytes, commit_limit_bytes
run_every   = 1m
max_runtime = 30s

[job.disk]
metric_name = system.disk
metrics     = used_pct, used_bytes, total_bytes, inodes_used_pct
cron        = 1/5 * * * *
max_runtime = 30s

[job.diskio]
metric_name = system.diskio
metrics     = read_bytes, write_bytes, reads, writes, busy_ms
cron        = 2/5 * * * *
max_runtime = 30s

[job.network]
metric_name = system.network
metrics     = rx_bytes, tx_bytes, rx_packets, tx_packets, rx_errors, tx_errors, rx_drops, tx_drops
run_every   = 1m
max_runtime = 30s

[job.load]
metric_name = system.load
metrics     = load1, load5, load15
run_every   = 1m
max_runtime = 30s

[job.services]
metric_name = system.services
metrics     = failed
run_every   = 1m
max_runtime = 30s

[job.processes]
metric_name = system.processes
metrics     = cpu_pct, memory_bytes
cron        = 3/5 * * * *
max_runtime = 30s

[job.host]
metric_name = system.host
metrics     = uptime_seconds, process_count, cores, info
cron        = 4/5 * * * *
max_runtime = 30s
