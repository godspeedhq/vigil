# The base pack: what any machine should report (SPECIFICATION.md 18.10).
[pack]
version     = 1.0.0
vigil       = 0.3.0
description = CPU, memory, disk, network, load and services

[job.cpu]
metric_name = system.cpu
metrics     = used_pct
run_every   = 1m
max_runtime = 30s

[job.memory]
metric_name = system.memory
metrics     = used_pct, used_bytes, total_bytes
run_every   = 1m
max_runtime = 30s

[job.disk]
metric_name = system.disk
metrics     = used_pct, used_bytes, total_bytes
run_every   = 5m
max_runtime = 30s

[job.network]
metric_name = system.network
metrics     = rx_bytes, tx_bytes
run_every   = 1m
max_runtime = 30s

[job.load]
metric_name = system.load
metrics     = load1, load5, load15
run_every   = 1m
max_runtime = 30s

[job.services]
metric_name = system.services
metrics     = failed
run_every   = 1m
max_runtime = 30s
