# alertmanager - an Alertmanager, from its own metrics page: is it ready,
# what alerts and silences does it hold, do its notifications get
# through, and is its cluster whole.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable alertmanager (or one job: vigil pack enable alertmanager_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Alertmanager: whether it is ready and its configuration loaded, alerts and silences, notifications sent and failed for each integration, and its cluster (members, failed peers)
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Alertmanager 0.25 and later (tested: 0.35.1, alone and as a cluster of two)
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/alertmanager/README.md
needs       = its address, where it is not http://localhost:9093: env = ALERTMANAGER_URL=... on each job (one Alertmanager: for a cluster, the pack on each member's machine)
needs       = where it asks for a login: ALERTMANAGER_USER and secret = ALERTMANAGER_PASSWORD=secret:ALERTMANAGER_PASSWORD, or secret = ALERTMANAGER_TOKEN=secret:ALERTMANAGER_TOKEN for a bearer token
needs       = for Alertmanager's CPU and memory: the base pack's processes job

[job.status]
metric_name = alertmanager
metrics     = up, ready, version, uptime_seconds, config_reload_ok, config_age_seconds, alerts_active, alerts_suppressed, alerts_unprocessed, alerts_received_count, alerts_invalid_count, silences_active, silences_pending, silences_expired, receivers, integrations, inhibition_rules, aggregation_groups, aggregation_limit_reached_count, fds_pct
run_every   = 1m
max_runtime = 30s
env         = ALERTMANAGER_URL=
env         = ALERTMANAGER_USER=
env         = ALERTMANAGER_CACERT=

[job.notifications]
metric_name = alertmanager.notifications
metrics     = up, notifications_count, notifications_failed_count, failed_pct, sent, sent_not_shown, failed, failed_not_shown, failed_reason, failed_reason_not_shown, requests_count, requests_failed_count, latency_avg_seconds
run_every   = 1m
max_runtime = 30s
env         = ALERTMANAGER_URL=
env         = ALERTMANAGER_USER=
env         = ALERTMANAGER_CACERT=

[job.cluster]
metric_name = alertmanager.cluster
metrics     = up, cluster_enabled, members, failed_peers, health_score, peer_position, messages_queued, messages_pruned_count, reconnections_count, reconnections_failed_count, peers_joined_count, peers_left_count
run_every   = 1m
max_runtime = 30s
env         = ALERTMANAGER_URL=
env         = ALERTMANAGER_USER=
env         = ALERTMANAGER_CACERT=
