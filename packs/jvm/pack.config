# jvm - Java virtual machines, any Java application through the JVM it runs
# on: its process, memory (heap, pools, metaspace, code cache, buffers,
# native), garbage collection, threads (deadlocks too), JIT, classes,
# safepoints, crashes, heap dumps, settings and security. Linux, macOS and
# Windows. See SPECIFICATION.md section 18.10 for this format.
#
# Three tiers, each used where it reaches: the process (nothing to set
# up); the JVM's own counters (this machine, and root, an administrator
# or the JVM's own account); JMX, at an address given in JVM_TARGETS.
# Every script runs the client beside it with Java 11 or later: a JDK
# runs _client.java, any other Java _client.jar, compiled from it when the
# pack was released, once it matches its digest. From source a run takes
# two or three seconds (Java compiles it each run), so the jobs every
# minute are the cheap ones, and the rest run every 2, 5 or 15 minutes,
# or each hour, each on minutes of its own (cron, local time).
#
# Off until enabled: vigil pack enable jvm. With JVM_TARGETS empty, every
# JVM on this machine is watched, named by its main class. To name them,
# or reach one over JMX, set JVM_TARGETS on the jobs' env lines:
#   env = JVM_TARGETS=shop: main=com.acme.Shop, jmx=localhost:9010
# For JMX with a password, add to each job (packs/README.md has it all):
#   secret = JVM_JMX_PASSWORD=secret:JVM_JMX_PASSWORD
# and: vigil secret set JVM_JMX_PASSWORD
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.1.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Java virtual machines: process, heap and pools, metaspace, code cache, buffers, native memory, GC, threads and deadlocks, JIT, classes, safepoints, crashes, heap dumps, settings, security
# What vigil pack info shows besides: the JVMs it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Java 8 and later (HotSpot for the counters: OpenJDK, Oracle, Temurin, Corretto, Zulu...); any Java application
programs_linux = Java 11 or later, a JDK or a JRE, to run its client
programs_macos = Java 11 or later, a JDK or a JRE, to run its client
programs_windows = Java 11 or later, a JDK or a JRE, to run its client
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#jvm
needs       = for the JVM's own counters (heap, GC, threads without JMX): Vigil running as root or an administrator, or as the JVM's own account
needs       = for everything else: each JVM's JMX address in JVM_TARGETS (jmx=host:port), with -Dcom.sun.management.jmxremote.port and a password and TLS (packs/README.md shows how)
needs       = for JMX with a password: a secret line on the jobs: secret = JVM_JMX_PASSWORD=secret:JVM_JMX_PASSWORD, then vigil secret set JVM_JMX_PASSWORD

[job.process]
metric_name = jvm.process
metrics     = jvms, jmx_up, running, rss_bytes, virtual_bytes, cpu_seconds, threads, open_files, open_files_max, uptime_seconds
run_every   = 1m
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.discovery]
metric_name = jvm.discovery
metrics     = jvms, found, jvms_not_shown
cron        = 7 * * * *
max_runtime = 2m
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.status]
metric_name = jvm.status
metrics     = jvms, jmx_up, up, tier_os, tier_counters, tier_jmx, info, uptime_seconds, heap_max_bytes
cron        = 1/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.flags]
metric_name = jvm.flags
metrics     = jvms, jmx_up, heap_max_set, heap_dump_on_oom, exit_on_oom, deprecated_gc, heap_over_memory, explicit_gc_disabled, risks
cron        = 4/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.container]
metric_name = jvm.container
metrics     = jvms, jmx_up, cpus, memory_bytes, cpus_host, memory_host_bytes, cpus_limited, memory_limited
cron        = 11 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.release_age]
metric_name = jvm.release_age
metrics     = jvms, jmx_up, feature_version, lts, release_age_days
cron        = 13 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.security]
metric_name = jvm.security
metrics     = jvms, jmx_up, debug_agent, debug_agent_remote, jmx_remote, jmx_no_password, jmx_no_tls, verify_off, risks
cron        = 8/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.startup]
metric_name = jvm.startup
metrics     = jvms, jmx_up, startup_seconds, init_seconds, started_epoch_seconds, uptime_seconds
cron        = 9/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.heap]
metric_name = jvm.heap
metrics     = jvms, jmx_up, used_bytes, committed_bytes, max_bytes, used_percent
run_every   = 1m
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.pools]
metric_name = jvm.pools
metrics     = jvms, jmx_up, used_bytes, committed_bytes, max_bytes, after_gc_bytes, after_gc_percent
cron        = 1/2 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.metaspace]
metric_name = jvm.metaspace
metrics     = jvms, jmx_up, metaspace_used_bytes, metaspace_committed_bytes, metaspace_max_bytes, metaspace_used_percent, class_space_used_bytes, class_space_committed_bytes, class_space_max_bytes, class_space_used_percent
cron        = 2/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.codecache]
metric_name = jvm.codecache
metrics     = jvms, jmx_up, used_bytes, max_bytes, used_percent, nmethod_code_bytes
cron        = 3/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.buffers]
metric_name = jvm.buffers
metrics     = jvms, jmx_up, count, used_bytes, capacity_bytes
cron        = 4/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.native]
metric_name = jvm.native
metrics     = jvms, jmx_up, tracking, reserved_bytes, committed_bytes, category_committed_bytes
cron        = 5/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.native_overhead]
metric_name = jvm.native_overhead
metrics     = jvms, jmx_up, rss_bytes, heap_committed_bytes, outside_heap_bytes, outside_heap_percent
cron        = 2/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.gc]
metric_name = jvm.gc
metrics     = jvms, jmx_up, collections, time_seconds, collections_total, time_seconds_total, time_percent_lifetime, last_cause
run_every   = 1m
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.gc_cycles]
metric_name = jvm.gc_cycles
metrics     = jvms, jmx_up, pauses, pause_seconds, pause_avg_ms, concurrent_cycles, concurrent_seconds
cron        = 1/2 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.gc_last]
metric_name = jvm.gc_last
metrics     = jvms, jmx_up, duration_ms, seconds_ago, freed_bytes, after_bytes
cron        = 1/2 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.gc_cpu]
metric_name = jvm.gc_cpu
metrics     = jvms, jmx_up, gc_cpu_seconds, process_cpu_seconds, gc_cpu_percent_lifetime
cron        = 2/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.allocation]
metric_name = jvm.allocation
metrics     = jvms, jmx_up, allocated_bytes, allocation_bytes_per_second
cron        = 1/2 * * * *
max_runtime = 2m
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.promotion]
metric_name = jvm.promotion
metrics     = jvms, promoted_last_bytes, survived_last_bytes, promoted_avg_bytes, tenuring_threshold, tenuring_threshold_max, survivor_desired_bytes, survivor_overflowed
cron        = 3/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.tlab]
metric_name = jvm.tlab
metrics     = jvms, allocated_words, threads, refills, refills_max, slow_allocations, slow_allocations_max, waste_gc_words, waste_refill_words
cron        = 6/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.gclog]
metric_name = jvm.gclog
metrics     = jvms, window_seconds, pauses, pause_max_ms, pause_p99_ms, pause_total_ms, full_gcs, allocation_stalls_in_log
cron        = 4/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.gclog_detail]
metric_name = jvm.gclog_detail
metrics     = jvms, window_seconds, pauses, humongous_allocations_in_log, to_space_exhausted_in_log, evacuation_failures_in_log, promotion_failed_in_log
cron        = 10/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.threads]
metric_name = jvm.threads
metrics     = jvms, jmx_up, live, daemon, peak, started, state
run_every   = 1m
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.deadlocks]
metric_name = jvm.deadlocks
metrics     = jvms, jmx_up, deadlocked, monitor_deadlocked, thread
run_every   = 1m
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.contention]
metric_name = jvm.contention
metrics     = jvms, jmx_up, blocked, waiting, blocked_times_total, lock_waiters
cron        = 12/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.hot_threads]
metric_name = jvm.hot_threads
metrics     = jvms, jmx_up, cpu_time_enabled, cpu_percent_total, cpu_percent, busy_threads_shown
cron        = 14/15 * * * *
max_runtime = 2m
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.virtual_threads]
metric_name = jvm.virtual_threads
metrics     = jvms, jmx_up, scheduler_parallelism, carriers, mounted, queued, carriers_runnable
cron        = 1/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.classes]
metric_name = jvm.classes
metrics     = jvms, jmx_up, loaded, loaded_total, unloaded, load_seconds
cron        = 0/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.classloaders]
metric_name = jvm.classloaders
metrics     = jvms, jmx_up, loaders, loaders_of_type, classes_of_type, types_not_shown
cron        = 3/15 * * * *
max_runtime = 2m
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.jit]
metric_name = jvm.jit
metrics     = jvms, jmx_up, compile_seconds, compiles, osr_compiles, compiled_code_bytes
cron        = 1/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.deopt]
metric_name = jvm.deopt
metrics     = jvms, invalidated, bailouts, compiles, invalidated_percent
cron        = 7/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.safepoints]
metric_name = jvm.safepoints
metrics     = jvms, safepoints, stopped_seconds, sync_seconds, stopped_percent_lifetime
cron        = 2/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.finalization]
metric_name = jvm.finalization
metrics     = jvms, jmx_up, pending
cron        = 11/15 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.os]
metric_name = jvm.os
metrics     = jvms, jmx_up, process_cpu_percent, system_cpu_percent, process_cpu_seconds, load_average, cpus, memory_bytes, memory_free_bytes, swap_bytes, swap_free_bytes, open_files, open_files_max, open_files_percent
cron        = 1/2 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.io]
metric_name = jvm.io
metrics     = jvms, jmx_up, read_bytes, write_bytes, open
cron        = 3/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.crashes]
metric_name = jvm.crashes
metrics     = jvms, jmx_up, crash_reports_day, crash_reports, crash_reports_bytes, newest_crash_report_age_seconds, compiler_replays_day, compiler_replays, compiler_replays_bytes, newest_compiler_replay_age_seconds, core_dumps_day, core_dumps, core_dumps_bytes, newest_core_dump_age_seconds
cron        = 0/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=
env         = JVM_DUMP_DIRS=

[job.oom]
metric_name = jvm.oom
metrics     = jvms, jmx_up, heap_dumps_day, heap_dumps, heap_dumps_bytes, newest_heap_dump_age_seconds
cron        = 1/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=
env         = JVM_DUMP_DIRS=

[job.jfr]
metric_name = jvm.jfr
metrics     = jvms, jmx_up, available, recordings, recordings_running
cron        = 17 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=

[job.mbeans]
metric_name = jvm.mbeans
metrics     = jvms, jmx_up, value
cron        = 4/5 * * * *
max_runtime = 90s
env         = JVM_TARGETS=
env         = JVM_JMX_USER=
env         = JVM_CACERT=
env         = JVM_MBEANS=java.lang:type=Threading/ThreadCount; java.lang:type=Memory/HeapMemoryUsage.used
