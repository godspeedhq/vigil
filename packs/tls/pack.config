# tls - TLS certificates, from a handshake with each target you list: the
# days until each expires, whether it is within its dates, trusted, and for
# the name asked for; whether the handshake finished, why not, how long it
# took, and the TLS version agreed. Linux, macOS and Windows.
# See SPECIFICATION.md section 18.10 for this format.
#
# It only makes a handshake: no request is sent, no login. It watches no
# service of this machine in particular: list what to check, anywhere this
# machine can reach.
#
# Off until enabled: vigil pack enable tls. Then set the job's env line:
#   env = TLS_TARGETS=example.com mail.example.com:993 10.0.0.5:8443/app.internal
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = TLS certificates of any host and port: days until expiry, within its dates, trusted, for the right name; the handshake, why it failed, how long it took, the TLS version
# What vigil pack info shows besides: what it checks, the programs its
# scripts need on each platform, and where it is explained.
works_with  = any service that speaks TLS from its first byte: HTTPS, LDAPS, SMTPS, IMAPS, a database's TLS port, a Kubernetes API (not STARTTLS)
programs_linux = bash, openssl, awk, date
programs_macos = bash, openssl (macOS has LibreSSL's), awk, date, perl (macOS has them)
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/tls/README.md
needs       = the targets, separated by spaces: env = TLS_TARGETS=example.com mail.example.com:993 10.0.0.5:8443/app.internal
needs       = for certificates from a private CA: env = TLS_CACERT=/etc/ssl/private-ca.pem (on Windows, or trust the CA in Windows)

[job.certs]
metric_name = tls
metrics     = targets, targets_failed, soonest_days, up, handshake_ms, cert_expires_days, cert_valid, cert_trusted, cert_name_ok, cert_info, targets_not_shown
run_every   = 15m
max_runtime = 10m
env         = TLS_TARGETS=
env         = TLS_CACERT=
env         = TLS_TIMEOUT=10
