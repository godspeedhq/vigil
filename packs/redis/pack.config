# redis - a Redis or Valkey server, on this machine or any it can reach:
# whether it answers, its clients, commands and hit rate, its memory against
# the limit and what it evicts, replication from either side, whether its
# snapshots and append-only file are written, and the keys in each
# database. Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for
# this format.
#
# Linux and macOS read the server with redis-cli or valkey-cli; Windows
# speaks the server's protocol itself, with nothing to install.
#
# The job that runs every 15 minutes has a minute of its own (cron, local
# time): keyspace at 7, 22, 37 and 52.
#
# Off until enabled: vigil pack enable redis. It logs in as a user that may
# run INFO and PING and nothing else; create one once, as an administrator
# (Redis 6 or Valkey on):
#   ACL SETUSER vigil_monitor on >... -@all +info +ping
# then ACL SAVE (with an aclfile) or CONFIG REWRITE, so it outlives a
# restart; and give Vigil its password:
#   vigil secret set REDIS_MONITOR_PASSWORD
# For another host, port or user, or TLS, edit the env lines of the jobs
# vigil pack enable writes into the configuration.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.1
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Redis and Valkey: up, clients, commands and hit rate, memory and evictions, replication, persistence, keys
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Redis 6.2 or later, or Valkey; tested with Redis 6.2, 7.4 and 8.10 and Valkey 7.2, 8.1 and 9.2
programs_linux = redis-cli or valkey-cli
programs_macos = redis-cli or valkey-cli
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#redis
needs       = a user that may only read INFO, as an administrator: ACL SETUSER vigil_monitor on >... -@all +info +ping (then ACL SAVE or CONFIG REWRITE, so it outlives a restart)

[job.status]
metric_name = redis
metrics     = up, info, loading, uptime_seconds, clients, blocked_clients, max_clients, clients_pct, rejected_connections_count, connections_count, commands_count, ops_per_sec, hits_count, misses_count, hit_pct, evicted_keys_count, expired_keys_count, error_replies_count
run_every   = 1m
max_runtime = 30s
env         = REDIS_HOST=127.0.0.1
env         = REDIS_PORT=6379
env         = REDIS_USER=vigil_monitor
secret      = REDISCLI_AUTH=secret:REDIS_MONITOR_PASSWORD

[job.memory]
metric_name = redis.memory
metrics     = used_bytes, rss_bytes, peak_bytes, max_bytes, used_pct, fragmentation_ratio
run_every   = 1m
max_runtime = 30s
env         = REDIS_HOST=127.0.0.1
env         = REDIS_PORT=6379
env         = REDIS_USER=vigil_monitor
secret      = REDISCLI_AUTH=secret:REDIS_MONITOR_PASSWORD

[job.replication]
metric_name = redis.replication
metrics     = is_replica, replicas, online, lag_bytes, lag_seconds, link_up, last_io_seconds, link_down_seconds, sync_in_progress
run_every   = 1m
max_runtime = 30s
env         = REDIS_HOST=127.0.0.1
env         = REDIS_PORT=6379
env         = REDIS_USER=vigil_monitor
secret      = REDISCLI_AUTH=secret:REDIS_MONITOR_PASSWORD

[job.persistence]
metric_name = redis.persistence
metrics     = last_save_ok, last_save_age_seconds, changes_since_save, save_in_progress, last_fork_usec, aof_enabled, aof_last_write_ok, aof_last_rewrite_ok, aof_rewrite_in_progress
run_every   = 1m
max_runtime = 30s
env         = REDIS_HOST=127.0.0.1
env         = REDIS_PORT=6379
env         = REDIS_USER=vigil_monitor
secret      = REDISCLI_AUTH=secret:REDIS_MONITOR_PASSWORD

[job.keyspace]
metric_name = redis.keyspace
metrics     = keys, expires
cron        = 7/15 * * * *
max_runtime = 30s
env         = REDIS_HOST=127.0.0.1
env         = REDIS_PORT=6379
env         = REDIS_USER=vigil_monitor
secret      = REDISCLI_AUTH=secret:REDIS_MONITOR_PASSWORD
