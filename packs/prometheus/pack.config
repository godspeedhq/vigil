# prometheus - a Prometheus server, from its own metrics page and its
# federation page: is it ready, are its targets up, is its TSDB sound,
# are its rules evaluated, do its alerts reach an Alertmanager, and does
# its remote write keep up.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable prometheus (or one job: vigil pack enable prometheus_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Prometheus: whether it is ready and its configuration loaded, targets up and down, the TSDB (head, WAL, compactions), rule evaluation and alerts firing, notifications to Alertmanager, remote write queues and how far they are behind
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Prometheus 2.40 and later, and 3.x (tested: 3.15.1)
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/prometheus/README.md
needs       = its address, where it is not http://localhost:9090: env = PROMETHEUS_URL=... on each job
needs       = where it asks for a login: PROMETHEUS_USER and secret = PROMETHEUS_PASSWORD=secret:PROMETHEUS_PASSWORD, or secret = PROMETHEUS_TOKEN=secret:PROMETHEUS_TOKEN for a bearer token
needs       = for Prometheus' CPU and memory: the base pack's processes job

[job.status]
metric_name = prometheus
metrics     = up, ready, version, uptime_seconds, config_reload_ok, config_age_seconds, queries, queries_max, queries_pct, http_requests_count, http_4xx_count, http_5xx_count, alertmanagers, notifications_sent_count, notifications_errors_count, notifications_errors, notifications_errors_not_shown, notifications_dropped_count, notification_queue, notification_queue_capacity, fds_pct
run_every   = 1m
max_runtime = 30s
env         = PROMETHEUS_URL=
env         = PROMETHEUS_USER=
env         = PROMETHEUS_CACERT=

[job.targets]
metric_name = prometheus.targets
metrics     = up, scrape_pools, targets, discovered_targets, sd_failed_configs, pool_reloads_failed_count, exceeded_sample_limit_count, exceeded_body_size_count, exceeded_target_limit_count, out_of_order_count, duplicate_timestamp_count, out_of_bounds_count, targets_up, targets_down, down, down_not_shown, scrape_slowest_seconds, samples_scraped
run_every   = 1m
max_runtime = 30s
env         = PROMETHEUS_URL=
env         = PROMETHEUS_USER=
env         = PROMETHEUS_CACERT=

[job.tsdb]
metric_name = prometheus.tsdb
metrics     = up, head_series, head_chunks, series_created_count, samples_appended_count, out_of_order_samples_count, blocks, blocks_bytes, wal_bytes, head_chunks_bytes, retention_seconds, oldest_sample_seconds, newest_sample_seconds, compactions_count, compactions_failed_count, wal_corruptions_count, wal_writes_failed_count, wal_truncations_failed_count, checkpoints_failed_count, head_truncations_failed_count, reloads_failed_count, mmap_corruptions_count, clean_start
run_every   = 1m
max_runtime = 30s
env         = PROMETHEUS_URL=
env         = PROMETHEUS_USER=
env         = PROMETHEUS_CACERT=

[job.rules]
metric_name = prometheus.rules
metrics     = up, groups, rules, evaluations_count, evaluation_failures_count, evaluation_failures, evaluation_failures_not_shown, iterations_missed_count, slowest_group_seconds, stalest_group_seconds, alerts_firing, alerts_pending, firing, firing_not_shown
run_every   = 1m
max_runtime = 30s
env         = PROMETHEUS_URL=
env         = PROMETHEUS_USER=
env         = PROMETHEUS_CACERT=

[job.remote_write]
metric_name = prometheus.remote_write
metrics     = up, remotes, samples_sent_count, samples_failed_count, samples_failed, samples_failed_not_shown, samples_retried_count, samples_dropped_count, samples_pending, pending, pending_not_shown, shards, shards_max, shards_desired, behind_seconds, remotes_never_sent
run_every   = 1m
max_runtime = 30s
env         = PROMETHEUS_URL=
env         = PROMETHEUS_USER=
env         = PROMETHEUS_CACERT=
