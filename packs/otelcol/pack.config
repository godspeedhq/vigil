# otelcol - an OpenTelemetry Collector, from its own metrics page: what
# its receivers accept and refuse, what its exporters send and fail to
# send, and how full their queues are.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable otelcol (or one job: vigil pack enable otelcol_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = the OpenTelemetry Collector: what its receivers accepted and refused, what its exporters sent and failed to send (for each exporter), and how full their queues are, for traces, metrics and logs
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = the OpenTelemetry Collector 0.100 and later, core and contrib (tested: contrib 0.166.0)
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/otelcol/README.md
needs       = its own metrics page, which it serves on localhost:8888 by default (service::telemetry::metrics); where it is elsewhere: env = OTELCOL_URL=... on each job
needs       = for every reading: service::telemetry::metrics::level: detailed (the default, normal, leaves out the queue readings on some versions)
needs       = where it asks for a login (a proxy in front of it): OTELCOL_USER and secret = OTELCOL_PASSWORD=secret:OTELCOL_PASSWORD, or secret = OTELCOL_TOKEN=secret:OTELCOL_TOKEN
needs       = for the Collector's CPU: the base pack's processes job

[job.status]
metric_name = otelcol
metrics     = up, version, uptime_seconds, memory_rss_bytes, heap_bytes
run_every   = 1m
max_runtime = 30s
env         = OTELCOL_URL=
env         = OTELCOL_USER=
env         = OTELCOL_CACERT=

[job.receivers]
metric_name = otelcol.receivers
metrics     = up, accepted_spans_count, refused_spans_count, failed_spans_count, accepted_metric_points_count, refused_metric_points_count, failed_metric_points_count, accepted_log_records_count, refused_log_records_count, failed_log_records_count, refused_spans, refused_spans_not_shown, refused_metric_points, refused_metric_points_not_shown, refused_log_records, refused_log_records_not_shown
run_every   = 1m
max_runtime = 30s
env         = OTELCOL_URL=
env         = OTELCOL_USER=
env         = OTELCOL_CACERT=

[job.exporters]
metric_name = otelcol.exporters
metrics     = up, sent_spans_count, send_failed_spans_count, enqueue_failed_spans_count, sent_metric_points_count, send_failed_metric_points_count, enqueue_failed_metric_points_count, sent_log_records_count, send_failed_log_records_count, enqueue_failed_log_records_count, send_failed_spans, send_failed_spans_not_shown, send_failed_metric_points, send_failed_metric_points_not_shown, send_failed_log_records, send_failed_log_records_not_shown, queue_size, queue_capacity, queue_fullest_pct, queue, queue_not_shown, in_flight
run_every   = 1m
max_runtime = 30s
env         = OTELCOL_URL=
env         = OTELCOL_USER=
env         = OTELCOL_CACERT=
