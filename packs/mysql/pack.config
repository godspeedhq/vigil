# mysql - a MySQL or MariaDB server, on this machine or any it can reach:
# whether it answers, its connections and queries, its sessions and lock
# waits, replication, InnoDB's buffer pool, purge and lock counters, and
# each database's size. Linux, macOS and Windows. See SPECIFICATION.md section 18.10
# for this format.
#
# The jobs that run every 5 or 15 minutes have minutes of their own (cron,
# local time), around the base pack's and the postgres pack's, so few runs
# start together: innodb at 4, 9, 14 and so on, size at 8, 23, 38 and 53.
#
# Off until enabled: vigil pack enable mysql. It logs in as a read-only
# user, never root; create one once, as an administrator:
#   CREATE USER 'vigil_monitor'@'%' IDENTIFIED BY '...';
#   GRANT PROCESS, REPLICATION CLIENT ON *.* TO 'vigil_monitor'@'%';
# and on MariaDB, which reads replication status with a right of its own:
#   GRANT REPLICA MONITOR ON *.* TO 'vigil_monitor'@'%';
# and give Vigil its password:
#   vigil secret set MYSQL_MONITOR_PASSWORD
# For another host, port or user, edit the env lines of the jobs vigil pack
# enable writes into the configuration.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.1
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = MySQL and MariaDB: up, connections, queries, sessions and locks, replication, InnoDB, database sizes
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = MySQL 8.0 and MariaDB 10.5 on; tested with MySQL 8.4 and MariaDB 11.4
programs_linux = mysql or mariadb
programs_macos = mysql or mariadb
programs_windows = mysql or mariadb
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#mysql
needs       = a read-only user, as a database administrator: CREATE USER 'vigil_monitor'@'%' IDENTIFIED BY '...'; GRANT PROCESS, REPLICATION CLIENT ON *.* TO 'vigil_monitor'@'%' (on MariaDB also GRANT REPLICA MONITOR ON *.* TO 'vigil_monitor'@'%')

[job.status]
metric_name = mysql
metrics     = up, connections, max_connections, connections_pct, running, longest_query_seconds, queries_count, slow_queries_count, aborted_connects_count, tmp_disk_tables_count
run_every   = 1m
max_runtime = 30s
env         = MYSQL_HOST=127.0.0.1
env         = MYSQL_TCP_PORT=3306
env         = MYSQL_USER=vigil_monitor
secret      = MYSQL_PWD=secret:MYSQL_MONITOR_PASSWORD

[job.activity]
metric_name = mysql.activity
metrics     = longest_transaction_seconds, idle_in_transaction, longest_idle_in_transaction_seconds, waiting, longest_wait_seconds
run_every   = 1m
max_runtime = 30s
env         = MYSQL_HOST=127.0.0.1
env         = MYSQL_TCP_PORT=3306
env         = MYSQL_USER=vigil_monitor
secret      = MYSQL_PWD=secret:MYSQL_MONITOR_PASSWORD

[job.replication]
metric_name = mysql.replication
metrics     = is_replica, io_running, sql_running, lag_seconds, replicas
run_every   = 1m
max_runtime = 30s
env         = MYSQL_HOST=127.0.0.1
env         = MYSQL_TCP_PORT=3306
env         = MYSQL_USER=vigil_monitor
secret      = MYSQL_PWD=secret:MYSQL_MONITOR_PASSWORD

[job.innodb]
metric_name = mysql.innodb
metrics     = buffer_pool_hit_pct, buffer_pool_used_pct, history_list_count, row_lock_waits_count, deadlocks_count
cron        = 4/5 * * * *
max_runtime = 30s
env         = MYSQL_HOST=127.0.0.1
env         = MYSQL_TCP_PORT=3306
env         = MYSQL_USER=vigil_monitor
secret      = MYSQL_PWD=secret:MYSQL_MONITOR_PASSWORD

[job.size]
metric_name = mysql.database
metrics     = size_bytes
cron        = 8/15 * * * *
max_runtime = 1m
env         = MYSQL_HOST=127.0.0.1
env         = MYSQL_TCP_PORT=3306
env         = MYSQL_USER=vigil_monitor
secret      = MYSQL_PWD=secret:MYSQL_MONITOR_PASSWORD
