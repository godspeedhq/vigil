# nginx - an nginx server on this machine, from its stub_status page:
# whether it answers, its connections and its requests. See
# SPECIFICATION.md section 18.10 for this format.
#
# Off until enabled: vigil pack enable nginx. It needs nginx's stub_status
# page, reachable from this machine only, for example:
#   location = /nginx_status { stub_status; allow 127.0.0.1; deny all; }
# For another address, edit the env line of the job vigil pack enable
# writes into the configuration. Linux and macOS: there is no Windows script.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.1.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = nginx: up, connections and requests, from stub_status
needs       = its stub_status page, reachable from this machine only: location = /nginx_status { stub_status; allow 127.0.0.1; deny all; }

[job.status]
metric_name = nginx
metrics     = up, active_connections, reading, writing, waiting, accepts_count, handled_count, requests_count, dropped_count
run_every   = 1m
max_runtime = 30s
env         = NGINX_STATUS_URL=http://127.0.0.1/nginx_status
