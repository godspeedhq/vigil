# nginx - an nginx server on this machine: its stub_status page, its
# processes and configuration, its access log minute by minute, and the
# certificates it serves.
# Linux, macOS and Windows (on Windows: status, log, tls). See
# SPECIFICATION.md section 18.10 for this format, and tools/web/DESIGN.md.
#
# It only reads: it changes nothing on the server.
#
# Off until enabled: vigil pack enable nginx (or one job: vigil pack enable nginx_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.2.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = nginx: connections and requests (stub_status), processes and configuration reloads, the access log minute by minute (status, errors, response times, upstream times), certificate expiry
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = nginx 1.18 and later (tested: 1.30.8 and 1.31.10)
programs_linux = bash, curl, openssl, ps
programs_macos = bash, curl, openssl, ps
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/nginx/README.md
needs       = its stub_status page, reachable from this machine only: location = /nginx_status { stub_status; allow 127.0.0.1; deny all; }
needs       = for the log job, read access to the access log: on Debian and Ubuntu, usermod -aG adm vigil; elsewhere, the log folder's group (packs/nginx/README.md); with rt=$request_time urt=$upstream_response_time at the end of the log_format for response times
needs       = for nginx's CPU and memory: the base pack's processes job

[job.status]
metric_name = nginx
metrics     = up, active_connections, reading, writing, waiting, accepts_count, handled_count, requests_count, dropped_count
run_every   = 1m
max_runtime = 30s
env         = NGINX_STATUS_URL=http://127.0.0.1/nginx_status

[job.server]
metric_name = nginx.server
metrics     = running, master_uptime_seconds, workers, workers_shutting_down, cache_processes, last_reload_seconds, config_changed, worker_processes_setting, worker_connections, connections_capacity_pct, worker_open_files_limit
run_every   = 1m
max_runtime = 30s
env         = NGINX_PID_FILE=/run/nginx.pid
env         = NGINX_CONF=/etc/nginx/nginx.conf
env         = NGINX_STATUS_URL=http://127.0.0.1/nginx_status

[job.log]
metric_name = nginx.log
metrics     = log_found, log_readable, log_bytes, window_complete, requests, status_1xx, status_2xx, status_3xx, status_4xx, status_5xx, errors_4xx_pct, errors_5xx_pct, bytes_sent, clients, status, method, response_avg_ms, response_p50_ms, response_p90_ms, response_p99_ms, response_max_ms, upstream_avg_ms, upstream_p50_ms, upstream_p90_ms, upstream_p99_ms, upstream_max_ms
run_every   = 1m
max_runtime = 50s
env         = NGINX_ACCESS_LOG=/var/log/nginx/access.log
env         = NGINX_LOG_MAX_MB=32

[job.tls]
metric_name = nginx.tls
metrics     = tls_up, cert_expires_days, cert_valid, cert_verified, cert_info, certs_not_shown
run_every   = 15m
max_runtime = 2m
env         = NGINX_TLS=localhost:443
env         = NGINX_CACERT=
