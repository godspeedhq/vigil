# httpd - an Apache httpd server on this machine: its server-status page
# (workers, the scoreboard, requests, connections), whether its
# configuration changed since it last loaded, its access log minute by
# minute, and the certificates it serves.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/web/DESIGN.md.
#
# It only reads: it changes nothing on the server.
#
# Off until enabled: vigil pack enable httpd (or one job: vigil pack enable httpd_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Apache httpd: workers and the scoreboard, requests, connections, TLS session cache, configuration not reloaded, the access log minute by minute, certificate expiry
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Apache httpd 2.4 (tested: 2.4.71, event and prefork MPMs)
programs_linux = bash, curl, openssl, ps
programs_macos = bash, curl, openssl, ps
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/httpd/README.md
needs       = its server-status page, from this machine only: <Location "/server-status"> SetHandler server-status; Require local </Location>, and ExtendedStatus On
needs       = for the log job, read access to the access log (packs/httpd/README.md); with rtus=%D at the end of the LogFormat for response times
needs       = for httpd's CPU and memory: the base pack's processes job

[job.status]
metric_name = httpd
metrics     = up, info, extended_status, uptime_seconds, restarts, accesses_count, bytes_count, duration_ms_count, cpu_load_pct, busy_workers, idle_workers, finishing_workers, scoreboard_slots, busy_pct, processes, stopping_processes, connections, conns_writing, conns_keepalive, conns_closing, workers_in_state, ssl_cache_entries, ssl_cache_usage_pct, ssl_cache_hits_count, ssl_cache_misses_count, ssl_cache_discards_count, config_changed
run_every   = 1m
max_runtime = 30s
env         = HTTPD_STATUS_URL=http://127.0.0.1/server-status
env         = HTTPD_CONF=
env         = HTTPD_PID_FILE=

[job.log]
metric_name = httpd.log
metrics     = log_found, log_readable, log_bytes, window_complete, requests, status_1xx, status_2xx, status_3xx, status_4xx, status_5xx, errors_4xx_pct, errors_5xx_pct, bytes_sent, clients, status, method, response_avg_ms, response_p50_ms, response_p90_ms, response_p99_ms, response_max_ms
run_every   = 1m
max_runtime = 50s
env         = HTTPD_ACCESS_LOG=
env         = HTTPD_LOG_MAX_MB=32

[job.tls]
metric_name = httpd.tls
metrics     = tls_up, cert_expires_days, cert_valid, cert_verified, cert_info, certs_not_shown
run_every   = 15m
max_runtime = 2m
env         = HTTPD_TLS=localhost:443
env         = HTTPD_CACERT=
