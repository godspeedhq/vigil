# activemq - Apache ActiveMQ Classic, on this machine or any it can reach,
# over JMX: its health, its memory, store and temp against their limits,
# queues (the deepest first), topics, dead letter queues, consumers and
# durable subscribers, connections and network bridges. ActiveMQ Artemis is
# the artemis pack's; the broker's JVM is the jvm pack's. Linux, macOS and
# Windows. See SPECIFICATION.md section 18.10 for this format, and
# tools/probe/DESIGN.md for the probe that reads it.
#
# Every script runs _probe.jar, beside it, with Java 11 or later (a JDK or a
# JRE), once it matches the digest the script carries, with this pack's
# _probe.tables. Nothing of ActiveMQ's is needed here: only its JMX.
#
# Off until enabled: vigil pack enable activemq. Then set ACTIVEMQ_JMX in the
# jobs vigil pack enable writes into the configuration (amq1:
# jmxs=host:port), ACTIVEMQ_JMX_USER, and for its password a secret line
# (packs/README.md has it all).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Apache ActiveMQ Classic over JMX: health, memory, store and temp limits, queues (the deepest first), topics, dead letter queues, durable subscribers, connections and network bridges
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Apache ActiveMQ Classic 5.18 to 6.x (tested: 5.18, 5.19 and 6.2), with JMX on; Artemis is the artemis pack's
programs_linux = Java 11 or later, a JDK or a JRE, to run the probe
programs_macos = Java 11 or later, a JDK or a JRE, to run the probe
programs_windows = Java 11 or later, a JDK or a JRE, to run the probe
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/README.md#activemq
needs       = each broker's JMX in ACTIVEMQ_JMX (amq1: jmxs=host:port): -Dcom.sun.management.jmxremote.port and a password and TLS in ACTIVEMQ_SUNJMX_START (packs/README.md shows how)
needs       = for JMX with a password: a secret line on the jobs: secret = ACTIVEMQ_JMX_PASSWORD=secret:ACTIVEMQ_JMX_PASSWORD, then vigil secret set ACTIVEMQ_JMX_PASSWORD
needs       = for the broker's JVM (heap, garbage collection, threads, CPU, open files): the jvm pack, not this one: vigil pack install jvm, with each broker in JVM_TARGETS named as here (amq1: jmxs=host:port)

[job.status]
metric_name = activemq
metrics     = jmx_up, version, broker, uptime_seconds, healthy, slave, connector_up, connections_refused_count, version_not_shown, broker_not_shown, uptime_seconds_not_shown, healthy_not_shown, slave_not_shown, connector_up_not_shown, connections_refused_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = ACTIVEMQ_JMX=
env         = ACTIVEMQ_JMX_USER=
env         = ACTIVEMQ_CACERT=

[job.broker]
metric_name = activemq.broker
metrics     = jmx_up, memory_pct, memory_limit_bytes, store_pct, store_limit_bytes, temp_pct, temp_limit_bytes, scheduler_pct, scheduler_limit_bytes, store_bytes, connections, connections_count, producers, consumers, messages, enqueued_count, dequeued_count, queues, topics, temp_queues, temp_topics, message_mean_bytes, message_max_bytes, memory_pct_not_shown, memory_limit_bytes_not_shown, store_pct_not_shown, store_limit_bytes_not_shown, temp_pct_not_shown, temp_limit_bytes_not_shown, scheduler_pct_not_shown, scheduler_limit_bytes_not_shown, store_bytes_not_shown, connections_not_shown, connections_count_not_shown, producers_not_shown, consumers_not_shown, messages_not_shown, enqueued_count_not_shown, dequeued_count_not_shown, queues_not_shown, topics_not_shown, temp_queues_not_shown, temp_topics_not_shown, message_mean_bytes_not_shown, message_max_bytes_not_shown
run_every   = 1m
max_runtime = 90s
env         = ACTIVEMQ_JMX=
env         = ACTIVEMQ_JMX_USER=
env         = ACTIVEMQ_CACERT=

[job.queues]
metric_name = activemq.queue
metrics     = jmx_up, size, enqueued_count, dequeued_count, dispatched_count, expired_count, in_flight, consumers, producers, memory_pct, memory_bytes, cursor_pct, blocked_sends_count, blocked_seconds, enqueue_mean_seconds, enqueue_max_seconds, message_mean_bytes, paused, forwarded_count, size_not_shown, enqueued_count_not_shown, dequeued_count_not_shown, dispatched_count_not_shown, expired_count_not_shown, in_flight_not_shown, consumers_not_shown, producers_not_shown, memory_pct_not_shown, memory_bytes_not_shown, cursor_pct_not_shown, blocked_sends_count_not_shown, blocked_seconds_not_shown, enqueue_mean_seconds_not_shown, enqueue_max_seconds_not_shown, message_mean_bytes_not_shown, paused_not_shown, forwarded_count_not_shown
run_every   = 1m
max_runtime = 2m
env         = ACTIVEMQ_JMX=
env         = ACTIVEMQ_JMX_USER=
env         = ACTIVEMQ_CACERT=

[job.topics]
metric_name = activemq.topic
metrics     = jmx_up, pending, enqueued_count, dequeued_count, dispatched_count, expired_count, consumers, producers, memory_pct, blocked_sends_count, pending_not_shown, enqueued_count_not_shown, dequeued_count_not_shown, dispatched_count_not_shown, expired_count_not_shown, consumers_not_shown, producers_not_shown, memory_pct_not_shown, blocked_sends_count_not_shown
run_every   = 1m
max_runtime = 2m
env         = ACTIVEMQ_JMX=
env         = ACTIVEMQ_JMX_USER=
env         = ACTIVEMQ_CACERT=

[job.dlq]
metric_name = activemq.dlq
metrics     = jmx_up, size, enqueued_count, size_not_shown, enqueued_count_not_shown
run_every   = 1m
max_runtime = 90s
env         = ACTIVEMQ_JMX=
env         = ACTIVEMQ_JMX_USER=
env         = ACTIVEMQ_CACERT=

[job.subscribers]
metric_name = activemq.subscriber
metrics     = jmx_up, pending, dispatched, enqueued_count, dequeued_count, active, slow, pending_not_shown, dispatched_not_shown, enqueued_count_not_shown, dequeued_count_not_shown, active_not_shown, slow_not_shown
run_every   = 2m
max_runtime = 2m
env         = ACTIVEMQ_JMX=
env         = ACTIVEMQ_JMX_USER=
env         = ACTIVEMQ_CACERT=

[job.connections]
metric_name = activemq.connection
metrics     = jmx_up, dispatch_queue, blocked, slow, transactions, oldest_transaction_seconds, bridge, bridge_enqueued_count, bridge_dequeued_count, dispatch_queue_not_shown, blocked_not_shown, slow_not_shown, transactions_not_shown, oldest_transaction_seconds_not_shown, bridge_not_shown, bridge_enqueued_count_not_shown, bridge_dequeued_count_not_shown
run_every   = 2m
max_runtime = 2m
env         = ACTIVEMQ_JMX=
env         = ACTIVEMQ_JMX_USER=
env         = ACTIVEMQ_CACERT=
