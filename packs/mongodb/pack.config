# mongodb - MongoDB, from the server itself, with mongosh: up, connections,
# operations and their latency, the WiredTiger cache, queues; the replica
# set: a primary or not, members down, lag, the oplog window; databases and
# their size; operations running long. Linux, macOS and Windows. See
# SPECIFICATION.md section 18.10 for this format.
#
# It only reads, as a user with MongoDB's own clusterMonitor role, which
# may read the server's state and none of its data. Each job is a script
# mongosh runs with no connection of its own; the script logs in from the
# environment, so the password is never on a command line.
#
# Off until enabled: vigil pack enable mongodb. Then set the jobs' env
# lines:
#   env = MONGODB_URL=mongodb://db1.example.com:27017
# and: vigil secret set MONGODB_PASSWORD (the monitoring user's).
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = MongoDB: up, connections, operations and latency, the WiredTiger cache and queues; the replica set's primary, members down, lag and oplog window; databases and their size; operations running long
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = MongoDB 8.0 and 9.0, a server or a replica set member (tested: a 9.0 replica set of three, and 8.0)
programs_linux = bash, mongosh
programs_macos = bash, mongosh
programs_windows = PowerShell 5.1 or later, mongosh
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/mongodb/README.md
needs       = mongosh on this machine (MongoDB's shell: https://www.mongodb.com/try/download/shell), or MONGOSH naming it
needs       = a user with the clusterMonitor role, as an admin: db.getSiblingDB('admin').createUser({ user: 'vigil', pwd: passwordPrompt(), roles: ['clusterMonitor'] }); then vigil secret set MONGODB_PASSWORD

[job.status]
metric_name = mongodb
metrics     = up, info, uptime_seconds, connections, connections_available, connections_pct, connections_active, connections_created_count, operations_count, latency_avg_ms, queued, memory_resident_bytes, cache_bytes, cache_max_bytes, cache_pct, cache_dirty_pct, cache_evicted_by_threads_count, cursors_open, cursors_timed_out_count, asserts_count, page_faults_count, network_in_bytes_count, network_out_bytes_count, transactions_open, transactions_aborted_count
run_every   = 1m
max_runtime = 50s
env         = MONGODB_URL=
env         = MONGODB_USER=vigil
env         = MONGODB_CACERT=
env         = MONGOSH=
secret      = MONGODB_PASSWORD=secret:MONGODB_PASSWORD

[job.replication]
metric_name = mongodb.replication
metrics     = up, info, replicated, members, members_healthy, members_down, primary, secondaries, lag_seconds_max, lag_seconds, member_health, member_lag_seconds, members_not_shown, oplog_window_hours, oplog_bytes, oplog_max_bytes
run_every   = 1m
max_runtime = 50s
env         = MONGODB_URL=
env         = MONGODB_USER=vigil
env         = MONGODB_CACERT=
env         = MONGODB_MOST=50
env         = MONGOSH=
secret      = MONGODB_PASSWORD=secret:MONGODB_PASSWORD

[job.databases]
metric_name = mongodb.databases
metrics     = up, databases, size_bytes, db_size_bytes, db_data_bytes, db_index_bytes, db_collections, db_indexes, db_documents, databases_not_shown
run_every   = 15m
max_runtime = 2m
env         = MONGODB_URL=
env         = MONGODB_USER=vigil
env         = MONGODB_CACERT=
env         = MONGODB_MOST=50
env         = MONGOSH=
secret      = MONGODB_PASSWORD=secret:MONGODB_PASSWORD

[job.operations]
metric_name = mongodb.operations
metrics     = up, running, slow, longest_seconds, waiting_for_lock, transactions_open, op_seconds
run_every   = 1m
max_runtime = 50s
env         = MONGODB_URL=
env         = MONGODB_USER=vigil
env         = MONGODB_CACERT=
env         = MONGOSH=
secret      = MONGODB_PASSWORD=secret:MONGODB_PASSWORD
