# cockroachdb - CockroachDB, from its HTTP API: each node's health, ranges,
# storage and SQL from its own metrics, and the cluster's nodes and jobs.
# A node or a whole cluster: run the node jobs on every node, the cluster
# jobs on one. Linux, macOS and Windows. See SPECIFICATION.md section 18.10
# for this format.
#
# It only reads: a node's metrics need no login; the cluster's nodes and
# jobs are read as a user with three read-only system privileges.
# Linux and macOS read with curl and jq; Windows with PowerShell alone.
#
# Off until enabled: vigil pack enable cockroachdb. Then set the jobs' env lines:
#   env = COCKROACH_URL=https://db1.example.com:8080   (the node's HTTP port)
#   env = COCKROACH_CACERT=/var/lib/cockroach/certs/ca.crt   (the cluster's CA)
# and: vigil secret set COCKROACH_PASSWORD (the cluster and jobs jobs). An
# insecure cluster: COCKROACH_URL=http://..., COCKROACH_USER= and no secret
# line.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = CockroachDB, a node or a cluster: health, readiness, clock offset, certificates, ranges unavailable and under-replicated, slow requests, storage and write stalls, admission control, SQL, nodes live and dead, decommissioning, upgrades, jobs, backups and changefeeds
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = CockroachDB 25.x and 26.x (tested: 25.4.21 and 26.4.1, a three-node cluster), secure or insecure
programs_linux = bash, curl, jq
programs_macos = bash, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/cockroachdb/README.md
needs       = the node's HTTP port (8080 by default) reachable from this machine, and over https the cluster's CA file: env = COCKROACH_CACERT=<its certs folder>/ca.crt
needs       = for the cluster and jobs jobs, a user with three read-only system privileges, as an admin: CREATE USER vigil WITH PASSWORD '...'; GRANT SYSTEM VIEWCLUSTERMETADATA, VIEWCLUSTERSETTING, VIEWJOB TO vigil; then vigil secret set COCKROACH_PASSWORD
needs       = on an insecure cluster, no user: env = COCKROACH_USER= and take out the secret line

[job.status]
metric_name = cockroachdb
metrics     = up, ready, node_id, info, uptime_seconds, live_nodes, heartbeat_failures_count, clock_offset_ms, clock_offset_stddev_ms, cpu_pct, rss_bytes, goroutines, runnable_per_cpu, cpu_queue, cpu_slots_exhausted_seconds, fds_open, fds_pct, cert_days, cert_days_min
run_every   = 1m
max_runtime = 50s
env         = COCKROACH_URL=
env         = COCKROACH_CACERT=

[job.replication]
metric_name = cockroachdb.replication
metrics     = up, ranges, replicas, leaseholders, raft_leaders, leaders_not_leaseholders, ranges_unavailable, ranges_underreplicated, ranges_overreplicated, ranges_decommissioning, slow_raft, slow_lease, slow_latch, slow_distsender, replicate_queue_pending, splits_count, merges_count
run_every   = 1m
max_runtime = 50s
env         = COCKROACH_URL=
env         = COCKROACH_CACERT=

[job.storage]
metric_name = cockroachdb.storage
metrics     = up, stores, disk_bytes, disk_free_bytes, disk_used_pct, used_bytes, live_bytes, l0_sublevels, l0_files, read_amp, io_overload, io_queue, io_tokens_exhausted_seconds, write_stalls_count, write_stall_seconds, disk_slow_count, wal_fsync_seconds, wal_fsyncs_count
run_every   = 1m
max_runtime = 50s
env         = COCKROACH_URL=
env         = COCKROACH_CACERT=

[job.sql]
metric_name = cockroachdb.sql
metrics     = up, connections, statements_active, transactions_open, memory_bytes, connections_count, selects_count, inserts_count, updates_count, deletes_count, ddl_count, failures_count, full_scans_count, commits_count, aborts_count, restarts_count, statement_seconds, statements_count, transaction_seconds, transactions_count
run_every   = 1m
max_runtime = 50s
env         = COCKROACH_URL=
env         = COCKROACH_CACERT=

[job.cluster]
metric_name = cockroachdb.cluster
metrics     = up, nodes, live, dead, unavailable, draining, decommissioning, decommissioned, versions, version_info, cluster_version, upgrade_pending, downgrade_preserved, node_status, node_uptime_seconds, nodes_not_shown
run_every   = 1m
max_runtime = 50s
env         = COCKROACH_URL=
env         = COCKROACH_CACERT=
env         = COCKROACH_USER=vigil
secret      = COCKROACH_PASSWORD=secret:COCKROACH_PASSWORD

[job.jobs]
metric_name = cockroachdb.jobs
metrics     = up, running, paused, failed, reverting, jobs, job_failed, job_paused_seconds, jobs_not_shown, schedules, schedules_paused, schedules_late, changefeeds, changefeed_behind_seconds
run_every   = 5m
max_runtime = 2m
env         = COCKROACH_URL=
env         = COCKROACH_CACERT=
env         = COCKROACH_USER=vigil
secret      = COCKROACH_PASSWORD=secret:COCKROACH_PASSWORD
