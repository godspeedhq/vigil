# loki - a Loki, from its own metrics page: is it ready and are its rings
# whole, what logs does it receive and what does it discard, do its
# chunks get flushed, and does its compactor run.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable loki (or one job: vigil pack enable loki_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Loki: whether it is ready and its rings whole, ingestion (lines and bytes received, entries discarded and why, streams, chunks flushed and flushes failed), requests and those that failed, and its compactor (last compaction, retention, delete requests)
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Loki 2.9 and later, and 3.x (tested: 3.7.9, one binary); in microservices mode, each component reports those of these metrics it has
programs_linux = bash, awk, curl
programs_macos = bash, awk, curl
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/loki/README.md
needs       = its address, where it is not http://localhost:3100: env = LOKI_URL=... on each job (in microservices mode, a component: the ingestion job at a distributor or an ingester, the compaction job at the compactor)
needs       = where it asks for a login (a proxy in front of it): LOKI_USER and secret = LOKI_PASSWORD=secret:LOKI_PASSWORD, or secret = LOKI_TOKEN=secret:LOKI_TOKEN for a bearer token
needs       = for Loki's CPU and memory: the base pack's processes job

[job.status]
metric_name = loki
metrics     = up, ready, version, uptime_seconds, ingesters_active, ingesters_unhealthy, ring_unhealthy, ring_not_active, requests_count, requests_4xx_count, requests_5xx_count, queries_in_progress, queue_length, tails_active, panics_count, errors_logged_count
run_every   = 1m
max_runtime = 30s
env         = LOKI_URL=
env         = LOKI_USER=
env         = LOKI_CACERT=

[job.ingestion]
metric_name = loki.ingestion
metrics     = up, lines_received_count, bytes_received_count, discarded_count, discarded, discarded_not_shown, discarded_bytes_count, streams, chunks, streams_created_count, chunks_flushed_count, flush_failures_count, flush_queue, wal_disk_full_count, wal_corruptions_count, checkpoints_failed_count, append_failures_count
run_every   = 1m
max_runtime = 30s
env         = LOKI_URL=
env         = LOKI_USER=
env         = LOKI_CACERT=

[job.compaction]
metric_name = loki.compaction
metrics     = up, compactor_active, compactions_count, compactions_failed_count, last_compaction_seconds, retention_runs_count, retention_failed_count, last_retention_seconds, delete_requests_pending, oldest_delete_request_seconds, tables_skipped
run_every   = 5m
max_runtime = 30s
env         = LOKI_URL=
env         = LOKI_USER=
env         = LOKI_CACERT=
