# podman - Podman, asked with its own command: can it be asked, what state is
# every container in (running, unhealthy, killed for memory, restarted again
# and again), what does each use (CPU, memory against its limit, network,
# disk), and how much disk do images, containers and volumes take. Linux and
# macOS. See SPECIFICATION.md section 18.10 for this format.
#
# It only reads, and changes nothing: no container is started, stopped or
# removed, and nothing is pruned.
#
# Off until enabled: vigil pack enable podman (or one job: vigil pack enable
# podman_<job>). Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Podman: whether it answers, its containers by state, each container (running, restarts, health, exit code, killed for memory), each one's CPU, memory against its limit, network and disk, and the disk it uses (images, containers, volumes)
# What vigil pack info shows besides: the engines it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Podman 4.0 and later, rootless and as root (tested: 5.8 on Linux)
programs_linux = bash, podman, jq
programs_macos = bash, podman, jq
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/podman/README.md
needs       = Podman keeps containers by account: Vigil reads those of the account it runs as. As root, root's containers; as another account, that account's own (rootless) and no one else's
needs       = for another Podman than this account's own (a remote one, a podman machine that is not the default): env = CONTAINER_HOST=... on each job, as for the podman command
needs       = for the machine's CPU and memory: the base pack's processes job; for how full the disk is, its disk job

[job.status]
metric_name = podman
metrics     = up, version, rootless, containers, running, paused, exited, created, unhealthy, health_starting, exited_nonzero, restarts_total_count, pods, images, cpus, memory_bytes
run_every   = 1m
max_runtime = 30s
env         = CONTAINER_HOST=

[job.containers]
metric_name = podman.containers
metrics     = up, containers, containers_unhealthy, containers_oom_killed, containers_exited_nonzero, restarts_total_count, running, restarts_count, oom_killed, uptime_seconds, healthy, exit_code, containers_not_shown
run_every   = 1m
max_runtime = 1m
env         = CONTAINER_HOST=

[job.resources]
metric_name = podman.resources
metrics     = up, containers_measured, memory_total_bytes, memory_fullest_pct, cpu_seconds_count, memory_bytes, memory_limit_bytes, memory_pct, pids, network_rx_bytes_count, network_tx_bytes_count, block_read_bytes_count, block_write_bytes_count, containers_not_shown
run_every   = 1m
max_runtime = 2m
env         = CONTAINER_HOST=

[job.disk]
metric_name = podman.disk
metrics     = up, images, images_unused, images_dangling, images_bytes, images_reclaimable_bytes, containers, containers_bytes, containers_reclaimable_bytes, container_bytes, container_bytes_not_shown, volumes, volumes_unused, volumes_bytes, volumes_reclaimable_bytes
run_every   = 15m
max_runtime = 5m
env         = CONTAINER_HOST=
