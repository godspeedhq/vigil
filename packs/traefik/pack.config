# traefik - a Traefik proxy, from its own metrics page and its read-only API:
# is it up, do its backends answer, which routers and services fail, which
# routers are broken in its configuration, and which certificate expires
# first.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable traefik (or one job: vigil pack enable traefik_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Traefik: up, its configuration reloads, connections and requests on each entrypoint, 4xx and 5xx; backend servers up and down (health checks), each named; services and routers answering 5xx; routers, services and middlewares in error, named; TLS certificates and the soonest to expire
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Traefik 3.x, as a container, a Kubernetes ingress or a binary (tested: 3.8.0 and 3.7.20), with its Prometheus metrics and its API on the traefik entrypoint
programs_linux = bash, awk, curl, jq
programs_macos = bash, awk, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/traefik/README.md
needs       = its metrics and API: --metrics.prometheus=true (with addRoutersLabels and addServicesLabels for the routers and services jobs), --api=true and --ping=true; they are served on the traefik entrypoint (port 8080): env = TRAEFIK_URL=... where it is elsewhere
needs       = for backends up and down: health checks on the services (loadBalancer.healthCheck); without one, Traefik does not know
needs       = where the API is behind a login (a router with basicAuth): TRAEFIK_USER and secret = TRAEFIK_PASSWORD=secret:TRAEFIK_PASSWORD
needs       = for Traefik's CPU and memory: the base pack's processes job

[job.status]
metric_name = traefik
metrics     = up, ping, last_reload_seconds, reloads_count, connections, connections_by_entrypoint, connections_by_entrypoint_not_shown, requests_count, requests_4xx_count, requests_5xx_count, requests_5xx, requests_5xx_not_shown, request_avg_ms, tls_requests_count, certs, cert_expires_at
run_every   = 1m
max_runtime = 30s
env         = TRAEFIK_URL=
env         = TRAEFIK_USER=
env         = TRAEFIK_CACERT=

[job.services]
metric_name = traefik.services
metrics     = up, servers, servers_down, server_down, server_down_not_shown, down_by_service, down_by_service_not_shown, requests_count, requests_5xx_count, requests_5xx, requests_5xx_not_shown, request_avg_ms, retries_count
run_every   = 1m
max_runtime = 30s
env         = TRAEFIK_URL=
env         = TRAEFIK_USER=
env         = TRAEFIK_CACERT=

[job.routers]
metric_name = traefik.routers
metrics     = up, requests_count, requests, requests_not_shown, requests_4xx, requests_4xx_not_shown, requests_5xx, requests_5xx_not_shown
run_every   = 1m
max_runtime = 30s
env         = TRAEFIK_URL=
env         = TRAEFIK_USER=
env         = TRAEFIK_CACERT=

[job.config]
metric_name = traefik.config
metrics     = up, version, routers, routers_errors, routers_warnings, services, services_errors, services_warnings, middlewares, middlewares_errors, middlewares_warnings, certificates, certificates_warnings, certificates_errors, router_error, router_errors_not_shown, cert_expires_days, certs_expiring_30d
run_every   = 5m
max_runtime = 30s
env         = TRAEFIK_URL=
env         = TRAEFIK_USER=
env         = TRAEFIK_CACERT=
