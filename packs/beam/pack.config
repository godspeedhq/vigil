# beam - Erlang and Elixir virtual machines (the BEAM), any application
# that runs on one (RabbitMQ, CouchDB, ejabberd, EMQX, Phoenix...): its
# process, epmd's nodes, memory by kind, processes, ports, atoms and ETS
# tables against their limits, run queues, garbage collection, the longest
# mailboxes, the largest ETS tables, distribution, applications and crash
# dumps. Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for
# this format.
#
# Tiers, each used where it reaches:
#   the process and crash dumps: nothing to set up
#   epmd: its address in BEAM_EPMD (this machine's, unless set)
#   Prometheus: a node's /metrics (RabbitMQ's on 15692, prometheus.erl's)
#     in BEAM_PROMETHEUS, read with curl
#   the cookie: the node in BEAM_DIST and its cookie as a secret, read by
#     _beam.escript with Erlang's own escript (Erlang/OTP 25 or later)
#
# WARNING, the cookie: a node's cookie lets whoever holds it run anything
# on that node. This pack never changes anything: it only reads, and
# _beam.escript lists every call it makes. Give Vigil the cookie only if
# you accept what the cookie allows (packs/beam/README.md has it all).
#
# Off until enabled: vigil pack enable beam. Then set the env lines of the
# jobs vigil pack enable writes into the configuration, for example:
#   env = BEAM_PROMETHEUS=rabbit=http://127.0.0.1:15692/metrics
#   env = BEAM_DIST=rabbit=rabbit@db1
# and, for the cookie, add to the jobs that read it (vm, processes,
# tables, dist and apps):
#   secret = BEAM_COOKIE=secret:BEAM_COOKIE
# then: vigil secret set BEAM_COOKIE
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Erlang and Elixir VMs: process, epmd, memory by kind, processes, ports, atoms and ETS against their limits, run queues, GC, mailboxes, ETS tables, distribution, applications, crash dumps
# What vigil pack info shows besides: the VMs it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Erlang/OTP 25 and later; any Erlang or Elixir application: RabbitMQ, CouchDB, ejabberd, EMQX, Phoenix...
programs_linux = bash; curl, for Prometheus; Erlang/OTP 25 or later (escript), for the cookie
programs_macos = bash; curl, for Prometheus; Erlang/OTP 25 or later (escript), for the cookie
programs_windows = PowerShell 5.1 or later; Erlang/OTP 25 or later (escript.exe), for the cookie
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/beam/README.md
needs       = for the process tier: nothing; another account's VMs need root or an administrator for their open files (Linux) and command lines (Windows)
needs       = for epmd: its address in BEAM_EPMD (host or host:port; this machine's, unless set)
needs       = for Prometheus: a node's /metrics in BEAM_PROMETHEUS (<name>=<url>; RabbitMQ's on port 15692)
needs       = for the cookie: the node in BEAM_DIST (<name>=<node>), Erlang/OTP 25 or later here, and a secret line: secret = BEAM_COOKIE=secret:BEAM_COOKIE, then vigil secret set BEAM_COOKIE. WARNING: the cookie lets whoever holds it run anything on the node; this pack only reads

[job.process]
metric_name = beam.process
metrics     = beams, running, rss_bytes, cpu_seconds, threads, open_files, open_files_max, uptime_seconds, cookie_on_command_line, beams_not_shown
run_every   = 1m
max_runtime = 30s

[job.epmd]
metric_name = beam.epmd
metrics     = epmd_up, nodes, node, nodes_not_shown
run_every   = 1m
max_runtime = 30s
env         = BEAM_EPMD=

[job.vm]
metric_name = beam.vm
metrics     = nodes, up, version, memory_bytes, processes, process_limit, process_pct, ports, port_limit, port_pct, atoms, atom_limit, atom_pct, ets_tables, ets_limit, ets_pct, schedulers_online, run_queue, dirty_cpu_run_queue, dirty_io_run_queue, reductions_count, gcs_count, gc_reclaimed_bytes, context_switches_count, received_bytes, sent_bytes, uptime_seconds
run_every   = 1m
max_runtime = 50s
env         = BEAM_PROMETHEUS=
env         = BEAM_DIST=
env         = BEAM_ERLANG=

[job.processes]
metric_name = beam.processes
metrics     = nodes, up, processes_read, processes_not_read, mailbox_messages, mailboxes_over_1000, mailbox, process_memory_bytes, process_reductions_count
cron        = 2/5 * * * *
max_runtime = 4m
env         = BEAM_DIST=
env         = BEAM_ERLANG=

[job.tables]
metric_name = beam.tables
metrics     = nodes, up, tables, objects, memory_bytes, table_memory_bytes, table_objects
cron        = 3/5 * * * *
max_runtime = 2m
env         = BEAM_DIST=
env         = BEAM_ERLANG=

[job.dist]
metric_name = beam.dist
metrics     = nodes, up, peers, hidden_peers, peer, peer_queue_bytes, peers_not_shown, busy_limit_bytes
run_every   = 1m
max_runtime = 50s
env         = BEAM_DIST=
env         = BEAM_ERLANG=

[job.apps]
metric_name = beam.apps
metrics     = nodes, up, apps, app, apps_not_shown
cron        = 11 * * * *
max_runtime = 2m
env         = BEAM_DIST=
env         = BEAM_ERLANG=

[job.crashdumps]
metric_name = beam.crashdumps
metrics     = dumps, dump, age_seconds, newest_age_seconds, dumps_not_shown
cron        = 4/15 * * * *
max_runtime = 2m
env         = BEAM_CRASH_DUMPS=
