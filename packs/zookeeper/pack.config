# zookeeper - Apache ZooKeeper, from its four-letter words: each server up
# and serving, its role, read-only mode, latency, requests waiting, znodes
# and watches, fsync and JVM pauses; the leader's followers in sync; and the
# ensemble: servers serving, and one leader. Linux, macOS and Windows. See
# SPECIFICATION.md section 18.10 for this format.
#
# It only reads: ruok, mntr and isro, on the client port. No login, no
# client: bash alone on Linux and macOS, PowerShell alone on Windows.
#
# Off until enabled: vigil pack enable zookeeper. Then set the job's env
# line, the servers to read:
#   env = ZOOKEEPER_SERVERS=zk1:2181; zk2:2181; zk3:2181
# and allow the words on each server, in zoo.cfg:
#   4lw.commands.whitelist=mntr,ruok,isro
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = ZooKeeper: each server up and serving, leader and followers in sync, read-only mode, latency, requests waiting, znodes, watches and ephemerals, fsync and JVM pauses, elections; the ensemble's servers serving and its one leader
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Apache ZooKeeper 3.8 and 3.9, a server or an ensemble (tested: a 3.9.7 ensemble of three, and 3.8.8)
programs_linux = bash
programs_macos = bash
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/zookeeper/README.md
needs       = each server's client port (2181) reachable from this machine, in plain text (not secureClientPort alone)
needs       = the four-letter words allowed on each server, in zoo.cfg: 4lw.commands.whitelist=mntr,ruok,isro (then restart it)

[job.status]
metric_name = zookeeper
metrics     = servers, servers_up, servers_serving, leaders, up, serving, info, readonly, uptime_seconds, latency_avg_ms, latency_max_ms, connections, outstanding_requests, znodes, watches, ephemerals, data_bytes, fds_open, fds_pct, fsync_max_ms, jvm_pause_max_ms, packets_received_count, packets_sent_count, elections_count, auth_failed_count, throttled_count, errors_count, quorum_size, followers, followers_synced, pending_syncs
run_every   = 1m
max_runtime = 50s
env         = ZOOKEEPER_SERVERS=
