# grafana - a Grafana, from its own metrics page and, for the data
# sources, its API with a read-only token: is it healthy, does every
# data source answer, are its alert rules evaluated, and do their
# notifications get through.
# Linux, macOS and Windows. See SPECIFICATION.md section 18.10 for this
# format, and tools/obs/DESIGN.md.
#
# It only reads: every request is a GET, and it changes nothing on the server.
#
# Off until enabled: vigil pack enable grafana (or one job: vigil pack enable grafana_<job>).
# Each job's settings are its env lines.
#
# Copyright (c) Bankole Ogundero and the Vigil contributors
# SPDX-License-Identifier: Apache-2.0
#
# Provided "AS IS", WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, express or
# implied. Run it at your own risk: review it first, and test it before you
# rely on it. In no event shall the authors or copyright holders be liable
# for any claim, damages or other liability arising from its use. See the
# LICENSE file for the full terms.

[pack]
version     = 1.0.0
# vigil: the oldest Vigil this pack runs on. vigil pack update refuses the
# pack on an older one.
vigil       = 0.3.0
description = Grafana: whether it is healthy (its database too), requests and those that failed, its database connections, whether each data source answers, and its alerting (rules evaluated and failed, alerts by state, notifications sent and failed)
# What vigil pack info shows besides: the servers it is meant for, the
# programs its scripts need on each platform, and where it is explained.
works_with  = Grafana 10 and later (tested: 13.2.5)
programs_linux = bash, awk, curl, jq
programs_macos = bash, awk, curl, jq
programs_windows = PowerShell 5.1 or later
docs        = https://github.com/godspeedhq/vigil/blob/main/packs/grafana/README.md
needs       = its address, where it is not http://localhost:3000: env = GRAFANA_URL=... on each job
needs       = its metrics page, which is on by default ([metrics] enabled); where it asks for a login ([metrics] basic_auth_username): GRAFANA_USER and secret = GRAFANA_PASSWORD=secret:GRAFANA_PASSWORD
needs       = for the datasources job, a service account with the Viewer role and a token for it (Administration, Users and access, Service accounts), kept in Vigil's secret store: vigil secret set GRAFANA_TOKEN. A Viewer may list the data sources and ask each for its health, and change nothing. With no token to give, turn that job off: vigil pack disable grafana_datasources
needs       = for Grafana's CPU and memory: the base pack's processes job

[job.status]
metric_name = grafana
metrics     = up, healthy, version, uptime_seconds, dashboards, users, active_users, alert_rules, datasources, datasources_by_type, datasources_by_type_not_shown, http_requests_count, http_4xx_count, http_5xx_count, requests_in_flight, db_connections, db_connections_in_use, db_connections_max, db_waits_count, plugin_requests_count, plugin_errors_count, plugin_errors, plugin_errors_not_shown, live_clients
run_every   = 1m
max_runtime = 30s
env         = GRAFANA_URL=
env         = GRAFANA_USER=
env         = GRAFANA_CACERT=

[job.alerting]
metric_name = grafana.alerting
metrics     = up, rules, rule_groups, evaluations_count, evaluation_failures_count, evaluation_failures_pct, alerts, alerts_not_shown, alerts_alerting, alerts_error, alerts_nodata, scheduler_behind_seconds, last_tick_seconds, notifications_count, notifications_failed_count, notifications_failed, notifications_failed_not_shown, silences_active, alerts_received_count, alerts_invalid_count
run_every   = 1m
max_runtime = 30s
env         = GRAFANA_URL=
env         = GRAFANA_USER=
env         = GRAFANA_CACERT=

[job.datasources]
metric_name = grafana.datasources
metrics     = up, login_ok, datasource_ok, datasources, datasources_failing, datasources_not_shown
run_every   = 5m
max_runtime = 2m
env         = GRAFANA_URL=
env         = GRAFANA_USER=
env         = GRAFANA_CACERT=
secret      = GRAFANA_TOKEN=secret:GRAFANA_TOKEN
