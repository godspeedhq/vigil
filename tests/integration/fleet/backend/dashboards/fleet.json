{
  "uid": "vigil-fleet",
  "title": "Vigil fleet test",
  "tags": [
    "vigil",
    "fleet"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(vigil_config_info, kind)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Instances reporting",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "Instances whose configuration revision reached Prometheus in the last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (host) (vigil_config_info{kind=~\"$kind\"}))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Waves in use",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "1 when every instance runs the same wave: the fleet has converged.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (wave) (vigil_config_info{kind=~\"$kind\"}))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fetch failures (15m)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "Checks that could not reach or read the configuration's source (reason unreachable, timeout, auth or digest), across the fleet. A refused configuration is counted next door.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vigil_source_failures_total{kind=~\"$kind\", reason!=\"invalid\"}[15m])) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Instances refusing a config",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "Instances that fetched a configuration that does not validate (reason invalid): it is refused, and the instance keeps the one it runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(increase(vigil_source_failures_total{kind=~\"$kind\", reason=\"invalid\"}[2m]) > 0) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Revision changes (15m)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count by (host) (max_over_time(vigil_config_info{kind=~\"$kind\"}[15m])) - 1) or vector(0)"
        }
      ],
      "description": "How many times instances moved to another configuration revision (each instance counts its changes)."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Oldest source check (s)",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "Seconds since the least recent successful check of the configuration's source.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(vigil_source_check_age{kind=~\"$kind\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Instances by wave",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "description": "A change pushed to Git moves the fleet from one wave to the next.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (wave) (max by (host, wave) (vigil_config_info{kind=~\"$kind\"}))",
          "legendFormat": "wave {{wave}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Instances by kind",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (kind) (max by (host, kind) (vigil_config_info{kind=~\"$kind\"}))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Every instance: what it runs now",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host, os, kind, wave, revision) (vigil_config_info{kind=~\"$kind\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "host": 0,
              "os": 1,
              "kind": 2,
              "wave": 3,
              "revision": 4
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Configuration events (from the fleet's own logs)",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "showLabels": false,
        "showCommonLabels": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"vigil\"} | kind=~\"$kind\" |~ \"configuration revision|has errors|ERROR|INVALID|must be\" | line_format \"{{.host}}  {{ __line__ }}\""
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU used %",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_cpu_used_pct{kind=~\"$kind\"}",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memory used %",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_memory_used_pct{kind=~\"$kind\"}",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Spool bytes (unsent metrics)",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "description": "Rises while the backend is out of reach; drains when it is back.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vigil_spool_bytes{kind=~\"$kind\"}",
          "legendFormat": "{{host}}"
        }
      ]
    }
  ]
}
