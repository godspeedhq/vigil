[vigil]
instance = mac-e2e

[scheduler]
tick = 10s

[backend.file]
path = metrics/vigil.prom

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

# pack nginx 1.2.0 for macOS, from packs-2026.11.24.2.
# Its jobs, for a configuration that comes from a source: paste them
# into it. Each env line holds the pack's default: set it for your
# hosts. It runs on Vigil 0.3.0 or later.
# needs its stub_status page, reachable from this machine only: location = /nginx_status { stub_status; allow 127.0.0.1; deny all; }
# needs for the log job, read access to the access log: on Debian and Ubuntu, usermod -aG adm vigil; elsewhere, the log folder's group (packs/nginx/README.md); with rt=$request_time urt=$upstream_response_time at the end of the log_format for response times
# needs for nginx's CPU and memory: the base pack's processes job

# pack nginx: vigil pack disable takes these out

[job.nginx_status]
file = packs/nginx/status.sh
metric_name = nginx
run_every = 1m
max_runtime = 30s
env = NGINX_STATUS_URL=http://127.0.0.1/nginx_status

[job.nginx_server]
file = packs/nginx/server.sh
metric_name = nginx.server
run_every = 1m
max_runtime = 30s
env = NGINX_PID_FILE=/run/nginx.pid
env = NGINX_CONF=/etc/nginx/nginx.conf
env = NGINX_STATUS_URL=http://127.0.0.1/nginx_status

[job.nginx_log]
file = packs/nginx/log.sh
metric_name = nginx.log
run_every = 1m
max_runtime = 50s
env = NGINX_ACCESS_LOG=/var/log/nginx/access.log
env = NGINX_LOG_MAX_MB=32

[job.nginx_tls]
file = packs/nginx/tls.sh
metric_name = nginx.tls
run_every = 15m
max_runtime = 2m
env = NGINX_TLS=localhost:443
env = NGINX_CACERT=
# end of pack nginx
