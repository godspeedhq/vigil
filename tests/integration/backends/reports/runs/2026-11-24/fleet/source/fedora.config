[vigil]
instance = fedora-e2e

[scheduler]
tick = 10s

[backend.file]
path = metrics/vigil.prom

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[secret_store.bao]
type     = hashicorp_vault
url      = https://127.0.0.1:8200
auth     = token
token    = secret:BAO_TOKEN
ca_file  = config/store-ca.pem

# pack postgres 1.2.1 for Linux, as installed here.
# Its jobs, for a configuration that comes from a source: paste them
# into it. Each env line holds the pack's default: set it for your
# hosts. It runs on Vigil 0.3.0 or later.
# needs a read-only role, as a database administrator: CREATE ROLE vigil_monitor LOGIN PASSWORD '...' IN ROLE pg_monitor

# pack postgres: vigil pack disable takes these out

[job.postgres_status]
file = packs/postgres/status.sh
metric_name = postgres
run_every = 1m
max_runtime = 30s
env = PGHOST=127.0.0.1
env = PGPORT=55432
env = PGUSER=vigil_monitor
env = PGDATABASE=postgres
secret = PGPASSWORD=store:bao/POSTGRES_MONITOR_PASSWORD

[job.postgres_size]
file = packs/postgres/size.sh
metric_name = postgres.database
cron = 10/15 * * * *
max_runtime = 1m
env = PGHOST=127.0.0.1
env = PGPORT=55432
env = PGUSER=vigil_monitor
env = PGDATABASE=postgres
secret = PGPASSWORD=store:bao/POSTGRES_MONITOR_PASSWORD

[job.postgres_activity]
file = packs/postgres/activity.sh
metric_name = postgres.activity
run_every = 1m
max_runtime = 30s
env = PGHOST=127.0.0.1
env = PGPORT=55432
env = PGUSER=vigil_monitor
env = PGDATABASE=postgres
secret = PGPASSWORD=store:bao/POSTGRES_MONITOR_PASSWORD

[job.postgres_replication]
file = packs/postgres/replication.sh
metric_name = postgres.replication
run_every = 1m
max_runtime = 30s
env = PGHOST=127.0.0.1
env = PGPORT=55432
env = PGUSER=vigil_monitor
env = PGDATABASE=postgres
secret = PGPASSWORD=store:bao/POSTGRES_MONITOR_PASSWORD

[job.postgres_wraparound]
file = packs/postgres/wraparound.sh
metric_name = postgres.wraparound
cron = 5/15 * * * *
max_runtime = 1m
env = PGHOST=127.0.0.1
env = PGPORT=55432
env = PGUSER=vigil_monitor
env = PGDATABASE=postgres
secret = PGPASSWORD=store:bao/POSTGRES_MONITOR_PASSWORD

[job.postgres_vacuum]
file = packs/postgres/vacuum.sh
metric_name = postgres.vacuum
cron = 0/15 * * * *
max_runtime = 2m
env = PGHOST=127.0.0.1
env = PGPORT=55432
env = PGUSER=vigil_monitor
env = PGDATABASE=postgres
secret = PGPASSWORD=store:bao/POSTGRES_MONITOR_PASSWORD

[job.postgres_io]
file = packs/postgres/io.sh
metric_name = postgres.io
cron = 2/5 * * * *
max_runtime = 30s
env = PGHOST=127.0.0.1
env = PGPORT=55432
env = PGUSER=vigil_monitor
env = PGDATABASE=postgres
secret = PGPASSWORD=store:bao/POSTGRES_MONITOR_PASSWORD
# end of pack postgres
