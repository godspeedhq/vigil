[vigil]
instance = backend-test

[scheduler]
tick = 10s

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[backend.target]
type     = otel
endpoint = http://127.0.0.1:4318/v1/metrics

[log_forward]
destination = target
include     = supervisor, run, stdout, stderr
check_every = 10s

[log_destination.target]
type     = otel
endpoint = http://127.0.0.1:4318/v1/logs

[job.bk_ok]
file = scripts\ok.ps1
run_every = 1m

[job.bk_fail]
file = scripts\fail.ps1
run_every = 1m

[job.bk_long]
file = scripts\long.ps1
run_every = 1m
max_runtime = 55s

[job.bk_overrun]
file = scripts\overrun.ps1
run_every = 1m
max_runtime = 10s
grace = 5s

[job.bk_missing]
file = scripts\missing.ps1
run_every = 1m

[job.bk_output]
file = scripts\output.ps1
run_every = 1m
env = BK_RUN=bk202611032135249088

[job.bk_metrics]
file = scripts\metrics.ps1
run_every = 1m
env = BK_RUN=bk202611032135249088

[job.bk_native]
file = C:\WINDOWS\System32\hostname.exe
run_every = 1m
