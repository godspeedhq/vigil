# A source test fixture: the configuration Vigil fetches from the test SFTP
# server (backlog task 25), version 1. Its script is pinned by SHA-256,
# as an sftp source requires (spec 6.9).

[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.files]
type = sftp
host = 127.0.0.1
port = 2022
user = vigil
path = /files

[job.remote_check]
source    = files
file      = check-v1.ps1
sha256    = 644785cf8e8c8a4ba0ffaef70fa213f1d8c2b2fa8717a2ca43276813836163cd
run_every = 3650d
