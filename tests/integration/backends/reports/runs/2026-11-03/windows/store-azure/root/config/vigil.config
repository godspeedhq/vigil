[vigil]
instance = store-test

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[backend.file]
path = metrics\vigil.prom

[secret_store.az]
type = azure_keyvault
client = http
vault = https://127.0.0.1:4577/vigiltest-keyvault
auth = service_principal
authority = https://127.0.0.1:4577
tenant_id = 00000000-0000-0000-0000-000000000001
client_id = vigil-test
client_secret = env:VIGIL_ST_CLIENT_SECRET
ca_file = config\store-ca.pem

[secret_store.az_untrusted]
type = azure_keyvault
client = http
vault = https://127.0.0.1:4577/vigiltest-keyvault
auth = service_principal
authority = https://127.0.0.1:4577
tenant_id = 00000000-0000-0000-0000-000000000001
client_id = vigil-test
client_secret = env:VIGIL_ST_CLIENT_SECRET

[secret_store.az_bad_secret]
type = azure_keyvault
client = http
vault = https://127.0.0.1:4577/vigiltest-keyvault
auth = service_principal
authority = https://127.0.0.1:4577
tenant_id = 00000000-0000-0000-0000-000000000001
client_id = vigil-test
client_secret = env:VIGIL_ST_BAD_CLIENT_SECRET
ca_file = config\store-ca.pem

[secret_store.az_sp]
type = azure_keyvault
client = http
vault = https://127.0.0.1:4577/vigiltest-keyvault
auth = service_principal
authority = https://127.0.0.1:4577
tenant_id = 00000000-0000-0000-0000-000000000001
client_id = vigil-test
client_secret = env:VIGIL_ST_CLIENT_SECRET
ca_file = config\store-ca.pem

[secret_store.az_mi]
type = azure_keyvault
client = http
vault = https://127.0.0.1:4577/vigiltest-keyvault
auth = managed_identity
ca_file = config\store-ca.pem

[job.bk_sp]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az/vigil-probe
env = BK_SECRET_SHA256=2ecd59ab8ae85f1009d6aac3d6737ab33efb6391a1f07eba5b826c309d9eec29

[job.bk_latest]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az/vigil-versioned
env = BK_SECRET_SHA256=e62e5ae099cbfe8b8872b2c61df287de0814b791a4c77b6f26905b3aa8feec9d

[job.bk_version]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az/vigil-versioned/da6ed373e2f54acb8fe96764b6483ecf
env = BK_SECRET_SHA256=963c06aa4317944499df7b912191716143da075758fc7bbb7cca2b14ab14033c

[job.bk_missing]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az/vigil-nosuch

[job.bk_bad_version]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az/vigil-versioned/0123456789abcdef0123456789abcdef

[job.bk_bad_name]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az/vigil_probe

[job.bk_untrusted]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az_untrusted/vigil-probe

[job.bk_managed_identity]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az_mi/vigil-probe
env = BK_SECRET_SHA256=2ecd59ab8ae85f1009d6aac3d6737ab33efb6391a1f07eba5b826c309d9eec29

[job.bk_rotating]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az/vigil-rotating
env = BK_SECRET_SHA256=123fa35af545673ae04e4dfd97f91547e9beee0a6b109cf57a79ea6ed082a0f4

[job.bk_bad_secret]
file = scripts\secret.ps1
run_every = 3650d
secret = BK_SECRET=store:az_bad_secret/vigil-probe
env = BK_SECRET_SHA256=2ecd59ab8ae85f1009d6aac3d6737ab33efb6391a1f07eba5b826c309d9eec29

