# A source test fixture: the configuration Vigil fetches from the test Gitea
# (backlog task 25), version 1.

[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.scripts]
type = git
url  = https://127.0.0.1:3443/vigil-admin/vigil-sources.git
ref  = v1

[job.remote_check]
source    = scripts
file      = checks/check.ps1
run_every = 3650d
