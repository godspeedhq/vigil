[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics\vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.untrusted]
type        = https
url = https://127.0.0.1:9443/files/
check_every = 1s

[job.check]
source    = untrusted
file      = check-v2.ps1
sha256    = 11eecfa95d36050232bb47d1fad617e88a983a0d0ca14a526c301f7b9be74fe0
run_every = 3650d
