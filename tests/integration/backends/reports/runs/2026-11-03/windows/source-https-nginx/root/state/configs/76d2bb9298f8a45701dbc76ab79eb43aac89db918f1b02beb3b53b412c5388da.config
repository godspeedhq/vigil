[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics\vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.plain]
type        = https
url = http://127.0.0.1:9080/files/
check_every = 1s

[job.check]
source    = plain
file      = check-v1.ps1
sha256    = 644785cf8e8c8a4ba0ffaef70fa213f1d8c2b2fa8717a2ca43276813836163cd
run_every = 3650d
