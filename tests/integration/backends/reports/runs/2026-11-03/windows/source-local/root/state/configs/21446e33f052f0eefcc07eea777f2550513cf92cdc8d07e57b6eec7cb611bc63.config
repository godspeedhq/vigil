[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics\vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.fail2]
type        = local
path        = C:\Users\vigil-test\AppData\Local\Temp\vigil-source.12620\no such dir
check_every = 1s

[job.check]
source    = fail2
file      = check.ps1
sha256    = 644785cf8e8c8a4ba0ffaef70fa213f1d8c2b2fa8717a2ca43276813836163cd
run_every = 3650d
