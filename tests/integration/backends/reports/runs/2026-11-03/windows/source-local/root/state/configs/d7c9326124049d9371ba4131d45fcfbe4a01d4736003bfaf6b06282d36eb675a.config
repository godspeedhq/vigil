[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics\vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.followed]
type        = local
path        = C:\Users\vigil-test\AppData\Local\Temp\vigil-source.12620\a share with spaces
check_every = 1s

[job.check]
source    = followed
file      = check.ps1
run_every = 3650d
