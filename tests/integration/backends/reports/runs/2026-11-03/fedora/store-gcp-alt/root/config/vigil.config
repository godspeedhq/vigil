[vigil]
instance = store-test

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.file]
path = metrics/vigil.prom

[secret_store.gcp]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4598
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY
ca_file = config/store-ca.pem

[secret_store.gcp_other]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4598
auth = service_account_key
project = vigil-other
service_account_key = env:VIGIL_ST_GCP_KEY
ca_file = config/store-ca.pem

[secret_store.gcp_http]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4598
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY_HTTP
ca_file = config/store-ca.pem

[secret_store.gcp_untrusted]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4598
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY

[secret_store.gcp_other_key]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4598
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY_OTHER
ca_file = config/store-ca.pem

[job.bk_key]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-probe
env = BK_SECRET_SHA256=9a42e0401cd7bd08c62326f82eb332a0d3f71be8e7a6dc16a59fb5df17362768

[job.bk_latest]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-versioned
env = BK_SECRET_SHA256=7e3830af61afb5c7d30bdaad7d09219c61e4ac82a9ad0adf8e2f53ef0bb60c0d

[job.bk_version]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-versioned/1
env = BK_SECRET_SHA256=71231e0d9a1816781dcf9594136ddb54dab30e8b570be80efe47a7d77138c310

[job.bk_missing]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-nosuch

[job.bk_bad_version]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-versioned/9999

[job.bk_other_project]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp_other/vigil-probe

[job.bk_http_token_uri]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp_http/vigil-probe

[job.bk_untrusted]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp_untrusted/vigil-probe

[job.bk_rotating]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-rotating
env = BK_SECRET_SHA256=e633febde4f96e800246b88a75ced6e3e07f69cd5111d2135565d4f691228e55

