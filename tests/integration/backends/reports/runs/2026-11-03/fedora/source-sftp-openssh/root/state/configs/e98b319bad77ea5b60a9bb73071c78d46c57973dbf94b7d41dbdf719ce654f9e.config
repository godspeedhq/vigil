# A source test fixture: the configuration Vigil fetches from the test SFTP
# server (backlog task 25), version 1. Its script is pinned by SHA-256,
# as an sftp source requires (spec 6.9).

[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.sh]
command = /bin/sh

[runners]
.sh = sh

[source.files]
type = sftp
host = 127.0.0.1
port = 2022
user = vigil
path = /files

[job.remote_check]
source    = files
file      = check-v1.sh
sha256    = 5bebecfabec36fc36aff72a30213be0479e57d1bb4b45fc00739e4683e7501a1
run_every = 3650d
