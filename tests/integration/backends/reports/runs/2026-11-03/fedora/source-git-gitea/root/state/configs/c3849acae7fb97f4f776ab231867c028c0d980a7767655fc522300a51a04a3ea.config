# A source test fixture: the configuration Vigil fetches from the test Gitea
# (backlog task 25), version 2.

[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.sh]
command = /bin/sh

[runners]
.sh = sh

[source.scripts]
type = git
url  = https://127.0.0.1:3443/vigil-admin/vigil-sources.git
ref  = v2

[job.remote_check]
source    = scripts
file      = checks/check.sh
run_every = 3650d
