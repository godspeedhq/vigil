[vigil]
instance = store-test

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.file]
path = metrics/vigil.prom

[secret_store.gcp]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4588
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY
ca_file = config/store-ca.pem

[secret_store.gcp_other]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4588
auth = service_account_key
project = vigil-other
service_account_key = env:VIGIL_ST_GCP_KEY
ca_file = config/store-ca.pem

[secret_store.gcp_http]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4588
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY_HTTP
ca_file = config/store-ca.pem

[secret_store.gcp_untrusted]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4588
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY

[secret_store.gcp_other_key]
type = gcp_secret_manager
client = http
endpoint = https://127.0.0.1:4588
auth = service_account_key
project = vigil-test
service_account_key = env:VIGIL_ST_GCP_KEY_OTHER
ca_file = config/store-ca.pem

[job.bk_key]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-probe
env = BK_SECRET_SHA256=d4035657fc3a0b6a592561be0209facfa076570625d0cd602f6ed58ec4e5ff36

[job.bk_latest]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-versioned
env = BK_SECRET_SHA256=37f41d462e00b1eaeadcc30ec60fac5b99ebe1879074b2a332823d0aa7766c39

[job.bk_version]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-versioned/1
env = BK_SECRET_SHA256=b99b9eee392a1a8bf49f48c08107fda005a4fb55c95df638262a181d3fb8aa0e

[job.bk_missing]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-nosuch

[job.bk_bad_version]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-versioned/9999

[job.bk_other_project]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp_other/vigil-probe

[job.bk_http_token_uri]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp_http/vigil-probe

[job.bk_untrusted]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp_untrusted/vigil-probe

[job.bk_rotating]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp/vigil-rotating
env = BK_SECRET_SHA256=e79ee7bd2010c20ad46126d50ce025a5ec574d03a20635307fdc0216714c6edb

[job.bk_other_key]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:gcp_other_key/vigil-probe
env = BK_SECRET_SHA256=d4035657fc3a0b6a592561be0209facfa076570625d0cd602f6ed58ec4e5ff36

