[vigil]
instance = store-test

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.file]
path = metrics/vigil.prom

[secret_store.st]
type = hashicorp_vault
url = https://127.0.0.1:8210
auth = approle
role_id = 8fa92b34-b4c5-9179-ab7c-de1269a1b137
secret_id = env:VIGIL_ST_SECRET_ID
ca_file = config/store-ca.pem

[secret_store.st_token]
type = hashicorp_vault
url = https://127.0.0.1:8210
auth = token
token = env:VIGIL_ST_TOKEN
ca_file = config/store-ca.pem

[secret_store.st_untrusted]
type = hashicorp_vault
url = https://127.0.0.1:8210
auth = token
token = env:VIGIL_ST_TOKEN

[secret_store.st_bad_token]
type = hashicorp_vault
url = https://127.0.0.1:8210
auth = token
token = env:VIGIL_ST_BAD_TOKEN
ca_file = config/store-ca.pem

[secret_store.st_expired]
type = hashicorp_vault
url = https://127.0.0.1:8210
auth = token
token = env:VIGIL_ST_EXPIRING_TOKEN
ca_file = config/store-ca.pem

[secret_store.st_bad_secret_id]
type = hashicorp_vault
url = https://127.0.0.1:8210
auth = approle
role_id = 8fa92b34-b4c5-9179-ab7c-de1269a1b137
secret_id = env:VIGIL_ST_BAD_SECRET_ID
ca_file = config/store-ca.pem

[secret_store.st_kv1]
type = hashicorp_vault
url = https://127.0.0.1:8210
mount = kv1
auth = token
token = env:VIGIL_ST_TOKEN
ca_file = config/store-ca.pem

[job.bk_approle]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st/vigil/probe
env = BK_SECRET_SHA256=0ace170b23dc1af4f3210b918527dff3ff0a855f65e2e6f5b404a2fa697646ce

[job.bk_token]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st_token/vigil/probe
env = BK_SECRET_SHA256=0ace170b23dc1af4f3210b918527dff3ff0a855f65e2e6f5b404a2fa697646ce

[job.bk_missing]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st/vigil/nosuch

[job.bk_denied]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st/other/probe

[job.bk_untrusted]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st_untrusted/vigil/probe

[job.bk_bad_token]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st_bad_token/vigil/probe

[job.bk_expired]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st_expired/vigil/probe

[job.bk_bad_secret_id]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st_bad_secret_id/vigil/probe

[job.bk_kv1]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st_kv1/vigil/probe

[job.bk_rotating]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:st/vigil/rotating
env = BK_SECRET_SHA256=d8220fd6a1f47a3a16109a53ee2a0473ffef68e5e21751e5912a9c4cd98bdcc5

