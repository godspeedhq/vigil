[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.sh]
command = /bin/sh

[runners]
.sh = sh

[source.files]
type = local
path = /var/folders/92/4btgbn9d6453tlvqwyrbgqt40000gq/T//vigil-source.jJsEe0/a share with spaces

[job.remote_check]
source    = files
file      = check-v1.sh
sha256    = 5bebecfabec36fc36aff72a30213be0479e57d1bb4b45fc00739e4683e7501a1
run_every = 3650d
