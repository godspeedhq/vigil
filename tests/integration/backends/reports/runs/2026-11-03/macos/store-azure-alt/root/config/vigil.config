[vigil]
instance = store-test

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.file]
path = metrics/vigil.prom

[secret_store.az]
type = azure_keyvault
client = http
vault = https://127.0.0.1:8443
auth = managed_identity
ca_file = config/store-ca.pem

[secret_store.az_untrusted]
type = azure_keyvault
client = http
vault = https://127.0.0.1:8443
auth = managed_identity

[secret_store.az_sp]
type = azure_keyvault
client = http
vault = https://127.0.0.1:8443
auth = service_principal
authority = https://127.0.0.1:8443
tenant_id = 00000000-0000-0000-0000-000000000001
client_id = vigil-test
client_secret = env:VIGIL_ST_CLIENT_SECRET
ca_file = config/store-ca.pem

[secret_store.az_mi]
type = azure_keyvault
client = http
vault = https://127.0.0.1:8443
auth = managed_identity
ca_file = config/store-ca.pem

[job.bk_sp]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az/vigil-probe
env = BK_SECRET_SHA256=0c06e30476b935f1c128964cb719abfb4a88b51316f7a36aab9d9ea5d84eeed9

[job.bk_latest]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az/vigil-versioned
env = BK_SECRET_SHA256=01d4c50d0ba5c832d539c4f81eac5b3b871071be244a304354c56d7ef1e4ddc8

[job.bk_version]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az/vigil-versioned/e9ba147841ec4c88ba70d5cbe2a603ab
env = BK_SECRET_SHA256=25c033e5239d552dd6cc07489a39bae41660ad43291cbfd8295f41602bc96842

[job.bk_missing]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az/vigil-nosuch

[job.bk_bad_version]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az/vigil-versioned/0123456789abcdef0123456789abcdef

[job.bk_bad_name]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az/vigil_probe

[job.bk_untrusted]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az_untrusted/vigil-probe

[job.bk_managed_identity]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az_mi/vigil-probe
env = BK_SECRET_SHA256=0c06e30476b935f1c128964cb719abfb4a88b51316f7a36aab9d9ea5d84eeed9

[job.bk_rotating]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az/vigil-rotating
env = BK_SECRET_SHA256=2e6534969852c931b9c87921a313d342c2fd721059d746063e22cb09b6a3ce0c

[job.bk_sp_alt]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:az_sp/vigil-probe
env = BK_SECRET_SHA256=0c06e30476b935f1c128964cb719abfb4a88b51316f7a36aab9d9ea5d84eeed9

