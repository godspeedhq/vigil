[vigil]
instance = store-test

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.file]
path = metrics/vigil.prom

[secret_store.aws]
type = aws_secrets_manager
client = http
endpoint = https://127.0.0.1:4566
auth = access_keys
access_key_id = AKIAVIGILTEST0000001
region = us-east-1
secret_access_key = env:VIGIL_ST_SECRET_KEY
ca_file = config/store-ca.pem

[secret_store.aws_field]
type = aws_secrets_manager
client = http
endpoint = https://127.0.0.1:4566
auth = access_keys
access_key_id = AKIAVIGILTEST0000001
region = us-east-1
secret_access_key = env:VIGIL_ST_SECRET_KEY
field = password
ca_file = config/store-ca.pem

[secret_store.aws_bad_field]
type = aws_secrets_manager
client = http
endpoint = https://127.0.0.1:4566
auth = access_keys
access_key_id = AKIAVIGILTEST0000001
region = us-east-1
secret_access_key = env:VIGIL_ST_SECRET_KEY
field = nosuch
ca_file = config/store-ca.pem

[secret_store.aws_eu]
type = aws_secrets_manager
client = http
endpoint = https://127.0.0.1:4566
auth = access_keys
access_key_id = AKIAVIGILTEST0000001
region = eu-west-2
secret_access_key = env:VIGIL_ST_SECRET_KEY
ca_file = config/store-ca.pem

[secret_store.aws_untrusted]
type = aws_secrets_manager
client = http
endpoint = https://127.0.0.1:4566
auth = access_keys
access_key_id = AKIAVIGILTEST0000001
region = us-east-1
secret_access_key = env:VIGIL_ST_SECRET_KEY

[secret_store.aws_bad_key]
type = aws_secrets_manager
client = http
endpoint = https://127.0.0.1:4566
auth = access_keys
access_key_id = AKIAVIGILTEST0000001
region = us-east-1
secret_access_key = env:VIGIL_ST_BAD_SECRET_KEY
ca_file = config/store-ca.pem

[job.bk_probe]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws/vigil/probe
env = BK_SECRET_SHA256=a48b2b07812ee5c9207467dd1564e4916cbd4dc34b36649c257807ea156cff4f

[job.bk_field]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws_field/vigil/json
env = BK_SECRET_SHA256=3debeba163cdc39a158a40da23755120686bff6549bd9d68a7ece8ac85a3a5e3

[job.bk_missing]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws/vigil/nosuch

[job.bk_bad_field]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws_bad_field/vigil/json

[job.bk_binary]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws/vigil/binary

[job.bk_other_region]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws_eu/vigil/probe

[job.bk_untrusted]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws_untrusted/vigil/probe

[job.bk_rotating]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws/vigil/rotating
env = BK_SECRET_SHA256=dc0fd1ad124c0c74c48776810ddb865d5d913875796637804904a8a1b919b5e6

[job.bk_bad_key]
file = scripts/secret.sh
run_every = 3650d
secret = BK_SECRET=store:aws_bad_key/vigil/probe
env = BK_SECRET_SHA256=a48b2b07812ee5c9207467dd1564e4916cbd4dc34b36649c257807ea156cff4f

