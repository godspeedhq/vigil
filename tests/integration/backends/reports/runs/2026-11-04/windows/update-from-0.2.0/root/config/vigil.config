# vigil.config - written by vigil init on 2026-11-04 for Windows.
#
# The format and every key: https://godspeedhq.github.io/vigil/spec/06/
# Check it after every change: vigil precheck
#
# Secrets never go in this file. Credentials are references: env:NAME
# (the service environment), secret:NAME (vigil secret set NAME) or
# store:<store>/<name> (an external secret store).

[vigil]
# Names this deployment; becomes the "instance" tag on every metric.
instance = update

[scheduler]
# How often the supervisor wakes to start due jobs.
tick = 1s

# Prometheus text file, for windows_exporter's textfile collector.
[backend.file]
path = metrics\vigil.prom

# Runners: how files are run, by extension. .cmd and .bat need none.
[runner.ps]
command = powershell.exe
arg     = -NoProfile
arg     = -NonInteractive
arg     = -ExecutionPolicy
arg     = Bypass
arg     = -File

# PowerShell 7, for jobs that need it: runner = pwsh in the job.
[runner.pwsh]
command = C:\Program Files\PowerShell\7\pwsh.exe
arg     = -NoProfile
arg     = -NonInteractive
arg     = -File

[runners]
.ps1 = ps

# A sample job: the system drive's use, every 5 minutes.
[job.disk]
metric_name = os.disk
file        = scripts\disk.ps1
run_every   = 5m
max_runtime = 30s

[job.beat]
file      = scripts\beat.cmd
run_every = 2s

[job.long]
file      = scripts\long.cmd
run_every = 3650d
