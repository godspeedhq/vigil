[vigil]
instance = backend-test

[scheduler]
tick = 10s

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.target]
type     = otel
endpoint = http://127.0.0.1:4438/v1/metrics

[job.bk_ok]
file = scripts/ok.sh
run_every = 1m

[job.bk_fail]
file = scripts/fail.sh
run_every = 1m

[job.bk_long]
file = scripts/long.sh
run_every = 1m
max_runtime = 55s

[job.bk_overrun]
file = scripts/overrun.sh
run_every = 1m
max_runtime = 10s
grace = 5s

[job.bk_missing]
file = scripts/missing.sh
run_every = 1m

[job.bk_output]
file = scripts/output.sh
run_every = 1m
env = BK_RUN=bk202611041400332816023

[job.bk_metrics]
file = scripts/metrics.sh
run_every = 1m
env = BK_RUN=bk202611041400332816023

[job.bk_native]
file = /bin/date
run_every = 1m
