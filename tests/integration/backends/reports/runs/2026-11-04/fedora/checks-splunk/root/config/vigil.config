[vigil]
instance = backend-check

[scheduler]
tick = 2s

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.target]
type     = splunk
endpoint = http://127.0.0.1:8088
token    = env:VIGIL_SPLUNK_METRICS_TOKEN

[backend.badtoken]
type     = splunk
endpoint = http://127.0.0.1:8088
token    = env:BK_BAD_TOKEN

[backend.local]
type = file
path = metrics/local.prom

[log_forward]
destination = target
include     = run, stdout, stderr
check_every = 5s

[log_destination.target]
type     = splunk
endpoint = http://127.0.0.1:8088
token    = env:VIGIL_SPLUNK_LOGS_TOKEN

[job.bk_check]
file = scripts/check.sh
run_every = 5s
env = BK_RUN=ck202611041723333500243
env = BK_LEDGER=/tmp/vigil-ck.69X7Hs/ledger

