# vigil.config - written by vigil init on 2026-11-04 for Linux.
#
# The format and every key: https://godspeedhq.github.io/vigil/spec/06/
# Check it after every change: vigil precheck
#
# Secrets never go in this file. Credentials are references: env:NAME
# (the service environment), secret:NAME (vigil secret set NAME) or
# store:<store>/<name> (an external secret store).

[vigil]
# Names this deployment; becomes the "instance" tag on every metric.
instance = update

[scheduler]
# How often the supervisor wakes to start due jobs.
tick = 1s

# Prometheus text file, for node_exporter's textfile collector.
[backend.file]
path = metrics/vigil.prom

# Runners: how files are run, by extension.
[runner.sh]
command = /bin/bash

[runner.py]
command = /usr/bin/python3

[runners]
.sh = sh
.py = py

# A sample job: the root filesystem's use, every 5 minutes.
[job.disk]
metric_name = os.disk
file        = scripts/disk.sh
run_every   = 5m
max_runtime = 30s

[job.beat]
file      = scripts/beat.sh
run_every = 2s

[job.long]
file      = scripts/long.sh
run_every = 3650d
