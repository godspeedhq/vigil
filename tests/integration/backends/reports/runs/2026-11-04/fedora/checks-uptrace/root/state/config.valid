[vigil]
instance = backend-check

[scheduler]
tick = 2s

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.target]
type     = otel
endpoint = http://127.0.0.1:14318/v1/metrics
api_key  = env:VIGIL_UPTRACE_DSN

[backend.badtoken]
type     = otel
endpoint = http://127.0.0.1:14318/v1/metrics
api_key  = env:BK_BAD_DSN

[backend.local]
type = file
path = metrics/local.prom

[log_forward]
destination = target
include     = run, stdout, stderr
check_every = 5s

[log_destination.target]
type     = otel
endpoint = http://127.0.0.1:14318/v1/logs
header_name  = uptrace-dsn
header_value = env:VIGIL_UPTRACE_DSN

[job.bk_check]
file = scripts/check.sh
run_every = 5s
env = BK_RUN=ck202611041810303970843
env = BK_LEDGER=/tmp/vigil-ck.LSvCVv/ledger
env = BK_T0=1793815830

