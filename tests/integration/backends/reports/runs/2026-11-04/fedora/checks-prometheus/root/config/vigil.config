[vigil]
instance = backend-check

[scheduler]
tick = 2s

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.target]
type     = otel
endpoint = http://127.0.0.1:9090/api/v1/otlp/v1/metrics

[backend.local]
type = file
path = metrics/local.prom

[job.bk_check]
file = scripts/check.sh
run_every = 5s
env = BK_RUN=ck202611041038361700975
env = BK_LEDGER=/tmp/vigil-ck.6C9IxD/ledger

