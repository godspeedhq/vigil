[vigil]
instance = backend-test

[scheduler]
tick = 10s

[runner.sh]
command = /bin/bash

[runners]
.sh = sh

[backend.target]
type     = otel
endpoint = http://127.0.0.1:14318/v1/metrics
api_key  = env:VIGIL_UPTRACE_DSN

[log_forward]
destination = target
include     = supervisor, run, stdout, stderr
check_every = 10s

[log_destination.target]
type     = otel
endpoint = http://127.0.0.1:14318/v1/logs
header_name  = uptrace-dsn
header_value = env:VIGIL_UPTRACE_DSN

[job.bk_ok]
file = scripts/ok.sh
run_every = 1m

[job.bk_fail]
file = scripts/fail.sh
run_every = 1m

[job.bk_long]
file = scripts/long.sh
run_every = 1m
max_runtime = 55s

[job.bk_overrun]
file = scripts/overrun.sh
run_every = 1m
max_runtime = 10s
grace = 5s

[job.bk_missing]
file = scripts/missing.sh
run_every = 1m

[job.bk_output]
file = scripts/output.sh
run_every = 1m
env = BK_RUN=bk202611041745173696285

[job.bk_metrics]
file = scripts/metrics.sh
run_every = 1m
env = BK_RUN=bk202611041745173696285

[job.bk_native]
file = /bin/date
run_every = 1m
