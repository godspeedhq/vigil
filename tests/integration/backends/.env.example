# Copy to .env and fill in. .env is never committed (see .gitignore).
# Every value here is for a local test container on 127.0.0.1 only: never
# reuse a real password or token.

# Grafana (standalone, profile grafana). lgtm's own Grafana is admin / admin.
GRAFANA_ADMIN_PASSWORD=change-me

# Splunk Enterprise (profile splunk). Splunk will not start until you have
# read its licence and General Terms and set these two yourself:
#   SPLUNK_START_ARGS=--accept-license
#   SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com
SPLUNK_START_ARGS=
SPLUNK_GENERAL_TERMS=
# At least 8 characters.
SPLUNK_PASSWORD=change-me-please
# Two HEC tokens, each a UUID (uuidgen makes one): one for metrics, one for
# logs, since a metrics token must default to a metrics index.
VIGIL_SPLUNK_METRICS_TOKEN=
VIGIL_SPLUNK_LOGS_TOKEN=

# Elasticsearch and Kibana (profile elastic).
ELASTIC_PASSWORD=change-me-please
KIBANA_PASSWORD=change-me-please

# OpenSearch (profile opensearch). Needs upper and lower case, a digit and a
# symbol, at least 8 characters.
OPENSEARCH_ADMIN_PASSWORD=Change-me-pl3ase!

# InfluxDB 2 (profile influxdb).
INFLUXDB_PASSWORD=change-me-please
INFLUXDB_TOKEN=change-me-to-a-long-random-token

# ClickHouse (profile clickhouse).
CLICKHOUSE_PASSWORD=change-me-please

# Graylog (official deployment, fetched): see configs/upstream.txt and its
# own .env.example, which start.sh copies into place for you to fill in.

# The secret stores (openbao, vault) need nothing here: their credentials
# are made by configs/secrets/provision.sh, in .secrets/.
