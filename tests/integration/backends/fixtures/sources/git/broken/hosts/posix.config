# A source test fixture: a configuration invalid outside any job (a tick
# that is not a duration). Spec 16.3: it is refused as a whole, and the
# configuration Vigil has stays active.

[vigil]
instance = source-test

[scheduler]
tick = soon

[backend.file]
path = metrics/vigil.prom

[runner.sh]
command = /bin/sh

[runners]
.sh = sh

[source.scripts]
type = git
url  = https://127.0.0.1:3443/vigil-admin/vigil-sources.git
ref  = v1

[job.remote_check]
source    = scripts
file      = checks/check.sh
run_every = 3650d
