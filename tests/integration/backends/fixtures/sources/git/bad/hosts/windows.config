# A source test fixture: a configuration with one invalid job (run_every
# with run_at, spec 7.5). Spec 16.3: the job is skipped and shown INVALID,
# and the rest of the configuration is activated.

[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.scripts]
type = git
url  = https://127.0.0.1:3443/vigil-admin/vigil-sources.git
ref  = v1

[job.remote_check]
source    = scripts
file      = checks/check.ps1
run_every = 3650d
run_at    = 06:00
