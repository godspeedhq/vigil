# A source test fixture: the configuration Vigil fetches from the test
# nginx (backlog task 25), version 2. Its script is pinned by SHA-256,
# as an https source requires (spec 6.9).

[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.files]
type = https
url  = https://127.0.0.1:9443/files/

[job.remote_check]
source    = files
file      = check-v2.ps1
sha256    = 11eecfa95d36050232bb47d1fad617e88a983a0d0ca14a526c301f7b9be74fe0
run_every = 3650d
