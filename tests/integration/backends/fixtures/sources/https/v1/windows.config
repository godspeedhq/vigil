# A source test fixture: the configuration Vigil fetches from the test
# nginx (backlog task 25), version 1. Its script is pinned by SHA-256,
# as an https source requires (spec 6.9).

[vigil]
instance = source-test

[scheduler]
tick = 1s

[backend.file]
path = metrics/vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.files]
type = https
url  = https://127.0.0.1:9443/files/

[job.remote_check]
source    = files
file      = check-v1.ps1
sha256    = 644785cf8e8c8a4ba0ffaef70fa213f1d8c2b2fa8717a2ca43276813836163cd
run_every = 3650d
