# A source test fixture: a configuration invalid outside any job (a tick
# that is not a duration). Spec 16.3: it is refused as a whole.

[vigil]
instance = source-test

[scheduler]
tick = soon

[backend.file]
path = metrics/vigil.prom

[runner.ps]
command = powershell.exe
arg = -NoProfile
arg = -NonInteractive
arg = -ExecutionPolicy
arg = Bypass
arg = -File

[runners]
.ps1 = ps

[source.files]
type = https
url  = https://127.0.0.1:9443/files/

[job.remote_check]
source    = files
file      = check-v1.ps1
sha256    = 644785cf8e8c8a4ba0ffaef70fa213f1d8c2b2fa8717a2ca43276813836163cd
run_every = 3650d
