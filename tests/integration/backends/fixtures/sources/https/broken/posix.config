# A source test fixture: a configuration invalid outside any job (a tick
# that is not a duration). Spec 16.3: it is refused as a whole.

[vigil]
instance = source-test

[scheduler]
tick = soon

[backend.file]
path = metrics/vigil.prom

[runner.sh]
command = /bin/sh

[runners]
.sh = sh

[source.files]
type = https
url  = https://127.0.0.1:9443/files/

[job.remote_check]
source    = files
file      = check-v1.sh
sha256    = 5bebecfabec36fc36aff72a30213be0479e57d1bb4b45fc00739e4683e7501a1
run_every = 3650d
