# Caddy for the caddy pack (compose.web.yaml): its admin API open to the
# host's port, its HTTP metrics on, a site with a certificate from its own
# local CA, a route that fails, and a reverse proxy with health checks
# whose third upstream does not exist.
{
    admin 0.0.0.0:2019
    metrics
    local_certs
    skip_install_trust
}
https://shop.test {
    respond /boom 500
    reverse_proxy nginx:80
}
http://:80 {
    handle /noanswer* {
        reverse_proxy 10.255.255.1:81 {
            lb_try_duration 1s
            fail_duration 30s
        }
    }
    handle {
        reverse_proxy nginx:80 httpd:80 gone:80 {
            health_uri /
            health_interval 5s
            lb_try_duration 5s
        }
    }
}
