# List keys: arg order kept; tags merged with [tags] (job value replaces in
# place, new job tags after); env merged with the resolved runner's env;
# require_env combined, each name once. [defaults] backends applies.
[tags]
team = ops
site = lon

[backend.file]
path = metrics/vigil.prom

[backend.splunk]
token = env:SPLUNK_TOKEN

[runner.java]
command     = /usr/bin/java
env         = LANG=C
env         = TZ=UTC
require_env = JAVA_HOME, SHARED

[runners]
.java = java

[defaults]
backends = splunk

[job.export]
file        = jobs/Export.java
run_every   = 1h
arg         = --to
arg         = b
arg         = --from
arg         = a
tag         = region=eu
tag         = team=finance
env         = JAVA_TOOL_OPTIONS=-Xmx1g
env         = TZ=Europe/London
require_env = SHARED, EXPORT_KEY

[job.no_runner]
file      = bin/check
run_every = 1h
env       = A=1
