# Secrets for jobs (spec 6.5.4): merged by name with the runner's, the
# job's value winning; references are shown, never values.
[secret_store.kv]
type  = azure_keyvault
vault = https://kv.vault.azure.net/
auth  = managed_identity

[runner.psql]
command = /usr/bin/psql
secret  = PGPASSWORD=secret:PGPASSWORD
secret  = PGSSLKEY=env:PGSSLKEY

[job.backup]
file      = sql/backup.sql
runner    = psql
run_every = 1h
env       = PGHOST=db01
secret    = PGPASSWORD=store:kv/backup-pg-password
secret    = API_TOKEN=secret:BACKUP_API_TOKEN

[job.plain]
file      = bin/check
run_every = 1h
secret    = TOKEN=env:CHECK_TOKEN
