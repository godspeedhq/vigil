# Single-valued keys: job, then [defaults], then the global section, then
# built-in. Runner: job key, then the extension map (case-insensitive, either
# path separator), then none.
[scheduler]
late_start_window = 20m

[log]
retain_days = 9

[backend.file]
path = metrics/vigil.prom

[backend.off]
type    = file
enabled = false

[backend.datadog]
api_key = env:DD_API_KEY

[runner.psql]
command = /usr/bin/psql

[runner.pg16]
command = /usr/lib/postgresql/16/bin/psql

[runners]
.sql = psql

[defaults]
grace           = 10s
log_retain_days = 30

[job.all_builtin]
file      = checks/disk.sh
run_every = 5m

[job.all_job]
file              = queries\Report.SQL
runner            = pg16
metric_name       = db.report
run_at            = 01:00,13:00
run_on_days       = MON, Wed
max_runtime       = 2h
grace             = 0s
overlap           = queue_one
exit_codes        = 0-7
enabled           = false
on_uncertain      = manual
backends          = datadog,off
late_start_window = 3h
log_retain_days   = 90
working_dir       = queries

[job.mapped]
file      = queries\Nightly.SQL
run_every = 1d
