# Datadog's Series API v2: the default site, another site, and the
# configurations a delivery refuses.
[backend.datadog]
api_key = env:VIGIL_TEST_DD_KEY
timeout = 5s

[backend.datadog_eu]
type     = datadog
endpoint = https://api.datadoghq.eu/
api_key  = env:VIGIL_TEST_DD_KEY

[backend.datadog_nokey]
type = datadog

[backend.datadog_plain]
type     = datadog
endpoint = http://datadog.example.com
api_key  = env:VIGIL_TEST_DD_KEY
