# OTLP/HTTP with JSON: a local collector, a remote one with a bearer token
# and its own CA, the default endpoint, and the endpoints a delivery refuses.
[backend.otel]
endpoint = http://127.0.0.1:4318

[backend.otel_auth]
type     = otel
endpoint = https://collector.example.com/v1/metrics
api_key  = env:VIGIL_TEST_OTEL_TOKEN
ca_file  = /etc/vigil/ca.pem
timeout  = 30s

[backend.otel_default]
type = otel

[backend.otel_creds]
type     = otel
endpoint = https://user:pass@collector.example.com

[backend.otel_remote_http]
type     = otel
endpoint = http://collector.example.com:4318/v1/metrics
