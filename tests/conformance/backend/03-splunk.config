# Splunk's HTTP Event Collector: a bare address, a full URL with its own CA,
# and what a delivery refuses.
[backend.splunk]
endpoint = https://splunk.example.com:8088
token    = env:VIGIL_TEST_HEC_TOKEN
timeout  = 5s

[backend.splunk_full]
type     = splunk
endpoint = https://hec.example.com/custom/path
token    = env:VIGIL_TEST_HEC_TOKEN
ca_file  = /etc/vigil/ca.pem

[backend.splunk_nokey]
type     = splunk
endpoint = https://splunk.example.com:8088

[backend.splunk_noendpoint]
type  = splunk
token = env:VIGIL_TEST_HEC_TOKEN

[backend.splunk_plain]
type     = splunk
endpoint = http://splunk.example.com:8088
token    = env:VIGIL_TEST_HEC_TOKEN
