# A native log destination needs its credential (spec 13.4.1).
[log_forward]
destination = hec

[log_destination.hec]
type     = splunk
endpoint = https://splunk.example.com:8088

[log_destination.dd]
type     = datadog
endpoint = https://http-intake.logs.datadoghq.com

[log_destination.raw]
type     = splunk
endpoint = https://splunk.example.com:8088
token    = a-raw-value

[log_destination.fine]
type     = datadog
endpoint = https://http-intake.logs.datadoghq.com
api_key  = env:DATADOG_API_KEY
