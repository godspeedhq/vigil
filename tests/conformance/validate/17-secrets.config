# Secret references and secret stores (spec 6.5).
[backend.datadog]
api_key = env:DATADOG_API_KEY

[backend.splunk]
token = secret:SPLUNK_HEC_TOKEN

[backend.datadog_eu]
type    = datadog
api_key = store:ops_kv/datadog-eu-api-key

# A raw value (never shown), a malformed secret:, a store: without a name,
# and a store that is not defined.
[backend.raw]
type    = datadog
api_key = 3f9a1c0b
[backend.bad_secret]
type    = datadog
api_key = secret:1bad
[backend.no_name]
type    = datadog
api_key = store:ops_kv/
[backend.no_store]
type    = datadog
api_key = store:nowhere/key

# --- Secret stores ---------------------------------------------------------
[secret_store.ops_kv]
type  = azure_keyvault
vault = https://ops-kv.vault.azure.net/
auth  = managed_identity

[secret_store.hv]
type    = hashicorp_vault
url     = https://vault.example.com:8200
mount   = secret
field   = value
auth    = token
token   = secret:VAULT_TOKEN
timeout = 5s

[secret_store.aws]
type              = aws_secrets_manager
region            = eu-west-2
auth              = access_keys
access_key_id     = env:AWS_ACCESS_KEY_ID
secret_access_key = env:AWS_SECRET_ACCESS_KEY

[secret_store.gcp]
type    = gcp_secret_manager
project = ops-prod
auth    = metadata

[secret_store.ext]
type    = helper
command = /usr/local/bin/get-secret
arg     = --profile
arg     = ops

# A store's own credential from another store; an auth method of another
# type; a key that does not apply; plain http; no type; no required key.
[secret_store.chained]
type          = azure_keyvault
vault         = https://other.vault.azure.net/
auth          = service_principal
tenant_id     = 0000-tenant
client_id     = 0000-client
client_secret = store:ops_kv/sp-secret
[secret_store.bad_auth]
type  = azure_keyvault
vault = https://x.vault.azure.net/
auth  = approle
[secret_store.wrong_key]
type   = helper
command = /bin/get
region = eu-west-2
[secret_store.http]
type = hashicorp_vault
url  = http://vault.example.com
[secret_store.untyped]
url = https://vault.example.com
[secret_store.no_command]
type = helper
[secret_store.bad_type]
type = keychain

# --- Secrets for jobs -------------------------------------------------------
[runner.psql]
command = /usr/bin/psql
secret  = PGPASSWORD=secret:PGPASSWORD

[job.backup]
file      = sql/backup.sql
runner    = psql
run_every = 1h
env       = PGHOST=db01.example.com
secret    = API_TOKEN=store:ops_kv/backup-api-token
secret    = VAULT_ROLE=env:VAULT_ROLE

[job.bad_pair]
file      = a.sh
run_every = 1h
secret    = NOEQUALS

[job.raw_pair]
file      = a.sh
run_every = 1h
secret    = TOKEN=hunter2

[job.both]
file      = a.sh
run_every = 1h
env       = TOKEN=x
secret    = TOKEN=secret:TOKEN

[job.literal]
file      = a.sh
run_every = 1h
env       = TOKEN=secret:TOKEN

[defaults]
secret = TOKEN=secret:TOKEN
