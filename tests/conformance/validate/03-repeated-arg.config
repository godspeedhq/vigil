# Repeated arg keys are a list: valid, order kept (order is checked in
# effective/02-lists-and-merges).
[job.args]
file      = jobs/report.sh
arg       = --from
arg       = 2026-01-01
arg       = --to
arg       = 2026-12-31
arg       = --from
run_every = 1h

[runner.wrapped]
command = /usr/bin/env
arg     = -i
arg     = -i
