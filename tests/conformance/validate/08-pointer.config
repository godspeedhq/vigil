# A pointer file: the whole configuration is fetched from [source.central]
# (spec 6.8). Only state_dir may be set beside it.
[vigil]
config_source = central
config_file   = hosts/db01.config
state_dir     = /var/lib/vigil

[source.central]
type        = git
url         = git@git.example.com:ops/vigil-config.git
ref         = main
check_every = 5m
timeout     = 30s
