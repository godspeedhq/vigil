# Metric names that become the same name in a backend allowing only
# underscores (spec 14.1): dots become underscores there.
[backend.prometheus]
endpoint = https://pushgateway.example.com:9091

[backend.datadog]
api_key = env:DATADOG_API_KEY

[backend.vm_off]
type    = victoriametrics
enabled = false

[job.a]
metric_name = app.queue_depth
file        = a.sh
run_every   = 1m
backends    = prometheus

# The same name as a: not a collision, the job tag tells them apart.
[job.c]
metric_name = app.queue_depth
file        = c.sh
run_every   = 1m
backends    = prometheus

# Collides with a in prometheus: both are app_queue_depth there.
[job.b]
metric_name = app_queue.depth
file        = b.sh
run_every   = 1m
backends    = prometheus, datadog

# Dots are kept in datadog: no collision.
[job.d]
metric_name = app_queue_depth
file        = d.sh
run_every   = 1m
backends    = datadog

# A disabled backend receives nothing: no collision.
[job.e]
metric_name = app_queue_depth
file        = e.sh
run_every   = 1m
backends    = vm_off

# No metric_name, so the job id; no backends, so every enabled backend,
# prometheus included: collides with a.
[job.app_queue_depth]
file      = f.sh
run_every = 1m
