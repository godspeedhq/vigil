# cron (7.10): standard five-field cron and the @ shorthands, nothing else.
[job.ok]
file = checks/a.sh
cron = 5,35 */2 * jan-jun,dec MON-FRI

[job.fields]
file = checks/a.sh
cron = 0 * * *

[job.range]
file = checks/a.sh
cron = 0 24 * * *

[job.step]
file = checks/a.sh
cron = */0 * * * *

[job.name]
file = checks/a.sh
cron = 0 0 * * someday

[job.never]
file = checks/a.sh
cron = 0 0 31 4,6 *

[job.reboot]
file = checks/a.sh
cron = @reboot

[job.quartz]
file = checks/a.sh
cron = 0 0 L * *

[job.both]
file      = checks/a.sh
cron      = @hourly
run_every = 1h

[job.days]
file        = checks/a.sh
cron        = 0 9 * * *
run_on_days = mon

# Both day fields restricted: a warning, since cron then runs on either.
[job.either]
file = checks/a.sh
cron = 0 9 1 * mon

[defaults]
cron = 0 * * * *
