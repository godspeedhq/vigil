# [source.*] sections and jobs using them (spec 6.9, 16.3).

# --- Valid sources, one of each type ----------------------------------------
[source.fleet]
type        = git
url         = https://git.example.com/ops/monitoring.git
ref         = main
config      = fleet/linux-common.config
config      = fleet/db-hosts.config
check_every = 5m

[source.fleet_ssh]
type = git
url  = ssh://git@git.example.com:2222/ops/monitoring.git
ref  = v1.0.0

[source.fleet_scp]
type = git
url  = git@git.example.com:ops/monitoring.git
ref  = 4f2a9c1e

[source.files]
type         = https
url          = https://files.example.com/vigil/
header_name  = Authorization
header_value = env:VIGIL_FILES_AUTH
timeout      = 30s

[source.drop]
type = sftp
host = sftp.example.com
port = 2022
user = vigil
path = /exports/vigil

[source.share]
type = local
path = /mnt/ops-share/vigil

# --- Invalid sources ---------------------------------------------------------
# Unknown type.
[source.bad_type]
type = ftp
path = /srv

# No type.
[source.no_type]
path = /srv

# A git source without ref: reported on the header.
[source.no_ref]
type = git
url  = https://git.example.com/a.git

# url does not apply to a local source.
[source.local_url]
type = local
path = /srv
url  = https://example.com/

# Plain HTTP, credentials in an https URL, git://, a password in an ssh URL.
[source.http]
type = https
url  = http://files.example.com/

[source.https_creds]
type = https
url  = https://user:secret@files.example.com/

[source.git_proto]
type = git
url  = git://git.example.com/a.git
ref  = main

[source.ssh_password]
type = git
url  = ssh://git:secret@git.example.com/a.git
ref  = main

# A raw secret, a port out of range, a config path escaping the source.
[source.raw_header]
type         = https
url          = https://files.example.com/
header_name  = Authorization
header_value = Bearer abc123

[source.bad_port]
type = sftp
host = sftp.example.com
port = 70000
path = /x

[source.escape]
type   = local
path   = /srv
config = ../outside.config

# --- Jobs --------------------------------------------------------------------
# Valid: git with its own ref; https with an uppercase digest (as printed by
# Get-FileHash); sftp with a digest; a local source without a digest warns.
[job.from_git]
source    = fleet
ref       = v2.3.1
file      = checks/posix/inode_usage.sh
run_every = 5m

[job.from_https]
source    = files
file      = checks/cert_expiry.sh
sha256    = 3B7E1F0C9D2A4E6B8C0D1F2A3B4C5D6E7F8091A2B3C4D5E6F708192A3B4C5D6E
run_at    = 07:30

[job.from_sftp]
source    = drop
file      = export_freshness.sh
sha256    = 9f2c4e7a1b3d5f7092a4c6e8f0b1d3f5a7c9e1b3d5f7a9c1e3f5b7d9f1a3c5e7
run_every = 15m

[job.from_share]
source    = share
file      = app/queue_depth.sh
run_every = 1m

# Invalid jobs.
[job.unknown_source]
source    = nowhere
file      = a.sh
run_every = 5m

[job.absolute_file]
source    = fleet
file      = /etc/a.sh
run_every = 5m

[job.windows_file]
source    = fleet
file      = C:\scripts\a.ps1
run_every = 5m

[job.ref_no_source]
file      = scripts/a.sh
ref       = v1
run_every = 5m

[job.ref_https]
source    = files
file      = a.sh
ref       = v1
sha256    = 3b7e1f0c9d2a4e6b8c0d1f2a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e
run_every = 5m

[job.https_no_digest]
source    = files
file      = a.sh
run_every = 5m

[job.short_digest]
source    = drop
file      = a.sh
sha256    = 9f2c4e
run_every = 5m

[defaults]
source = fleet
