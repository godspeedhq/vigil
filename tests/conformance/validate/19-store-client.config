# Secret stores: client chooses the vendor's CLI or Vigil's own HTTPS
# (spec 6.5.3).
[secret_store.kv_cli]
type   = azure_keyvault
vault  = https://ops-kv.vault.azure.net/
auth   = managed_identity
client = cli

[secret_store.aws_cli]
type              = aws_secrets_manager
region            = eu-west-2
auth              = access_keys
access_key_id     = AKIAEXAMPLE
secret_access_key = secret:AWS_SECRET
client            = cli

[secret_store.gcp_auto]
type    = gcp_secret_manager
project = ops-prod
auth    = metadata
client  = auto

[secret_store.gcp_http]
type                = gcp_secret_manager
project             = ops-prod
auth                = service_account_key
service_account_key = secret:GCP_KEY
client              = http

# The CLI would keep a credential on disk; a value not in the list; a
# store type the CLI does not apply to.
[secret_store.kv_sp_cli]
type          = azure_keyvault
vault         = https://ops-kv.vault.azure.net/
auth          = service_principal
tenant_id     = t
client_id     = c
client_secret = secret:SP
client        = cli
[secret_store.gcp_key_cli]
type                = gcp_secret_manager
project             = ops-prod
auth                = service_account_key
service_account_key = secret:GCP_KEY
client              = cli
[secret_store.bad_client]
type   = aws_secrets_manager
region = eu-west-2
auth   = instance_profile
client = sdk
[secret_store.vault_client]
type   = hashicorp_vault
url    = https://vault.example.com
auth   = token
token  = secret:T
client = cli
