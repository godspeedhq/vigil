# Secret stores: the keys each authentication method needs (spec 6.5.3),
# and ca_file and authority.
[secret_store.hv_ok]
type      = hashicorp_vault
url       = https://vault.example.com:8200
auth      = approle
role_id   = 7f1c-role
secret_id = secret:VAULT_SECRET_ID
ca_file   = config/vault-ca.pem

[secret_store.kv_ok]
type          = azure_keyvault
vault         = https://ops-kv.vault.usgovcloudapi.net/
auth          = service_principal
tenant_id     = 0000-tenant
client_id     = 0000-client
client_secret = env:AZURE_CLIENT_SECRET
authority     = https://login.microsoftonline.us

[secret_store.mi_ok]
type      = azure_keyvault
vault     = https://ops-kv.vault.azure.net/
auth      = managed_identity
client_id = 0000-user-assigned

# Missing auth; a token without the token; an approle without its
# secret_id; a service principal without its secret; access keys and a
# service account without theirs.
[secret_store.no_auth]
type = hashicorp_vault
url  = https://vault.example.com
[secret_store.no_token]
type = hashicorp_vault
url  = https://vault.example.com
auth = token
[secret_store.no_secret_id]
type    = hashicorp_vault
url     = https://vault.example.com
auth    = approle
role_id = 7f1c-role
[secret_store.no_client_secret]
type      = azure_keyvault
vault     = https://ops-kv.vault.azure.net/
auth      = service_principal
tenant_id = 0000-tenant
client_id = 0000-client
[secret_store.no_keys]
type          = aws_secrets_manager
region        = eu-west-2
auth          = access_keys
access_key_id = env:AWS_ACCESS_KEY_ID
[secret_store.no_sa_key]
type    = gcp_secret_manager
project = ops-prod
auth    = service_account_key

# ca_file and authority only where they apply; authority must be https.
[secret_store.helper_ca]
type    = helper
command = /bin/get
ca_file = config/ca.pem
[secret_store.vault_authority]
type      = hashicorp_vault
url       = https://vault.example.com
auth      = token
token     = env:VAULT_TOKEN
authority = https://login.example.com
[secret_store.http_authority]
type          = azure_keyvault
vault         = https://ops-kv.vault.azure.net/
auth          = service_principal
tenant_id     = t
client_id     = c
client_secret = env:S
authority     = http://login.example.com

# AWS: field, endpoint and ca_file; endpoint must be https.
[secret_store.aws_ok]
type     = aws_secrets_manager
region   = eu-west-2
auth     = instance_profile
field    = password
endpoint = https://vpce-0abc.secretsmanager.eu-west-2.vpce.amazonaws.com
ca_file  = config/ca.pem
[secret_store.aws_http]
type     = aws_secrets_manager
region   = eu-west-2
auth     = instance_profile
endpoint = http://localhost:4566
