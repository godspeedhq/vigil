# Repeated env and tag keys with distinct names are valid, and the same name
# in different layers ([tags] vs job, runner vs job) is an override, not a
# duplicate.
[tags]
team = ops
site = lon

[runner.java]
command = /usr/bin/java
env     = LANG=C
env     = TZ=UTC

[job.export]
file      = jobs/Export.java
run_every = 1h
tag       = team=finance
tag       = region=eu
env       = LANG=en_GB.UTF-8
env       = JAVA_TOOL_OPTIONS=-Xmx1g
