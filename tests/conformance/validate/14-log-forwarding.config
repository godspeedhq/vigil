# Log forwarding (spec 13.4): every key, valid and invalid destinations,
# and forward_output on jobs and in [defaults].
[log_forward]
enabled        = true
destination    = ops_logs
include        = supervisor, run, stdout, stderr
check_every    = 30s
batch_lines    = 500
batch_kb       = 512
max_pending_mb = 64

[log_destination.ops_logs]
type         = otel
endpoint     = https://collector.example.com:4318/v1/logs
header_name  = Authorization
header_value = env:OTEL_LOGS_AUTH
timeout      = 10s

# A type Vigil does not have yet.
[log_destination.splunk_logs]
type     = splunk
endpoint = https://splunk.example.com:8088/services/collector/event

# Plain HTTP, and credentials in the URL (never shown).
[log_destination.plain]
type     = otel
endpoint = http://collector.example.com/v1/logs

[log_destination.creds]
type     = otel
endpoint = https://user:secret@collector.example.com/v1/logs

# A raw secret, an unknown key, no endpoint.
[log_destination.raw]
type         = otel
endpoint     = https://collector.example.com/v1/logs
header_name  = Authorization
header_value = Bearer abc123

[log_destination.unknown_key]
type     = otel
endpoint = https://collector.example.com/v1/logs
api_key  = env:X

[log_destination.no_endpoint]
type = otel

[defaults]
forward_output = true

[job.quiet]
file           = scripts/secret_report.sh
run_every      = 1h
forward_output = false

[job.bad_flag]
file           = a.sh
run_every      = 1h
forward_output = maybe
