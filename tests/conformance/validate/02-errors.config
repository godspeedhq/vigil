[vigil]
instance = my host
max_concurrent = 0
[scheduler]
tick = 60
[log]
stdout = yes
[tags]
host = x
env = prod
team = a b
[spool]
when_full = block
[defaults]
grace = 0s
run_every = 5m
[runners]
sql = psql
.ps1 = nope
[runner.psql]
arg = -b
env = A=1
env = A=2
env = B=env:SECRET
[backend.datadog]
api_key = abc123
enabled = maybe
[backend.mine]
endpoint = http://x
[backend.off]
type = file
enabled = false
[job.a]
file = a.sh
run_every = 5m
run_at = 01:00
tag = job=x
tag = team=a
tag = team=b
backends = off
[job.b]
file = b.sh
run_on_days = mon, funday
[job.c]
run_at = 25:00, 01:00
exit_codes = 0-7, 9-3
max_runtime = 0m
run_on_days = Mon, TUE
runner = ghost
backends = ghost
[job.vigil_x]
file = x
run_every = 1h
[job.d]
file = d
run_every = 5m
run_every = 10m
tick = 5s
[weird]
x = 1
