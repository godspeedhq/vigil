# The same env or tag name twice in one section is invalid: an error in a
# job makes only that job INVALID; in a runner or [tags] it rejects the file.
[tags]
team = ops
team = dba

[runner.java]
command = /usr/bin/java
env     = LANG=C
env     = LANG=C

[job.tag_twice]
file      = a.sh
run_every = 1h
tag       = team=a
tag       = team=b

[job.env_twice]
file      = b.sh
run_every = 1h
env       = TZ=UTC
env       = TZ=UTC

[job.empty_value_is_still_a_name]
file      = c.sh
run_every = 1h
env       = DEBUG=
env       = DEBUG=1
