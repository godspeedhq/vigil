# A pointer file holding more than where the configuration is (spec 6.8).
# Everything else belongs in the fetched file, so it is rejected here.
[vigil]
config_source = central
config_file   = hosts/db01.config
instance      = db01

[source.central]
type         = https
url          = https://config.example.com/vigil/
header_name  = Authorization
header_value = env:VIGIL_CONFIG_AUTH

[source.scripts]
type = git
url  = https://git.example.com/ops/scripts.git
ref  = v1.0.0

[job.disk]
file      = checks/disk.sh
run_every = 5m

[backend.file]
path = metrics/vigil.prom
