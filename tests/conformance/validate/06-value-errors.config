# Value errors not covered elsewhere, one per job so each is isolated.
[backend.datadog]
api_key = env:1BAD

[job.empty_value]
file      =
run_every = 5m

[job.bad_metric_name]
file        = a.sh
run_every   = 5m
metric_name = app..check

[job.metric_name_with_dash]
file        = a.sh
run_every   = 5m
metric_name = app.disk-usage

[job.env_without_equals]
file      = a.sh
run_every = 5m
env       = JUST_A_NAME

[job.env_bad_name]
file      = a.sh
run_every = 5m
env       = 1ST=x

[job.require_env_bad_name]
file        = a.sh
run_every   = 5m
require_env = GOOD, has-dash

[job.no_schedule]
file = a.sh

[job.empty_list_item]
file      = a.sh
run_at    = 01:00,,02:00
