# Every section and override form, all valid: no records expected.
[vigil]
instance       = sybase-windows
state_dir      = state
max_concurrent = 5

[scheduler]
tick              = 60s
late_start_window = 15m
max_pending       = 20

[log]
dir         = logs
stdout      = true
retain_days = 7
max_file_mb = 50

[tags]
environment = dev

[spool]
dir       = spool
max_mb    = 100
when_full = drop_oldest

[backend.file]
path = metrics/vigil.prom

[backend.datadog_eu]
type    = datadog
api_key = env:DATADOG_EU_API_KEY
timeout = 10s

[runner.java8]
command     = /usr/lib/jvm/java-1.8.0/bin/java
arg         = -jar
env         = LANG=C
require_env = JAVA_HOME

[runners]
.jar = java8

[defaults]
grace             = 0s
overlap           = skip
exit_codes        = standard
on_uncertain      = wait
late_start_window = 30m
log_retain_days   = 14

[job.legacy_export]
file              = jobs/legacy/LegacyExport.jar
runner            = java8
arg               = --since
arg               = 1d
run_at            = 02:00, 14:30
run_on_days       = Mon, wed, FRI
max_runtime       = 2h
late_start_window = 3h
log_retain_days   = 90
working_dir       = jobs/legacy
exit_codes        = 0-7, 9
backends          = file, datadog_eu
tag               = team=finance
tag               = environment=prod
env               = JAVA_TOOL_OPTIONS=-Xmx4g
env               = LANG=en_GB.UTF-8
require_env       = EXPORT_SFTP_PASSWORD, EXPORT_SFTP_USER

[job.disabled_check]
file      = checks/disk.sh
run_every = 5m
enabled   = false
