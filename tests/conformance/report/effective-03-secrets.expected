job.backup
  file              = sql/backup.sql         (job)
  runner            = psql                   (job)
  metric_name       = backup                 (built-in)
  run_every         = 1h                     (job)
  max_runtime       = none                   (built-in)
  grace             = 30s                    (built-in)
  overlap           = skip                   (built-in)
  exit_codes        = standard               (built-in)
  enabled           = true                   (built-in)
  on_uncertain      = wait                   (built-in)
  backends          = none                   (built-in)
  late_start_window = 15m                    (built-in)
  log_retain_days   = 7                      (built-in)
  working_dir       = .                      (built-in)
  env               = PGHOST=db01            (job)
  secret            = PGPASSWORD=store:kv/backup-pg-password (job)
  secret            = PGSSLKEY=env:PGSSLKEY  (runner)
  secret            = API_TOKEN=secret:BACKUP_API_TOKEN (job)
job.plain
  file              = bin/check              (job)
  runner            = none                   (built-in)
  metric_name       = plain                  (built-in)
  run_every         = 1h                     (job)
  max_runtime       = none                   (built-in)
  grace             = 30s                    (built-in)
  overlap           = skip                   (built-in)
  exit_codes        = standard               (built-in)
  enabled           = true                   (built-in)
  on_uncertain      = wait                   (built-in)
  backends          = none                   (built-in)
  late_start_window = 15m                    (built-in)
  log_retain_days   = 7                      (built-in)
  working_dir       = .                      (built-in)
  secret            = TOKEN=env:CHECK_TOKEN  (job)
