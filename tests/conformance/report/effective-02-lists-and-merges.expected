job.export
  file              = jobs/Export.java       (job)
  runner            = java                   (runners)
  arg               = --to                   (job)
  arg               = b                      (job)
  arg               = --from                 (job)
  arg               = a                      (job)
  metric_name       = export                 (built-in)
  run_every         = 1h                     (job)
  max_runtime       = none                   (built-in)
  grace             = 30s                    (built-in)
  overlap           = skip                   (built-in)
  exit_codes        = standard               (built-in)
  enabled           = true                   (built-in)
  on_uncertain      = wait                   (built-in)
  backends          = splunk                 (defaults)
  late_start_window = 15m                    (built-in)
  log_retain_days   = 7                      (built-in)
  working_dir       = .                      (built-in)
  tag               = team=finance           (job)
  tag               = site=lon               (tags)
  tag               = region=eu              (job)
  env               = LANG=C                 (runner)
  env               = TZ=Europe/London       (job)
  env               = JAVA_TOOL_OPTIONS=-Xmx1g (job)
  require_env       = JAVA_HOME              (runner)
  require_env       = SHARED                 (runner)
  require_env       = EXPORT_KEY             (job)
job.no_runner
  file              = bin/check              (job)
  runner            = none                   (built-in)
  metric_name       = no_runner              (built-in)
  run_every         = 1h                     (job)
  max_runtime       = none                   (built-in)
  grace             = 30s                    (built-in)
  overlap           = skip                   (built-in)
  exit_codes        = standard               (built-in)
  enabled           = true                   (built-in)
  on_uncertain      = wait                   (built-in)
  backends          = splunk                 (defaults)
  late_start_window = 15m                    (built-in)
  log_retain_days   = 7                      (built-in)
  working_dir       = .                      (built-in)
  tag               = team=ops               (tags)
  tag               = site=lon               (tags)
  env               = A=1                    (job)
