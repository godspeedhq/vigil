job.legacy_export
  file              = jobs/legacy/LegacyExport.jar (job)
  runner            = java8                  (job)
  arg               = --since                (job)
  arg               = 1d                     (job)
  metric_name       = legacy_export          (built-in)
  run_at            = 02:00, 14:30           (job)
  run_on_days       = mon, wed, fri          (job)
  max_runtime       = 2h                     (job)
  grace             = 0s                     (defaults)
  overlap           = skip                   (defaults)
  exit_codes        = 0-7, 9                 (job)
  enabled           = true                   (built-in)
  on_uncertain      = wait                   (defaults)
  backends          = file, datadog_eu       (job)
  late_start_window = 3h                     (job)
  log_retain_days   = 90                     (job)
  working_dir       = jobs/legacy            (job)
  tag               = environment=prod       (job)
  tag               = team=finance           (job)
  env               = LANG=en_GB.UTF-8       (job)
  env               = JAVA_TOOL_OPTIONS=-Xmx4g (job)
  require_env       = JAVA_HOME              (runner)
  require_env       = EXPORT_SFTP_PASSWORD   (job)
  require_env       = EXPORT_SFTP_USER       (job)
job.disabled_check
  file              = checks/disk.sh         (job)
  runner            = none                   (built-in)
  metric_name       = disabled_check         (built-in)
  run_every         = 5m                     (job)
  max_runtime       = none                   (built-in)
  grace             = 0s                     (defaults)
  overlap           = skip                   (defaults)
  exit_codes        = standard               (defaults)
  enabled           = false                  (job)
  on_uncertain      = manual                 (job)
  backends          = file, datadog_eu       (built-in)
  late_start_window = 30m                    (defaults)
  log_retain_days   = 14                     (defaults)
  working_dir       = .                      (built-in)
  tag               = environment=dev        (tags)
