# Batch targets: cmd.exe parses the command line, so arguments are quoted
# only when needed and any cmd.exe metacharacter makes the job INVALID.
[runner.wrap]
command = C:\tools\run.CMD

[job.batch_safe]
file      = scripts/a.ps1
runner    = wrap
run_every = 5m
arg       = plain
arg       = two words
arg       =

[job.batch_ampersand]
file      = scripts/b.ps1
runner    = wrap
run_every = 5m
arg       = a&b

[job.batch_percent]
file      = scripts/legacy.BAT
run_every = 5m
arg       = %USERNAME%

[job.batch_quote]
file      = scripts/legacy.bat
run_every = 5m
arg       = say "hi"

[job.batch_caret_in_file_path]
file      = odd^dir/x.cmd
run_every = 5m

[job.not_batch_ampersand_is_fine]
file      = scripts/c.exe
run_every = 5m
arg       = a&b
