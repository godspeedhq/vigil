# POSIX: the argument vector is passed as is, so no encoding; paths resolve
# against the root "/opt/vigil".
[runner.psql]
command = /usr/bin/psql
arg     = -X
arg     = -f
arg     = {file}

[runner.local]
command = bin/runner
arg     = --

[job.matrix]
file      = scripts/check.sh
run_every = 5m
arg       = two words
arg       = tab	inside
arg       =
arg       = say "hi"
arg       = $HOME
arg       = *.log
arg       = back\slash

[job.mapped_psql]
file        = sql/q.sql
runner      = psql
run_every   = 5m
working_dir = sql

[job.relative_command]
file        = /srv/x.sh
runner      = local
run_every   = 5m
working_dir = /tmp
