# Path resolution and {file} substitution (platform windows, root
# "C:\Program Files\Vigil"). Forward slashes become backslashes; drive,
# UNC and rooted paths are absolute; a bare command name is left for PATH.
[runner.sqlplus]
command = sqlplus
arg     = -S
arg     = /nolog
arg     = @{file}

[runner.twice]
command = tools/wrap.exe
arg     = --in={file}
arg     = --log={file}.log

[runner.java]
command = C:/Program Files/Java/bin/java.exe

[job.relative_file]
file      = scripts/disk.ps1
run_every = 5m

[job.absolute_forward_slashes]
file        = C:/data/check.exe
run_every   = 5m
working_dir = D:/work

[job.unc]
file      = \\fileserver\vigil\check.exe
run_every = 5m

[job.rooted]
file        = \tools\check.exe
run_every   = 5m
working_dir = logs

[job.substituted]
file      = sql/report.sql
runner    = sqlplus
run_every = 1h

[job.substituted_twice]
file      = in/data.csv
runner    = twice
run_every = 1h
arg       = --verbose

[job.java_path_with_space]
file      = jobs/Export.java
runner    = java
run_every = 1h
