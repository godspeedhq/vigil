# Argument matrix for the Microsoft C runtime encoding (platform windows,
# root "C:\Program Files\Vigil"). Every argument is quoted, so Cygwin never
# expands * or ?. tests/Test-CommandLineRoundTrip.ps1 parses each cmdline
# back with CommandLineToArgvW and compares it with the arg rows.
[runner.echo]
command = C:\tools\echoargs.exe

[job.matrix]
file      = scripts/check.ps1
runner    = echo
run_every = 5m
arg       = plain
arg       = two words
arg       = tab	inside
arg       =
arg       = say "hi"
arg       = C:\path with space\
arg       = C:\trailing\
arg       = a\"b
arg       = a\\"b
arg       = \\server\share
arg       = *.log
arg       = ?
arg       = %PATH%
arg       = a&b|c<d>e^f!
arg       = ""
arg       = \
