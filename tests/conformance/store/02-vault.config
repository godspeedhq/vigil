# HashiCorp Vault, KV version 2 (spec 6.5.3).
[secret_store.hv]
type    = hashicorp_vault
url     = https://vault.example.com:8200/
auth    = token
token   = env:VIGIL_CT_VAULT_TOKEN
timeout = 5s

[secret_store.hv_role]
type      = hashicorp_vault
url       = https://vault.example.com
mount     = kv/ops team
field     = password
auth      = approle
role_id   = role "1"
secret_id = env:VIGIL_CT_SECRET_ID
