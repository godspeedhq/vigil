# AWS Secrets Manager (spec 6.5.3).
[secret_store.aws]
type              = aws_secrets_manager
region            = eu-west-2
auth              = access_keys
access_key_id     = AKIDEXAMPLE
secret_access_key = env:VIGIL_CT_AWS_SECRET

[secret_store.aws_json]
type              = aws_secrets_manager
region            = eu-west-2
auth              = access_keys
access_key_id     = env:VIGIL_CT_AWS_KEY_ID
secret_access_key = env:VIGIL_CT_AWS_SECRET
field             = password
endpoint          = https://vpce-0abc.secretsmanager.eu-west-2.vpce.amazonaws.com:443/
timeout           = 3s

[secret_store.aws_ip]
type   = aws_secrets_manager
region = us-east-1
auth   = instance_profile
