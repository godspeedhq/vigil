# GCP Secret Manager with the instance's service account (spec 6.5.3).
[secret_store.gcp]
type    = gcp_secret_manager
project = ops-prod
auth    = metadata

[secret_store.gcp_psc]
type     = gcp_secret_manager
project  = 123456789012
auth     = metadata
endpoint = https://secretmanager-ops.p.googleapis.com/
timeout  = 3s
