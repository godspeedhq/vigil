# The vendor CLIs: client = auto, cli or http (spec 6.5.3).
[secret_store.kv]
type  = azure_keyvault
vault = https://ops-kv.vault.azure.net/
auth  = managed_identity

[secret_store.kv_cli]
type   = azure_keyvault
vault  = https://ops-kv.vault.azure.net/
auth   = managed_identity
client = cli

[secret_store.kv_sp]
type          = azure_keyvault
vault         = https://ops-kv.vault.azure.net/
auth          = service_principal
tenant_id     = 2222-tenant
client_id     = 3333-client
client_secret = env:VIGIL_CT_SP

[secret_store.aws_keys]
type              = aws_secrets_manager
region            = eu-west-2
auth              = access_keys
access_key_id     = AKIDEXAMPLE
secret_access_key = env:VIGIL_CT_AWS_SECRET
ca_file           = /etc/vigil/ca.pem

[secret_store.aws_role]
type     = aws_secrets_manager
region   = us-east-1
auth     = instance_profile
field    = password
endpoint = https://vpce-0abc.secretsmanager.us-east-1.vpce.amazonaws.com
client   = cli
timeout  = 30s

[secret_store.gcp]
type     = gcp_secret_manager
project  = ops-prod
auth     = metadata
endpoint = https://secretmanager-ops.p.googleapis.com

[secret_store.gcp_http]
type    = gcp_secret_manager
project = ops-prod
auth    = metadata
client  = http
