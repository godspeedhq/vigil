# Azure Key Vault (spec 6.5.3).
[secret_store.kv]
type  = azure_keyvault
vault = https://ops-kv.vault.azure.net/
auth  = managed_identity

[secret_store.kv_user]
type      = azure_keyvault
vault     = https://ops-kv.vault.azure.net
auth      = managed_identity
client_id = 1111-user

[secret_store.kv_sp]
type          = azure_keyvault
vault         = https://gov-kv.vault.usgovcloudapi.net/
auth          = service_principal
tenant_id     = 2222-tenant
client_id     = 3333-client
client_secret = env:VIGIL_CT_CLIENT_SECRET
authority     = https://login.microsoftonline.us/
timeout       = 1m
