# GCP Secret Manager with a service account key (spec 6.5.3). Not run by
# Git Bash or Cygwin, whose Windows openssl cannot read a key from a pipe.
[secret_store.gcp_key]
type                = gcp_secret_manager
project             = ops-prod
auth                = service_account_key
service_account_key = env:VIGIL_CT_GCP_KEY

[secret_store.gcp_bad]
type                = gcp_secret_manager
project             = ops-prod
auth                = service_account_key
service_account_key = env:VIGIL_CT_GCP_BAD
