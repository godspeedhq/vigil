fail timeout
fetch store:aws/prod/db
unenv VIGIL_CT_AWS_SECRET
fetch store:aws/prod/db
unenv VIGIL_CT_AWS_KEY_ID
# The instance's role: IMDSv2 token, role, credentials, then the signed request.
reply 200 AQAEAtoken==
reply 200 vigil-role
reply 200 {"Code":"Success","AccessKeyId":"ASIAINSTANCE","SecretAccessKey":"instance/secret+key","Token":"IQoJb3JpZ2luX2VjE+/session=","Expiration":"2026-10-31T18:00:00Z"}
reply 200 {"SecretString":"from-role"}
