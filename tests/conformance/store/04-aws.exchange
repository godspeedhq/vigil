now 20261031T120000Z
env VIGIL_CT_AWS_SECRET wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY
reply 200 {"ARN":"arn:aws:secretsmanager:eu-west-2:123456789012:secret:prod/db-AbCdEf","Name":"prod/db","SecretString":"pw-1","VersionId":"v1"}
