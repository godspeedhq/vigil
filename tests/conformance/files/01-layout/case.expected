local_disk	file	checks/disk.sh	job
local_disk	runner		built-in
local_disk	metric_name	local_disk	built-in
local_disk	run_every	5m	job
local_disk	max_runtime		built-in
local_disk	grace	10s	defaults
local_disk	overlap	skip	built-in
local_disk	exit_codes	standard	built-in
local_disk	enabled	true	built-in
local_disk	on_uncertain	wait	built-in
local_disk	backends	file, datadog	built-in
local_disk	late_start_window	15m	built-in
local_disk	log_retain_days	7	built-in
local_disk	working_dir	.	built-in
local_disk	tag	team=ops	tags
