# Fetched from the fleet source. Its [defaults] and backend apply to every
# job, wherever the job is defined; backends keep the order of the files.
[defaults]
grace = 10s

[backend.datadog]
api_key = env:DD_API_KEY

[job.pg_connections]
source    = fleet
ref       = v2.3.1
file      = checks/postgres/pg_connections.sh
run_every = 1m
