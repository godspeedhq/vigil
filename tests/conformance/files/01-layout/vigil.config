# The main file: host settings, a source, and a local job.
[vigil]
instance = web01

[tags]
team = ops

[backend.file]
path = metrics/vigil.prom

[source.fleet]
type   = git
url    = https://git.example.com/ops/monitoring.git
ref    = main
config = fleet/db.config

[job.local_disk]
file      = checks/disk.sh
run_every = 5m
