# run_every jobs. Slots are aligned to the Unix epoch (UTC), so 5m means
# :00, :05, :10 ... of every UTC hour.
[scheduler]
tick = 60s

[job.every5]
file      = checks/a.sh
run_every = 5m

[job.every5_queue]
file      = checks/a.sh
run_every = 5m
overlap   = queue_one

[job.strict]
file              = checks/a.sh
run_every         = 5m
late_start_window = 0s

[job.off]
file      = checks/a.sh
run_every = 5m
enabled   = false

[job.hourly]
file      = checks/a.sh
run_every = 1h

[job.hourly_weekdays]
file        = checks/a.sh
run_every   = 1h
run_on_days = mon, tue, wed, thu, fri
