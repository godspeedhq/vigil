# Schedule decisions for run_at jobs (SPECIFICATION.md 7.9).
# Columns as in 01-interval.table, except that cursor, slot and next are local
# wall-clock times with no offset.
# 2026-10-29 is a Thursday. Europe moves to summer time on 2026-03-29
# (02:00 +0100 -> 03:00 +0200) and back on 2026-10-25 (03:00 +0200 -> 02:00 +0100).
#
# job      now                       prev                      cursor               active   decision  slot                 next

# Added at 14:00 with run_at = 20:00: first runs at 20:00 (7.6).
nightly    2026-10-29T14:00:00+0100  -                         -                    -        new       -                    2026-10-29T20:00:00
nightly    2026-10-29T19:59:30+0100  2026-10-29T19:58:30+0100  2026-10-29T14:00:00  -        wait      -                    2026-10-29T20:00:00
nightly    2026-10-29T20:00:30+0100  2026-10-29T19:59:30+0100  2026-10-29T14:00:00  -        run       2026-10-29T20:00:00  2026-10-30T20:00:00
# Missed runs (7.7): back within 15 minutes runs, later is missed.
nightly    2026-10-29T20:10:00+0100  -                         2026-10-28T20:00:00  -        run       2026-10-29T20:00:00  2026-10-30T20:00:00
nightly    2026-10-29T20:16:00+0100  -                         2026-10-28T20:00:00  -        missed    2026-10-29T20:00:00  2026-10-30T20:00:00
# Down for four days: one run for the latest slot, no backlog.
nightly    2026-11-02T20:05:00+0100  -                         2026-10-29T20:00:00  -        run       2026-11-02T20:00:00  2026-11-03T20:00:00
# The clock went back an hour after the run: it does not run again.
nightly    2026-10-29T20:30:00+0100  2026-10-29T21:30:00+0100  2026-10-29T20:00:00  -        wait      -                    2026-10-30T20:00:00

multi      2026-10-29T08:59:00+0000  2026-10-29T08:58:00+0000  2026-10-29T03:00:00  -        wait      -                    2026-10-29T09:00:00
multi      2026-10-29T09:00:20+0000  2026-10-29T08:59:20+0000  2026-10-29T03:00:00  -        run       2026-10-29T09:00:00  2026-10-29T15:00:00
multi      2026-10-29T22:00:00+0000  -                         2026-10-29T15:00:00  -        missed    2026-10-29T21:00:00  2026-10-30T03:00:00

# Days are case-insensitive. Thursday is not listed; Friday is.
weekly     2026-10-29T18:00:30+0000  2026-10-29T17:59:30+0000  2026-10-28T18:00:00  -        wait      -                    2026-10-30T18:00:00
weekly     2026-10-30T18:00:30+0000  2026-10-30T17:59:30+0000  2026-10-28T18:00:00  -        run       2026-10-30T18:00:00  2026-11-01T18:00:00
weekly     2026-10-31T18:00:30+0000  2026-10-31T17:59:30+0000  2026-10-30T18:00:00  running  wait      -                    2026-11-01T18:00:00
weekly     2026-11-01T18:00:30+0000  2026-11-01T17:59:30+0000  2026-10-30T18:00:00  running  skip      2026-11-01T18:00:00  2026-11-02T18:00:00

# Spring forward: 02:30 does not exist on 2026-03-29. It fires at the first
# tick after it, although the local clock says it is 30 minutes old.
dst        2026-03-29T01:59:30+0100  2026-03-29T01:58:30+0100  2026-03-29T01:30:00  -        wait      -                    2026-03-29T02:30:00
dst        2026-03-29T03:00:30+0200  2026-03-29T01:59:30+0100  2026-03-29T01:30:00  -        run       2026-03-29T02:30:00  2026-03-30T01:30:00
# Fall back: 02:30 occurs twice on 2026-10-25 and fires once.
dst        2026-10-25T02:30:20+0200  2026-10-25T02:29:20+0200  2026-10-25T01:30:00  -        run       2026-10-25T02:30:00  2026-10-26T01:30:00
dst        2026-10-25T02:00:10+0100  2026-10-25T02:59:10+0200  2026-10-25T02:30:00  -        wait      -                    2026-10-26T01:30:00
dst        2026-10-25T02:30:20+0100  2026-10-25T02:29:20+0100  2026-10-25T02:30:00  -        wait      -                    2026-10-26T01:30:00

# late_start_window = 1h, from the job.
late       2026-10-29T06:50:00+0000  -                         2026-10-28T06:00:00  -        run       2026-10-29T06:00:00  2026-10-30T06:00:00
late       2026-10-29T07:01:00+0000  -                         2026-10-28T06:00:00  -        missed    2026-10-29T06:00:00  2026-10-30T06:00:00
# The clock jumped forwards three hours while ticking: subject to the window.
late       2026-10-29T09:00:00+0000  2026-10-29T05:59:30+0000  2026-10-28T06:00:00  -        missed    2026-10-29T06:00:00  2026-10-30T06:00:00

# Unknown job.
nojob      2026-10-29T14:00:00+0100  -                         -                    -        error     -                    -
