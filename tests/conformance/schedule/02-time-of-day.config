# run_at jobs. Slots are local wall-clock times.
[scheduler]
tick = 60s

[job.nightly]
file   = checks/a.sh
run_at = 20:00

# Out of order on purpose: slots are taken in time order.
[job.multi]
file   = checks/a.sh
run_at = 21:00, 03:00, 09:00, 15:00

[job.weekly]
file        = checks/a.sh
run_at      = 18:00
run_on_days = MON, Wed, fri, sun

# Times inside the 2026 European daylight-saving transitions.
[job.dst]
file   = checks/a.sh
run_at = 02:30, 01:30

[job.late]
file              = checks/a.sh
run_at            = 06:00
late_start_window = 1h
