# cron jobs (7.10). Slots are local wall-clock times, as for run_at.
[scheduler]
tick = 60s

[job.hourly]
file = checks/a.sh
cron = 0 * * * *

# Every quarter of an hour, 09:00 to 17:45, Monday to Friday.
[job.office]
file = checks/a.sh
cron = */15 9-17 * * 1-5

[job.monthly]
file = checks/a.sh
cron = 0 2 1 * *

# Both day fields restricted: the 1st of the month or any Monday.
[job.either]
file = checks/a.sh
cron = 0 9 1 * mon

# 29 February only: the next one is more than a year away.
[job.leap]
file = checks/a.sh
cron = 0 0 29 2 *

# Names, in any case; day of the month is *, so both must match: Sundays in
# January to March.
[job.names]
file = checks/a.sh
cron = 30 4 * JAN-mar Sun

[job.daily]
file = checks/a.sh
cron = @daily
