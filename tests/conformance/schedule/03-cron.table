# Schedule decisions for cron jobs (SPECIFICATION.md 7.9, 7.10).
# Columns as in 02-time-of-day.table: cursor, slot and next are local
# wall-clock times with no offset. 2026-10-29 is a Thursday.
#
# job      now                       prev                      cursor               active   decision  slot                 next

# Added at 14:00: first runs at its next slot (7.6), then on the hour.
hourly     2026-10-29T14:00:00+0000  -                         -                    -        new       -                    2026-10-29T15:00:00
hourly     2026-10-29T15:00:20+0000  2026-10-29T14:59:20+0000  2026-10-29T14:00:00  -        run       2026-10-29T15:00:00  2026-10-29T16:00:00
# Back after 20 minutes: past the 15-minute late-start window (7.7).
hourly     2026-10-29T16:20:00+0000  -                         2026-10-29T15:00:00  -        missed    2026-10-29T16:00:00  2026-10-29T17:00:00

# The last quarter of a Thursday, then Friday morning; Friday evening waits
# for Monday.
office     2026-10-29T17:45:30+0000  2026-10-29T17:44:30+0000  2026-10-29T17:30:00  -        run       2026-10-29T17:45:00  2026-10-30T09:00:00
office     2026-10-30T18:00:30+0000  2026-10-30T17:59:30+0000  2026-10-30T17:45:00  -        wait      -                    2026-11-02T09:00:00
office     2026-10-30T09:00:10+0000  2026-10-30T08:59:10+0000  2026-10-29T17:45:00  running  skip      2026-10-30T09:00:00  2026-10-30T09:15:00

monthly    2026-10-31T23:00:00+0000  2026-10-31T22:59:00+0000  2026-10-01T02:00:00  -        wait      -                    2026-11-01T02:00:00
monthly    2026-11-01T02:00:30+0000  2026-11-01T01:59:30+0000  2026-10-01T02:00:00  -        run       2026-11-01T02:00:00  2026-12-01T02:00:00

# Friday: not the 1st, not a Monday. Sunday the 1st is; so is Monday the 2nd.
either     2026-10-30T10:00:00+0000  2026-10-30T09:59:00+0000  2026-10-26T09:00:00  -        wait      -                    2026-11-01T09:00:00
either     2026-11-02T09:00:30+0000  2026-11-02T08:59:30+0000  2026-11-01T09:00:00  -        run       2026-11-02T09:00:00  2026-11-09T09:00:00

leap       2026-10-29T12:00:00+0000  -                         -                    -        new       -                    2028-02-29T00:00:00

# 1 January 2027 is a Friday: the first Sunday is the 3rd.
names      2026-10-29T12:00:00+0000  -                         -                    -        new       -                    2027-01-03T04:30:00

daily      2026-10-29T00:00:30+0000  2026-10-28T23:59:30+0000  2026-10-28T00:00:00  -        run       2026-10-29T00:00:00  2026-10-30T00:00:00
