[vigil]
instance = lg

[log_forward]
destination = ops
include     = supervisor, run, stdout

[log_destination.ops]
type     = datadog
endpoint = https://http-intake.logs.datadoghq.com
api_key  = env:DD_KEY

[job.chatty]
file      = scripts/chatty.sh
run_every = 5m

[job.quiet]
file           = scripts/quiet.sh
run_every      = 5m
forward_output = false
