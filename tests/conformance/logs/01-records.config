[vigil]
instance = lg

[log_forward]
destination = ops
include     = supervisor, run, stdout

[log_destination.ops]
type     = otel
endpoint = https://collector.example.com/v1/logs

[job.chatty]
file      = scripts/chatty.sh
run_every = 5m

[job.quiet]
file           = scripts/quiet.sh
run_every      = 5m
forward_output = false
