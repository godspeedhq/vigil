[vigil]
instance = lg

[log_forward]
destination = ops
include     = supervisor, run, stdout

[log_destination.ops]
type     = splunk
endpoint = https://splunk.example.com:8088
token    = env:HEC_TOKEN

[job.chatty]
file      = scripts/chatty.sh
run_every = 5m

[job.quiet]
file           = scripts/quiet.sh
run_every      = 5m
forward_output = false
