# =============================================================================
# vigil.config  -  Linux / macOS  (MOCK - for design review only)
#   TIER: MIXED - local configuration, some scripts fetched
# =============================================================================
#
# Companion to vigil_mock.config (Windows). Same format, same keys, same
# semantics - only runners, paths and a few OS-specific jobs differ.
# One file serves both Linux and macOS. This copy is set up for a Linux
# host: the "Linux only" jobs are enabled and the "macOS only" ones carry
# enabled = false. On a Mac, flip those two groups.
#
# FORMAT RULES
#   Identical parser in Windows PowerShell 5.1 and bash 3.2.
#
#   - One "key = value" per line. Whitespace around "=" is trimmed.
#   - A line starting with "#" or ";" is a comment. There are NO inline
#     comments - "#" inside a value is literal (URLs, regexes, etc.).
#   - No quoting, no escaping, no variable expansion. Values are literal.
#     "~" and "$HOME" are NOT expanded - use absolute or relative paths.
#     One exception: the token {file} inside a runner "arg" (see RUNNERS).
#   - Repeating a key appends to a list (used for "arg" and "env").
#   - Lists inside a single value are comma-separated.
#   - Durations : 30s, 5m, 2h, 7d   (no months - "m" is always minutes)
#   - Times     : HH:MM, 24-hour, local wall-clock time
#   - Days      : mon, tue, wed, thu, fri, sat, sun (case-insensitive)
#   - Relative paths resolve against the install root (the folder that
#     contains config/), e.g. file = scripts/x.sh -> <root>/scripts/x.sh.
#   - ASCII only, LF line endings.
#
# SECRETS
#   Secrets are NEVER written in this file. Every credential value has the
#   form  env:NAME  - the name of an environment variable, not the secret:
#
#     api_key = env:DATADOG_API_KEY     <- correct: names the variable
#     api_key = 3f9a1c...               <- REJECTED at validation
#
#   Credential keys (api_key, token, username, password, *_secret, *_key,
#   header_value, ...) refuse any value that does not start with env:. The
#   rejected value is never echoed in the error message or logs.
#
#   Where the variables come from on this platform:
#     Linux systemd (user or system unit):
#       EnvironmentFile=<install>/vigil.env   (chmod 600, owner = vigil user)
#       A systemd unit does NOT read ~/.bashrc or ~/.profile.
#     macOS launchd (LaunchAgent or LaunchDaemon):
#       EnvironmentVariables dictionary in the plist (chmod 600).
#   Environment changes on Linux/macOS need a service restart.
#
# VALIDATION
#   The whole file is validated before it becomes active. On startup, an
#   invalid file stops Vigil. On reload, an invalid file is rejected and the
#   last known valid configuration stays active (VIGIL-010).
#
# MIXED - LOCAL CONFIGURATION, SOME SCRIPTS FETCHED
#   One Vigil instance, one configuration file: this one. Most jobs run a
#   local script; some fetch theirs from a source (see SOURCES) with
#   "source = <name>". The configuration itself is still entirely here.
#
#   The other two tiers, in their own mocks:
#     simple   : everything local, no sources - see simple/.
#     advanced : this file only points at a configuration kept elsewhere,
#                which Vigil fetches - see advanced/.
#   The configuration is never part local, part remote: it is this file,
#   or the one this file points at. Only scripts can come from elsewhere.
#
#   Vigil checks this file every tick, and each source every check_every.
#   A change is validated as a whole; it becomes active only when it, and
#   every script it names, is present and verified. A broken or unreachable
#   source never replaces a working configuration.
# =============================================================================


# -----------------------------------------------------------------------------
# VIGIL
#   instance       : Name of this deployment. Used in the service name
#                    (systemd: vigil-<instance>, launchd: com.godspeedhq.vigil.
#                    <instance>), the state directory and the "instance" tag.
#   state_dir      : Execution state. Owned by exactly one supervisor.
#   max_concurrent : Global limit on running jobs across ALL jobs.
#                    Default: 5
# -----------------------------------------------------------------------------
[vigil]
instance       = app-posix
state_dir      = state
max_concurrent = 5


# -----------------------------------------------------------------------------
# SCHEDULER
#   tick              : How often the supervisor evaluates jobs. Default: 60s
#   late_start_window : A missed "run_at" still fires if Vigil is back within
#                       this window; otherwise it is skipped (no backlog).
#                       Default: 15m
#   max_pending       : Upper bound on runs waiting for a concurrency slot.
#                       Default: 20
# -----------------------------------------------------------------------------
[scheduler]
tick              = 60s
late_start_window = 15m
max_pending       = 20


# -----------------------------------------------------------------------------
# LOG
#   dir         : Root for all logs. Relative = under the install root, which
#                 keeps a user-mode install entirely inside its own folder.
#                 System mode would typically use /var/log/vigil.
#                   Supervisor : <dir>/supervisor/yyyy-MM-dd.log
#                   Status     : <dir>/supervisor/jobs.log  (rewritten every tick)
#                   Job        : <dir>/jobs/<job id>/yyyy-MM-dd.log
#   stdout      : Also write to stdout (captured by journald / launchd).
#   retain_days : Daily log files older than this are deleted.
#   max_file_mb : A single log file is capped at this size.
# -----------------------------------------------------------------------------
[log]
dir         = logs
stdout      = true
retain_days = 7
max_file_mb = 50


# -----------------------------------------------------------------------------
# TAGS
#   Applied to every metric from every job on this host.
#   Add as many tags as you like. Keys: lowercase letters, digits, "_".
#   Values: any text without spaces. Tags are the same on every metric
#   from this host, so more tags do not mean more data in the backend.
#   Some backends cap tags per metric (Azure Monitor 10, CloudWatch 30,
#   including the automatic ones) - validation warns if exceeded.
#
#   Added automatically - do not declare: host, os, instance, job
#   Also reserved: label, uom, exit_code
#   ("os" is linux or macos, detected at runtime.)
# -----------------------------------------------------------------------------
[tags]
client      = CLIENT
environment = dev
product     = platform
host_type   = app


# -----------------------------------------------------------------------------
# SPOOL
#   Every metric event is written here first; each enabled backend drains it
#   independently. A dead backend never blocks another or the scheduler.
# -----------------------------------------------------------------------------
[spool]
dir       = spool
max_mb    = 100
when_full = drop_oldest


# -----------------------------------------------------------------------------
# BACKENDS
#   [backend.<name>]  The name is free text. "type" defaults to the name.
#
#   Common keys:
#     type     : Backend type. Default: the section name.
#     enabled  : true | false
#     endpoint : Non-secret target URL or host:port.
#     timeout  : Per-request limit. Default: 10s
#     api_key, token, username, password, ... :
#                Credentials. ALWAYS  env:NAME  - never the secret itself.
#
#   Transport: curl. Secrets are handed to curl on stdin (curl -K -), never
#   on the command line, so they never appear in "ps" output. UDP (statsd)
#   uses bash's built-in /dev/udp - no curl, no nc.
#
#   Every type from the Windows mock is available here too (prometheus,
#   graphite, azuremonitor, elasticsearch, opensearch, newrelic,
#   dynatrace ...). A representative set is shown.
# -----------------------------------------------------------------------------

# Local flat file. Prometheus text format.
[backend.file]
enabled = true
format  = prometheus
path    = metrics/vigil.prom

[backend.datadog]
enabled  = true
endpoint = https://api.datadoghq.com
api_key  = env:DATADOG_API_KEY
timeout  = 10s

[backend.otel]
enabled  = true
endpoint = http://otel-collector:4318/v1/metrics
api_key  = env:OTEL_API_KEY
timeout  = 10s

[backend.victoriametrics]
enabled  = true
endpoint = http://victoriametrics:8428/api/v1/import/prometheus
timeout  = 10s

[backend.influxdb]
enabled  = true
endpoint = https://influxdb:8086/api/v2/write?org=ops&bucket=vigil&precision=s
token    = env:INFLUXDB_TOKEN
timeout  = 10s

[backend.splunk]
enabled  = true
endpoint = https://splunk:8088/services/collector/event
token    = env:SPLUNK_HEC_TOKEN
timeout  = 10s

[backend.statsd]
; UDP via bash /dev/udp. dialect = dogstatsd keeps tags.
enabled  = true
endpoint = 127.0.0.1:8125
dialect  = dogstatsd

[backend.cloudwatch]
; On EC2: auth = instance_profile and drop the three credential keys -
; credentials come from IMDSv2, no secret on the host.
; SigV4 signing uses curl --aws-sigv4 (curl 7.75+).
enabled           = true
region            = eu-west-1
namespace         = Vigil
access_key_id     = env:AWS_ACCESS_KEY_ID
secret_access_key = env:AWS_SECRET_ACCESS_KEY
session_token     = env:AWS_SESSION_TOKEN
timeout           = 10s

[backend.gcp]
; On GCE / GKE: token from the metadata server, no secret. Off GCP, a
; service-account key file is signed with openssl - an extra prerequisite
; for this backend only.
enabled = true
project = my-gcp-project
auth    = metadata
timeout = 10s

[backend.webhook]
enabled      = true
endpoint     = https://collector.internal/vigil
header_name  = X-Api-Key
header_value = env:VIGIL_WEBHOOK_KEY
timeout      = 10s

# --- Custom backends ----------------------------------------------------------
# A backend's name is yours; its type says how it talks. When the name is
# not a type, "type" is required. Name them after where the data goes, and
# jobs read naturally: "backends = security_splunk".

# A second Datadog site: the EU account.
[backend.datadog_eu]
type     = datadog
endpoint = https://api.datadoghq.eu
api_key  = env:DATADOG_EU_API_KEY
timeout  = 10s

# The security team's own Splunk index, separate from operations'.
[backend.security_splunk]
type     = splunk
endpoint = https://splunk-sec.example.com:8088/services/collector/event
token    = env:SPLUNK_SECURITY_HEC_TOKEN
timeout  = 10s

# The in-house operations collector: a second webhook with its own auth.
[backend.ops_collector]
type         = webhook
endpoint     = https://ops-collector.example.com/ingest/vigil
header_name  = Authorization
header_value = env:OPS_COLLECTOR_AUTH
timeout      = 15s

# A long-term local archive beside the main file backend, for jobs whose
# history must stay on the host (audit evidence).
[backend.local_archive]
type   = file
format = prometheus
path   = metrics/archive/vigil-archive.prom

# The finance team's Datadog organisation.
[backend.datadog_finance]
type     = datadog
endpoint = https://api.datadoghq.com
api_key  = env:DATADOG_FINANCE_API_KEY
timeout  = 10s

# The DBA team's VictoriaMetrics cluster (vminsert), tenant 7.
[backend.dba_metrics]
type     = victoriametrics
endpoint = https://vminsert.example.com:8480/insert/7/prometheus/api/v1/import/prometheus
username = env:DBA_VM_USERNAME
password = env:DBA_VM_PASSWORD
timeout  = 10s



# -----------------------------------------------------------------------------
# LOG FORWARDING  (optional - off when this section is absent)
#   Sends Vigil's OWN logs to your logging service: the supervisor log and
#   the job logs (what ran, when, how it ended, and - if you ask - what the
#   job printed). Never other logs on this host. Local logs are always
#   written first and stay the authoritative record; a logging service that
#   is down never affects jobs, scheduling or metrics.
#
#   Forwarding runs in its own worker (vigil_logs), separate from the metrics
#   sender, and resumes where it left off after any restart. Records lost to
#   log retention before they could be sent are reported (vigil.logs.gaps),
#   never silently dropped.
#
#   enabled        : true | false. Default true when this section exists,
#                    so forwarding can be switched off keeping its settings.
#   destination    : Required. The [log_destination.*] to send to.
#   include        : What to send, comma-separated:
#                      supervisor  the supervisor log
#                      run         each run's start and end lines, outcome
#                      stdout      what jobs print (opt-in)
#                      stderr      what jobs print to stderr (opt-in)
#                    Default: supervisor, run. Job output is only sent when
#                    named here, and a job can keep its own output local with
#                    "forward_output = false" (see JOBS).
#   check_every    : How often to look for new log lines. Default 30s.
#   batch_lines    : Most lines per request. Default 500.
#   batch_kb       : Most kilobytes per request. Default 512.
#   max_pending_mb : Most unsent data handled in one forwarder run.
#                    Default 64.
#
#   Log destinations are separate from metrics backends: a metrics endpoint
#   is never assumed to accept logs, even for the same product.
# -----------------------------------------------------------------------------
[log_forward]
enabled        = true
destination    = ops_logs
include        = supervisor, run, stdout, stderr
check_every    = 30s
batch_lines    = 500
batch_kb       = 512
max_pending_mb = 64

# An OpenTelemetry collector's OTLP/HTTP logs endpoint. The collector can
# route to Splunk, Datadog, Elasticsearch, Loki or anything else it supports.
#   type         : otel (OTLP/HTTP). Native splunk and datadog types later.
#   endpoint     : https:// only; credentials in the URL are rejected.
#   header_name /
#   header_value : Optional authentication header; header_value is env:NAME.
#   timeout      : Limit for one request. Default 10s.
[log_destination.ops_logs]
type         = otel
endpoint     = https://otel-collector.example.com:4318/v1/logs
header_name  = Authorization
header_value = env:OTEL_LOGS_AUTH
timeout      = 10s

# A second destination, defined but not in use: switching is a one-line
# change to "destination" above. The new destination starts from now; it is
# not sent history.
[log_destination.security_logs]
type     = otel
endpoint = https://otel-security.example.com/v1/logs
timeout  = 15s
# -----------------------------------------------------------------------------
# RUNNERS
#   A job's final command line is:
#     runner.command  runner.arg...  job.file  job.arg...
#   If a runner arg contains {file}, the path goes there instead of the end.
#
#   Which runner a job uses, first match wins:
#     1. The job's own "runner" key.
#     2. The file's extension looked up in [runners].
#     3. No runner - "file" is executed directly. Needs the executable bit
#        (chmod +x) and, for scripts, a "#!" first line. Pre-flight reports
#        a file that is not executable.
#
#   command     : Program to start. Absolute path recommended - a systemd or
#                 launchd service has a minimal PATH (often just
#                 /usr/bin:/bin:/usr/sbin:/sbin), so Homebrew (/opt/homebrew)
#                 and /usr/local tools are NOT found by name.
#   arg         : One argument per line, in order. Repeat the key.
#   env         : NAME=value for the job's process only. Literal, no secrets.
#   require_env : Variables that must exist before any job using this runner
#                 may start. Checked by pre-flight and before every spawn.
#
#   Paths that differ between Linux and macOS are noted per runner.
# -----------------------------------------------------------------------------

# bash. /bin/bash exists on every supported Linux and on macOS (3.2 there -
# scripts meant for both must stay bash 3.2 compatible).
[runner.bash]
command = /bin/bash
arg     = -o
arg     = pipefail

# POSIX sh - for scripts written to the strictest portable subset.
[runner.sh]
command = /bin/sh

# Korn shell, for legacy .ksh scripts from the old cron hub. Not installed
# by default on most distros (package: ksh or mksh) - a job prerequisite.
[runner.ksh]
command = /bin/ksh

# PowerShell 7 - lets teams reuse .ps1 checks written for the Windows fleet.
# A job prerequisite, not a Vigil one.
#   Linux : /usr/bin/pwsh
#   macOS : /usr/local/bin/pwsh
[runner.pwsh]
command = /usr/bin/pwsh
arg     = -NoProfile
arg     = -NonInteractive
arg     = -File

# Python 3. Common on Linux; on macOS /usr/bin/python3 is a stub until the
# Command Line Tools are installed. A job prerequisite.
[runner.python]
command = /usr/bin/python3

# Perl. Still shipped on macOS and almost every Linux distribution.
[runner.perl]
command = /usr/bin/perl

# Java single-file source launch (JDK 11+).
#   Linux : /usr/bin/java (alternatives symlink)
#   macOS : /usr/bin/java is a stub that finds the installed JDK
[runner.java]
command = /usr/bin/java

# Legacy Java 8 for one job (see job.legacy_export). Runs a jar, since
# Java 8 cannot launch .java source. Jobs opt in with "runner = java8".
#   Linux : /usr/lib/jvm/java-1.8.0/bin/java (Fedora/RHEL path)
#   macOS : /Library/Java/JavaVirtualMachines/<jdk8>/Contents/Home/bin/java
[runner.java8]
command = /usr/lib/jvm/java-1.8.0/bin/java
arg     = -jar

# HTTP checks: the job file is a curl config file. curl is a Vigil
# prerequisite, so this runner works on every host.
#   --fail      Exit 22 on HTTP status >= 400.
#   --max-time  Per-request limit (exit 28); keep below the job's max_runtime.
[runner.curl]
command = /usr/bin/curl
arg     = --silent
arg     = --show-error
arg     = --fail
arg     = --max-time
arg     = 10
arg     = --config

# The database fleet's SQL client, behind a wrapper. runners/dbsql.sh finds
# the client, connects to DB_SERVER with the credentials from the
# environment (so the password never appears on a command line), runs the
# .sql file and exits 1 when the client reports an SQL error (some clients
# exit 0 on SQL errors).
[runner.dbsql]
command     = /bin/bash
arg         = runners/dbsql.sh
require_env = DB_DBA_USER, DB_DBA_PASSWORD, DB_SERVER

# PostgreSQL via psql.
#   -X -w -q -t -A    No psqlrc, never prompt, quiet, tuples only, unaligned.
#   ON_ERROR_STOP=1   Exit 3 on the first SQL error.
#   Password from ~/.pgpass of the user Vigil runs as (chmod 600).
#   Linux : /usr/bin/psql
#   macOS : /opt/homebrew/bin/psql (Apple silicon) or /usr/local/bin/psql
[runner.psql]
command = /usr/bin/psql
arg     = -X
arg     = -w
arg     = -q
arg     = -t
arg     = -A
arg     = -v
arg     = ON_ERROR_STOP=1
arg     = -h
arg     = localhost
arg     = -U
arg     = vigil_monitor
arg     = -d
arg     = postgres
arg     = -f

# MySQL / MariaDB. --defaults-extra-file MUST be the first argument; the
# option file holds user + password (chmod 600, owned by the Vigil user).
# mysql reads scripts from stdin, so {file} goes inside --execute.
[runner.mysql]
command = /usr/bin/mysql
arg     = --defaults-extra-file=/etc/vigil/mysql-monitor.cnf
arg     = --batch
arg     = --skip-column-names
arg     = --execute=source {file}

# Microsoft SQL Server on Linux/macOS via mssql-tools18.
#   -b         Exit non-zero on SQL errors.
#   -h -1 -W   No headers, trimmed.
#   -C         Trust the server certificate (ODBC 18 encrypts by default);
#              drop it once the server has a CA-signed certificate.
#   No integrated auth here: SQL auth with -U, password read by sqlcmd from
#   SQLCMDPASSWORD - never on the command line.
[runner.sqlcmd]
command     = /opt/mssql-tools18/bin/sqlcmd
arg         = -S
arg         = localhost
arg         = -U
arg         = vigil_monitor
arg         = -C
arg         = -b
arg         = -h
arg         = -1
arg         = -W
arg         = -i
require_env = SQLCMDPASSWORD

# Oracle via SQL*Plus (Instant Client) with an Oracle Wallet - no password.
# Scripts must start with WHENEVER SQLERROR EXIT FAILURE and end with EXIT,
# or sqlplus waits on stdin forever.
[runner.sqlplus]
command = /opt/oracle/instantclient_21_13/sqlplus
arg     = -S
arg     = -L
arg     = /@PRODDB
arg     = @{file}
env     = TNS_ADMIN=/opt/oracle/network/admin

# Extension -> runner map. One runner per extension; .sql maps to psql on
# this host and the other databases set "runner" explicitly.
[runners]
.sh   = bash
.bash = bash
.ksh  = ksh
.ps1  = pwsh
.py   = python
.pl   = perl
.java = java
.curl = curl
.sql  = psql


# -----------------------------------------------------------------------------
# SOURCES  (optional - with none, everything is local)
#   Places Vigil fetches scripts from (and, for a pointer file, the
#   configuration - see the top of this file). Fetched files are cached
#   under <root>/cache/ and jobs always run the cached copy, never a live
#   remote file. Nothing is activated until every file the configuration
#   needs has been fetched and verified; on any failure the last valid
#   configuration keeps running, even across a restart. Fetching runs in
#   its own worker (vigil_fetch), so a slow or unreachable source never
#   delays scheduling.
#
#   type         : local | git | https | sftp
#   check_every  : How often the source is checked for changes. Default 5m.
#   timeout      : Limit for one fetch. Default 60s.
#
#   git   : url (https://, ssh:// or user@host:path), ref (tag, commit or
#           branch). Needs the git client - only on hosts that use a git
#           source. Credentials come from the service account's SSH key or
#           git credential helper, never from this file. Nothing is checked
#           out, so repository hooks never run.
#   https : url (https:// only), optional header_name / header_value
#           (header_value is a credential: env:NAME).
#   sftp  : host, port (default 22), user, path. SSH key authentication
#           only; the server's host key must already be in the service
#           account's known_hosts.
#   local : path - a directory or mounted network share. Files are copied
#           into the cache, so a job never runs from a share that may
#           change or vanish under it.
#
#   A job uses a fetched script with "source = <name>"; "file" is then a
#   path inside the source. The VERSION lives on the source, never on the
#   job - upgrading every job from a source is one change to its ref:
#     git         : ref. A tag or commit is fixed; a branch follows the
#                   branch (picked up every check_every) and is reported as
#                   unpinned unless the job sets sha256.
#     https, sftp : sha256 = <64 hex digits> on the job, required.
#     local       : sha256 on the job recommended; without it, changes in
#                   the folder are picked up and it is reported as unpinned.
#   To run two versions side by side, define two sources (see git_trial).
#   A job's sha256 always wins: changed content is rejected and the last
#   verified copy keeps running until the digest is updated.
# -----------------------------------------------------------------------------

# The monitoring repository at the fleet's current release.
[source.fleet]
type        = git
url         = https://git.example.com/ops/monitoring.git
ref         = v2.3.1
check_every = 5m

# Single scripts published on an internal HTTPS file server.
[source.files]
type         = https
url          = https://files.example.com/vigil/
header_name  = Authorization
header_value = env:VIGIL_FILES_AUTH
timeout      = 30s

# The DBA team's script drop on an SFTP server.
[source.dba_sftp]
type = sftp
host = sftp.example.com
user = vigil
path = /exports/vigil/scripts

# A read-only NFS share with team scripts.
[source.team_share]
type = local
path = /mnt/ops-share/vigil

# --- Every source shape -------------------------------------------------------
# Name sources after what they are; jobs then read naturally:
# "source = git", "source = sftp", "source = share".

# Git over HTTPS at a release tag - the recommended form.
[source.git]
type = git
url  = https://git.example.com/ops/monitoring.git
ref  = v1.4.0

# The same repository following its main branch: merged changes reach this
# host within check_every. Reported as unpinned when fetched; fine for a
# test host, not for production.
[source.git_main]
type        = git
url         = https://git.example.com/ops/monitoring.git
ref         = main
check_every = 2m

# A release candidate, for trialling on one job while the rest stay on
# v1.4.0 through [source.git].
[source.git_trial]
type = git
url  = https://git.example.com/ops/monitoring.git
ref  = v1.5.0-rc1

# Git over SSH, scp-style address - the usual form with SSH keys. The key is
# the service account's (~/.ssh of the vigil user), never this file.
[source.git_ssh]
type = git
url  = git@git.example.com:ops/monitoring.git
ref  = v1.4.0

# The legacy jar repository over SSH, at its own release.
[source.legacy_jars]
type = git
url  = git@git.example.com:finance/legacy-export.git
ref  = v2.0.3

# Git over SSH on a non-standard port needs the ssh:// form. Pinned to a tag
# at source level; checked less often, with a longer limit for a slow link.
[source.git_ssh_port]
type        = git
url         = ssh://git@git.example.com:2222/ops/monitoring.git
ref         = v1.4.0
check_every = 15m
timeout     = 2m

# Git pinned to one full commit id: the strictest pin.
[source.git_pinned]
type = git
url  = https://git.example.com/ops/legacy-checks.git
ref  = 4f2a9c1e7b3d5a60f8e2c4b6d8a0f1e3c5b7d9a2

# SFTP on the default port 22, with a login name.
[source.sftp]
type = sftp
host = sftp.example.com
user = vigil
path = /exports/vigil

# SFTP on a custom port. No user: the service account's own name is used.
[source.sftp_port]
type = sftp
host = sftp2.example.com
port = 2022
path = /srv/vigil/scripts

# An NFS or SMB share mounted on this host.
[source.share]
type = local
path = /mnt/ops-share/vigil

# A local folder that another tool fills (a deployment agent, a package).
# Copied into the cache like a share, so a half-finished copy by that tool
# is never run. Relative paths resolve against the install root.
[source.staging]
type = local
path = staging/checks

# Public HTTPS: no authentication header.
[source.public_https]
type = https
url  = https://downloads.example.com/vigil-checks/

# -----------------------------------------------------------------------------
# DEFAULTS
#   max_runtime : Optional. Omit it and the job runs until it finishes.
#                 Checked each tick; on expiry the job's process group gets
#                 TERM, then KILL after "grace". Not enforced while the
#                 supervisor is down.
#   grace       : Time between TERM and KILL.
#   overlap     : skip | queue_one
#   exit_codes  : standard | nagios | <list>, e.g. "0,24" for rsync
#
#   Also allowed here: on_uncertain, backends, enabled, working_dir,
#   late_start_window, log_retain_days, forward_output.
#   Not allowed here (job-only): file, source, sha256, arg,
#   metric_name, run_every, run_at, run_on_days, runner, tag, env,
#   require_env.
#   Precedence: the job, then [defaults] (or the global section it
#   overrides), then the built-in default. "vigil precheck <job>" shows it.
# -----------------------------------------------------------------------------
[defaults]
grace      = 30s
overlap    = skip
exit_codes = standard


# =============================================================================
# JOBS
#
#   [job.<id>]   The id names the state file, the log folder and the "job" tag.
#
#   file        : Required. Script or executable.
#                 Without "source": a local path; relative = from the root.
#                 With "source": a path inside that source, "/" separators,
#                 no ".." - e.g. checks/posix/disk.sh.
#   source      : Optional. [source.*] the script is fetched from (see
#                 SOURCES). Omit it and the script is local. Vigil runs the
#                 cached copy, never the remote file directly. The version
#                 is the source's ref - a job never sets one.
#   sha256      : SHA-256 of the script, 64 hex digits (sha256sum, or
#                 shasum -a 256 on macOS). Required for https and sftp
#                 sources; optional for git; recommended for local.
#
#                   Local script               Script from a source
#                   [job.disk]                 [job.disk]
#                   file = checks/posix/x.sh   source = fleet
#                   run_every = 5m             file   = checks/posix/x.sh
#                                              run_every = 5m
#   runner      : Optional. Overrides the [runners] map.
#   arg         : Optional. Extra argument after "file". Repeat per argument.
#   metric_name : Optional. Base metric name; defaults to the job id.
#   max_runtime : Optional. No key = no limit.
#   enabled     : Optional. false = not scheduled, shown as DISABLED.
#   backends    : Optional. Comma-separated [backend.<name>] names.
#                 Default: every enabled backend.
#
#   Per-job overrides (all optional):
#   tag               : key=value, repeat per tag; merged with [tags].
#   env               : NAME=value, repeat; literal, never a secret; merged
#                       with the runner's env (job wins).
#   require_env       : Comma-separated; added to the runner's require_env.
#   late_start_window : Overrides [scheduler] late_start_window.
#   log_retain_days   : Overrides [log] retain_days for this job's log.
#   forward_output    : false keeps this job's stdout and stderr out of log
#                       forwarding (see LOG FORWARDING). Default true.
#   working_dir       : Working directory of the job. Default: install root.
#
#   Schedule - exactly one of run_every / run_at, optionally + run_on_days.
#
#   Stdout lines of the form   metric <name> <value> [key=value ...]
#   are posted as <metric_name>.<name> with the job's tags.
#
#   Nagios checks: jobs with exit_codes = nagios also have the numbers a
#   Nagios check prints after "|" turned into metrics automatically:
#     <metric_name>.perf  value  label=<the check's label>
#   plus .warn / .crit / .min / .max when present. Units are converted
#   (ms -> seconds, MB -> bytes). Nothing to configure.
#
#   Smallest useful job:
#     [job.disk_usage]
#     file      = checks/posix/disk_usage.sh
#     run_every = 5m
# =============================================================================


# --- Host basics (Linux and macOS) -------------------------------------------

# METRIC  : os.disk
# Unit    : percent used, per mount
# Desc    : "df -P" (POSIX output format, identical on GNU and BSD), skipping
#           pseudo filesystems (tmpfs, devfs, overlay, ...).
# Stdout  : metric used_pct <n> mount=<path>
# Alerts  : .used_pct > 80             -> WARN
#           .used_pct > 90             -> CRITICAL
[job.disk_usage]
metric_name = os.disk
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s

# METRIC  : os.memory
# Unit    : percent used
# Desc    : One script, two sources: /proc/meminfo on Linux, vm_stat +
#           sysctl hw.memsize on macOS, chosen with "uname -s".
# Stdout  : metric used_pct <n>
#           metric swap_used_pct <n>
# Alerts  : .used_pct > 90             -> WARN
[job.memory]
metric_name = os.memory
file        = checks/posix/memory.sh
run_every   = 1m
max_runtime = 15s

# METRIC  : os.load
# Unit    : load average / CPU count
# Desc    : uptime-derived load averages normalised by CPU count
#           (nproc on Linux, sysctl -n hw.ncpu on macOS).
# Stdout  : metric load1_per_cpu <n>
#           metric load15_per_cpu <n>
# Alerts  : .load15_per_cpu > 1.5      -> WARN: sustained saturation
[job.load]
metric_name = os.load
file        = checks/posix/load.sh
run_every   = 1m
max_runtime = 15s

# METRIC  : net.tcp_port
# Unit    : seconds (connect time)
# Desc    : The SAME script the Windows mock runs under Cygwin. bash's
#           /dev/tcp - no nc, no telnet. Host and port as job args.
# Exit    : nagios - 0 open, 2 refused / timed out
[job.db_listener]
metric_name = net.tcp_port
file        = checks/posix/tcp_port.sh
arg         = db01.internal
arg         = 5432
run_every   = 1m
max_runtime = 15s
exit_codes  = nagios


# --- Linux only --------------------------------------------------------------

# METRIC  : linux.systemd
# Unit    : count of failed units
# Desc    : "systemctl --failed --no-legend" - catches services that died
#           and were not restarted.
# Stdout  : metric failed_units <n>
#           metric failed <1> unit=<name>    (one line per failed unit)
# Alerts  : .failed_units > 0          -> WARN
[job.systemd_failed]
metric_name = linux.systemd
file        = checks/linux/systemd_failed.sh
run_every   = 5m
max_runtime = 30s

# METRIC  : linux.journal
# Unit    : count of priority err..emerg entries in the last 15 minutes
# Desc    : journalctl -p err --since "-15m" -o json, grouped by unit.
#           Reading the system journal needs the Vigil user in the
#           systemd-journal (or adm) group.
# Stdout  : metric errors <n> unit=<name>
# Alerts  : .errors anomaly            -> WARN
# backends = file: high-volume, kept local only.
[job.journal_errors]
metric_name = linux.journal
file        = checks/linux/journal_errors.sh
run_every   = 15m
max_runtime = 2m
backends    = file

# METRIC  : nagios.disk
# Unit    : Nagios status
# Desc    : An existing Nagios plugin, run unmodified - direct executable,
#           no runner. Package: monitoring-plugins (Debian/Ubuntu) or
#           nagios-plugins-disk (RHEL, path /usr/lib64/nagios/plugins).
# Output  : DISK OK - free space: / 7800 MB (40%) | /=11700MB;15600;17550;0;19500
# Metrics : The numbers after "|" become metrics automatically:
#             nagios.disk.perf      = 12268339200  label=/   (MB -> bytes)
#             nagios.disk.perf.warn = 16357785600  label=/
#             nagios.disk.perf.crit = 18402508800  label=/
#             nagios.disk.perf.min  = 0            label=/
#             nagios.disk.perf.max  = 20447232000  label=/
# Exit    : nagios - 0 OK, 1 WARNING, 2 CRITICAL, 3 UNKNOWN
[job.nagios_check_disk]
metric_name = nagios.disk
file        = /usr/lib/nagios/plugins/check_disk
arg         = -w
arg         = 20%
arg         = -c
arg         = 10%
arg         = -p
arg         = /
run_every   = 5m
max_runtime = 30s
exit_codes  = nagios

# METRIC  : nagios.ping
# Desc    : Round-trip time and packet loss to a host, via the standard
#           Nagios check_ping.
# Output  : PING OK - Packet loss = 0%, RTA = 0.80 ms
#           | rta=0.800000ms;100.000000;500.000000;0.000000 pl=0%;20;60;0
# Metrics : nagios.ping.perf = 0.0008  label=rta   (ms -> seconds)
#           nagios.ping.perf = 0       label=pl    (packet loss %)
#           plus .warn / .crit / .min for each
[job.nagios_check_ping]
metric_name = nagios.ping
file        = /usr/lib/nagios/plugins/check_ping
arg         = -H
arg         = gateway.internal
arg         = -w
arg         = 100,20%
arg         = -c
arg         = 500,60%
run_every   = 1m
max_runtime = 30s
exit_codes  = nagios


# --- macOS only --------------------------------------------------------------

# METRIC  : macos.time_machine
# Unit    : hours since the last completed backup
# Desc    : "tmutil latestbackup" + the backup's timestamp. macOS only;
#           disabled here because this file is deployed to Linux hosts too -
#           a macOS-only config would set enabled = true.
# Stdout  : metric hours_since_backup <n>
# Alerts  : .hours_since_backup > 26   -> WARN
[job.time_machine]
metric_name = macos.time_machine
file        = checks/macos/time_machine.sh
run_every   = 1h
max_runtime = 1m
enabled     = false


# --- Databases ---------------------------------------------------------------

# METRIC  : db.backup_log
# Desc    : The database jobs from the Windows mock, on a Linux host. The
#           same .sql files, run through runners/dbsql.sh instead of
#           runners\dbsql.ps1. Only one shown; the rest follow the same shape.
# Timeout : 5m - a blocked log backup usually means a full log volume.
[job.backup_log]
metric_name = db.backup_log
runner      = dbsql
file        = sql/backup_log.sql
run_every   = 1m
max_runtime = 5m

# METRIC  : postgres.replication
# Unit    : seconds behind primary; percent of max_connections used
# Desc    : .sql is mapped to psql on this host, so no runner line.
# Stdout  : metric lag_seconds <n>
#           metric connections_used_pct <n>
# Alerts  : .lag_seconds > 60 WARN, > 300 CRITICAL
[job.pg_replication]
metric_name = postgres.replication
file        = checks/sql/pg_replication_lag.sql
run_every   = 1m
max_runtime = 30s

# METRIC  : mysql.status
# Stdout  : metric threads_connected <n>, threads_running, slow_queries,
#           aborted_connects
# Alerts  : .threads_running > 50      -> WARN
[job.mysql_status]
metric_name = mysql.status
runner      = mysql
file        = checks/sql/mysql_status.sql
run_every   = 1m
max_runtime = 30s

# METRIC  : mssql.backup_age
# Desc    : The same .sql as the Windows mock, run with sqlcmd on Linux.
# Stdout  : metric hours <n> db=<name>
# Alerts  : .hours > 26 WARN, > 50 CRITICAL
[job.mssql_backup_age]
metric_name = mssql.backup_age
runner      = sqlcmd
file        = checks/sql/mssql_backup_age.sql
run_every   = 1h
max_runtime = 2m

# METRIC  : oracle.tablespace
# Stdout  : metric used_pct <n> tablespace=<name>
# Alerts  : .used_pct > 85 WARN, > 95 CRITICAL
[job.oracle_tablespace]
metric_name = oracle.tablespace
runner      = sqlplus
file        = checks/sql/oracle_tablespace.sql
run_every   = 15m
max_runtime = 2m


# --- Applications and services ----------------------------------------------

# METRIC  : http.api_health
# Desc    : No script - checks/http/api_health.curl:
#             url       = "https://api.example.internal/health"
#             output    = "/dev/null"
#             write-out = "metric response_seconds %{time_total} status=%{http_code}\n"
# Alerts  : .failures > 0 CRITICAL; .response_seconds > 2 WARN
[job.api_health]
metric_name = http.api_health
file        = checks/http/api_health.curl
run_every   = 1m
max_runtime = 15s

# METRIC  : tls.cert_expiry
# Unit    : days until expiry, per endpoint
# Desc    : openssl s_client + x509 -enddate for each host:port arg.
#           openssl ships with macOS (LibreSSL) and nearly every Linux
#           distribution; it is this job's prerequisite, not Vigil's.
# Stdout  : metric days_left <n> target=<host>:<port>
# Exit    : nagios - 1 if any < 30 days, 2 if any < 7 days
[job.cert_expiry]
metric_name = tls.cert_expiry
file        = checks/posix/cert_expiry.sh
arg         = api.example.internal:443
arg         = mail.example.internal:465
run_at      = 08:00
max_runtime = 2m
exit_codes  = nagios

# METRIC  : app.legacy.export
# Unit    : seconds (success duration)
# Desc    : Example only. Per-job overrides: this job uses the java8 runner
#           while every other .java job uses the default through [runners].
#           Command line (working directory jobs/legacy):
#             /usr/lib/jvm/java-1.8.0/bin/java -jar jobs/legacy/LegacyExport.jar --since 1d
#           "vigil precheck legacy_export" shows each value and its source.
# Alerts  : .failures > 0              -> export failed
[job.legacy_export]
metric_name       = app.legacy.export
file              = jobs/legacy/LegacyExport.jar
runner            = java8
arg               = --since
arg               = 1d
run_at            = 02:00
max_runtime       = 2h
late_start_window = 3h
log_retain_days   = 90
working_dir       = jobs/legacy
tag               = team=finance
env               = JAVA_TOOL_OPTIONS=-Xmx4g
require_env       = EXPORT_SFTP_PASSWORD
# Its output lists customer accounts: keep it on this host even though
# [log_forward] includes stdout and stderr.
forward_output    = false

# METRIC  : rabbitmq.queues
# Unit    : messages ready, per queue
# Desc    : Python example. Calls the RabbitMQ management API with
#           urllib (standard library - no pip packages). Credentials from
#           RABBITMQ_USER / RABBITMQ_PASS in the service environment.
# Stdout  : metric messages_ready <n> queue=<name>
#           metric consumers <n> queue=<name>
# Alerts  : .messages_ready growing and .consumers == 0 -> CRITICAL
[job.rabbitmq_queues]
metric_name = rabbitmq.queues
file        = checks/python/rabbitmq_queues.py
run_every   = 1m
max_runtime = 20s

# METRIC  : windows_parity.ps_check
# Desc    : A .ps1 written for the Windows fleet, run unchanged with
#           PowerShell 7 on Linux via the [runners] map. Disabled: pwsh is
#           not installed on this host.
[job.ps_shared_check]
metric_name = windows_parity.ps_check
file        = checks/ps/shared_check.ps1
run_every   = 15m
max_runtime = 2m
enabled     = false


# --- Backups and maintenance -------------------------------------------------

# METRIC  : backup.rsync
# Unit    : seconds (success duration)
# Desc    : Direct executable, args only. rsync exit 24 = "some source files
#           vanished during transfer" - normal on live data, so treated as
#           success alongside 0. Everything else is a failure.
#           macOS ships openrsync / rsync 2.6.9 - check option support.
# Alerts  : .failures > 0              -> CRITICAL: offsite copy broken
[job.offsite_sync]
metric_name = backup.rsync
file        = /usr/bin/rsync
arg         = -a
arg         = --delete
arg         = /var/backups/db/
arg         = backup@backupsrv:/srv/backups/app-posix/
run_at      = 03:30
max_runtime = 3h
exit_codes  = 0,24

# METRIC  : maintenance.log_cleanup
# Desc    : "find -mtime" style housekeeping written to the strict POSIX sh
#           subset. [runners] maps .sh to bash, so this job opts into the
#           sh runner explicitly.
[job.log_cleanup]
metric_name = maintenance.log_cleanup
runner      = sh
file        = checks/posix/log_cleanup.sh
arg         = /var/log/app
arg         = 14
run_at      = 04:00
max_runtime = 30m


# --- Legacy scripts (migration from cron) ------------------------------------

# METRIC  : legacy.replication_check
# Desc    : A script from an old cron hub, run unchanged as a direct executable
#           (#!/bin/sh first line, chmod +x). Was one cron line per server
#           on the hub; now each host runs its own copy with state, a log
#           and metrics. Legacy scripts often exit 0 and email problems
#           instead - until they exit non-zero or print metric lines, Vigil
#           can only report that they ran and how long they took.
[job.replication_check]
metric_name = legacy.replication_check
file        = legacy/replication_check.sh
run_every   = 5m
max_runtime = 2m

# METRIC  : legacy.perf_report
# Desc    : A legacy Perl report parser, via the
#           [runners] map (.pl -> perl).
[job.legacy_perf_report]
metric_name = legacy.perf_report
file        = legacy/perf_report.pl
run_every   = 5m
max_runtime = 7m


# =============================================================================
# FETCHED SCRIPTS  (see SOURCES)
#   These jobs are defined here like any other, but run scripts fetched from
#   a source. The job names the file; the source says where, and which
#   version.
# =============================================================================

# METRIC  : os.inode_usage
# Desc    : Script from the monitoring repository at [source.fleet]'s release
#           tag. The repository's whole tree at that tag is fetched, so the
#           script can source lib/common.sh beside it. Upgrading is a
#           one-line change to that source's ref.
[job.inode_usage]
metric_name = os.inode_usage
source      = fleet
file        = checks/posix/inode_usage.sh
run_every   = 5m
max_runtime = 30s

# METRIC  : tls.cert_expiry_external
# Desc    : Single script from the HTTPS file server. sha256 is required:
#           an https source has no versions, so the digest is the version.
#           A different file at that URL is rejected, and the last verified
#           copy keeps running.
[job.cert_expiry_external]
metric_name = tls.cert_expiry_external
source      = files
file        = checks/cert_expiry_external.sh
sha256      = 3b7e1f0c9d2a4e6b8c0d1f2a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e
arg         = www.example.com:443
run_at      = 07:30
max_runtime = 2m
exit_codes  = nagios

# METRIC  : db.export_freshness
# Desc    : Script from the DBA team's SFTP drop, pinned by digest.
[job.export_freshness]
metric_name = db.export_freshness
source      = dba_sftp
file        = export_freshness.sh
sha256      = 9f2c4e7a1b3d5f7092a4c6e8f0b1d3f5a7c9e1b3d5f7a9c1e3f5b7d9f1a3c5e7
run_every   = 15m
max_runtime = 1m

# METRIC  : app.queue_depth
# Desc    : Script from the NFS share. Without sha256 it is reported as
#           unpinned: edits on the share are picked up at the next check,
#           so hosts may briefly run different versions.
[job.queue_depth]
metric_name = app.queue_depth
source      = team_share
file        = app/queue_depth.sh
run_every   = 1m
max_runtime = 20s


# =============================================================================
# SAME SCRIPT, EVERY WAY TO GET IT
#   One script, disk_usage.sh, obtained every way Vigil supports. In a real
#   configuration a job uses one of these; they share a metric name here
#   only so they are easy to compare. Each sends its metrics somewhere
#   different - built-in and custom backends - because where the SCRIPT
#   comes from (source) and where the METRICS go (backends) are independent.
# =============================================================================

# --- Local, no source: the script is used where it is ------------------------

# Relative to the install root (/opt/vigil/checks/...).
[job.disk_usage_file]
metric_name = os.disk_usage
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = file

# Absolute path anywhere on the host.
[job.disk_usage_abs]
metric_name = os.disk_usage
file        = /usr/local/libexec/checks/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = local_archive

# --- Local folder and share sources: copied into the cache first ------------

# From the mounted share, pinned by digest: editing the file on the share
# changes nothing here until this sha256 changes.
[job.disk_usage_share]
metric_name = os.disk_usage
source      = share
file        = checks/posix/disk_usage.sh
sha256      = 5d41402abc4b2a76b9719d911017c592a1b2c3d4e5f60718293a4b5c6d7e8f90
run_every   = 5m
max_runtime = 30s
backends    = ops_collector

# From the share without a digest: allowed, but warned as unpinned. Copied
# once when this job appears or its "file" changes - later edits on the
# share are NOT picked up, and hosts that copied at different times may
# differ.
[job.disk_usage_share_unpinned]
metric_name = os.disk_usage
source      = share
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = file

# From a local folder another tool fills, pinned by digest.
[job.disk_usage_staging]
metric_name = os.disk_usage
source      = staging
file        = disk_usage.sh
sha256      = 5d41402abc4b2a76b9719d911017c592a1b2c3d4e5f60718293a4b5c6d7e8f90
run_every   = 5m
max_runtime = 30s
backends    = victoriametrics

# --- Git: the version is the source's ref - a tag, a commit or a branch ------

# [source.git] is at release tag v1.4.0 - the recommended form. Upgrading
# every job from it is one change to that source's ref.
[job.disk_usage_git]
metric_name = os.disk_usage
source      = git
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = datadog, ops_collector

# [source.git_main] follows the main branch: merged changes arrive within
# its check_every. Reported as unpinned when fetched; fine for a test host,
# not for production.
[job.disk_usage_git_branch]
metric_name = os.disk_usage
source      = git_main
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = file

# [source.git_pinned] is frozen at a full commit id: the strictest pin.
[job.disk_usage_git_commit]
metric_name = os.disk_usage
source      = git_pinned
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = local_archive, datadog

# A branch plus a digest: follows "main", but only ever runs this exact
# content - a commit that changes the script is rejected, and the last
# verified copy keeps running, until the digest here is updated.
[job.disk_usage_git_digest]
metric_name = os.disk_usage
source      = git_main
file        = checks/posix/disk_usage.sh
sha256      = 5d41402abc4b2a76b9719d911017c592a1b2c3d4e5f60718293a4b5c6d7e8f90
run_every   = 5m
max_runtime = 30s
backends    = datadog_eu

# Trial a release candidate on one job: [source.git_trial] is the same
# repository at v1.5.0-rc1, while every other job stays on [source.git].
[job.disk_usage_git_trial]
metric_name = os.disk_usage
source      = git_trial
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = influxdb

# --- Git over SSH -------------------------------------------------------------

# scp-style address (git@host:path), at the source's tag v1.4.0.
[job.disk_usage_ssh]
metric_name = os.disk_usage
source      = git_ssh
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = otel

# ssh:// on port 2222, at the source's tag v1.4.0.
[job.disk_usage_ssh_port]
metric_name = os.disk_usage
source      = git_ssh_port
file        = checks/posix/disk_usage.sh
run_every   = 5m
max_runtime = 30s
backends    = otel, local_archive

# --- SFTP: no versions, so sha256 is required ---------------------------------

[job.disk_usage_sftp]
metric_name = os.disk_usage
source      = sftp
file        = checks/posix/disk_usage.sh
sha256      = 9f2c4e7a1b3d5f7092a4c6e8f0b1d3f5a7c9e1b3d5f7a9c1e3f5b7d9f1a3c5e7
run_every   = 5m
max_runtime = 30s
backends    = webhook

# A file at the top of the remote directory.
[job.disk_usage_sftp_port]
metric_name = os.disk_usage
source      = sftp_port
file        = disk_usage.sh
sha256      = 9f2c4e7a1b3d5f7092a4c6e8f0b1d3f5a7c9e1b3d5f7a9c1e3f5b7d9f1a3c5e7
run_every   = 5m
max_runtime = 30s
backends    = ops_collector, local_archive

# --- HTTPS: no versions, so sha256 is required --------------------------------

# With the authentication header of [source.files].
[job.disk_usage_https]
metric_name = os.disk_usage
source      = files
file        = checks/posix/disk_usage.sh
sha256      = 3b7e1f0c9d2a4e6b8c0d1f2a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e
run_every   = 5m
max_runtime = 30s
backends    = statsd

# Public download, no authentication.
[job.disk_usage_https_public]
metric_name = os.disk_usage
source      = public_https
file        = posix/disk_usage.sh
sha256      = 3b7e1f0c9d2a4e6b8c0d1f2a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e
run_every   = 5m
max_runtime = 30s
backends    = splunk


# =============================================================================
# FETCHED SCRIPTS WITH EVERY OTHER JOB FEATURE
#   A fetched script is an ordinary job in every other respect: runners,
#   arguments, schedules, overrides, tags, environment and backends all work
#   exactly as for a local file.
# =============================================================================

# Runner from the [runners] extension map (.py -> python), arguments, Nagios
# exit codes, metrics to two named backends.
[job.memory_fleet]
metric_name = os.memory_fleet
source      = git
file        = checks/posix/memory.py
arg         = --warn-percent
arg         = 90
run_every   = 1m
max_runtime = 20s
exit_codes  = nagios
backends    = file, datadog

# Explicit runner: a .sql from the repository through sqlcmd instead of the
# mapped psql. {file} in the runner's args becomes the cached copy's path.
[job.mssql_blocking_fleet]
metric_name = mssql.blocking
source      = git
file        = sql/mssql/blocking_sessions.sql
runner      = sqlcmd
run_every   = 5m
max_runtime = 2m
tag         = team=dba
tag         = database=orders
backends    = dba_metrics

# A jar from its own repository over git+SSH ([source.legacy_jars], at
# v2.0.3) on the java8 runner, with a working directory,
# environment, required variables, weekdays only and every override.
[job.legacy_export_fleet]
metric_name       = app.legacy.export_fleet
source            = legacy_jars
file              = jars/LegacyExport.jar
runner            = java8
arg               = --since
arg               = 1d
run_at            = 02:00
run_on_days       = mon, tue, wed, thu, fri
max_runtime       = 2h
grace             = 2m
overlap           = queue_one
on_uncertain      = manual
late_start_window = 3h
log_retain_days   = 90
working_dir       = jobs/legacy
tag               = team=finance
env               = JAVA_TOOL_OPTIONS=-Xmx4g
require_env       = EXPORT_SFTP_PASSWORD
backends          = datadog_finance, local_archive

# Several times a day from SFTP, explicit success codes (rsync: 0 and 24),
# metrics to Splunk and the in-house collector.
[job.offsite_sync_check]
metric_name = backup.offsite_sync_check
source      = sftp
file        = checks/posix/offsite_sync_check.sh
sha256      = 9f2c4e7a1b3d5f7092a4c6e8f0b1d3f5a7c9e1b3d5f7a9c1e3f5b7d9f1a3c5e7
run_at      = 06:00, 12:00, 18:00
max_runtime = 10m
exit_codes  = 0,24
backends    = splunk, ops_collector

# Disabled: still validated, and its script is still fetched and cached, so
# re-enabling it never waits on the network.
[job.cert_expiry_fleet]
metric_name = tls.cert_expiry_fleet
source      = git
file        = checks/posix/cert_expiry.sh
run_at      = 08:00
max_runtime = 2m
exit_codes  = nagios
enabled     = false
