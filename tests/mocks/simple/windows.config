# =============================================================================
# vigil.config  -  Windows  (MOCK - for design review only)
#   A database server with its maintenance jobs, plus general examples.
#   TIER: SIMPLE - everything local
# =============================================================================
#
# FORMAT RULES
#   Identical parser in Windows PowerShell 5.1 and bash 3.2.
#
#   - One "key = value" per line. Whitespace around "=" is trimmed.
#   - A line starting with "#" or ";" is a comment. There are NO inline
#     comments - "#" inside a value is literal (URLs, regexes, etc.).
#   - No quoting, no escaping, no variable expansion. Values are literal.
#     One exception: the token {file} inside a runner "arg" (see RUNNERS).
#   - Repeating a key appends to a list (used for "arg").
#   - Lists inside a single value are comma-separated.
#   - Durations : 30s, 5m, 2h, 7d   (no months - "m" is always minutes)
#   - Times     : HH:MM, 24-hour, local wall-clock time
#   - Days      : mon, tue, wed, thu, fri, sat, sun (case-insensitive)
#   - Relative paths resolve against the install root (the folder that
#     contains config/), e.g. file = scripts/x.sh -> <root>/scripts/x.sh.
#   - ASCII only. Keeps PowerShell 5.1 and older shells out of encoding trouble.
#
# SECRETS
#   Secrets are NEVER written in this file. Every credential value has the
#   form  env:NAME  - the name of an environment variable, not the secret:
#
#     api_key = env:DATADOG_API_KEY     <- correct: names the variable
#     api_key = 3f9a1c...               <- REJECTED at validation
#
#   Credential keys (api_key, token, username, password, *_secret, *_key,
#   header_value, ...) refuse any value that does not start with env:, so a
#   pasted raw key stops validation instead of being used. The rejected
#   value is never echoed in the error message or logs.
#   Vigil reads the variable only at the moment it sends, and never logs,
#   persists or passes the value on a command line.
#
#   Where the variable comes from depends on the service manager:
#     Windows (NSSM) : machine environment, or NSSM AppEnvironmentExtra
#     Linux systemd  : EnvironmentFile= (readable by the owner only)
#     macOS launchd  : EnvironmentVariables in the LaunchAgent/Daemon plist
#
# VALIDATION
#   The whole file is validated before it becomes active. On startup, an
#   invalid file stops Vigil. On reload, an invalid file is rejected and the
#   last known valid configuration stays active (VIGIL-010).
#
# SIMPLE - EVERYTHING LOCAL
#   One Vigil instance, one configuration file: this one. Every job runs a
#   script that is already on this machine; nothing is fetched. This is
#   the default way to run Vigil.
#
#   The other two tiers, in their own mocks:
#     mixed    : this file is still the configuration, but some jobs
#                fetch their script from a source (git, https, sftp or
#                a share) - see mixed/.
#     advanced : this file only points at a configuration kept
#                elsewhere, which Vigil fetches - see advanced/.
#   The configuration is never part local, part remote: it is this file,
#   or the one this file points at.
#
#   Vigil checks this file every tick. A change is validated as a whole
#   and becomes active only if it is valid; a broken edit never replaces
#   a working configuration.
# =============================================================================


# -----------------------------------------------------------------------------
# VIGIL
#   instance       : Name of this deployment. Used in the service name, the
#                    state directory and the "instance" tag. Several instances
#                    may run on one host with different config files.
#   state_dir      : Where execution state lives. Owned by exactly one
#                    supervisor (VIGIL-001).
#   max_concurrent : Global limit on running jobs across ALL jobs (VIGIL-002).
#                    Default: 5
# -----------------------------------------------------------------------------
[vigil]
instance       = db-windows
state_dir      = state
max_concurrent = 5


# -----------------------------------------------------------------------------
# SCHEDULER
#   tick              : How often the supervisor evaluates jobs.
#                       Default: 60s
#   late_start_window : Replaces RunAtBuffer. If Vigil was down at a job's
#                       "at" time and comes back within this window, the run
#                       still fires. Outside the window it is skipped and
#                       recorded as missed - no backlog (VIGIL-008).
#                       Example: at = 23:00, window = 15m
#                         back at 23:05 -> fires
#                         back at 23:20 -> skipped, next run tomorrow 23:00
#                       Default: 15m
#   max_pending       : Upper bound on runs waiting for a free concurrency
#                       slot. Beyond this, new runs are skipped and recorded.
#                       Default: 20
# -----------------------------------------------------------------------------
[scheduler]
tick              = 60s
late_start_window = 15m
max_pending       = 20


# -----------------------------------------------------------------------------
# LOG
#   dir         : Root for all logs.
#                   Supervisor : <dir>\supervisor\yyyy-MM-dd.log
#                   Status     : <dir>\supervisor\jobs.log  (rewritten every tick)
#                   Job        : <dir>\jobs\<job id>\yyyy-MM-dd.log
#   stdout      : Also write to stdout (captured by NSSM / journald / launchd).
#   retain_days : Daily log files older than this are deleted.
#   max_file_mb : A single log file is capped at this size (VIGIL-014).
# -----------------------------------------------------------------------------
[log]
dir         = C:\logs\vigil\db-windows
stdout      = true
retain_days = 7
max_file_mb = 50


# -----------------------------------------------------------------------------
# TAGS
#   Applied to every metric from every job on this host. Backend-neutral;
#   each backend translates to its native form:
#     Datadog    : key:value
#     OTel       : attributes { key = value }
#     Prometheus : {key="value"}
#     Splunk     : fields
#   Add as many tags as you like. Keys: lowercase letters, digits, "_".
#   Values: any text without spaces. Tags are the same on every metric
#   from this host, so more tags do not mean more data in the backend.
#   Some backends cap tags per metric (Azure Monitor 10, CloudWatch 30,
#   including the automatic ones) - validation warns if exceeded.
#
#   Added automatically - do not declare: host, os, instance, job
#   Also reserved: label, uom, exit_code
# -----------------------------------------------------------------------------
[tags]
client      = CLIENT
environment = dev
product     = scf
host_type   = db


# -----------------------------------------------------------------------------
# SPOOL
#   Every metric event (from Vigil itself and from job stdout) is written to
#   the spool first. Each enabled backend drains the spool independently with
#   its own position, timeout and retry. A dead backend never blocks another
#   backend or the scheduler (VIGIL-009), and events survive outages.
#
#   dir       : Spool directory.
#   max_mb    : Hard cap on spool size (VIGIL-014).
#   when_full : drop_oldest | drop_newest. Drops are counted and reported.
# -----------------------------------------------------------------------------
[spool]
dir       = spool
max_mb    = 100
when_full = drop_oldest


# -----------------------------------------------------------------------------
# BACKENDS
#   Any number may be enabled at once. All are optional; with none enabled
#   Vigil still schedules, supervises and logs (VIGIL-015).
#
#   [backend.<name>] The name is free text. "type" defaults to the name, so
#                    [backend.datadog] needs no type line. Set "type" to use
#                    the same backend twice (e.g. two Datadog accounts).
#
#   Common keys:
#     type     : Backend type (see list below). Default: the section name.
#     enabled  : true | false
#     endpoint : Non-secret target URL or host:port.
#     timeout  : Per-request limit. Default: 10s
#     api_key, token, username, password, ... :
#                Credentials. ALWAYS  env:NAME  - never the secret itself.
#                See SECRETS at the top of this file.
#
#   Transport: curl on Linux/macOS (secrets passed on stdin, never argv),
#              Invoke-WebRequest on Windows. Secrets go in headers only,
#              never in the URL query string.
#
#   Types: file, datadog, otel, prometheus, splunk, graphite, statsd,
#          azuremonitor, elasticsearch, opensearch, victoriametrics,
#          influxdb, cloudwatch, gcp, newrelic, dynatrace, webhook
#
#   Not possible from plain scripts: Prometheus remote_write (needs
#   protobuf + snappy). Use VictoriaMetrics import, OTLP/HTTP JSON or the
#   Influx line protocol endpoints that Mimir, Grafana Cloud and Thanos
#   receivers expose instead.
# -----------------------------------------------------------------------------

# Local flat file. Always safe to leave on - also the fallback evidence
# when every remote backend is unreachable.
[backend.file]
enabled = true
format  = prometheus
path    = metrics\vigil.prom

[backend.datadog]
enabled  = true
endpoint = https://api.datadoghq.com
api_key  = env:DATADOG_API_KEY
timeout  = 10s

[backend.otel]
enabled  = true
endpoint = http://otel-collector:4318/v1/metrics
api_key  = env:OTEL_API_KEY
timeout  = 10s

[backend.prometheus]
; Pushgateway
enabled  = true
endpoint = http://pushgateway:9091
username = env:PROMETHEUS_USERNAME
password = env:PROMETHEUS_PASSWORD
timeout  = 10s

[backend.splunk]
; HTTP Event Collector
enabled  = true
endpoint = https://splunk:8088/services/collector/event
token    = env:SPLUNK_HEC_TOKEN
timeout  = 10s

[backend.graphite]
; Carbon plaintext, no auth
enabled  = true
endpoint = graphite.internal:2003
timeout  = 5s

[backend.azuremonitor]
; Azure Monitor custom metrics. The endpoint is regional and names the
; Azure resource the metrics attach to. Service principal shown; on an
; Azure VM set "auth = managed_identity" instead and drop the three credential
; keys - the token comes from the local metadata endpoint, no secret.
enabled       = true
endpoint      = https://westeurope.monitoring.azure.com/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Compute/virtualMachines/<vm>/metrics
tenant_id     = env:AZURE_TENANT_ID
client_id     = env:AZURE_CLIENT_ID
client_secret = env:AZURE_CLIENT_SECRET
timeout       = 10s

[backend.elasticsearch]
; Basic auth shown. For API key auth use api_key_id + api_key_secret.
enabled  = true
endpoint = https://elasticsearch:9200
index    = vigil-metrics
username = env:ELASTICSEARCH_USERNAME
password = env:ELASTICSEARCH_PASSWORD
timeout  = 10s

[backend.opensearch]
enabled        = true
endpoint       = https://opensearch:9200
index          = vigil-metrics
api_key_id     = env:OPENSEARCH_API_KEY_ID
api_key_secret = env:OPENSEARCH_API_KEY_SECRET
timeout        = 10s

[backend.victoriametrics]
; Prometheus text-format import - the same bytes as [backend.file], pushed.
; Single-node shown. Cluster: http://vminsert:8480/insert/0/prometheus/api/v1/import/prometheus
; Auth is optional (vmauth / reverse proxy): username + password
; or bearer_token (all as env:NAME).
enabled  = true
endpoint = http://victoriametrics:8428/api/v1/import/prometheus
timeout  = 10s

[backend.influxdb]
; InfluxDB v2 line protocol. For v1 / VictoriaMetrics influx endpoint use
; endpoint = http://host:8086/write?db=vigil and drop token.
enabled  = true
endpoint = https://influxdb:8086/api/v2/write?org=ops&bucket=vigil&precision=s
token    = env:INFLUXDB_TOKEN
timeout  = 10s

[backend.statsd]
; UDP, fire-and-forget, no auth. Sent with bash's /dev/udp and .NET
; UdpClient - no curl. Tags use the DogStatsD "|#k:v" extension when
; dialect = dogstatsd; plain statsd drops tags.
enabled  = true
endpoint = statsd.internal:8125
dialect  = dogstatsd

[backend.cloudwatch]
; AWS CloudWatch PutMetricData. Requests are SigV4-signed: curl 7.75+
; --aws-sigv4 on Linux/macOS, .NET HMAC-SHA256 in PowerShell. On EC2 set
; "auth = instance_profile" and drop the three credential keys - credentials come
; from the instance metadata service (IMDSv2), no secret on the host.
enabled           = true
region            = eu-west-1
namespace         = Vigil
access_key_id     = env:AWS_ACCESS_KEY_ID
secret_access_key = env:AWS_SECRET_ACCESS_KEY
session_token     = env:AWS_SESSION_TOKEN
timeout           = 10s

[backend.gcp]
; Google Cloud Monitoring timeSeries.create as custom.googleapis.com/vigil/*.
; On a GCE / GKE VM: "auth = metadata" - token from the metadata server,
; no secret. Off GCP: a service-account key file, signed into a token with
; RS256 (.NET RSA in PowerShell, openssl on Linux/macOS - openssl is then
; an extra prerequisite for this backend only).
enabled = true
project = my-gcp-project
auth    = metadata
; key_file = env:GOOGLE_APPLICATION_CREDENTIALS
timeout = 10s

[backend.newrelic]
; New Relic Metric API. EU accounts: https://metric-api.eu.newrelic.com/metric/v1
enabled  = true
endpoint = https://metric-api.newrelic.com/metric/v1
api_key  = env:NEW_RELIC_LICENSE_KEY
timeout  = 10s

[backend.dynatrace]
; Dynatrace metrics ingest (line protocol). Token needs metrics.ingest scope.
enabled   = true
endpoint  = https://<env-id>.live.dynatrace.com/api/v2/metrics/ingest
api_token = env:DYNATRACE_API_TOKEN
timeout   = 10s

[backend.datadog_eu]
; Same backend type twice: a second Datadog account / site.
type     = datadog
enabled  = true
endpoint = https://api.datadoghq.eu
api_key  = env:DATADOG_EU_API_KEY
timeout  = 10s

[backend.webhook]
; Generic JSON POST of each spool batch - for in-house collectors, n8n,
; Logic Apps, Lambda URLs, etc. Body: {"host":..,"metrics":[{name,value,
; tags,timestamp},..]}. Optional header_name + header_value for auth.
enabled      = true
endpoint     = https://collector.internal/vigil
header_name  = X-Api-Key
header_value = env:VIGIL_WEBHOOK_KEY
timeout      = 10s

# --- Custom backends ----------------------------------------------------------
# A backend's name is yours; its type says how it talks. When the name is
# not a type, "type" is required. Name them after where the data goes, and
# jobs read naturally: "backends = security_splunk".

# The security team's own Splunk index, separate from operations'.
[backend.security_splunk]
type     = splunk
endpoint = https://splunk-sec.example.com:8088/services/collector/event
token    = env:SPLUNK_SECURITY_HEC_TOKEN
timeout  = 10s

# The in-house operations collector: a second webhook with its own auth.
[backend.ops_collector]
type         = webhook
endpoint     = https://ops-collector.example.com/ingest/vigil
header_name  = Authorization
header_value = env:OPS_COLLECTOR_AUTH
timeout      = 15s

# A long-term local archive beside the main file backend, for jobs whose
# history must stay on the host (audit evidence).
[backend.local_archive]
type   = file
format = prometheus
path   = metrics\archive\vigil-archive.prom

# The finance team's Datadog organisation, in the US site.
[backend.datadog_finance]
type     = datadog
endpoint = https://api.datadoghq.com
api_key  = env:DATADOG_FINANCE_API_KEY
timeout  = 10s

# The DBA team's VictoriaMetrics cluster (vminsert), tenant 7.
[backend.dba_metrics]
type     = victoriametrics
endpoint = https://vminsert.example.com:8480/insert/7/prometheus/api/v1/import/prometheus
username = env:DBA_VM_USERNAME
password = env:DBA_VM_PASSWORD
timeout  = 10s



# -----------------------------------------------------------------------------
# LOG FORWARDING  (optional - off when this section is absent)
#   Sends Vigil's OWN logs to your logging service: the supervisor log and
#   the job logs (what ran, when, how it ended, and - if you ask - what the
#   job printed). Never other logs on this host. Local logs are always
#   written first and stay the authoritative record; a logging service that
#   is down never affects jobs, scheduling or metrics.
#
#   Forwarding runs in its own worker (vigil_logs), separate from the metrics
#   sender, and resumes where it left off after any restart. Records lost to
#   log retention before they could be sent are reported (vigil.logs.gaps),
#   never silently dropped.
#
#   enabled        : true | false. Default true when this section exists,
#                    so forwarding can be switched off keeping its settings.
#   destination    : Required. The [log_destination.*] to send to.
#   include        : What to send, comma-separated:
#                      supervisor  the supervisor log
#                      run         each run's start and end lines, outcome
#                      stdout      what jobs print (opt-in)
#                      stderr      what jobs print to stderr (opt-in)
#                    Default: supervisor, run. Job output is only sent when
#                    named here, and a job can keep its own output local with
#                    "forward_output = false" (see JOBS).
#   check_every    : How often to look for new log lines. Default 30s.
#   batch_lines    : Most lines per request. Default 500.
#   batch_kb       : Most kilobytes per request. Default 512.
#   max_pending_mb : Most unsent data handled in one forwarder run.
#                    Default 64.
#
#   Log destinations are separate from metrics backends: a metrics endpoint
#   is never assumed to accept logs, even for the same product.
# -----------------------------------------------------------------------------
[log_forward]
enabled        = true
destination    = ops_logs
include        = supervisor, run, stdout, stderr
check_every    = 30s
batch_lines    = 500
batch_kb       = 512
max_pending_mb = 64

# An OpenTelemetry collector's OTLP/HTTP logs endpoint. The collector can
# route to Splunk, Datadog, Elasticsearch, Loki or anything else it supports.
#   type         : otel (OTLP/HTTP). Native splunk and datadog types later.
#   endpoint     : https:// only; credentials in the URL are rejected.
#   header_name /
#   header_value : Optional authentication header; header_value is env:NAME.
#   timeout      : Limit for one request. Default 10s.
[log_destination.ops_logs]
type         = otel
endpoint     = https://otel-collector.example.com:4318/v1/logs
header_name  = Authorization
header_value = env:OTEL_LOGS_AUTH
timeout      = 10s

# A second destination, defined but not in use: switching is a one-line
# change to "destination" above. The new destination starts from now; it is
# not sent history.
[log_destination.security_logs]
type     = otel
endpoint = https://otel-security.example.com/v1/logs
timeout  = 15s
# -----------------------------------------------------------------------------
# RUNNERS
#   Reusable command prefixes. Vigil knows nothing about database clients, PowerShell,
#   Perl or anything else - it starts a command and supervises it.
#
#   A job's final command line is:
#     runner.command  runner.arg...  job.file  job.arg...
#
#   Which runner a job uses, first match wins:
#     1. The job's own "runner" key.
#     2. The file's extension looked up in [runners] (case-insensitive).
#     3. No runner - "file" is executed directly. Works for native
#        executables, .bat/.cmd on Windows, and scripts with a "#!" line
#        and the executable bit on Linux/macOS.
#   A file that matches nothing and cannot run directly (e.g. .sql, .java,
#   or .ps1 - Windows opens .ps1 in Notepad) is rejected at validation as
#   invalid_config, never discovered at first run.
#
#   command     : Program to start. Absolute path, or a name found on PATH.
#                 Paths with spaces need no quoting.
#   arg         : One argument per line, in order. Repeat the key.
#                 If any runner arg contains the token {file}, Vigil
#                 substitutes the job's file path there and does NOT append
#                 it at the end. Needed by clients that take the script
#                 inside another argument:
#                   sqlplus  @{file}
#                   mysql    --execute=source {file}
#   env         : Optional. NAME=value set for the job's process only.
#                 Repeat the key per variable. Literal values - never put a
#                 secret here; secrets stay in the service environment.
#   require_env : Environment variables that must exist before any job using
#                 this runner may start. Checked by pre-flight and before
#                 every spawn. Values are inherited by the job, never read or
#                 logged by Vigil.
# -----------------------------------------------------------------------------

# Plain PowerShell script.
[runner.ps]
command = powershell.exe
arg     = -NoProfile
arg     = -NonInteractive
arg     = -ExecutionPolicy
arg     = Bypass
arg     = -File

# The database fleet's SQL client, behind a wrapper. runners\dbsql.ps1 finds
# the client, connects to DB_SERVER with the credentials from the
# environment, runs the .sql file and exits non-zero when the client reports
# an SQL error (some clients exit 0 on SQL errors). Every database-specific
# detail lives in this runner, not in Vigil.
[runner.dbsql]
command     = powershell.exe
arg         = -NoProfile
arg         = -NonInteractive
arg         = -ExecutionPolicy
arg         = Bypass
arg         = -File
arg         = runners\dbsql.ps1
require_env = DB_DBA_USER, DB_DBA_PASSWORD, DB_SERVER

# Java single-file source launch (JDK 11+): java.exe HeapCheck.java
# No wrapper needed - no secrets on the command line.
[runner.java]
command = C:\Program Files\Java\jdk-21\bin\java.exe

# Legacy Java 8 for one job (see job.legacy_export). Java 8 cannot run a
# .java source file, so it runs a jar. Not in [runners] - a job opts in
# with "runner = java8"; every other .java job keeps using JDK 21.
[runner.java8]
command = C:\Program Files\Java\jre1.8.0_421\bin\java.exe
arg     = -jar

# Microsoft SQL Server via sqlcmd - pure SQL, no wrapper script.
# The client is sqlcmd.exe (there is no mssql.exe). Install path varies by
# ODBC driver version (130, 170, ...).
#   -E          Windows integrated auth: the service account logs in, so no
#               password exists anywhere. For SQL auth use "-U <user>"
#               instead; sqlcmd reads the password from the SQLCMDPASSWORD
#               environment variable, so it never appears on the command line.
#   -b          Exit non-zero on any SQL error, so no output scanning is
#               needed to catch failures.
#   -h -1 -W    No column headers, trimmed whitespace - clean stdout, so a
#               SELECT can print "metric <name> <value>" lines directly.
#   -i          Input file. Must be the last arg: Vigil appends "file" next.
[runner.mssql]
command = C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\170\Tools\Binn\SQLCMD.EXE
arg     = -S
arg     = localhost
arg     = -E
arg     = -b
arg     = -h
arg     = -1
arg     = -W
arg     = -i

# PostgreSQL via psql - pure SQL, no wrapper.
#   -X              Ignore any psqlrc, so behaviour never depends on a profile.
#   -w              Never prompt for a password - fail instead of hanging.
#   -q -t -A        Quiet, tuples only, unaligned: clean "metric ..." stdout.
#   ON_ERROR_STOP=1 Stop at the first SQL error and exit 3. Without it psql
#                   carries on and exits 0 - a common trap with SQL clients.
#   Password      : from pgpass.conf in the service account's profile
#                   (%APPDATA%\postgresql\pgpass.conf), the client's own
#                   credential store. Vigil never sees it. PGPASSWORD also
#                   works (add require_env) but PostgreSQL discourages it.
#   Exit codes    : 0 ok, 1 fatal, 2 connection lost, 3 script error.
[runner.psql]
command = C:\Program Files\PostgreSQL\16\bin\psql.exe
arg     = -X
arg     = -w
arg     = -q
arg     = -t
arg     = -A
arg     = -v
arg     = ON_ERROR_STOP=1
arg     = -h
arg     = localhost
arg     = -U
arg     = vigil_monitor
arg     = -d
arg     = postgres
arg     = -f

# MySQL / MariaDB via mysql - pure SQL, no wrapper.
#   mysql cannot take a script path as a plain argument (it reads stdin), so
#   the {file} token puts it inside --execute.
#   --defaults-extra-file MUST be the first argument (mysql rule). It holds
#   user and password in an option file ACL'd to the service account - the
#   client's own credential store, outside Vigil's config.
#   --batch --skip-column-names : tab-separated rows, no headers.
#   Exits 1 on any SQL error in batch mode.
[runner.mysql]
command = C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
arg     = --defaults-extra-file=C:\vigil\credentials\mysql-monitor.cnf
arg     = --batch
arg     = --skip-column-names
arg     = --execute=source {file}

# Oracle via SQL*Plus (Instant Client) - pure SQL, no wrapper.
#   -S          Silent: no banner or prompts.
#   -L          Try to log on once; fail instead of re-prompting.
#   /@PRODDB    External auth through an Oracle Wallet: no password anywhere.
#   @{file}     SQL*Plus wants "@script" as a single argument.
#   The script itself MUST:
#     - start with   WHENEVER SQLERROR EXIT FAILURE
#                    SET HEADING OFF FEEDBACK OFF PAGESIZE 0 LINESIZE 32767
#     - end with     EXIT
#   Without the final EXIT, sqlplus waits on stdin and the job hangs until
#   max_runtime kills it.
[runner.sqlplus]
command = C:\oracle\instantclient_21_13\sqlplus.exe
arg     = -S
arg     = -L
arg     = /@PRODDB
arg     = @{file}

# HTTP checks via curl.exe (ships with Windows 10 1803+ and Server 2019+).
# The job file is a curl config file (one option per line), so an HTTP
# check needs no script at all.
#   --fail        Exit 22 on HTTP status >= 400.
#   --max-time    Hard per-request limit (exit 28 on timeout); keep it below
#                 the job's max_runtime.
#   --config      The job's .curl file follows.
[runner.curl]
command = C:\Windows\System32\curl.exe
arg     = --silent
arg     = --show-error
arg     = --fail
arg     = --max-time
arg     = 10
arg     = --config

# Shell scripts on Windows via Cygwin bash. Lets the same .sh checks run on
# Linux, macOS and Windows, and lets legacy Cygwin/cron scripts migrate
# unchanged.
#   --login          Loads /etc/profile so PATH has /usr/bin (awk, sed, grep,
#                    df ...) ahead of the Windows tools of the same name.
#   CHERE_INVOKING   Stops --login from cd-ing to $HOME, so the working
#                    directory stays where Vigil set it.
#   -o pipefail      A failure anywhere in a pipeline fails the script.
#   Paths          : Vigil passes the file as an absolute Windows path
#                    (C:\vigil\checks\x.sh); Cygwin accepts it. Inside the
#                    script use cygpath if POSIX paths are needed.
#   Line endings   : scripts MUST be LF. CRLF fails with "$'\r': command not
#                    found". Add "*.sh text eol=lf" to .gitattributes so Git
#                    on Windows does not convert them.
#   Process tree   : Cygwin processes are real Windows processes, so tree
#                    cleanup applies - but Cygwin emulates fork/exec, so
#                    Windows parent links can differ from Cygwin's. Needs its
#                    own fault-injection test.
[runner.cygwin]
command = C:\cygwin64\bin\bash.exe
arg     = --login
arg     = -o
arg     = pipefail
env     = CHERE_INVOKING=1

# Legacy Korn shell scripts (.ksh) from the old Cygwin/cron hub. Requires the
# Cygwin "mksh" package.
[runner.cygwin_ksh]
command = C:\cygwin64\bin\mksh.exe
env     = CHERE_INVOKING=1

# Git Bash (MSYS2) - same idea, often already installed with Git for Windows.
# Not mapped in [runners]; jobs opt in with "runner = gitbash".
[runner.gitbash]
command = C:\Program Files\Git\bin\bash.exe
arg     = --login
arg     = -o
arg     = pipefail
env     = CHERE_INVOKING=1

# Extension -> runner map. Lets jobs omit "runner". Keys are extensions
# including the dot; values are [runner.*] names. One runner per extension:
# on a host with two database engines, .sql maps to one of them and
# jobs for the other set "runner" explicitly (see job.mssql_backup_age).
[runners]
.ps1  = ps
.sql  = dbsql
.java = java
.curl = curl
.sh   = cygwin
.ksh  = cygwin_ksh

# -----------------------------------------------------------------------------
# DEFAULTS
#   Applied to every job unless the job overrides the key.
#
#   max_runtime : Optional. Omit it and the job runs until it finishes.
#                 Duration (300s, 5m, 2h). Checked by the supervisor each
#                 tick; on expiry the job's process tree is asked to stop,
#                 then killed after "grace". Not enforced while the
#                 supervisor is down. Rarely belongs in [defaults].
#   grace       : Time between polite stop and forced kill.
#   overlap     : skip      - do not start while the previous run is active
#                 queue_one - keep at most one pending run
#   exit_codes  : standard  - 0 = success, anything else = failed
#                 nagios    - 0 = OK, 1 = WARNING, 2 = CRITICAL, 3 = UNKNOWN
#                             (lets existing Nagios plugins run unmodified)
#                 <list>    - explicit success codes, ranges allowed,
#                             e.g. "0-7" for robocopy, "0,1" for diff.
#                             Anything else = failed.
#
#   Also allowed here: on_uncertain, backends, enabled, working_dir,
#   late_start_window, log_retain_days, forward_output.
#   Not allowed here (job-only): file, arg,
#   metric_name, run_every, run_at, run_on_days, runner, tag, env,
#   require_env.
#
#   Precedence for every job key: the job, then [defaults] (or the global
#   section it overrides), then Vigil's built-in default.
#   "vigil precheck <job>" prints each effective value and where it came from.
# -----------------------------------------------------------------------------
[defaults]
grace       = 30s
overlap     = skip
exit_codes  = standard


# =============================================================================
# JOBS
#
#   [job.<id>]   The id names the state file, the log folder and the "job" tag.
#
#   file        : Required. The script or executable to run.
#                 A local path; relative paths resolve against the install
#                 root. (Scripts fetched from a source: see the mixed mock.)
#   runner      : Optional. Name of a [runner.*] section that runs "file".
#                 Overrides the [runners] extension map. Omitted on the jobs
#                 below because .sql / .ps1 / .java are all mapped.
#   arg         : Optional. Extra argument after "file". Repeat per argument.
#   metric_name : Optional. Base metric name; defaults to the job id.
#                 Vigil posts per run:
#                   <metric_name>.duration_seconds   success duration
#                   <metric_name>.runs / .failures / .timeouts / .skipped
#                   <metric_name>.terminated
#                   <metric_name>.running            elapsed seconds in flight
#                   <metric_name>.invalid_config     job rejected by validation
#                   <metric_name>.file_missing       file not found on disk
#                 Lines the job prints to stdout as
#                   metric <name> <value> [key=value ...]
#                 are posted as <metric_name>.<name> with the job's tags.
#   max_runtime : Optional. No key = no limit. See DEFAULTS.
#   enabled     : Optional. "false" stops scheduling the job but keeps it
#                 visible as DISABLED in jobs.log. Default: true.
#   backends    : Optional. Comma-separated [backend.<name>] names this job's
#                 metrics go to. Default: every enabled backend.
#                 e.g.  backends = splunk
#
#   Per-job overrides (all optional):
#   tag               : Extra metric tag, key=value. Repeat per tag. Merged
#                       with [tags]; the job's value wins on a clash.
#   env               : Environment variable for the job, NAME=value.
#                       Repeat per variable. Literal - never a secret.
#                       Merged with the runner's env; the job wins.
#   require_env       : Comma-separated variables that must exist before
#                       the job starts. Added to the runner's require_env.
#   late_start_window : Overrides [scheduler] late_start_window.
#   log_retain_days   : Overrides [log] retain_days for this job's log.
#   forward_output    : false keeps this job's stdout and stderr out of log
#                       forwarding (see LOG FORWARDING). Default true.
#   working_dir       : Working directory of the job. Default: install root.
#
#   Nagios checks: jobs with exit_codes = nagios also have the numbers a
#   Nagios check prints after "|" turned into metrics automatically:
#     <metric_name>.perf  value  label=<the check's label>
#   plus .warn / .crit / .min / .max when present. Units are converted
#   (ms -> seconds, MB -> bytes). Nothing to configure.
#
#   Schedule - exactly one of run_every / run_at:
#   run_every   : Fixed interval, measured from scheduled time.
#   run_at      : One or more local times of day (comma-separated).
#   run_on_days : Optional. Restricts run_every or run_at to these weekdays.
#
#   Valid    : run_every
#              run_at
#              run_every + run_on_days
#              run_at    + run_on_days
#   Invalid  : run_every + run_at   (list the times in run_at instead)
#              run_on_days alone    (nothing says when to run)
#   An invalid job is skipped, shown as INVALID in jobs.log and reported via
#   <metric_name>.invalid_config until fixed. Other jobs keep running.
#
#   Smallest useful job:
#     [job.disk_usage]
#     file        = checks\disk_usage.ps1
#     run_every   = 5m
#
#   Per-job notes below: Unit / Desc / Stdout / Alerts / Timeout - what the
#   job reports and how to alert on it in the backend.
# =============================================================================


# --- Every few minutes -------------------------------------------------------
# The database maintenance jobs: .sql files run through the dbsql runner
# (see RUNNERS), which owns every database-specific detail.

# METRIC  : db.backup_log
# Unit    : seconds (success duration)
# Desc    : Transaction log backup of every user database in full recovery.
#           Higher values mean larger databases or disk I/O pressure.
# Alerts  : .failures > 0              -> backup failed, investigate log
#           .running  > 300            -> stuck or unusually slow
#           .skipped  > 0              -> previous run still in flight
# Timeout : 5m. A log backup blocking beyond this usually means the log
#           volume is full. Kill and alert rather than let blocked runs pile
#           up every minute.
[job.backup_log]
metric_name = db.backup_log
file        = sql\backup_log.sql
run_every   = 1m
max_runtime = 5m

# METRIC  : db.blocking
# Unit    : count (sessions)
# Desc    : Blocking monitor. Emits blocked and blocking session counts and,
#           when blocking is found, writes a snapshot of the chain to the job
#           log.
# Stdout  : metric blocked_sessions <n>
#           metric blocking_sessions <n>
# Alerts  : .blocked_sessions  > 5     -> WARN
#           .blocked_sessions  > 20    -> CRITICAL
#           .blocking_sessions         -> anomaly alert
# Timeout : 55s - must finish inside its own 1-minute interval.
[job.blocking]
metric_name = db.blocking
file        = scripts\blocking.ps1
run_every   = 1m
max_runtime = 55s

# METRIC  : db.connections
# Unit    : seconds (duration of successful connection)
# Desc    : Liveness check: connect and run a trivial query. The exit code
#           alone decides success - no output parsing.
# Alerts  : .failures > 0              -> CRITICAL. Use a consecutive-failure
#                                         threshold (recommend 3) to separate
#                                         blips from outages: 3 @ 5m = ~15m.
#           no data > 10m              -> CRITICAL. Vigil itself may be down.
# Exit    : nagios - lets the runner report WARNING (slow connect) separately
#           from CRITICAL (no connect).
[job.connections]
metric_name = db.connections
file        = sql\connections.sql
run_every   = 5m
exit_codes  = nagios

# METRIC  : db.perf
# Unit    : various (%, count)
# Desc    : Server performance counters over a 5-minute window - metrics not
#           visible to OS-level monitoring.
# Stdout  : metric cpu_busy_pct, cache_hit_pct, lock_requests, deadlocks,
#           committed_transactions, disk_ios
# Alerts  : .deadlocks     > 0         -> WARN: investigate blocking
#           .cpu_busy_pct  > 80        -> WARN: CPU pressure
#           .cache_hit_pct < 95        -> WARN: consider a larger cache
#           lock_requests, committed_transactions, disk_ios
#                                      -> anomaly monitors (per-server baseline)
[job.perf]
metric_name = db.perf
file        = scripts\perf_counters.ps1
run_every   = 5m

# METRIC  : db.status
# Unit    : various (%, MB, count, state)
# Desc    : OS, process, service and database health snapshot. Also writes a
#           human-readable status.log beside jobs.log.
# Stdout  : metric os.cpu_pct / os.ram_used_pct / os.pagefile_used_pct
#           metric os.disk_<name>_used_pct
#           metric os.service.<name>.state  (0 ok, 1 wrong state, 2 not found)
#           metric db.data_used_pct db=<name>   (db as a tag, not a name)
#           metric db.log_used_pct  db=<name>
# Alerts  : os.cpu_pct > 80 WARN, > 95 CRIT
#           os.disk_*_used_pct > 70 WARN, > 85 CRIT (backups/logs: 60 / 75)
#           os.service.<database service>.state > 0 CRIT (database down)
#           db.data_used_pct > 80 WARN, > 90 CRIT
#           db.log_used_pct > 70 WARN, > 85 CRIT
[job.status]
metric_name = db.status
file        = scripts\status.ps1
run_every   = 5m

# METRIC  : db.errorlog_scan
# Unit    : count (error_lines), gauge (alert_level 0-4)
# Desc    : Error log scanner. Reads only new content since the last run via
#           a byte-offset file and classifies the highest severity found:
#             0 OK, 1 INFO, 2 WARN, 3 DEADLOCK, 4 CRITICAL
# Alerts  : .alert_level >= 3          -> PAGE (deadlock or critical)
#           .alert_level >= 2          -> WARN
[job.errorlog_scan]
metric_name = db.errorlog_scan
file        = scripts\errorlog_scan.ps1
run_every   = 15m

# METRIC  : db.audit_active
# Unit    : seconds since the last audit event recorded
# Desc    : Checks auditing is recording. If the newest audit event is older
#           than the warn threshold, restarts auditing automatically. Emits
#           0 if auditing is not configured - exclude 0 from alerts.
# Alerts  : .seconds_since_last_event > 300  -> WARN (restart attempted)
#           .seconds_since_last_event > 600  -> CRITICAL (DBA required)
[job.audit_active]
metric_name = db.audit_active
file        = scripts\audit_active.ps1
run_every   = 15m


# --- Hourly / several times a day --------------------------------------------

# METRIC  : db.database_size
# Unit    : seconds (success duration)
# Desc    : Data and log space per database.
# Stdout  : metric data.available_mb db=<name>
#           metric data.used_pct     db=<name>
#           metric log.available_mb  db=<name>
#           metric log.used_pct      db=<name>
# Alerts  : .data.used_pct > 85        -> data space critical
#           .log.used_pct  > 40        -> log space warning
#           .failures      > 0         -> query failed
[job.database_size]
metric_name = db.database_size
file        = scripts\database_size.ps1
run_every   = 1h

# METRIC  : db.backup_differential
# Unit    : seconds (success duration)
# Desc    : Differential backup of every user database: four recovery points
#           a day between full backups. Skips if the day's full backup has
#           not completed.
# Alerts  : .failures > 0              -> backup failed
# Timeout : 10m. Lighter than a full backup; blocking beyond 10m indicates a
#           disk or log space issue.
# Schedule: several fixed times, listed in one run_at.
[job.backup_differential]
metric_name = db.backup_differential
file        = sql\backup_differential.sql
run_at      = 03:00, 09:00, 15:00, 21:00
max_runtime = 10m


# --- Daily -------------------------------------------------------------------

# METRIC  : db.backup_full
# Unit    : seconds (success duration)
# Desc    : Full backup of all system and user databases, with 30-day
#           retention. Safe alongside backup_log.
# Alerts  : .failures > 0              -> backup failed
#           .running  > 3600           -> unusually slow (> 1h)
# Timeout : 2h. Beyond that indicates disk pressure, blocking or a hung
#           backup. Raise if production databases are very large.
[job.backup_full]
metric_name = db.backup_full
file        = sql\backup_full.sql
run_at      = 01:00
max_runtime = 2h

# METRIC  : db.audit_cleanup
# Unit    : seconds (success duration)
# Desc    : Deletes archived audit rows older than 60 days in 10,000-row
#           batches, keeping the archive's log bounded.
# Alerts  : .failures > 0              -> delete failed
#           .running  > 600            -> large backlog
[job.audit_cleanup]
metric_name = db.audit_cleanup
file        = sql\audit_cleanup.sql
run_at      = 07:30

# METRIC  : db.update_statistics
# Unit    : seconds (success duration)
# Desc    : Refreshes optimizer statistics on tables whose data changed past
#           a threshold.
# Alerts  : .failures > 0              -> run failed
#           .running  > 3600           -> unusually slow (> 1h)
[job.update_statistics]
metric_name = db.update_statistics
file        = scripts\update_statistics.ps1
run_at      = 18:00
run_on_days = mon, wed, fri, sun


# --- Weekly ------------------------------------------------------------------
# Long-running jobs pinned to off-peak hours, deliberately staggered
# (04:00, 05:00, 06:00 Sunday) to avoid concurrent heavy load.

# METRIC  : db.consistency_check
# Unit    : count (faults per database)
# Desc    : Consistency check of every user database; reports hard and soft
#           faults.
# Stdout  : metric hard_faults db=<name>
#           metric soft_faults db=<name>
# Alerts  : .hard_faults > 0           -> CRITICAL (page DBA)
#           .soft_faults > 0           -> WARNING (investigate)
#           .running                   -> anomaly detection
# Timeout : None, deliberately - a partial run is worse than no run. No
#           max_runtime key means the job runs to natural completion.
[job.consistency_check]
metric_name = db.consistency_check
file        = scripts\consistency_check.ps1
run_at      = 04:00
run_on_days = sun

# METRIC  : db.prune_backup_history
# Unit    : seconds (success duration)
# Desc    : Purges backup history older than 28 days.
# Alerts  : .failures > 0              -> investigate
[job.prune_backup_history]
metric_name = db.prune_backup_history
file        = sql\prune_backup_history.sql
run_at      = 05:00
run_on_days = sun

# METRIC  : db.cycle_errorlog
# Unit    : seconds (success duration)
# Desc    : Starts a new error log and compresses the old one into
#           <errorlog_dir>\archive\. Typical duration 8-15s.
# Alerts  : .failures > 0              -> rotation failed
[job.cycle_errorlog]
metric_name = db.cycle_errorlog
file        = sql\cycle_errorlog.sql
run_at      = 06:00
run_on_days = sun


# --- Non-SQL example ---------------------------------------------------------

# METRIC  : app.jvm.heap_check
# Unit    : percent
# Desc    : Example only - not part of the database fleet. Shows a file with no
#           "#!" line run through the java runner via the [runners] map.
#           The resulting command line is:
#             C:\Program Files\Java\jdk-21\bin\java.exe checks\HeapCheck.java --warn 80
# Stdout  : metric heap_used_pct <n> pool=<name>
# Exit    : nagios - 0 OK, 1 heap above --warn, 2 above 95%, 3 JVM not found
# Alerts  : .heap_used_pct > 80        -> WARN
#           .failures      > 0         -> check could not run
[job.heap_check]
metric_name = app.jvm.heap_check
file        = checks\HeapCheck.java
arg         = --warn
arg         = 80
run_every   = 5m
max_runtime = 60s
exit_codes  = nagios

# METRIC  : app.legacy.export
# Unit    : seconds (success duration)
# Desc    : Example only. Shows per-job overrides. The vendor's export tool
#           only runs on Java 8, so this job picks the java8 runner; every
#           other .java job still uses JDK 21 through [runners].
#           Command line built by Vigil (working directory jobs\legacy):
#             C:\Program Files\Java\jre1.8.0_421\bin\java.exe -jar jobs\legacy\LegacyExport.jar --since 1d
#           Effective settings ("vigil precheck legacy_export"):
#             runner            = java8         (job)
#             max_runtime       = 2h            (job)
#             grace             = 30s           (defaults)
#             late_start_window = 3h            (job)
#             log_retain_days   = 90            (job)
#             tag               = environment=dev (tags), team=finance (job)
#             env               = JAVA_TOOL_OPTIONS=-Xmx4g (job)
#             require_env       = EXPORT_SFTP_PASSWORD (job)
# Alerts  : .failures > 0              -> export failed, finance notified
[job.legacy_export]
metric_name       = app.legacy.export
file              = jobs\legacy\LegacyExport.jar
runner            = java8
arg               = --since
arg               = 1d
run_at            = 02:00
max_runtime       = 2h
late_start_window = 3h
log_retain_days   = 90
working_dir       = jobs\legacy
tag               = team=finance
env               = JAVA_TOOL_OPTIONS=-Xmx4g
require_env       = EXPORT_SFTP_PASSWORD
# Its output lists customer accounts: keep it on this host even though
# [log_forward] includes stdout and stderr.
forward_output    = false

# METRIC  : mssql.backup_age
# Unit    : hours since last full backup, per database
# Desc    : Example only. Pure SQL against SQL Server - no wrapper, no
#           password (integrated auth). Needs "runner = mssql" because .sql
#           is mapped to dbsql in [runners] on this host.
#           checks\mssql_backup_age.sql emits the stdout metric protocol
#           straight from a SELECT:
#             SET NOCOUNT ON;
#             SELECT 'metric hours ' + CAST(DATEDIFF(HOUR,
#                    MAX(b.backup_finish_date), GETDATE()) AS varchar(10))
#                    + ' db=' + d.name
#             FROM sys.databases d
#             LEFT JOIN msdb.dbo.backupset b
#                    ON b.database_name = d.name AND b.type = 'D'
#             WHERE d.name <> 'tempdb'
#             GROUP BY d.name;
#           Command line built by Vigil:
#             SQLCMD.EXE -S localhost -E -b -h -1 -W -i checks\mssql_backup_age.sql
# Stdout  : metric hours <n> db=<name>
# Alerts  : .hours > 26                -> WARN: nightly full backup missed
#           .hours > 50                -> CRITICAL: two backups missed
#           .failures > 0              -> query failed (sqlcmd -b exit code)
[job.mssql_backup_age]
metric_name = mssql.backup_age
runner      = mssql
file        = checks\mssql_backup_age.sql
run_every   = 1h
max_runtime = 2m

# METRIC  : os.free_disk
# Unit    : percent free, per drive
# Desc    : Example only. No runner at all - a .cmd file is executed directly
#           by Windows. Shows the third lookup step: no "runner", no match
#           in [runners], file is natively runnable.
# Stdout  : metric pct <n> drive=<letter>
# Alerts  : .pct < 15                  -> WARN
#           .pct < 5                   -> CRITICAL
[job.free_disk]
metric_name = os.free_disk
file        = checks\free_disk.cmd
run_every   = 10m
max_runtime = 30s


# =============================================================================
# INDUSTRY EXAMPLES
#   Not part of the database fleet. Common checks, one per runner style, to
#   show the same job shape covers any engine or tool. .sql jobs set
#   "runner" explicitly because .sql is mapped to dbsql on this host.
# =============================================================================

# --- Databases ---------------------------------------------------------------

# METRIC  : postgres.replication
# Unit    : seconds behind primary
# Desc    : Run on a streaming replica. 0 on a primary or an idle replica.
#           checks\pg_replication_lag.sql:
#             SELECT 'metric lag_seconds ' ||
#                    COALESCE(EXTRACT(EPOCH FROM now()
#                             - pg_last_xact_replay_timestamp()), 0)::int
#             WHERE pg_is_in_recovery();
#             SELECT 'metric connections_used_pct ' ||
#                    round(100.0 * count(*) /
#                          current_setting('max_connections')::int, 1)
#             FROM pg_stat_activity;
# Stdout  : metric lag_seconds <n>
#           metric connections_used_pct <n>
# Alerts  : .lag_seconds > 60          -> WARN
#           .lag_seconds > 300         -> CRITICAL
#           .connections_used_pct > 80 -> WARN
[job.pg_replication]
metric_name = postgres.replication
runner      = psql
file        = checks\pg_replication_lag.sql
run_every   = 1m
max_runtime = 30s

# METRIC  : mysql.status
# Unit    : count
# Desc    : Connection pressure and slow queries from global status.
#           checks\mysql_status.sql:
#             SELECT CONCAT('metric ', LOWER(VARIABLE_NAME), ' ', VARIABLE_VALUE)
#             FROM performance_schema.global_status
#             WHERE VARIABLE_NAME IN ('Threads_connected', 'Threads_running',
#                                     'Slow_queries', 'Aborted_connects');
# Stdout  : metric threads_connected <n>   (and the other three)
# Alerts  : .threads_running > 50      -> WARN: CPU-bound or lock pile-up
#           .aborted_connects rising   -> anomaly: auth failures / network
[job.mysql_status]
metric_name = mysql.status
runner      = mysql
file        = checks\mysql_status.sql
run_every   = 1m
max_runtime = 30s

# METRIC  : oracle.tablespace
# Unit    : percent used, per tablespace (autoextend-aware)
# Desc    : checks\oracle_tablespace.sql:
#             WHENEVER SQLERROR EXIT FAILURE
#             SET HEADING OFF FEEDBACK OFF PAGESIZE 0 LINESIZE 32767
#             SELECT 'metric used_pct ' || ROUND(used_percent, 1)
#                    || ' tablespace=' || tablespace_name
#             FROM dba_tablespace_usage_metrics;
#             EXIT
#           Command line built by Vigil:
#             sqlplus.exe -S -L /@PRODDB @checks\oracle_tablespace.sql
# Stdout  : metric used_pct <n> tablespace=<name>
# Alerts  : .used_pct > 85             -> WARN
#           .used_pct > 95             -> CRITICAL
[job.oracle_tablespace]
metric_name = oracle.tablespace
runner      = sqlplus
file        = checks\oracle_tablespace.sql
run_every   = 15m
max_runtime = 2m

# --- HTTP --------------------------------------------------------------------

# METRIC  : http.api_health
# Unit    : seconds (response time)
# Desc    : Endpoint health check with no script. checks\api_health.curl:
#             url       = "https://api.example.internal/health"
#             output    = "NUL"
#             write-out = "metric response_seconds %{time_total} status=%{http_code}\n"
#           Runner via [runners] (.curl). curl's --fail turns 4xx/5xx into
#           exit 22, so a bad status is a failed run, not just a slow one.
# Stdout  : metric response_seconds <n> status=<code>
# Alerts  : .failures > 0              -> CRITICAL: endpoint down or erroring
#           .response_seconds > 2      -> WARN: slow
[job.api_health]
metric_name = http.api_health
file        = checks\api_health.curl
run_every   = 1m
max_runtime = 15s

# --- Windows host ------------------------------------------------------------

# METRIC  : tls.cert_expiry
# Unit    : days until expiry, per certificate
# Desc    : Scans Cert:\LocalMachine\My for certificates with a private key
#           and prints days remaining. Catches the classic outage cause
#           weeks in advance.
# Stdout  : metric days_left <n> subject=<cn> thumbprint=<short>
# Exit    : nagios - 1 if any cert < 30 days, 2 if any < 7 days
# Alerts  : .days_left < 30            -> WARN
#           .days_left < 7             -> CRITICAL
[job.cert_expiry]
metric_name = tls.cert_expiry
file        = checks\cert_expiry.ps1
run_at      = 08:00
max_runtime = 2m
exit_codes  = nagios

# METRIC  : windows.eventlog
# Unit    : count of Critical/Error events in the last 15 minutes
# Desc    : Get-WinEvent over System and Application logs, Level 1-2,
#           grouped by provider.
#           backends = file: high-volume, kept local only - not sent to
#           the remote backends.
# Stdout  : metric errors <n> log=<System|Application> provider=<name>
# Alerts  : .errors > 0 for provider=Disk / Ntfs / volmgr -> CRITICAL
#           .errors anomaly                              -> WARN
[job.eventlog_errors]
metric_name = windows.eventlog
file        = checks\eventlog_errors.ps1
run_every   = 15m
max_runtime = 2m
backends    = file

# METRIC  : backup.file_sync
# Unit    : seconds (success duration)
# Desc    : Mirrors the backup directory to a file share with the built-in
#           robocopy.exe - a direct executable, no runner, args only.
#           robocopy exit codes are a bitmask: 0-7 mean success (with or
#           without files copied), 8+ mean failure. "exit_codes = 0-7"
#           stops a normal copy (exit 1) being reported as failed.
#           The share path is literal - Vigil does not expand %COMPUTERNAME%
#           (no shell is involved). Per-host values belong in that host's
#           config, or in a wrapper script.
# Alerts  : .failures > 0              -> CRITICAL: offsite copy broken
#           .duration_seconds anomaly  -> WARN: share or network slow
[job.backup_offsite_copy]
metric_name = backup.file_sync
file        = C:\Windows\System32\robocopy.exe
arg         = D:\backups
arg         = \\backupsrv\backups\DB01
arg         = /MIR
arg         = /R:2
arg         = /W:5
arg         = /NP
arg         = /NFL
arg         = /NDL
run_at      = 03:30
max_runtime = 3h
exit_codes  = 0-7

# --- Shell scripts on Windows (Cygwin) ---------------------------------------

# METRIC  : net.tcp_port
# Unit    : seconds (connect time)
# Desc    : One POSIX script, three platforms. checks/posix/tcp_port.sh uses
#           bash's built-in /dev/tcp - no nc, no telnet - so the identical
#           file runs on Linux, macOS (bash 3.2) and here under Cygwin.
#           Host and port come from job args, so one script serves many jobs.
#           Runner via [runners] (.sh -> cygwin). Command line built by Vigil:
#             C:\cygwin64\bin\bash.exe --login -o pipefail C:\vigil\checks\posix\tcp_port.sh db01 1433
# Stdout  : metric connect_seconds <n> target=<host>:<port>
# Exit    : nagios - 0 open, 2 refused / timed out
# Alerts  : .failures > 0              -> CRITICAL: database listener unreachable
[job.db_listener]
metric_name = net.tcp_port
file        = checks\posix\tcp_port.sh
arg         = db01
arg         = 1433
run_every   = 1m
max_runtime = 15s
exit_codes  = nagios

# METRIC  : legacy.replication_check
# Unit    : seconds (success duration)
# Desc    : Legacy migration - a script from an old cron hub, run unchanged.
#           It used to be one cron line per server on a central hub; now
#           each server runs its own copy under Vigil with a deadline, state
#           and metrics.
#           Legacy scripts often exit 0 even when they find a problem and
#           report by email instead. Until the script is changed to exit
#           non-zero (or print metric lines), Vigil can only report that it
#           ran and how long it took.
# Alerts  : .failures > 0              -> script itself broke
[job.replication_check]
metric_name = legacy.replication_check
file        = legacy\replication_check.sh
run_every   = 5m
max_runtime = 2m

# METRIC  : legacy.replication_latency
# Unit    : seconds (success duration)
# Desc    : Legacy Korn shell script via [runners] (.ksh -> cygwin_ksh).
#           Same caveat as above about exit codes.
[job.replication_latency]
metric_name = legacy.replication_latency
file        = legacy\replication_latency.ksh
run_every   = 15m
max_runtime = 5m

# METRIC  : backup.git_mirror
# Unit    : seconds (success duration)
# Desc    : Explicit runner override: this .sh needs Git Bash's git, so it
#           sets "runner = gitbash" instead of the mapped Cygwin bash.
#           enabled = false: defined but not scheduled - shown as DISABLED
#           in jobs.log.
[job.config_repo_mirror]
metric_name = backup.git_mirror
runner      = gitbash
file        = checks\posix\mirror_config_repo.sh
run_at      = 02:30
max_runtime = 10m
enabled     = false


# =============================================================================
# LOCAL PATHS
#   A job's file is relative to the install root, or absolute.
# =============================================================================

# Relative to the install root (C:\ProgramData\Vigil\checks\...).
[job.eventlog_errors_file]
metric_name = windows.eventlog
file        = checks\eventlog_errors.ps1
run_every   = 15m
max_runtime = 2m
backends    = file

# Absolute path anywhere on the host.
[job.eventlog_errors_abs]
metric_name = windows.eventlog
file        = D:\ops\checks\eventlog_errors.ps1
run_every   = 15m
max_runtime = 2m
backends    = local_archive

