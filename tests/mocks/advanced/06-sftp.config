# POINTER FILE - an SFTP server on the default port, with a login name.
# SSH key authentication only; the server's host key must already be in the
# service account's known_hosts.
[vigil]
config_source = central
config_file   = hosts/db01.config

[source.central]
type        = sftp
host        = sftp.example.com
user        = vigil
path        = /exports/vigil/config
check_every = 10m
