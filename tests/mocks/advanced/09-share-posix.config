# POINTER FILE - an NFS mount (Linux/macOS), with this host's own state
# directory: state_dir is the one other key a pointer file may hold, since
# where Vigil keeps its state is decided on the host.
[vigil]
config_source = central
config_file   = hosts/db01.config
state_dir     = /var/lib/vigil

[source.central]
type        = local
path        = /mnt/ops-share/vigil/config
check_every = 1m
