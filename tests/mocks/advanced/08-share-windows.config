# POINTER FILE - a UNC share (Windows). The file is copied into the cache
# before use, so a share that changes or disappears never breaks a running
# configuration.
[vigil]
config_source = central
config_file   = hosts/sql01.config

[source.central]
type        = local
path        = \fs01.example.com\ops\vigil\config
check_every = 1m
