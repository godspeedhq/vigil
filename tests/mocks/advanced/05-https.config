# POINTER FILE - an HTTPS file server, with an authentication header. The
# file is fetched from <url><config_file>. No digest: the configuration is
# meant to change, so the server and its access control are the trust
# anchor. The token is in the environment, never this file.
[vigil]
config_source = central
config_file   = hosts/db01.config

[source.central]
type         = https
url          = https://config.example.com/vigil/
header_name  = Authorization
header_value = env:VIGIL_CONFIG_AUTH
check_every  = 5m
timeout      = 30s
