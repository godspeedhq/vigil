# POINTER FILE - a Git repository over HTTPS at a release tag. The host
# runs exactly that release of its configuration until this line changes:
# the most controlled form, at the cost of editing every host to upgrade.
[vigil]
config_source = central
config_file   = hosts/db01.config

[source.central]
type = git
url  = https://git.example.com/ops/vigil-config.git
ref  = config-2026.10.1
