# POINTER FILE - everything remote. config/vigil.config on the host holds
# only where the configuration is. Here: a Git repository over HTTPS,
# following the "main" branch - merged changes reach every host pointing
# here within check_every. Credentials come from the service account's git
# credential helper (Git Credential Manager on Windows), never this file.
[vigil]
config_source = central
config_file   = hosts/db01.config

[source.central]
type        = git
url         = https://git.example.com/ops/vigil-config.git
ref         = main
check_every = 5m
