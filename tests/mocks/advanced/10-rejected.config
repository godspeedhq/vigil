# NOT VALID - what a pointer file may not do. Each line marked below is
# rejected; a pointer file holds only where the configuration is, so a
# setting never has two places it could come from.
[vigil]
config_source = central
config_file   = hosts/db01.config
# E_POINTER_ONLY: belongs in the fetched file.
instance      = db01

[source.central]
type = git
url  = https://git.example.com/ops/vigil-config.git
ref  = main

# E_POINTER_ONLY: script sources belong in the fetched file too.
[source.scripts]
type = git
url  = https://git.example.com/ops/monitoring.git
ref  = v2.3.1

# E_POINTER_ONLY: no local jobs beside a remote configuration.
[job.uptime]
file      = scripts/uptime.sh
run_every = 1m
