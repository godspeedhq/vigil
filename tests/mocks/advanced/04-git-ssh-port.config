# POINTER FILE - Git over SSH on port 2222 (ssh:// form), pinned to a full
# commit id, with a longer fetch limit for a slow link. Checked rarely,
# since a commit never changes.
[vigil]
config_source = central
config_file   = hosts/db01.config

[source.central]
type        = git
url         = ssh://git@git.example.com:2222/ops/vigil-config.git
ref         = 9c1e3f5b7d9f1a3c5e7a1b3d5f7092a4c6e8f0b1
check_every = 1h
timeout     = 2m
