# POINTER FILE - a Git repository over SSH, scp-style address, with the
# service account's SSH key. A "production" branch is the release channel
# for production hosts; others point at "staging".
[vigil]
config_source = central
config_file   = hosts/db01.config

[source.central]
type        = git
url         = git@git.example.com:ops/vigil-config.git
ref         = production
check_every = 2m
