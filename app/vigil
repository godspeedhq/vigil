# vigil - the Vigil command on Linux and macOS (SPECIFICATION.md 18.5).
#
#   vigil [--root <dir>] run <job>
#       Runs one job once now, in the foreground, for testing. Exits 0
#       succeeded, 1 warning, 2 failed, 3 unknown, 4 not run.
#   vigil [--root <dir>] resolve <job>
#       Confirms that the uncertain run holding <job> is over (11.4). Never
#       kills anything; the supervisor concludes the run at its next tick.
#   vigil [--root <dir>] precheck [<job>]
#       Pre-flight checks (16.4), changing nothing: the configuration's
#       problems, then everything runs need. With a job, also its effective
#       settings (6.6). Exits 0 when nothing failed, 1 otherwise.
#   vigil [--root <dir>] config
#       Edits the configuration as crontab -e does (16.6): a copy opens in
#       $VISUAL, $EDITOR or vi, and is saved only when it has no ERROR or
#       INVALID line. Exits 0 saved or unchanged, 1 not saved.
#   vigil [--root <dir>] secret set <NAME> [--stdin] | secret list | secret delete <NAME>
#       Vigil's own secret store (6.5.2). set prompts without echo, or reads
#       the value from stdin; list never shows values.
#   vigil [--root <dir>] service install [--user | --system] [--account <name>] [--no-start]
#       Registers the supervisor with systemd or launchd (18.1) after the
#       pre-flight checks pass, and starts it. System mode needs root and
#       runs as --account (Linux default: a vigil account, created when
#       missing; macOS default: root). The default mode is system for root,
#       user otherwise.
#   vigil [--root <dir>] service remove
#       Unregisters it. Running workers continue.
#   vigil [--root <dir>] start | stop | restart
#       Service control. Stopping leaves running workers alone (18.3).
#   vigil [--root <dir>] status
#       The service's state, then jobs.log.
#   vigil [--root <dir>] init [empty] [--instance <name>] [--backend file,datadog,otel] [--no-pack]
#       Writes a starting configuration (19): runners for the shells found
#       here, the backends, and the base pack's jobs; empty for neither. Asks
#       for what is not given when run at a terminal. Never overwrites a
#       configuration, never asks for a secret value.
#   vigil [--root <dir>] uninstall [--yes] [--keep-config]
#       Removes Vigil (18.8): the service, the running workers proven to be
#       Vigil's, the root (or all but config/ and scripts/) and the command
#       link. Lists what it will remove and asks first, unless --yes.
#   vigil [--root <dir>] version
#       The installed version.
#   vigil [--root <dir>] about
#       What Vigil is, who made it and where it runs.
#   vigil [--root <dir>] self update [--check] [--version <version>]
#       Upgrades this install to the latest release, or the one given (18.7).
#       --check only says whether there is a newer one.
#   vigil [--root <dir>] pack list | enable <what> | disable <what> | update [--check]
#       The packs of scripts and jobs (18.10). What is a pack or a pack_job.
#   vigil [--root <dir>] supervise [--once]
#       The supervisor (4.1): ticks until stopped (TERM or INT), or once
#       with --once. Running workers are never stopped with it.
#   vigil [--root <dir>] worker <job> --run-id <run id>
#       Internal: the worker the supervisor starts for a launched run.
#
# The install root is --root, else $VIGIL_ROOT, else the root a package names
# in app/PACKAGED, else the folder that contains this app/ folder.

set -u

# Follow links (the vigil command in ~/.local/bin is one) to find app/.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self="$(dirname "$self")/$link" ;;
    esac
done
# An absolute path needs no cd: a cd from a folder that was deleted (one an
# update replaced, say) prints an error on every command.
case $self in
    /*) app=$(dirname "$self") ;;
    *) app=$(cd "$(dirname "$self")" && pwd) ;;
esac
root=$(dirname "$app")

for lib in config validate effective command schedule outcome metrics events recovery prom secrets stores worker backends sender fetch logs format supervisor precheck service init selfupdate pack configedit; do
    # shellcheck source=/dev/null
    . "$app/lib/posix/$lib.sh"
done

# The root (18.6): --root, else VIGIL_ROOT, else a package's, else the folder
# above app/.
if [ -n "${VIGIL_ROOT-}" ]; then
    root=$(cd "$VIGIL_ROOT" && pwd) || exit 64
elif vigil_packaged "$app" && [ -n "$_vp_root" ]; then
    root=$_vp_root
fi

usage() {
    printf 'usage: vigil [--root <dir>] run <job> | resolve <job> | precheck [<job>] | config | supervise [--once]\n       vigil [--root <dir>] secret set <NAME> [--stdin] | secret list | secret delete <NAME>\n       vigil [--root <dir>] service install [--user | --system] [--account <name>] [--no-start] | service remove\n       vigil [--root <dir>] start | stop | restart | status\n       vigil [--root <dir>] init [empty] [--instance <name>] [--backend <list>] [--no-pack] | uninstall [--yes] [--keep-config]\n       vigil [--root <dir>] version | about | self update [--check] [--version <version>]\n       vigil [--root <dir>] pack list | enable <what> | disable <what> | update [--check]\n' >&2
    exit 64
}

if [ "${1-}" = --root ]; then
    [ "$#" -ge 2 ] || usage
    root=$(cd "$2" && pwd) || exit 64
    shift 2
fi

case ${1-} in
    run)
        [ "$#" -eq 2 ] || usage
        job=$2
        # Refuse while any run of the job may be in progress.
        state=$root/state
        if _vw_root=$root _vw_job=$job _vigil_wk_config 2>/dev/null; then state=$_vw_statedir; fi
        for f in "$state/locks/$job".*.launch "$state/locks/$job".*.token; do
            if [ -e "$f" ]; then
                printf 'vigil: a run of %s may be in progress (%s); not starting\n' "$job" "$f" >&2
                exit 4
            fi
        done
        vigil_launch "$root" "$job" || exit 4
        vigil_worker "$root" "$job" "$VIGIL_RUN_ID"
        rc=$?
        if [ "$rc" -le 3 ]; then
            if [ -n "$VIGIL_RUN_REASON" ]; then
                printf '%s: %s (%s) in %ss, run %s\n' "$job" "$VIGIL_RUN_OUTCOME" "$VIGIL_RUN_REASON" "$VIGIL_RUN_DURATION" "$VIGIL_RUN_ID"
            else
                printf '%s: %s in %ss, run %s\n' "$job" "$VIGIL_RUN_OUTCOME" "$VIGIL_RUN_DURATION" "$VIGIL_RUN_ID"
            fi
        fi
        exit "$rc"
        ;;
    precheck)
        [ "$#" -le 2 ] || usage
        vigil_precheck "$root" "${2-}"
        rc=$?
        vigil_update_notice "$root" "$app"
        exit "$rc"
        ;;
    config)
        [ "$#" -eq 1 ] || usage
        vigil_config_edit "$root"
        exit $?
        ;;
    secret)
        # Vigil's own secret store (6.5.2). Values are read from the terminal
        # without echo, or from stdin with --stdin; never from arguments.
        case ${2-}:$# in
            set:3 | set:4)
                name=$3
                if [ "$#" -eq 4 ]; then
                    [ "$4" = --stdin ] || usage
                    value=''
                    IFS= read -r -d '' value || true
                else
                    [ -t 0 ] || { printf 'vigil: not a terminal; use --stdin\n' >&2; exit 64; }
                    printf 'Value for %s (not echoed): ' "$name" >&2
                    IFS= read -r -s value
                    printf '\n' >&2
                fi
                _vsec_v=$value
                _vigil_secret_chomp
                vigil_secret_set "$root" "$name" "$_vsec_v" || exit 1
                _vsec_v='' value=''
                printf '%s set; runs started from now on use it\n' "$name"
                ;;
            list:2) vigil_secret_list "$root" || exit 1 ;;
            delete:3) vigil_secret_delete "$root" "$3" || exit 1 ;;
            *) usage ;;
        esac
        exit 0
        ;;
    resolve)
        [ "$#" -eq 2 ] || usage
        job=$2
        _vw_root=$root
        _vw_job=$job
        if ! _vigil_wk_config; then
            printf 'vigil: %s\n' "$_vw_error" >&2
            exit 1
        fi
        rec="$_vw_statedir/recovery/$job.recovery"
        if [ ! -f "$rec" ]; then
            printf 'vigil: %s is not held: there is no uncertain run to resolve\n' "$job" >&2
            exit 1
        fi
        rid=$(sed -n 's/^run_id *= *//p' "$rec")
        who=${USER:-$(id -un 2>/dev/null)}
        _vigil_wk_now
        # A file of its own, so the supervisor rewriting the record cannot
        # lose it (11.4). Nothing is killed.
        printf '[resolved]\nresolved_by = %s\nresolved_at = %s\n' "$who" "$_vw_iso" > "$rec.tmp.$$" &&
            mv -f "$rec.tmp.$$" "${rec%.recovery}.resolved" || exit 1
        printf '%s: run %s marked as over by %s; the supervisor concludes it and releases the job at its next tick\n' "$job" "$rid" "$who"
        exit 0
        ;;
    init)
        shift
        instance='' backends='' pack=base asked=0 empty=0 secrets=''
        if [ "${1-}" = empty ]; then
            empty=1 pack=''
            shift
        fi
        while [ "$#" -gt 0 ]; do
            case $1 in
                --instance | --backend)
                    [ "$#" -ge 2 ] || usage
                    if [ "$1" = --instance ]; then instance=$2; else backends=$2; fi
                    shift
                    ;;
                --no-pack) pack='' ;;
                *) usage ;;
            esac
            shift
        done
        # Defaults: the host name, and the file backend.
        host=$(hostname 2> /dev/null | sed 's/\..*//; s/[^A-Za-z0-9_.-]/-/g')
        if [ -t 0 ] && [ -z "$instance" ]; then
            printf 'Instance name [%s]: ' "${host:-vigil}"
            IFS= read -r instance
            asked=1
        fi
        if [ -t 0 ] && [ -z "$backends" ] && [ "$empty" = 0 ]; then
            printf 'Backends, comma-separated: file, datadog, otel [file]: '
            IFS= read -r backends
            asked=1
            # The credential: a name is asked for, and a secret's value only
            # by vigil secret set, which does not show it.
            for b in $(printf '%s' "$backends" | tr ',' ' '); do
                case $b in
                    datadog) name=DATADOG_API_KEY ;;
                    otel) name=OTEL_API_KEY ;;
                    *) continue ;;
                esac
                printf 'Credential for %s: (e)nvironment variable, (s)ecret store%s [e]: ' "$b" "$([ "$b" = otel ] && printf ', (n)one')"
                IFS= read -r how
                case $how in
                    s* | S*)
                        printf 'Secret name [%s]: ' "$name"
                        IFS= read -r given
                        name=${given:-$name}
                        printf -v "VIGIL_INIT_REF_$b" '%s' "secret:$name"
                        secrets="$secrets $name"
                        ;;
                    n* | N*)
                        [ "$b" = otel ] || { printf 'vigil: datadog needs a credential\n' >&2; exit 1; }
                        VIGIL_INIT_REF_otel=none
                        ;;
                    *)
                        printf 'Environment variable [%s]: ' "$name"
                        IFS= read -r given
                        name=${given:-$name}
                        printf -v "VIGIL_INIT_REF_$b" '%s' "env:$name"
                        ;;
                esac
            done
        fi
        [ -n "$instance" ] || instance=${host:-vigil}
        [ -n "$backends" ] || [ "$empty" = 1 ] || backends=file
        [ "$asked" = 1 ] && printf '\n'
        vigil_init "$root" "$instance" "$(printf '%s' "$backends" | tr -d ' ')" || exit $?
        vigil_pack_seed "$root" "$app" || exit 1
        for name in $secrets; do
            printf 'The value of %s, which is not shown:\n' "$name"
            "$BASH" "$app/vigil" --root "$root" secret set "$name" || printf 'not stored: run vigil secret set %s\n' "$name"
        done
        if [ -n "$pack" ] && [ -f "$root/packs/$pack/pack.config" ]; then
            vigil_pack_enable "$root" "$pack" || exit 1
        fi
        # A package registers its own service, and its install says how to
        # start it: vigil service install would refuse (18.6).
        vigil_packaged "$app" || printf '\nNext: vigil precheck, then vigil service install\n'
        exit 0
        ;;
    uninstall)
        shift
        yes=0 keep=0
        while [ "$#" -gt 0 ]; do
            case $1 in
                --yes) yes=1 ;;
                --keep-config) keep=1 ;;
                *) usage ;;
            esac
            shift
        done
        if vigil_packaged "$app"; then
            printf 'vigil: Vigil was installed by %s: remove it with that, which stops the service and keeps %s\n' "$_vp_manager" "$root" >&2
            exit 1
        fi
        vigil_uninstall "$root" "$yes" "$keep"
        exit $?
        ;;
    service)
        case ${2-} in
            install)
                shift 2
                mode='' account='' start=1
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --user) mode=user ;;
                        --system) mode=system ;;
                        --no-start) start=0 ;;
                        --account)
                            [ "$#" -ge 2 ] || usage
                            account=$2
                            shift
                            ;;
                        *) usage ;;
                    esac
                    shift
                done
                vigil_service_install "$root" "$app" "$mode" "$account" "$start"
                exit $?
                ;;
            remove)
                [ "$#" -eq 2 ] || usage
                vigil_service_remove "$root"
                exit $?
                ;;
            *) usage ;;
        esac
        ;;
    start | stop | restart)
        [ "$#" -eq 1 ] || usage
        vigil_service_control "$root" "$1"
        exit $?
        ;;
    status)
        [ "$#" -eq 1 ] || usage
        vigil_service_status "$root"
        rc=$?
        vigil_update_notice "$root" "$app"
        exit "$rc"
        ;;
    version)
        if [ "$#" -eq 2 ] && [ "$2" = --supervisor ]; then
            vigil_supervisor_version "$root"
            exit $?
        fi
        [ "$#" -eq 1 ] || usage
        vigil_version "$app"
        vigil_update_notice "$root" "$app"
        exit 0
        ;;
    about)
        [ "$#" -eq 1 ] || usage
        vigil_about "$root" "$app"
        vigil_update_notice "$root" "$app"
        exit 0
        ;;
    format-migrate)
        # Run by a supervisor under its lock, before it reloads (18.7).
        [ "$#" -eq 4 ] || usage
        vigil_format_migrate "$app" "$2" "$3" "$4" && exit 0
        printf '%s\n' "$_vf_error" >&2
        exit 1
        ;;
    pack)
        case ${2-}:$# in
            list:2) vigil_pack_list "$root" ;;
            enable:3) vigil_pack_enable "$root" "$3" ;;
            disable:3) vigil_pack_disable "$root" "$3" ;;
            update:2) vigil_pack_update "$root" "$app" 0 ;;
            update:3)
                [ "$3" = --check ] || usage
                vigil_pack_update "$root" "$app" 1
                ;;
            *) usage ;;
        esac
        exit $?
        ;;
    self)
        if [ "${2-}" = refresh-check ] && [ "$#" -eq 2 ]; then
            vigil_update_refresh "$root"
            exit 0
        fi
        [ "${2-}" = update ] || usage
        shift 2
        vigil_config_version "$root"
        # Internal (18.11): the one command the --update-by rule lets the service
        # account run as root to follow the configuration. Root reads the version
        # itself; the exit code tells the worker what went wrong.
        if [ "$#" -eq 1 ] && [ "$1" = --from-config ]; then
            [ -n "$_vu_want" ] || { printf 'vigil: the configuration names no version\n' >&2; exit 1; }
            vigil_self_update "$root" "$app" 0 "$_vu_want" wait && exit 0
            case $_vu_kind in download) exit 2 ;; install) exit 3 ;; esac
            exit 1
        fi
        check=0 want=''
        while [ "$#" -gt 0 ]; do
            case $1 in
                --check) check=1 ;;
                --version)
                    [ "$#" -ge 2 ] || usage
                    want=${2#v}
                    shift
                    ;;
                *) usage ;;
            esac
            shift
        done
        # The configuration decides the version when it names one (18.11):
        # an update here would be undone at its next load.
        # A package's program is refused whatever the configuration says.
        if [ "$check" = 0 ] && [ -n "$_vu_want" ] && ! vigil_packaged "$app"; then
            printf 'vigil: the version is set in the configuration (version = %s): change it there to update, or remove it to use vigil self update\n' "$_vu_want" >&2
            exit 1
        fi
        vigil_self_update "$root" "$app" "$check" "$want"
        exit $?
        ;;
    supervise)
        once=0
        if [ "$#" -eq 2 ] && [ "$2" = --once ]; then once=1; elif [ "$#" -ne 1 ]; then usage; fi
        VIGIL_APP=$app
        vigil_supervise "$root" "$once"
        exit $?
        ;;
    worker)
        [ "$#" -eq 4 ] && [ "$3" = --run-id ] || usage
        vigil_worker "$root" "$2" "$4"
        exit $?
        ;;
    *)
        usage
        ;;
esac
